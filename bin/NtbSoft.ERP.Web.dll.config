	<system.web>
		<globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" culture="vi-VN" uiCulture="vi-VN" />
		<compilation debug="true" targetFramework="4.5.2" />
		<httpRuntime targetFramework="4.5" maxRequestLength="2147483647" executionTimeout="3600" useFullyQualifiedRedirectUrl="true" minFreeThreads="8" minLocalRequestFreeThreads="4" />
		<pages controlRenderingCompatibilityVersion="4.0" />
	</system.web>
	<system.webServer>
		<modules runAllManagedModulesForAllRequests="true">
			<!--<remove name="FormsAuthenticationModule" />-->
			<remove name="WebDAVModule" />
		</modules>
		<security>
			<requestFiltering>
				<!--Đơn vị tính của maxAllowedContentLength là KB (2047G~2T) (1 GB = 1,048,576 KB) https://www.gbmb.org/gigabytes -->
				<requestLimits maxAllowedContentLength="2147483647" />
			</requestFiltering>
		</security>
		<handlers>
			<remove name="WebDAV" />




			<remove name="ExtensionlessUrlHandler-Integrated-4.0" />
			<remove name="OPTIONSVerbHandler" />
			<remove name="TRACEVerbHandler" />
			<add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
		</handlers>
	</system.webServer>
