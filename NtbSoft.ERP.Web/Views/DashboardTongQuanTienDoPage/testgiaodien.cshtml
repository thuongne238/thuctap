@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Dashboard Chuẩn Bị Sản Xuất";
    ViewBag.HeaderTitle = "Thống kê chuẩn bị sản xuất";
    ViewBag.ActiveTab = "chuanbi";
}

@section css {
    <!-- DevExtreme CSS -->
    <link rel="stylesheet" href="~/Content/plugins/DevExtreme/dx.common.css" onerror="this.onerror=null;this.href='https://cdn3.devexpress.com/jslib/23.2.5/css/dx.common.css';" />
    <link rel="stylesheet" href="~/Content/plugins/DevExtreme/dx.light.css" onerror="this.onerror=null;this.href='https://cdn3.devexpress.com/jslib/23.2.5/css/dx.light.css';" />

    <!-- CSS Modules Riêng Của Trang Dashboard -->
    <link href="~/css/DashboardTongQuanTienDo/production-progress-widget.css" rel="stylesheet" />
    <link href="~/css/DashboardTongQuanTienDo/chuanbisanxuat/dong-bo-giao-dien.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
    <link href="~/css/DashboardTongQuanTienDo/chuanbisanxuat/chuanbisanxuat.css?v=@DateTime.Now.Ticks" rel="stylesheet" />

    <!-- DevExtreme CSS -->
    <link rel="stylesheet" href="~/Content/plugins/DevExtreme/dx.common.css" />
    <link rel="stylesheet" href="~/Content/plugins/DevExtreme/dx.light.css" />

    <!-- CSS của Component Grid -->
    <link rel="stylesheet" href="~/css/griddevextreme/dx-detail-grid.css?v=@DateTime.Now.Ticks" />

    
}

<!-- =====================================================================
     NỘI DUNG TAB: TIẾN ĐỘ & CHUẨN BỊ 
     ===================================================================== -->
<div id="tab-content-tien-do" class="dashboard-tab-pane active-tab tab-tiendo-wrapper">
    <!-- SECTION 1: BẢNG ĐƠN HÀNG & THỜI GIAN  -->
    <section class="octo-card">
        <div class="card-header-title">
            <i class="fa-solid fa-list-check"></i>
            <span>Bảng Đơn Hàng & Kế Hoạch Thời Gian</span>
        </div>

        <div id="grid-orders-container" class="dx-octo-grid-wrapper"></div>
    </section>

    <!-- SECTION 2: MIDDLE ROW -->
    <section class="grid-middle">
        <div class="octo-card">
            <div class="card-header-title">
                <i class="fa-solid fa-boxes-packing"></i>
                <span>Tình Hình Nguyên Phụ Liệu</span>
            </div>

            <div id="grid-materials-container" class="dx-octo-grid-wrapper"></div>
        </div>

        <div class="octo-card">
            <div class="card-header-title">
                <i class="fa-solid fa-chart-pie"></i>
                <span>Tỷ Lệ Đáp Ứng NPL</span>
            </div>
            <!-- Biểu đồ hình tròn -->
            <div id="chart-pie-npl" style="width: 100%; height: 260px; min-height: 260px; cursor: pointer;"></div>
        </div>
    </section>

    <!-- SECTION 3: THEO DÕI MUA HÀNG -->
    <section class="octo-card">
        <div class="card-header-title">
            <i class="fa-solid fa-truck-ramp-box"></i>
            <span>Theo Dõi Mua Hàng (Nguyên Phụ Liệu)</span>
        </div>

        <div class="kpi-stats-grid">
            <div class="kpi-stat-card kpi-card-blue" data-purchase-kpi="all" style="cursor: pointer;" title="Bấm xem chi tiết tất cả đơn đã đặt (141,700)">
                <span class="kpi-value text-[#2563EB]" id="stat-da-dat">0</span>
                <span class="kpi-label">Đã Đặt</span>
            </div>
            <div class="kpi-stat-card kpi-card-green" data-purchase-kpi="da-ve" style="cursor: pointer;" title="Bấm xem chi tiết đơn đã về kho (133,960)">
                <span class="kpi-value text-[#059669]" id="stat-da-ve">0</span>
                <span class="kpi-label">Đã Về</span>
            </div>
            <div class="kpi-stat-card kpi-card-orange" data-purchase-kpi="sap-ve" style="cursor: pointer;" title="Bấm xem chi tiết đơn sắp về (8,740)">
                <span class="kpi-value text-[#EA580C]" id="stat-sap-ve">0</span>
                <span class="kpi-label">Sắp Về</span>
            </div>
            <div class="kpi-stat-card kpi-card-red" data-purchase-kpi="tre" style="cursor: pointer;" title="Bấm xem chi tiết đơn về trễ (2,500)">
                <span class="kpi-value text-[#DC2626]" id="stat-tre">0</span>
                <span class="kpi-label">Trễ</span>
            </div>
        </div>

        <!-- Biểu đồ nhiệt / thanh ngang -->
        <div class="chart-heatmap-wrap">
            <div id="chart-heatmap-purchase" style="width: 100%; height: 100%; min-height: 175px;"></div>
        </div>
    </section>
</div>






@section scripts {
    <!-- Apache ECharts CDN -->
    <script src="https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js"></script>
    <script>
        if (typeof echarts === 'undefined') {
            document.write('<script src="https://cdnjs.cloudflare.com/ajax/libs/echarts/5.5.0/echarts.min.js"><\/script>');
        }
    </script>


    <!-- DevExtreme Grid Components & Popup của 2 Bảng -->
    <script src="~/Scripts/griddevextreme/chuanbisanxuat/common-detail-popup.js?v=@DateTime.Now.Ticks" charset="utf-8"></script>
    <script src="~/Scripts/griddevextreme/orders-grid-component.js?v=@DateTime.Now.Ticks" charset="utf-8"></script>
    <script src="~/Scripts/griddevextreme/materials-grid-component.js?v=@DateTime.Now.Ticks" charset="utf-8"></script>

    <!-- Script Module của Tab Tiến Độ -->
    <script src="~/Scripts/DashboardTongQuanTienDo/chuanbisanxuat/dongbo-tab-tiendo.js?v=@DateTime.Now.Ticks" charset="utf-8"></script>

    <script>
        $(document).ready(function () {
            // Lắng nghe sự kiện thay đổi ngày từ Header (_Layout)
            $(document).on('dashboard:dateChanged', function (e, data) {
                if (window.TabTienDoModule) window.TabTienDoModule.reload();
            });

            // Lắng nghe sự kiện bấm nút Refresh từ Header (_Layout)
            $(document).on('dashboard:refresh', function () {
                if (window.TabTienDoModule) window.TabTienDoModule.reload(true);
            });

            // 👉 Kích hoạt vẽ 2 biểu đồ ECharts của Tab Tiến Độ ngay khi trang tải xong
            if (window.TabTienDoModule) {
                window.TabTienDoModule.activate();
            }


        });
    </script>
}
