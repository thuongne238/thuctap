@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi" id="html-root">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Merchandiser Order Management Dashboard</title>
    <!-- Google Fonts: Inter, Space Grotesk & JetBrains Mono for premium high-precision feel -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
          rel="stylesheet" />
    <!-- Font Awesome Free 6.5.2 CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <!-- Custom Style Sheet -->
    <link href="~/css/DashboardTongQuanTienDo/merchandiser-dashboard.css" rel="stylesheet" />
    <!-- DateRangePicker CSS CDN -->
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Apache ECharts CDN -->
    <script src="https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js"></script>
    <style>
        /* WIP Detail Modal Enhancements */
        .wip-summary-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 1rem;
            margin-bottom: 1.2rem;
        }

        .wip-summary-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 8px;
            padding: 0.8rem 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.2rem;
            box-shadow: 0 4px 6px rgba(0,0,0,0.15);
            backdrop-filter: blur(10px);
            transition: transform 0.2s ease, border-color 0.2s ease;
        }

            .wip-summary-card:hover {
                transform: translateY(-2px);
                border-color: var(--color-green);
            }

            .wip-summary-card .card-label {
                font-size: 0.95rem;
                color: var(--text-secondary, #a0aec0);
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }

            .wip-summary-card .card-value {
                font-size: 1.6rem;
                font-weight: 700;
                color: var(--text-primary, #ffffff);
                font-family: 'Space Grotesk', sans-serif;
            }

            .wip-summary-card.green .card-value {
                color: var(--color-green, #48bb78);
            }

            .wip-summary-card.blue .card-value {
                color: var(--color-blue, #4299e1);
            }

            .wip-summary-card.orange .card-value {
                color: var(--color-orange, #ed8936);
            }

        .wip-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 1rem;
            background: var(--bg-subtle);
            padding: 0.8rem 1rem;
            border-radius: 8px;
            border: 1px solid var(--border-color);
        }

        .wip-search-wrapper {
            position: relative;
            flex: 1;
            min-width: 250px;
        }

        .wip-search-input {
            width: 100%;
            padding: 0.5rem 1rem 0.5rem 2.2rem;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            color: var(--text-primary);
            font-size: 1.1rem;
            outline: none;
            transition: border-color 0.2s;
        }

            .wip-search-input:focus {
                border-color: var(--color-green);
            }

        .wip-search-icon {
            position: absolute;
            left: 0.8rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-secondary);
            font-size: 1.1rem;
        }

        .wip-group-controls {
            display: flex;
            align-items: center;
            gap: 0.8rem;
        }

        .wip-select-control {
            padding: 0.5rem 1.8rem 0.5rem 0.8rem;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            color: var(--text-primary);
            font-size: 1.1rem;
            outline: none;
            cursor: pointer;
            min-width: 180px;
        }

            .wip-select-control option {
                background-color: var(--bg-main, #fff);
                color: var(--text-primary, #000);
            }

            .wip-select-control:focus {
                border-color: var(--color-green);
            }

        /* Collapsible Rows styles */
        tr.group-row {
            cursor: pointer;
            background: rgba(255, 255, 255, 0.02) !important;
            font-weight: 600;
            font-size: 1.2rem;
        }

            tr.group-row:hover {
                background: rgba(255, 255, 255, 0.05) !important;
            }

            tr.group-row td {
                border-bottom: 2px solid rgba(255, 255, 255, 0.1) !important;
            }

        .expand-toggle {
            display: inline-block;
            width: 1.2rem;
            text-align: center;
            margin-right: 0.5rem;
            transition: transform 0.2s;
            color: var(--color-green);
            font-size: 1.1rem;
        }

        tr.group-row.expanded .expand-toggle {
            transform: rotate(90deg);
        }

        :root {
            --bg-child-row: #e2e8f0;
        }

        [data-theme="dark"] {
            --bg-child-row: #131b2e;
        }

        tr.child-row {
            background: var(--bg-child-row) !important;
        }

            tr.child-row.hidden {
                display: none;
            }

            tr.child-row td {
                font-size: 1.1rem;
                color: var(--text-primary) !important;
                padding: 0.5rem 0.8rem !important;
                border-bottom: 1px dashed var(--border-color) !important;
            }

        /* Force details button styling to be transparent and adapt to theme */
        #btn-wip-progress-details {
            background: transparent !important;
            border: none !important;
            color: var(--text-secondary) !important;
            box-shadow: none !important;
            outline: none !important;
            padding: 0.4rem !important;
            border-radius: var(--border-radius) !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
        }

            #btn-wip-progress-details:hover {
                background-color: var(--bg-subtle) !important;
                color: var(--text-primary) !important;
            }

            #btn-wip-progress-details svg {
                fill: none !important;
                stroke: currentColor !important;
            }

        /* Fix header modal table transparent scroll-through bug */
        .po-modal-table th {
            position: sticky;
            top: 0;
            z-index: 10;
            background: #111b33 !important; /* Đảm bảo màu nền đậm đục che đi nội dung cuộn bên dưới trong nền tối */
        }

        :root:not([data-theme="dark"]) .po-modal-table th {
            background: #ffffff !important; /* Màu trắng đục cho nền sáng */
        }

        :root[data-theme="dark"][data-ui-version="new"] .po-modal-table th {
            background: #1a1a28 !important; /* Màu xám đen đục cho new dark mode */
        }
    </style>
</head>

<body>
    <div class="dashboard-wrapper">
        <!-- 2. MAIN CONTAINER -->
        <main class="main-content">
            <!-- Header bar -->
            <header class="main-header">
                <div class="header-left">
                    <h1>Dashboard</h1>
                    
                    <div class="header-date" id="header-daterange-picker">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                            <line x1="16" y1="2" x2="16" y2="6" />
                            <line x1="8" y1="2" x2="8" y2="6" />
                            <line x1="3" y1="10" x2="21" y2="10" />
                        </svg>
                        <input type="text" id="start-date" class="datepicker-input" value="@(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).ToString("dd'/'MM'/'yyyy"))" readonly />
                        <span class="datepicker-separator">-</span>
                        <input type="text" id="end-date" class="datepicker-input" value="@(new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month)).ToString("dd'/'MM'/'yyyy"))" readonly />
                    </div>
                    <div class="header-side-nav inline-flex items-center p-1" id="header-side-nav" style="background-color: var(--btn-bg); border: var(--btn-border); border-radius: var(--btn-radius); backdrop-filter: var(--btn-blur); -webkit-backdrop-filter: var(--btn-blur); box-shadow: var(--btn-shadow);">
                        <!-- Nút đang chọn (Active) -->
                        <button type="button" class="side-nav-btn active inline-flex items-center gap-[0.6rem] px-[1.2rem] py-[0.6rem] text-[1.1rem] rounded-[calc(var(--btn-radius)-0.2rem)] font-semibold transition-all duration-200 cursor-pointer bg-white text-slate-800 shadow-sm border border-slate-200/60" id="btn-side-tinh-hinh" data-side="tinh-hinh" title="Tình hình sản xuất">
                            <i class="fa-solid fa-chart-pie text-[1.1rem]"></i>
                            <span>Tình hình sản xuất</span>
                            <
                        </button>
                        
                        <!-- Nút bình thường -->
                        <a href="~/DashboardTongQuanTienDoPage/testgiaodien" class="side-nav-btn inline-flex items-center gap-[0.6rem] px-[1.2rem] py-[0.6rem] text-[1.1rem] rounded-[calc(var(--btn-radius)-0.2rem)] font-medium transition-all duration-200 cursor-pointer text-slate-600 hover:text-slate-900 hover:bg-white/50 no-underline" id="btn-side-tien-do" data-side="tien-do" title="Tiến độ sản xuất">
                            <i class="fa-solid fa-chart-gantt text-[1.1rem]"></i>
                            <span>Tiến độ sản xuất</span>
                        </a>
                    </div>
                    <div class="header-select" style="display: none;">
                        <select id="header-factory-select">
                            <option value="all">Tất cả nhà máy</option>
                            <option value="factory-a">Nhà máy Bình Dương</option>
                            <option value="factory-b">Nhà máy Đồng Nai</option>
                        </select>
                    </div>
                </div>

                <div class="header-right">
                    <!-- Switch between mock and sql simulation -->
                    <div class="data-toggle-wrapper" style="display: none;">
                        <span class="toggle-label">Real SQL Mode</span>
                        <label class="switch">
                            <input type="checkbox" id="data-source-toggle" checked="checked" />
                            <span class="slider round"></span>
                        </label>
                        <span class="sql-loader" id="sql-loader" style="display: none;">
                            <span class="spinner"></span>
                            <span>Đang tải dữ liệu SQL...</span>
                        </span>
                    </div>

                    <button class="btn-icon btn-theme-toggle" id="btn-theme-toggle" title="Chuyển Dark/Light Mode">
                        <svg id="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="5"></circle>
                            <line x1="12" y1="1" x2="12" y2="3"></line>
                            <line x1="12" y1="21" x2="12" y2="23"></line>
                            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                            <line x1="1" y1="12" x2="3" y2="12"></line>
                            <line x1="21" y1="12" x2="23" y2="12"></line>
                            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                        </svg>
                        <svg id="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                        </svg>
                        <span class="btn-label" id="theme-toggle-label">Chế độ tối</span>
                    </button>

                    <button class="btn-icon btn-ui-toggle" id="btn-ui-toggle" title="Chuyển đổi giao diện Cũ/Mới" style="display: none;">
                        <!-- Icon giao diện Cũ (Glassmorphism / Layers) -->
                        <svg id="ui-icon-old" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="2" width="20" height="20" rx="2" ry="2"></rect>
                            <line x1="12" y1="2" x2="12" y2="22"></line>
                        </svg>
                        <!-- Icon giao diện Mới (Indigo Accent / Tech Layout) -->
                        <svg id="ui-icon-new" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
                        </svg>
                        <span class="btn-label" id="ui-toggle-label">Giao diện mới</span>
                    </button>

                    <button class="btn-icon header-notification" style="display: none;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                        </svg>
                        <span class="badge">12</span>
                        <span class="btn-label">Thông báo</span>
                    </button>
                    <button class="btn-export" style="display: none;">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                            <polyline points="7 10 12 15 17 10" />
                            <line x1="12" y1="15" x2="12" y2="3" />
                        </svg>
                        <span>Xuất báo cáo</span>
                    </button>
                </div>
            </header>



            <!-- ROW 1: KPI CARDS -->
            <section class="kpi-grid">
                <!-- Card 1: Tổng đơn -->
                <div class="kpi-card border-blue">
                    <div class="card-meta">
                        <div class="card-icon bg-light-blue text-blue">
                            <i class="fa-solid fa-file-lines"></i>
                        </div>
                        <div class="card-title-group">
                            <!-- Top: Dữ liệu / kết quả -->
                            <div class="kpi-value-row">
                                <span class="card-value" id="kpi-total-orders">128</span>
                                <!-- Trend Badge Inline -->
                                <div class="card-trend text-green">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="18 15 12 9 6 15" />
                                    </svg>
                                    <span>12.5%</span>
                                </div>
                            </div>
                            <!-- Middle: Title chính -->
                            <span class="card-label">TỔNG ĐƠN</span>
                        </div>
                    </div>
                </div>

                <!-- Card 2: Đơn đang sản xuất -->
                <div class="kpi-card border-orange">
                    <div class="card-meta">
                        <div class="card-icon bg-light-orange text-orange">
                            <i class="fa-solid fa-wrench"></i>
                        </div>
                        <div class="card-title-group">
                            <!-- Top: Dữ liệu / kết quả -->
                            <div class="kpi-value-row">
                                <span class="card-value" id="kpi-prod-orders">95</span>
                                <!-- Trend Badge Inline -->
                                <div class="card-trend text-green">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="18 15 12 9 6 15" />
                                    </svg>
                                    <span>8.2%</span>
                                </div>
                            </div>
                            <!-- Middle: Title chính -->
                            <span class="card-label">ĐƠN ĐANG SẢN XUẤT</span>
                        </div>
                    </div>
                </div>

                <!-- Card 3: Đơn đã giao -->
                <div class="kpi-card border-green">
                    <div class="card-meta">
                        <div class="card-icon bg-light-green text-green">
                            <i class="fa-solid fa-truck"></i>
                        </div>
                        <div class="card-title-group">
                            <!-- Top: Dữ liệu / kết quả -->
                            <div class="kpi-value-row">
                                <span class="card-value" id="kpi-delivered-orders">85</span>
                                <!-- Trend Badge Inline -->
                                <div class="card-trend text-green">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="18 15 12 9 6 15" />
                                    </svg>
                                    <span>15.6%</span>
                                </div>
                            </div>
                            <!-- Middle: Title chính -->
                            <span class="card-label">ĐƠN ĐÃ GIAO</span>
                        </div>
                    </div>
                </div>

                <!-- Card 4: Đơn trễ -->
                <div class="kpi-card border-red">
                    <div class="card-meta">
                        <div class="card-icon bg-light-red text-red">
                            <i class="fa-solid fa-clock"></i>
                        </div>
                        <div class="card-title-group">
                            <!-- Top: Dữ liệu / kết quả -->
                            <div class="kpi-value-row">
                                <span class="card-value text-red" id="kpi-late-orders">12</span>
                                <!-- Trend Badge Inline -->
                                <div class="card-trend text-red">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="6 9 12 15 18 9" />
                                    </svg>
                                    <span>9.4%</span>
                                </div>
                            </div>
                            <!-- Middle: Title chính -->
                            <span class="card-label">ĐƠN TRỄ</span>
                        </div>
                    </div>
                </div>

                <!-- Card 5: Doanh thu tháng -->
                <div class="kpi-card border-teal">
                    <div class="card-meta">
                        <div class="card-icon bg-light-teal text-teal">
                            <i class="fa-solid fa-dollar-sign"></i>
                        </div>
                        <div class="card-title-group">
                            <!-- Top: Dữ liệu / kết quả -->
                            <div class="kpi-value-row">
                                <span class="card-value" id="kpi-revenue">18.5</span>
                                <!-- Trend Badge Inline -->
                                <div class="card-trend text-green" id="kpi-revenue-trend-container">
                                    <svg id="kpi-revenue-trend-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="18 15 12 9 6 15" />
                                    </svg>
                                    <span id="kpi-revenue-trend-val">12.6%</span>
                                </div>
                            </div>
                            <!-- Middle: Title chính -->
                            <span class="card-label">DOANH THU (<span id="kpi-revenue-unit">USD</span>)</span>
                        </div>
                    </div>
                </div>

                <!-- Card 6: OTD -->
                <div class="kpi-card border-cyan">
                    <div class="card-meta">
                        <div class="card-icon bg-light-cyan text-cyan">
                            <i class="fa-solid fa-bullseye"></i>
                        </div>
                        <div class="card-title-group">
                            <!-- Top: Dữ liệu / kết quả -->
                            <div class="kpi-value-row">
                                <span class="card-value" id="kpi-otd">92%</span>
                                <!-- Trend Badge Inline -->
                                <div class="card-trend text-green">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="18 15 12 9 6 15" />
                                    </svg>
                                    <span>5.6%</span>
                                </div>
                            </div>
                            <!-- Middle: Title chính -->
                            <span class="card-label">GIAO ĐÚNG HẠN</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ROW 2: GANTT VIEW -->
            <section>
                <!-- 2.1 DELIVERY PROGRESS (GANTT VIEW) -->
                <div class="grid-card">
                    <div class="card-header">
                        <div class="marquee-wrapper" style="flex: 1; max-width: calc(100% - 15rem);">
                            <h2 class="marquee-content" style="margin: 0;">TIẾN ĐỘ GIAO HÀNG</h2>
                        </div>
                        <div class="header-actions">
                            <div class="tab-filters" id="gantt-view-toggle">
                                <button class="tab-btn">Ngày</button>
                                <button class="tab-btn active">Tuần</button>
                                <button class="tab-btn">Tháng</button>
                            </div>
                            <button class="btn-zoom" title="Phóng to" aria-label="Phóng to">
                                <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" y1="3" x2="14" y2="10"></line><line x1="3" y1="21" x2="10" y2="14"></line></svg>
                            </button>
                        </div>
                    </div>
                    <div class="card-body gantt-chart-container-wrapper">
                        <!-- Left Columns Table Overlay -->
                        <div class="gantt-overlay-table">
                            <div class="gantt-overlay-header">
                                <div class="col-po"><div class="marquee-wrapper"><span class="marquee-content">PO NO.</span></div></div>
                                <div class="col-cust"><div class="marquee-wrapper"><span class="marquee-content">KHÁCH HÀNG</span></div></div>
                                <div class="col-qty"><div class="marquee-wrapper"><span class="marquee-content">QTY (PCS)</span></div></div>
                                <div class="col-ordercode"><div class="marquee-wrapper"><span class="marquee-content">MÃ ĐƠN HÀNG</span></div></div>
                                <div class="col-etd"><div class="marquee-wrapper"><span class="marquee-content">ETD</span></div></div>
                            </div>
                            <div class="gantt-overlay-body" id="gantt-overlay-rows">
                                <!-- Generated Dynamically -->
                            </div>
                        </div>
                        <!-- ECharts Gantt Canvas -->
                        <div id="gantt-chart-canvas" style="width: 100%; height: 28rem;"></div>
                    </div>
                    <div class="gantt-legend">
                        <div class="legend-item"><span class="dot bg-blue"></span> Hoàn thành (>=95%)</div>
                        <div class="legend-item"><span class="dot bg-green"></span> Đạt (80-94%)</div>
                        <div class="legend-item"><span class="dot bg-orange"></span> Trung bình (50-79%)</div>
                        <div class="legend-item"><span class="dot bg-red"></span> Chậm (<50%)</div>
                                <div class="legend-item"><span class="line-today"></span> Hôm nay</div>
                                <div class="legend-item"><span class="diamond-etd"></span> ETD (Ngày giao hàng)</div>
                        </div>
                    </div>
            </section>

            <!-- ROW 2.5: REVENUES -->
            <section class="dashboard-grid-2">
                    <!-- 2.2 MONTHLY REVENUE CHART -->
                    <div class="grid-card" style="flex: 2;">
