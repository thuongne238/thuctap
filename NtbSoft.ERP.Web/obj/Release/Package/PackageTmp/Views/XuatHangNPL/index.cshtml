        var userName = '@ViewBag.userName';
        var userNameSave = '@ViewBag.userName'
        console.log(userNameSave)
        $(".callout label").each(function () {
            $(this).attr("title", $(this).text().trim());
        });

        function formatNumberToString(number, local = 'en-US') {
            if (!number) return '0';

            return parseFloat(parseFloat(number).toFixed(4)).toLocaleString(local);

        }
        function formatNumberToFixed(number, fixed = 4) {
            if (!number) return 0;

            return parseFloat(parseFloat(number).toFixed(fixed))

        }

    </script>
    <script type="module">

        import QrScanner from '/Scripts/qrcodenew.js';
        let qrScanner;
        let isProcessing = false;
        let lastScannedTime = 0;
        let lastScannedCode = '';
        let scannerSource = 'default';

        // Khởi tạo scanner khi mở modal
        $('#scannerModal').on('shown.bs.modal', function () {
            initScanner();
        });

        // Dừng scanner khi đóng modal
        $('#scannerModal').on('hidden.bs.modal', function () {
            if (qrScanner) {
                qrScanner.stop();
                $('#startScanBtn').show();
                $('#stopScanBtn').hide();
                $('#scanResultContainer').hide();
                lastScannedCode = '';
            }
        });

        function initScanner() {
            const videoElem = document.getElementById('video-preview');
            QrScanner.WORKER_PATH = '/Scripts/qr-scanner-worker.min.js';

            qrScanner = new QrScanner(
                videoElem,
                result => onScanSuccess(result),
                {
                    returnDetailedScanResult: true,
                    highlightScanRegion: false,
                    highlightCodeOutline: false,
                    maxScansPerSecond: 10,
                    preferredCamera: 'environment'
                }
            );
        }

        function onScanSuccess(result) {
            const currentTime = Date.now();
            const timeDiff = currentTime - lastScannedTime;
            const barcode = result.data;
            // CHỈ chặn nếu đang xử lý HOẶC quét cùng mã trong vòng 500ms
            if (isProcessing || (barcode == lastScannedCode) || timeDiff < 1000) {
                return;
            }

            isProcessing = true;
            lastScannedTime = currentTime;
            lastScannedCode = barcode;

            //$('#scanResultContainer').show();
            //showScanStatus('✅ Quét thành công! Đang kiểm tra...', 'success');

            if (navigator.vibrate) {
                navigator.vibrate(200);
            }

            const fn = scannerSource === 'xavai'
                ? GetVTBarCodeXoVai(barcode, 1)
                : GetVTBarCode(barcode, 1);

            fn.then(() => { isProcessing = false; })
                .catch(() => { isProcessing = false; });
        }


        function showScanStatus(message, type) {
            const statusElement = $('#scanStatus');
            statusElement.text(message);
            statusElement.removeClass().addClass(`status text-${type === 'success' ? 'success' : type === 'error' ? 'danger' : 'info'}`);
        }



        // Bắt đầu quét
        $('#startScanBtn').on('click', async function () {
            try {
                $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Đang khởi động...');
                await qrScanner.start();
                $(this).hide();
                $('#stopScanBtn').show();
                $(this).prop('disabled', false).html('<i class="bi bi-play-circle"></i> Bắt đầu quét');
                showScanStatus('🔍 Đang quét... Đưa mã barcode vào khung', 'info');
                lastScannedCode = '';
            } catch (err) {
                $(this).prop('disabled', false).html('<i class="bi bi-play-circle"></i> Bắt đầu quét');
                showScanStatus('❌ Không thể truy cập camera. Vui lòng cho phép quyền!', 'error');
                console.error('Lỗi camera:', err);
            }
        });

        // Dừng quét
        $('#stopScanBtn').on('click', function () {
            qrScanner.stop();
            $(this).hide();
            $('#startScanBtn').show();
            showScanStatus('⏸️ Đã dừng quét', 'error');
            lastScannedCode = '';
        });

        // Mở modal scanner
        $('#openScannerBtn').on('click', function () {
            scannerSource = 'default';
            const scannerModal = new bootstrap.Modal($('#scannerModal')[0]);
            scannerModal.show();
        });

        $('#openScannerBtn2').on('click', function () {
            scannerSource = 'xavai';
            const scannerModal = new bootstrap.Modal($('#scannerModal')[0]);
            scannerModal.show();
        });
    </script>

