                                                        <i style="position: absolute; right: 5px; top: 2px; font-size: 16px; cursor: pointer;z-index:10" class="fa-solid fa-calendar-days"></i>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-6 col-md-6 col-lg-6 col-xl-6 p-0">
                                                <div class="select2_item ">
                                                    <label class="txtselected">Đến ngày</label>
                                                    <div class="input-group datetimepicker" id="datetimepicker2" style="position:relative">
                                                        <input onchange="GetPhieuNhapKho()" style="font-size: 13px; font-weight: 600; height: 28px; border-radius: 5px;" type="text" class="form-control dateInput" id="dateInput2" value="1990-01-01" />
                                                        <i style="position: absolute; right: 5px; top: 2px; font-size: 16px; cursor: pointer;z-index:10" class="fa-solid fa-calendar-days"></i>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>

                                    <div class="col-2 col-md-2 col-lg-2 col-xl-1 ">
                                        <div style="display: flex; justify-content: start; align-items: center; height: 100%; gap: 10px;">
                                            <div class="icon_reload" style="margin-top: 18px;">
                                                <i class="fa-solid fa-arrows-rotate"></i>
                                            </div>
                                        </div>

                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row m-0 p-0">
                        <div class="container-fluid p-0">
                            <div class="row m-0 p-0">
                                <div class="col-12 col-lg-7 p-0 pe-lg-2 mb-3 mb-lg-0">
