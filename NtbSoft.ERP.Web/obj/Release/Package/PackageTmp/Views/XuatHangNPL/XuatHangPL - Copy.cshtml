                                                        <option value="1">Gia công</option>
                                                    </select>
                                                </div>
                                            </div>

                                        </div>

                                    </div>
                                    <div class="col-6 col-md-6 col-lg-3 col-xl-2 p-1 m-0 d-none">
                                        <div style="display: flex;justify-content: start;align-items: center;height: 100%;gap: 10px;width: 100%;">
                                            <div style=" width: 100%;">
                                                <label class="txtselected">Lọc  </label>
                                                <div class="item_ngaychon position-relative">
                                                    <select onchange="GetPhieuNhapKho()" class="selectView" style="height: 30px;border: 1px solid #ccc;border-radius: 5px;width: 100%;text-align: center;outline: none;" fdprocessedid="lrrlrg">
                                                        <option value="0">Tất cả</option>
                                                        <option value="1">Chưa cấp</option>
                                                        <option value="2">Đã cấp</option>
                                                    </select>
                                                </div>
                                            </div>

                                        </div>

                                    </div>
                                    <div class="col-8 col-md-6 col-lg-6 col-xl-3 tblngay d-none">
                                        <div class="row">
                                            <div class="col-6 col-md-6 col-lg-6 col-xl-6 ">
                                                <div class="select2_item ">
                                                    <label class="txtselected">Từ ngày</label>
                                                    <div class="input-group datetimepicker " id="datetimepicker" style="position:relative">
