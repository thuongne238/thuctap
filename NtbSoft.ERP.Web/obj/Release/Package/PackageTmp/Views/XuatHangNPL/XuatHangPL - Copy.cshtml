@{
    Layout = null;
}


<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width; initial-scale=1.0; maximum-scale=1.0; user-scalable=0;" />
    <title>Xuất hàng phụ liệu</title>

    <link href="~/Content/plugins/select2/css/select2.css" rel="stylesheet" />
    <link href="~/css/TheoDoiHangXuat/fontawesome.pro.6.0.0.css" rel="stylesheet" />
    <link href="~/css/TheoDoiHangXuat/roboto.css" rel="stylesheet" />
    <link href="~/css/QRCode/toastr.minM.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/Content/dist/css/adminlte.min.css">
    <link href="~/css/BienBanMoKien/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/BienBanMoKien/flatpickr-min.css" rel="stylesheet" />
    <link href="~/css/NguyenPhuLieu/Sign.css" rel="stylesheet" />
    <link href="~/css/DevExtreme/dx.light.css" rel="stylesheet" />
    <link href="~/css/DevExtreme/dx.common.css" rel="stylesheet" />
    <link href="~/Content/plugins/select2-bootstrap4-theme/select2-bootstrap4.min.css" rel="stylesheet" />
    <link href="~/css/TongHopNPL/tempus-dominus.min.css" rel="stylesheet" />
    <link href="~/css/ViTriKhoNPL/ScanQrCodeMobile.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/XuatHangNPL/xuathangnpl.css?version=1.0" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.0/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>

        .sec-action .item {
            margin-right: 10px;
            border: none;
        }



        .select-pkl {
            flex-direction: column;
            display: flex;
        }

        .labelTitle {
            font-weight: bold;
            color: green;
            font-size: 15px !important;
        }

        #reader {
            width: 500px;
            position: fixed !important;
            padding: 0px;
            border: none;
            left: 50%;
            top: 170px;
            transform: translate(-50%, -0%);
        }

        #reader2 {
            width: 600px;
            position: fixed !important;
            padding: 0px;
            border: none;
            left: 50%;
            top: 144px;
            transform: translate(-50%, -0%);
            background: #fff;
            height: 422px;
            z-index: 99;
        }

        #reader.active {
            z-index: 999;
        }

        .lableValue {
            font-weight: bold;
            font-size: 15px;
        }

        .select2-selection__choice {
            background: linear-gradient(90deg, #42a5f5, #478ed1) !important;
            color: #fff !important;
            border: none !important;
            border-radius: 15px !important;
            /*padding: 3px 10px !important;*/
            font-size: 14px !important;
            /* margin-top: 6px !important;
                    margin-right: 5px !important;*/
        }

        .select2-selection__choice__remove {
            color: #fff !important;
            /*    margin-right: 6px;*/
            font-weight: bold;
            font-size: 16px;
        }

        .select2-container--default .select2-selection--multiple {
            min-height: 40px;
            border-radius: 5px;
            border: 1px solid #42a5f5;
        }

        .tools-board .title {
            background: none
        }

        tr:nth-child(even) {
            background-color: #f7f3f3;
        }

        .dx-header-row .col-header {
            background: #5da566;
            color: #fff;
            text-align: center !important;
            vertical-align: middle !important
        }

        .dx-data-row .col-header {
            text-align: center !important;
            font-size: 13px !important;
            vertical-align: middle !important
        }

        .dx-data-row .checkboxTD {
            display: flex;
            justify-content: center
        }

        .dx-footer-row .col-header .dx-datagrid-text-content {
            text-align: center !important;
            color: red !important
        }

        .dx-datagrid-summary-item {
            text-align: center !important;
            color: red !important
        }

        .dx-datagrid-filter-row {
            background: #fff !important;
        }

        #tbodyA .activeT {
            background: #cff2f3;
        }


        /* 2. Scrollbar custom */
        ::-webkit-scrollbar {
            height: 2px;
            width: 2px;
        }

        /* Track */
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        /* Handle */
        ::-webkit-scrollbar-thumb {
            background: #888;
        }

            /* Handle on hover */
            ::-webkit-scrollbar-thumb:hover {
                background: #555;
            }

        #tblDataBodyLS {
            max-width: 100% !important;
        }

        #group2 .dx-datagrid {
        }

        .chitiet {
            width: 250px
        }
        /*   #gridXuatHang .dx-datagrid-filter-row {
                    background: #fff !important;
                    display:none
                }*/

        .dx-datagrid-rowsview .dx-row td {
            vertical-align: middle !important;
            font-size: 13px !important;
            border: 1px solid #ccc
        }

        .dx-row.dx-freespace-row.dx-column-lines {
            display: none !important
        }

        #modalChiTietLenh .dx-datagrid-total-footer > .dx-datagrid-content .dx-row > td {
            font-size: 12px;
            /* padding-top: 14px; */
            /* padding-bottom: 14px; */
        }


        #tbodyA tr.activeT.nenxanh,
        #tbodyA tr.activeT.nendo {
            background: #ff1a0ac7 !important;
        }


        .nhapnhay-text {
            animation: nhapnhay-text-do 1.5s infinite
        }

        .nenxanh {
            background: #cbe8ff !important;
        }

            .nenxanh .fa-solid.fa-rectangle-list {
                color: #7700d7 !important; /* Màu xanh */
            }


        .nendo {
            background: #fb968fc7 !important; /* Đỏ */
        }

            .nendo .fa-solid.fa-rectangle-list {
                color: #7700d7 !important;
            }



        @@keyframes nhapnhay-text-do {
            0%, 100% {
                color: black;
                transform: scale(1);
            }

            50% {
                transform: scale(1.1);
                background: red;
                font-weight: bold;
            }
        }
    </style>
</head>

<body>
    <div>
        @*<button class="chiakien">Chia kiên</button>*@
        <section>
            <div class="title">
                <div style="display: flex; align-items: center; width: 100%;flex-wrap:wrap ">
                    <div class="d-flex">
                        <i id="home" style="font-size: 21px; cursor: pointer; margin-right: 7px; color: #fff; margin-top: 2px;" class="fa-sharp fa-solid fa-house"></i>
                        <button type="button" style="background: #ffe216; color: #000;"
                                class="save-buttonShareA  btn-tab1 btn btn-primary d-flex align-items-center gap-2 ">
                            <i class="fa-solid fa-floppy-disk-circle-arrow-right"></i>
                            Phiếu yêu cầu
                        </button>
                        <button type="button"
                                class="save-buttonShareA btn-tab2 btn btn-primary d-flex align-items-center gap-2 ">
                            <i class="fa-solid fa-plus"></i>
                            Cấp phát
                        </button>
                        <button onclick="" type="button" style="background: #3b4789; color: #fff; "
                                class="save-buttonShareA btn-tab3 btn btn-primary d-flex align-items-center gap-2 ">
                            <i class="fa-solid fa-eye"></i>
                            Xem phiếu
                        </button>
                    </div>
                    <div class="tabl2A align-items-center tab2 " style="display:none;margin-left: auto;gap:5px">
                        <button onclick="inbarcode()" class="btn  bg-warning d-none" id="printBarCode"
                                style="font-size: 15px; width: 105px; height: 30px; display: flex; justify-content: center; align-items: center; background-color: #c883ff !important; color: #fff !important;">
                            In barcode
                        </button>


                        <button onclick="CallModal()" type="button" style="background: #ffe216; color: #000;"
                                class="save-buttonShareA btnSave btn btn-primary d-flex align-items-center gap-2 ">
                            <i class="fa-solid fa-floppy-disk-circle-arrow-right"></i>
                            Lưu
                        </button>

                    </div>
                    <div class="tabl2A align-items-center tab3 " style="display:none;margin-left: auto;gap:5px">
                        <button onclick="Export()" type="button" style="background: #ffe216; color: #000;"
                                class="save-buttonShareA btnEX btn btn-primary d-flex align-items-center gap-2 ">
                            <i class="fa-solid fa-file-export"></i>
                            Xuất EX
                        </button>


                    </div>
                </div>
            </div>

        </section>
        <section>
            <div class="tab2" style="display:none">
                <div class="container-fluid p-0 m-0">
                    <div class="row row p-0 m-0">

                        <!-- CARD TRÁI: Dữ liệu scan (giống hệt base) -->
                        <div class="col-12 col-md-12 col-lg-12 col-xl-4 row p-0 m-0">
                            <div class="card-body" style="padding: 2px; margin-bottom: 5px;">
                                <div class="callout callout-info" style="margin: 0px; padding-top: 5px; padding-bottom: 5px;">
                                    <div class="row">
                                        <!-- Header -->
                                        <div class="col-12 card-header"
                                             style="padding: 0px 0.4rem 5px; display: flex; border-bottom: 1px solid #ccc; padding-bottom: 6px; margin-bottom: 5px;">
                                            <div style="display:flex;align-items:center" class="align-items-end-mb">
                                                <h3 class="card-title"
                                                    style="font-size: 22px; color: #117a8b; font-weight: bold;">
                                                    Dữ liệu scan
                                                </h3>
                                            </div>
                                            <div style="margin-left:auto;margin-right:10px">
                                                <span style="text-align: center; float: right; display: flex !important; justify-content: center; align-items: center; gap: 10px;">
                                                    <button id="openScannerBtn" class="alt-button-2">
                                                        <span class="icon">
                                                            <i class="fa-solid fa-camera"></i>
                                                        </span>
                                                        <span>Mở máy quét</span>
                                                    </button>
                                                </span>
                                            </div>
                                        </div>

                                        <!-- Đã cấp / Chưa cấp / Tổng cấp -->
                                        <div class="col-3 col-xl-3 p-0 px-1 d-none">
                                            <div class="d-flex" style="flex-direction: column;">
                                                <label class="txtSelected"
                                                       style="display: flex; justify-content: space-between; align-items: center;">
                                                    Đã cấp
                                                </label>
                                                <input class="dacap text-center text-green" readonly
                                                       style="font-weight:bold; width: 100%; height: 30px; border-radius: 5px; outline: none; border: 1px solid #ccc;"
                                                       type="text" />
                                            </div>
                                        </div>
                                        <div class="col-3 col-xl-3 p-0 px-1 d-none">
                                            <div class="d-flex" style="flex-direction: column;">
                                                <label class="txtSelected">Chưa cấp</label>
                                                <input class="chuacap text-center text-green" readonly
                                                       style="font-weight:bold; width: 100%; height: 30px; border-radius: 5px; outline: none; border: 1px solid #ccc;"
                                                       type="text" />
                                            </div>
                                        </div>
                                        <div class="col-3 col-xl-3 p-0 px-1 d-none">
                                            <div class="d-flex" style="flex-direction: column;">
                                                <label class="txtSelected">Tổng cấp</label>
                                                <input class="tongcap text-center text-danger" readonly
                                                       style="font-weight:bold; width: 100%; height: 30px; border-radius: 5px; outline: none; border: 1px solid #ccc;"
                                                       type="text" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- CARD PHẢI: Filter chi tiết (kết hợp base + field PL) -->
                        <div class="col-12 col-md-12 col-lg-12 col-xl-8 row p-0 m-0">
                            <div class="card-body" style="padding: 2px; margin-bottom: 5px;">
                                <div class="callout callout-info" style="margin: 0px; padding-top: 5px; padding-bottom: 5px;">
                                    <div class="row">

                                        <div class="col-4 col-md-3 col-lg-2 col-xl-2 p-0 px-1 ">
                                            <div class="d-flex" style="flex-direction: column;">

                                                <label class="txtSelected">Lệnh</label>
                                                <input class="text-center optionCat" readonly style="width: 100%; height: 30px; border-radius: 5px; outline: none; border: 1px solid #ccc;" type="text" />
                                            </div>
                                        </div>
                                        <div class="col-8 col-md-6 col-lg-4 col-xl-4 p-0 px-1 tabGiaC">
                                            <div class="select-pkl" style="display: flex; flex-direction: column; ">
                                                <label class="txtSelected">Mã lệnh</label>
                                                <div style="position: relative;">
                                                    <select onchange="renderSLMetLoc()" id="MaLenhSX" class="select_2">
                                                    </select>
                                                    <input readonly style="position: absolute; top: 0; width: 100%; height: 30px; border-radius: 5px; outline: none; border: 1px solid #ccc;" type="text" class="text_phieu d-none" />
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-6 col-md-3 col-lg-3 col-xl-2 p-0 px-1">
                                            <div class="d-flex" style="flex-direction: column;">

                                                <label class="txtSelected">Mã hàng</label>
                                                <input class="mahangip text-center" readonly style="width: 100%; height: 30px; border-radius: 5px; outline: none; border: 1px solid #ccc;" type="text" />
                                            </div>
                                        </div>
                                        <div class="col-6 col-md-3 col-lg-3 col-xl-2 p-0 px-1">
                                            <div class="d-flex" style="flex-direction: column;">

                                                <label class="txtSelected">Khách hàng</label>
                                                <input class="khachhangip text-center" readonly style="width: 100%; height: 30px; border-radius: 5px; outline: none; border: 1px solid #ccc;" type="text" />
                                            </div>
                                        </div>
                                        <div class="col-4 col-md-3 col-lg-3 col-xl-2 p-0 px-1 d-none">
                                            <div class="d-flex" style="flex-direction: column;">

                                                <label class="txtSelected">Loại vải</label>
                                                <input class="loaivaiip text-center" readonly style="width: 100%; height: 30px; border-radius: 5px; outline: none; border: 1px solid #ccc;" type="text" />
                                            </div>
                                        </div>
                                        <div class="col-4 col-md-3 col-lg-3 col-xl-2 p-0 px-1 ">
                                            <div class="d-flex" style="flex-direction: column;">

                                                <label class="txtSelected">Tìm kiếm</label>

                                                <input class="item_inputsearch" style="width: 100%; text-align: center; height: 30px; border: 1px solid #ccc !important; border-radius: 4px; cursor: pointer; outline: none; "
                                                       type="text" name="name" value="" autocomplete="off" placeholder="" />
                                            </div>

                                        </div>
                                        <div class="col-4 col-md-3 col-lg-3 col-xl-4 p-0 px-1">
                                            <label class="text-black-small mb-0">
                                                <i class="bi bi-upc-scan"></i> Nhập barcode
                                            </label>

                                            <div class="input-group input-group-sm " style="margin-top: -6px;">
                                                <input type="text"
                                                       class="form-control"
                                                       id="QRScan"
                                                       placeholder="">
                                                <button style="border: 1px solid #ccc;" type="button"
                                                        class="btn btn-light enterbarcode"
                                                        id=""
                                                        data-side="left">
                                                    <i class="bi bi-search"></i>
                                                </button>
                                            </div>
                                        </div>

                                        <div class="col-4 col-md-3 col-lg-3 col-xl-2 p-0 px-1 d-none">
                                            <div class="d-flex" style="flex-direction: column;">
                                                <label class="txtSelected">Roll</label>
                                                <input class="kienquet" style="width: 100%; text-align: center; height: 30px; border: 1px solid #ccc !important; border-radius: 4px; cursor: pointer; outline: none; "
                                                       type="text" name="name" value="" autocomplete="off" placeholder="" />
                                            </div>

                                        </div>

                                        <div class="col-4 col-md-3 col-lg-3 col-xl-2 p-0 px-1 d-none">
                                            <div class="d-flex" style="flex-direction: column;">
                                                <label class="txtSelected">Thực xuất</label>
                                                <input class="thucnhap" style="width: 100%; text-align: center; height: 30px; border: 1px solid #ccc !important; border-radius: 4px; cursor: pointer; outline: none; "
                                                       type="text" name="name" value="" autocomplete="off" placeholder="" />
                                            </div>
                                        </div>

                                        <div class="col-4 col-md-3 col-lg-3 col-xl-2 p-0 px-1 ">
                                            <div class="d-flex" style="flex-direction: column;">

                                                <label class="txtSelected">Phiếu XH</label>
                                                <input class="text-center phieuxh" readonly style="width: 100%; height: 30px; border-radius: 5px; outline: none; border: 1px solid #ccc;" type="text" value="" />
                                            </div>
                                        </div>
                                        @*<div class="col-3 col-md-3 col-lg-3 col-xl-3 p-0 px-1 ">

                                            </div>*@

                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- HÀNG DƯỚI: 2 panel tím giống base -->
                <div class="row p-0 m-0">
                    <!-- Panel trái: Thông tin ItemCode -->
                    <div class="col-12 col-lg-4 col-xl-3 p-0 m-0 pe-lg-1">
                        <div class="collapsible-group">
                            <div class="group-header" data-bs-toggle="collapse" data-bs-target="#group2" aria-expanded="true">
                                <h4><i class="fa-solid fa-notes-medical"></i> Thông tin ItemCode</h4>
                                <span class="toggle-icon">▼</span>
                            </div>
                            <div class="collapse show" id="group2">
                                <section style="padding: 5px; ">
                                    <div class="" style="width: 100%; overflow: auto;">
                                        <div class="col-6 col-lg-6 col-xl-6 p-0 m-0 pe-lg-1 px-1">
                                            <div class="select-pkl" style="display: flex; flex-direction: column; ">
                                                <label class="txtSelected" style="margin-bottom: 1px;">Phiếu cấp</label>
                                                <div style="position: relative;">
                                                    <select onchange="GetXuatHangItemCode()" id="soPhieuDK" class="select_2">
                                                    </select>

                                                </div>
                                            </div>
                                        </div>
                                        <div class=" main-item">
                                            <div style="width:99%;min-height:200px;max-height: calc(100vh - 252px); margin-bottom: 13px; " class="task-item" id="tbodyXHItemCode"></div>
                                        </div>
                                    </div>
                                </section>
                            </div>
                        </div>
                    </div>

                    <!-- Panel phải: Thông tin xuất hàng -->
                    <div class="col-12 col-lg-8 col-xl-9 p-0 m-0 ps-lg-1">
                        <div class="collapsible-group">
                            <div class="group-header" data-bs-toggle="collapse" data-bs-target="#group1" aria-expanded="true">
                                <h4><i class="fa-solid fa-tag"></i> Thông tin xuất hàng</h4>
                                <span class="toggle-icon">▼</span>
                            </div>
                            <div class="collapse show" id="group1">
                                <section style="padding: 5px;" class="page-xuat-hang-dev">

                                    <div class="main-item">
                                        <div style="min-height:400px;max-height: calc(100vh - 260px);" id="gridXuatHang"></div>
                                    </div>
                                </section>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab1">
                <section>
                    <div class="container-fluid p-0" style="box-shadow: rgba(100, 100, 111, 0.2) 0px 7px 29px 0px;">
                        <div class="card-body" style="padding :2px;margin-bottom:5px">
                            <div class="">
                                <div class="row p-0 m-0">
                                    <div class="col-5 col-md-5 col-lg-3 col-xl-2 p-0 m-0 ">
                                        <div style="display: flex;justify-content: start;align-items: center;height: 100%;gap: 10px;width: 100%;">
                                            <div style=" width: 100%;
">
                                                <label class="txtselected">Cấp phát</label>
                                                <div class="item_ngaychon position-relative">
                                                    <select onchange=" GetPhieuNhapKho()" class="select_loc" style="height: 30px;border: 1px solid #ccc;border-radius: 5px;width: 100%;text-align: center;outline: none;" fdprocessedid="lrrlrg">
