
<link href="~/Scripts/ViTriKho/bootstrap5.3.min.css" rel="stylesheet" />

<link href="~/Scripts/ViTriKho/SignCss.css" rel="stylesheet" />


<style>
    #optionModal.show {
        display: flex !important;
        align-items: center;
        justify-content: center;
    }

    #optionModal .modal-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 15px 15px 0 0;
    }

    #optionModal .modal-header {
        padding: 10px 20px;
        background: #4CAF50;
        color: white;
        border-radius: 7px 7px 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    #optionModal .close-modal {
        background: none;
        border: none;
        color: white;
        font-size: 28px;
        cursor: pointer;
        padding: 0;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s;
    }

    .camera-container {
        text-align: center;
    }

    video {
        width: 100%;
        max-width: 640px;
        border-radius: 8px;
        background: #000;
    }

    canvas {
        display: none;
    }

    .modal-header {
        margin-bottom: 0
    }
    /* Camera Image Container */
    .camera-image-container {
        width: 85px;
        height: 50px;
        border: 2px dashed #ccc;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s;
        background: white;
        position: relative;
        overflow: hidden;
        flex-shrink: 0;
    }

        .camera-image-container:hover {
            border-color: #4CAF50;
            background: #f0f8f0;
        }

        .camera-image-container.has-image {
            border-style: solid;
            border-color: #4CAF50;
        }

        .camera-image-container i {
            color: #999;
            font-size: 20px;
        }

        .camera-image-container:hover i {
            color: #4CAF50;
        }

        .camera-image-container img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

    .camera-image-container {
        width: 22px;
        height: 18px;
        border-radius: 0px
    }

    .image-list {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 6px;
        margin-top: 6px;
    }

    .image-item {
        position: relative;
        border: 1px solid #ddd;
        border-radius: 6px;
        overflow: hidden;
        background: #fff;
        margin-bottom: 2px
    }

        .image-item img {
            width: 100%;
            height: 70px;
            object-fit: cover;
            display: block;
            cursor: pointer;
        }

    .image-item-actions {
        display: flex;
        gap: 4px;
        padding: 4px;
    }

        .image-item-actions button {
            flex: 1;
            font-size: 11px;
            padding: 3px 4px;
        }

    .camera-image-container i {
        color: #999;
        font-size: 11px;
        position: absolute;
        top: 1px;
    }

    .image-note {
        width: 100%;
        min-height: 45px;
        border: none;
        border-top: 1px solid #ddd;
        padding: 1px;
        font-size: 9px;
        resize: vertical;
        outline: none;
        text-align: left;
    }

        .image-note:focus {
            border-top-color: #4CAF50;
            background: #f8fff8;
        }

    .preview-nav {
        display: none !important;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-top: 8px;
    }

    .preview-counter {
        min-width: 60px;
        text-align: center;
        font-weight: 600;
    }

    .image-preview {
        max-width: 100%;
        max-height: 330px;
        border-radius: 8px;
        object-fit: contain;
    }

    .preview-note-wrap {
        margin-top: 10px;
        width: 100%;
    }

    .preview-note-label {
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .preview-image-note {
        font-size: 13px;
        resize: vertical;
        text-align: left;
    }

    button {
        padding: 6px !important
    }

    #cameraModal .modal-content {
        max-height: unset !important
    }

    ::-webkit-scrollbar {
        width: 8px !important;
    }

    #previewModal .modal-dialog {
        width: fit-content;
        max-width: min(80vw, 900px);
        margin: 40px auto;
    }

    #previewModal .modal-content {
        width: fit-content;
        max-width: min(80vw, 900px);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
        border: none;
    }

    #previewModal .modal-header {
        padding: 12px 16px;
        background: #1e1e2e;
        color: #fff;
        border-bottom: none;
    }

    #previewModal .modal-body {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        padding: 14px;
        background: #1e1e2e;
    }

    #previewModal .image-preview {
        width: auto;
        height: auto;
        max-width: 100%;
        max-height: 75vh;
        object-fit: contain;
        border-radius: 8px;
        display: block;
        transition: transform 0.2s ease;
        transform-origin: center center;
    }

    #previewModal .preview-nav {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    #previewModal .preview-counter {
        min-width: 60px;
        text-align: center;
        font-weight: 600;
        font-size: 14px;
        color: #ccc;
    }

    #previewModal .preview-note-wrap {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    #previewModal .preview-note-label {
        font-size: 13px;
        font-weight: 600;
        color: #aaa;
        white-space: nowrap;
    }

    #previewModal .preview-image-note {
        flex: 1;
        min-height: 32px;
        font-size: 13px;
        resize: vertical;
        border-radius: 6px;
        border: 1px solid #444;
        background: #2a2a3e;
        color: #fff;
        padding: 4px 8px;
        outline: none;
    }

        #previewModal .preview-image-note:focus {
            border-color: #4CAF50;
        }

    .item_addImage .image_other .input_image {
        width: 100%;
        border: none;
        outline: none;
        font-size: 16px;
    }

    #imgViewport {
        width: min(600px, 100%);
        min-height: clamp(200px, 40vh, 400px);
        max-height: 65vh;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #111;
        border-radius: 8px;
        cursor: grab;
    }

    /* Tablet */
    @@media (max-width: 768px) {
        #imgViewport {
            width: 100%;
            min-height: 35vh;
            max-height: 55vh;
            border-radius: 6px;
        }
    }

    /* Mobile */
    @@media (max-width: 480px) {
        #imgViewport {
            width: 100%;
            min-height: 30vh;
            max-height: 50vh;
            border-radius: 4px;
        }
    }

    /* Mobile nhỏ */
    @@media (max-width: 360px) {
        #imgViewport {
            min-height: 25vh;
            max-height: 45vh;
        }
    }

    /* Landscape mobile */
    @@media (max-width: 768px) and (orientation: landscape) {
        #imgViewport {
            min-height: 50vh;
            max-height: 70vh;
        }
    }

    #imgViewport img {
        will-change: transform;
        transform-origin: center center;
        transition: none; /* bỏ transition khi đang drag */
    }

    .pen-size-btn.active {
        margin-bottom: 0px !important
    }
    /*-------------*/
</style>

