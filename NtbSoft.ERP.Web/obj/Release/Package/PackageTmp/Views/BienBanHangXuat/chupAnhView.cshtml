<script src="~/Scripts/ViTriKho/bootstrap5.3.bundle.min.js"></script>
<script src="~/Scripts/ViTriKho/Sign.js"></script>
<script>
    let currentStream = null;
    let currentContainer = null;
    let currentFacingMode = 'environment'; // 'environment' (camera sau) hoặc 'user' (camera trước)
    const imageDataView = {};
    function validateImageTitle(currentContainer) {

        const $block = $(currentContainer).closest('.image_other');
        if (!$block.length) return true;

        let isEmpty = false;

        $block.find('.input_image').each(function () {
            if (!$(this).val() || $(this).val().trim() === "") {
                isEmpty = true;
                $(this).focus();
                $(this).css("border", "1px solid red");
                return false; // break
            } else {
                $(this).css("border", "");
            }
        });

        if (isEmpty) {
            showToast('warning', 'Vui lòng nhập tiêu đề cho hình');
            return false;
        }

        return true;
    }
    function handleImageClick(container) {
        currentContainer = container;
        if (!validateImageTitle(container)) return;

        showOptionModal();
    }
    function showOptionModal() {
        $("#optionModal").show()
        const modal = document.getElementById('optionModal');
        modal.classList.add('show');
    }

    function closeOptionModal() {
        $("#optionModal").hide()
        const modal = document.getElementById('optionModal');
        modal.classList.remove('show');
    }

    async function openCamera() {
        closeOptionModal();
        moduleAnh = 1
        const video = document.getElementById('video');

        try {
            if (currentStream) {
                currentStream.getTracks().forEach(track => track.stop());
            }

            const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);

            const constraints = isMobile ? {
                video: {
                    facingMode: { exact: currentFacingMode },
                    width: { min: 640, ideal: 1280, max: 1920 },
                    height: { min: 480, ideal: 960, max: 1920 }
                }
            } : {
                video: {
                    facingMode: currentFacingMode,
                    width: { ideal: 1280 },
                    height: { ideal: 720 }
                }
            };

            currentStream = await navigator.mediaDevices.getUserMedia(constraints);
            video.srcObject = currentStream;

            bootstrap.Modal.getOrCreateInstance(document.getElementById('cameraModal')).show();

        } catch (err) {
            // exact facingMode có thể throw nếu không có camera sau
            // fallback không dùng exact
            try {
                currentStream = await navigator.mediaDevices.getUserMedia({ video: true });
                video.srcObject = currentStream;
                bootstrap.Modal.getOrCreateInstance(document.getElementById('cameraModal')).show();
            } catch (err2) {
                alert('Không thể truy cập camera: ' + err2.message);
            }
        }
    }

    async function switchCamera() {
        // Đổi giữa camera trước và sau
        currentFacingMode = currentFacingMode === 'environment' ? 'user' : 'environment';

        // Mở lại camera với chế độ mới
        await openCamera();
    }

    function selectFromGallery() {
        closeOptionModal();
        moduleAnh = 2
        const fileInput = document.getElementById('fileInput');

        fileInput.onchange = function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (event) {
                    const imageUrl = event.target.result;
                    const field = currentContainer.getAttribute('data-field');

                    addImageToField(field, imageUrl);
                };
                reader.readAsDataURL(file);
            }
            // Reset input để có thể chọn lại cùng file
            fileInput.value = '';
        };

        fileInput.click();
    }

    function capturePhoto() {
        const video = document.getElementById('video');
        const canvas = document.getElementById('canvas');
        const context = canvas.getContext('2d');

        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;
        context.drawImage(video, 0, 0);

        const imageUrl = canvas.toDataURL('image/jpeg', 0.8);
        const field = currentContainer.getAttribute('data-field');



        // Hiển thị ảnh trong container
        addImageToField(field, imageUrl);

        // Đóng camera
        closeCamera();
    }

    function updateImageContainer(container, imageUrl) {
        container.innerHTML = `<img src="${imageUrl}" alt="Captured">`;
        container.classList.add('has-image');
    }

    function closeCamera() {
        bootstrap.Modal.getInstance(document.getElementById('cameraModal'))?.hide();
        if (currentStream) {
            currentStream.getTracks().forEach(track => track.stop());
            currentStream = null;
        }
    }

    function showPreview(field) {
        const images = imageDataView[field];
        if (!images || images.length === 0) return;

        currentPreviewField = field;
        currentPreviewIndex = 0;
        updatePreviewImage();

        bootstrap.Modal.getOrCreateInstance(document.getElementById('previewModal')).show();
    }

    function closePreview() {
        $("#previewModal").removeClass('show')
    }

    function retakePhoto() {
        closePreview();
        showOptionModal();
    }
    var fieldDelete


    // Đóng modal khi click bên ngoài
    window.onclick = function (event) {
        const cameraModal = document.getElementById('cameraModal');
        const previewModal = document.getElementById('previewModal');
        const optionModal = document.getElementById('optionModal');

        if (event.target === cameraModal) {
            closeCamera();
        }
        if (event.target === previewModal) {
            closePreview();
        }
        if (event.target === optionModal) {
            closeOptionModal();
        }
    }

    function addImageToField(field, imageUrl) {
        // Chỉ cho phép 1 ảnh mỗi field — ghi đè nếu đã có
        imageDataView[field] = [{
            url: imageUrl,
            note: ""
        }];

        renderImageList(field);
    }

    function renderImageList(field) {
        const images = imageDataView[field] || [];

        const $container = $(`#${field}`);
        if (!$container.length) return;

        $container.empty();

        for (let i = 0; i < images.length; i++) {
            const img = images[i];

            let src = "";

            if (img.url) {
                src = img.url;
            }

            const $img = $('<img>', {
                src: src,
                class: 'img-thumb',
                'data-name': 10 // hoặc img.name
            });
            $img.on('click', function () {
                previewListImage(field, i);
            });

            $container.append($img);
        }
    }

    let currentPreviewField = null;
    let currentPreviewIndex = null;

    function previewListImage(field, index) {
        currentPreviewField = field;
        currentPreviewIndex = index;

        updatePreviewImage();
        document.getElementById('previewModal').classList.add('show');
    }

    function deletePhoto() {
        if (currentPreviewField == null || currentPreviewIndex == null) {
            showToast('warning', 'Vui lòng chọn hình cần xóa.');
            return;
        }

        $("#modalDelete").modal("show");
    }

    async function ConfirmDelete() {
        if (!currentPreviewField || !imageDataView[currentPreviewField]) {
            $("#modalDelete").modal("hide");
            return;
        }

        const imageItem = imageDataView[currentPreviewField][currentPreviewIndex];
        const imageName = imageItem.imageName || "";

        imageDataView[currentPreviewField].splice(currentPreviewIndex, 1);

        renderImageList(currentPreviewField);

        if (imageDataView[currentPreviewField].length === 0) {
            currentPreviewField = null;
            currentPreviewIndex = 0;
            closePreview();
        } else {
            if (currentPreviewIndex >= imageDataView[currentPreviewField].length) {
                currentPreviewIndex = imageDataView[currentPreviewField].length - 1;
            }

            updatePreviewImage();
        }

        if (imageName && !isBase64(imageName)) {
            await DeleteImageList(imageName);
        }


        $("#modalDelete").modal("hide");
    }

    function updateImageNote(field, index, value) {
        if (!imageDataView[field] || !imageDataView[field][index]) return;

        imageDataView[field][index].note = value;
    }
    function previewPrevImage() {
        currentPreviewIndex--;
        updatePreviewImage();
    }

    function previewNextImage() {
        currentPreviewIndex++;
        updatePreviewImage();
    }
    function updatePreviewImage() {
        if (!currentPreviewField || !imageDataView[currentPreviewField]) return;

        const images = imageDataView[currentPreviewField];
        if (!images.length) {
            closePreview();
            return;
        }

        if (currentPreviewIndex < 0) {
            currentPreviewIndex = images.length - 1;
        }

        if (currentPreviewIndex >= images.length) {
            currentPreviewIndex = 0;
        }

        const currentImage = images[currentPreviewIndex];



        $("#previewImage").attr("src", currentImage.url);
        imgResetTransform();
    }


    let imgScale = 1;
    let imgRotation = 0;

    function applyImgTransform() {
        const img = document.getElementById('previewImage');
        if (!img) return;
        img.style.transform =
            `scale(${imgScale}) rotate(${imgRotation}deg)`;
    }

    function imgZoomIn() {
        imgScale = Math.min(imgScale + 0.25, 5);
        applyImgTransform();
    }

    function imgZoomOut() {
        imgScale = Math.max(imgScale - 0.25, 0.25);
        applyImgTransform();
    }

    function imgRotate(deg) {
        imgRotation = (imgRotation + deg) % 360;
        applyImgTransform();
    }

    function imgResetTransform() {
        imgScale = 1;
        imgRotation = 0;
        applyImgTransform();
    }



    // Nút "Xem Ảnh" trong optionModal gọi hàm này
    function openViewImageModal() {
        closeOptionModal();
        // Lấy field từ container đang được chọn
        const field = currentContainer?.getAttribute('data-field');

        if (!field || !imageDataView[field] || imageDataView[field].length === 0) {
            showToast('warning', 'Chưa có ảnh nào để xem.');
            return;
        }

        currentPreviewField = field;
        currentPreviewIndex = 0;
        updatePreviewImage();

        bootstrap.Modal.getOrCreateInstance(document.getElementById('previewModal')).show();
    }

    // Zoom bằng scroll chuột — dùng DOMContentLoaded để chắc element đã có
    document.addEventListener('DOMContentLoaded', function () {
        document.getElementById('imgViewport')
            ?.addEventListener('wheel', function (e) {
                e.preventDefault();
                if (e.deltaY < 0) imgZoomIn();
                else imgZoomOut();
            }, { passive: false });
    });
    // ============ DRAG TO PAN ============
    let isDragging = false;
    let dragStartX = 0, dragStartY = 0;
    let panX = 0, panY = 0;
    let rafId = null; // requestAnimationFrame id

    function applyImgTransform() {
        const img = document.getElementById('previewImage');
        if (!img) return;
        img.style.transform = `translate(${panX}px, ${panY}px) scale(${imgScale}) rotate(${imgRotation}deg)`;
    }

    // Dùng RAF để render mượt
    function applyImgTransformRAF() {
        if (rafId) cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(applyImgTransform);
    }

    function imgResetTransform() {
        imgScale = 1;
        imgRotation = 0;
        panX = 0;
        panY = 0;
        applyImgTransform();
    }

    document.addEventListener('DOMContentLoaded', function () {
        const viewport = document.getElementById('imgViewport');
        if (!viewport) return;

        // ---- Scroll để zoom ----
        viewport.addEventListener('wheel', function (e) {
            e.preventDefault();
            if (e.deltaY < 0) imgZoomIn();
            else imgZoomOut();
        }, { passive: false });

        // ---- Mouse drag ----
        viewport.addEventListener('mousedown', function (e) {
            if (e.button !== 0) return; // chỉ chuột trái
            isDragging = true;
            dragStartX = e.clientX - panX;
            dragStartY = e.clientY - panY;
            viewport.style.cursor = 'grabbing';
            e.preventDefault();
        });

        document.addEventListener('mousemove', function (e) {
            if (!isDragging) return;
            panX = e.clientX - dragStartX;
            panY = e.clientY - dragStartY;
            applyImgTransformRAF(); // dùng RAF thay vì gọi thẳng
        });

        document.addEventListener('mouseup', function () {
            if (!isDragging) return;
            isDragging = false;
            viewport.style.cursor = 'grab';
        });

        // ---- Touch drag (mobile) ----
        let lastTouchDist = null;
        let lastTouchX = 0, lastTouchY = 0;

        viewport.addEventListener('touchstart', function (e) {
            if (e.touches.length === 1) {
                isDragging = true;
                lastTouchX = e.touches[0].clientX;
                lastTouchY = e.touches[0].clientY;
                dragStartX = e.touches[0].clientX - panX;
                dragStartY = e.touches[0].clientY - panY;
            } else if (e.touches.length === 2) {
                isDragging = false;
                lastTouchDist = getTouchDist(e.touches);
            }
            e.preventDefault();
        }, { passive: false });

        viewport.addEventListener('touchmove', function (e) {
            if (e.touches.length === 1 && isDragging) {
                panX = e.touches[0].clientX - dragStartX;
                panY = e.touches[0].clientY - dragStartY;
                applyImgTransformRAF();
            } else if (e.touches.length === 2) {
                const dist = getTouchDist(e.touches);
                if (lastTouchDist) {
                    const delta = dist - lastTouchDist;
                    imgScale = Math.min(Math.max(imgScale + delta * 0.01, 0.25), 5);
                    applyImgTransformRAF();
                }
                lastTouchDist = dist;
            }
            e.preventDefault();
        }, { passive: false });

        viewport.addEventListener('touchend', function () {
            isDragging = false;
            lastTouchDist = null;
        });
    });

    function getTouchDist(touches) {
        const dx = touches[0].clientX - touches[1].clientX;
        const dy = touches[0].clientY - touches[1].clientY;
        return Math.sqrt(dx * dx + dy * dy);
    }
</script>
