@{
    Layout = null;
}
@{
    ViewBag.Title = "Biên bản hàng xuất ";
}

<!DOCTYPE html>
<html>
<head>
    <title>@ViewBag.Title</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width; initial-scale=1.0; maximum-scale=1.0; user-scalable=0;" />
    <link href="~/css/TheoDoiHangXuat/fontawesome.pro.6.0.0.css" rel="stylesheet" />
    <link href="~/css/TheoDoiHangXuat/roboto.css" rel="stylesheet" />
    <link href="~/Content/plugins/select2/css/select2.css" rel="stylesheet" />
    <link href="~/css/BienBanHangXuat/BienBanHangXuatV2.css?Ver=1.0" rel="stylesheet" />
    <link href="~/Scripts/ViTriKho/bootstrap5.3.min.css" rel="stylesheet" />
    <link href="~/css/TongHopNPL/tempus-dominus.min.css" rel="stylesheet" />

    <style>
        @@media screen and (min-width: 768px) {
            .modal-dialog {
                right: auto;
                left: 0 !important;
                width: 80%;
                padding-top: 30px;
                padding-bottom: 24px;
            }
        }

        .inspection-form {
            width: calc(100% - 20px) !important;
            margin: 8px 10px !important;
            padding: 4px 5px;
            background: #f8fafc;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            box-shadow: 0 2px 10px rgba(15, 23, 42, .06);
        }

            .inspection-form .row {
                width: 100%;
                margin: 0;
            }

        .item .list_item {
            width: unset !important
        }

        .inspection-form .list_item {
            position: relative;
            margin: 0 !important;
            padding: 0 6px 12px !important;
        }

            .inspection-form .list_item p {
                width: 100%;
                margin-bottom: 5px;
                color: #344054;
                font-size: 14px;
                font-style: normal;
                font-weight: 600;
                line-height: 1.25;
                text-align: left;
                white-space: normal;
            }

                .inspection-form .list_item p[style*="color: #4444c7"] {
                    color: #0d6efd !important;
                }

                .inspection-form .list_item p em {
                    position: static !important;
                    display: inline-block;
                    margin: 0 0 0 3px !important;
                    color: #dc3545 !important;
                    font-size: 16px !important;
                    line-height: 1;
                }

        .inspection-form .item_input {
            position: relative;
            display: flex;
            width: 100%;
            min-height: 36px;
            align-items: center;
            overflow: hidden;
            background: #fff;
            border: 1px solid #ced4da !important;
            border-radius: 6px;
            transition: border-color .15s ease-in-out, box-shadow .15s ease-in-out;
        }

            .inspection-form .item_input:focus-within {
                border-color: #86b7fe !important;
                box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .15);
            }

            .inspection-form .item_input input,
            .inspection-form .item_input select,
            .inspection-form .item_input .select2-container {
                width: 100% !important;
                min-width: 0 !important;
            }

            .inspection-form .item_input input,
            .inspection-form .item_input select {
                height: 34px !important;
                padding: 5px 34px 5px 10px;
                color: #212529;
                background: transparent;
                border: 0 !important;
                outline: 0 !important;
                font-size: 15px !important;
            }

        .inspection-form .datetime_Xe {
            left: 10px;
            width: calc(100% - 44px);
            padding-top: 0;
            color: #212529;
            font-size: 15px;
            line-height: 34px;
            text-align: left;
            pointer-events: none;
        }

        .inspection-form .icon_datexe {
            right: 10px;
            top: 50%;
            color: #6c757d;
            font-size: 16px;
            transform: translateY(-50%);
        }

        .inspection-form .icon_tableList {
            right: 16px;
            top: 26px;
            color: #0d6efd;
            font-size: 15px;
            z-index: 2;
        }

        @@media (max-width: 767.98px) {
            .inspection-form {
                width: calc(100% - 16px) !important;
                margin: 10px 8px !important;
                padding: 10px;
            }

                .inspection-form .list_item {
                    padding: 0 0 10px !important;
                }

                .inspection-form .item_input {
                    min-height: 38px;
                }

                    .inspection-form .item_input input,
                    .inspection-form .item_input select {
                        height: 36px !important;
                        font-size: 16px !important;
                    }

                .inspection-form .datetime_Xe {
                    font-size: 14px;
                    line-height: 36px;
                }

                .inspection-form .icon_tableList {
                    right: 10px;
                    top: 29px;
                }
        }

        .bb-surface {
            margin: 10px;
            padding: 12px;
            background: #f8fafc;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            box-shadow: 0 2px 10px rgba(15, 23, 42, .06);
        }

        .bb-inline-field {
            display: flex;
            align-items: center;
            gap: 8px;
            min-height: 38px;
        }

            .bb-inline-field p {
                width: auto;
                margin: 0;
                color: #344054;
                font-size: 14px;
                font-style: normal;
                font-weight: 600;
                white-space: nowrap;
            }

            .bb-inline-field input {
                width: 120px !important;
                height: 34px !important;
                padding: 5px 10px;
                color: #212529;
                background: #fff;
                border: 1px solid #ced4da !important;
                border-radius: 6px;
                outline: 0;
                font-size: 15px;
                text-align: center;
            }

                .bb-inline-field input:focus {
                    border-color: #86b7fe !important;
                    box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .15);
                }

        @@media (max-width: 575.98px) {
            .bb-surface {
                margin: 8px;
                padding: 10px;
            }

            .bb-inline-field {
                width: 100%;
                justify-content: space-between;
            }

                .bb-inline-field input {
                    width: 100% !important;
                    max-width: 180px;
                }
        }

        .app-toolbar {
            display: flex;
            width: calc(100% - 4px);
            min-height: 46px;
            margin: 2px;
            padding: 6px 10px;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            background: linear-gradient(90deg, #0f6fb7, #4fb3e8);
            border: 1px solid rgba(255, 255, 255, .35);
            border-radius: 8px;
            box-shadow: 0 2px 10px rgba(15, 23, 42, .12);
            position: unset;
            top: 2px;
            z-index: 10;
        }

        .toolbar-group,
        .toolbar-actions,
        .toolbar-title {
            display: flex;
            align-items: center;
            gap: 8px;
            min-width: 0;
        }

        .toolbar-title {
            justify-content: center;
            flex: 1;
            color: #fff;
            font-family: 'Roboto', sans-serif;
            font-weight: 700;
            white-space: nowrap;
        }

            .toolbar-title label,
            .toolbar-title p {
                width: auto;
                margin: 0;
                color: inherit;
                font-size: 14px;
                font-style: normal;
                text-align: left;
            }

        .toolbar-name {
            max-width: 220px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .toolbar-code {
            padding: 2px 7px;
            color: #0f172a !important;
            background: #fff;
            border-radius: 999px;
            font-size: 13px !important;
        }

        .toolbar-icon-btn,
        .toolbar-btn,
        .toolbar-action {
            display: inline-flex;
            height: 34px;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 0 10px;
            border: 1px solid rgba(255, 255, 255, .4);
            border-radius: 7px;
            outline: 0;
            font-family: 'Roboto', sans-serif;
            font-size: 13px;
            font-weight: 700;
            line-height: 1;
            white-space: nowrap;
            transition: transform .12s ease, box-shadow .12s ease, filter .12s ease;
        }

        .toolbar-icon-btn {
            width: 36px;
            padding: 0;
            color: #0f172a;
            background: #ffffff;
        }

        .toolbar-btn-primary {
            color: #083344;
            background: #a7f3d0;
        }

        .toolbar-btn-secondary {
            color: #172554;
            background: #bfdbfe;
        }

        .toolbar-save {
            min-width: 78px;
            color: #064e3b;
            background: #bbf7d0;
        }

        .toolbar-ktdt {
            min-width: 78px;
            color: #fd7e14;
            background: #ffefe3;
        }

        .toolbar-delete {
            color: #fff;
            background: #dc3545;
        }

        .toolbar-export {
            color: #064e3b;
            background: #d9f99d;
        }

        .toolbar-icon-btn:hover,
        .toolbar-btn:hover,
        .toolbar-action:hover {
            filter: brightness(.98);
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(15, 23, 42, .18);
        }

        .toolbar-icon-btn i,
        .toolbar-btn i,
        .toolbar-action i,
        .toolbar-title i {
            font-size: 15px;
        }

        .task-item .item-table .table tbody tr input {
            margin-top: 3px;
        }

        @@media (max-width: 768px) {
            .app-toolbar {
                flex-wrap: wrap;
                align-items: stretch;
            }

            .toolbar-group,
            .toolbar-actions {
                flex: 1 1 auto;
                flex-wrap: wrap;
            }

            .toolbar-title {
                order: 3;
                flex: 1 1 100%;
                justify-content: flex-start;
                padding-top: 2px;
            }

            .toolbar-btn,
            .toolbar-action {
                flex: 1 1 auto;
            }

            .task-item .item-table .table thead tr td {
                font-size: 11px;
            }
        }

        .seal-datetime-row {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            margin: 10px;
            padding: 14px;
            background: #f8fafc;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            justify-content: space-around;
        }

            .seal-datetime-row .field-group {
                flex: 1 1 200px;
                max-width: 280px;
                min-width: 0;
                display: flex;
                flex-direction: column;
                gap: 5px;
            }

                .seal-datetime-row .field-group p {
                    margin: 0;
                    font-size: 13px;
                    font-weight: 600;
                    color: #dc3545; /* đỏ theo thiết kế gốc */
                }

                    .seal-datetime-row .field-group p em {
                        display: inline-block;
                        margin-left: 3px;
                        font-size: 16px;
                        color: #dc3545;
                        line-height: 1;
                    }

        .field-input {
            position: relative;
            display: flex;
            align-items: center;
            min-height: 36px;
            background: #fff;
            border: 1px solid #ced4da;
            border-radius: 6px;
            overflow: hidden;
            transition: border-color .15s, box-shadow .15s;
        }

            .field-input:focus-within {
                border-color: #86b7fe;
                box-shadow: 0 0 0 .2rem rgba(13,110,253,.15);
            }

            .field-input input.datetime-hidden {
                position: absolute;
                inset: 0;
                opacity: 0;
                z-index: 2;
                cursor: pointer;
            }

            .field-input .datetime-label {
                flex: 1;
                padding: 0 10px;
                font-size: 14px;
                color: #212529;
                pointer-events: none;
                white-space: nowrap;
            }

            .field-input .icon-cal {
                padding: 0 10px;
                color: #6c757d;
                font-size: 15px;
                pointer-events: none;
            }

        .task-item .item-table .table thead tr td {
            font-size: 12px;
        }

        .lookup-input2 > div > div {
            height: 25px;
            border: 1px solid #ccc;
            padding: 0 8px;
            padding-top: 0px;
            font-size: 13px;
        }
        /* ── Camera buttons ─────────────────────────────── */
        .camera-bar {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 8px 10px;
        }

            .camera-bar button,
            .extra-cam-bar button {
                height: 34px;
                padding: 0 16px;
                border: none;
                border-radius: 6px;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
                transition: background .15s, opacity .15s;
            }

        .camera_car {
            background: #0ea5e9;
            color: #fff;
        }

            .camera_car:hover {
                background: #0284c7;
            }

        .camera_car_back {
            background: #f59e0b;
            color: #fff;
            display: none;
        }

            .camera_car_back:hover {
                background: #d97706;
            }

        /* ── Image section ───────────────────────────────── */
        .image_Cont {
            display: none;
            margin: 0 10px 10px;
            padding: 12px;
            background: #f8fafc;
            border: 1px solid #dee2e6;
            border-radius: 8px;
        }

        .list_image {
            margin-bottom: 10px;
        }

            .list_image:last-child {
                margin-bottom: 0;
            }

        .item_image {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

            .item_image [class*="col-"] {
                flex: 1 1 calc(50% - 10px);
                min-width: 0;
                display: flex;
                flex-direction: column;
                gap: 6px;
            }


        @@media (max-width: 575px) {
            .item_image [class*="col-"] {
                flex: 1 1 100%;
            }
        }

        .item_image p {
            margin: 0;
            font-size: 13px;
            font-weight: 600;
            color: #374151;
        }

        .item_image .image {
            border: 1px dashed #cbd5e1;
            border-radius: 6px;
            min-height: 120px;
            background: #fff;
            transition: border-color .15s;
            cursor: pointer;
        }

            .item_image .image:hover {
                border-color: #94a3b8;
                background: #f1f5f9;
            }

        /* ── Extra cam buttons ───────────────────────────── */
        .extra-cam-bar {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 8px 10px;
        }

        .camera_imageOther {
            background: #0ea5e9;
            color: #fff;
        }

            .camera_imageOther:hover {
                background: #0284c7;
            }

        .camera_imageOther_back {
            background: #a96060;
            color: #fff;
        }

            .camera_imageOther_back:hover {
                background: #8f4f4f;
            }

        .camera_imageOther_View {
            background: #a96060;
            color: #fff;
            display: none;
        }

            .camera_imageOther_View:hover {
                background: #8f4f4f;
            }

        /* ── Add image area ──────────────────────────────── */
        .item_addImage {
            margin: 0 10px 10px;
        }

        .btn-add-row {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            display: inline-flex;
            align-items: center;
            gap: 5px;
            height: 28px;
            padding: 0 10px;
            font-size: 12px;
            font-weight: 600;
            color: #fff;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            border: none;
            border-radius: 6px;
            cursor: pointer;
            box-shadow: 0 2px 6px rgba(99, 102, 241, 0.35);
            transition: background .15s, box-shadow .15s, transform .1s;
            white-space: nowrap;
        }

            .btn-add-row:hover {
                background: linear-gradient(135deg, #4f46e5, #7c3aed);
                box-shadow: 0 4px 10px rgba(99, 102, 241, 0.45);
                transform: translateY(-52%);
            }

            .btn-add-row i {
                font-size: 11px;
            }

        .inspection-form .item .list_item p {
            min-height: 16px !important;
            margin-bottom: 0px !important;
            display: flex;
            justify-content: left;
            align-items: center;
        }
    </style>
</head>

<body>
    <section class="nav_title app-toolbar">
        <div class="list_phieu toolbar-group">
            <button id="home" type="button" class="toolbar-icon-btn" title="Trang chủ">
                <i class="fa-sharp fa-solid fa-house"></i>
            </button>

            <button id="creatPhieu" type="button" class="toolbar-btn toolbar-btn-primary">
                <i class="fa-solid fa-circle-plus"></i>
                <span>Tạo phiếu</span>
            </button>

            <button id="viewPhieu" type="button" class="toolbar-btn toolbar-btn-secondary">
                <i class="fa-solid fa-pen-to-square"></i>
                <span>Sửa phiếu</span>
            </button>
        </div>

        <div class="maPhieu toolbar-title">
            <i class="fa-solid fa-clipboard-list"></i>
            <label>Biên bản phiếu</label>
            <p id="soPhieu" class="toolbar-code" style="display: none;">1</p>
            <p id="namePhieu" class="toolbar-name"></p>
        </div>

        <div class="toolbar-actions">
            <button class="btn_search toolbar-action toolbar-ktdt d-none" id="btnKyTenDT" type="button">
                <i class="fa-solid fa-file-pen"></i> Ký tên điện tử
            </button>
            <button class="btn_search toolbar-action toolbar-save" id="Update" type="button">
                <i class="fa-sharp fa-solid fa-floppy-disk"></i>
                <span>Lưu</span>
            </button>

            <button class="btn_search toolbar-action toolbar-delete" id="delete" type="button" style="display:none">
                <i class="fa-solid fa-trash-can"></i>
                <span>Xóa phiếu</span>
            </button>

            <button class="btn_search toolbar-action toolbar-export" id="xuatEX" type="button" style="display:none">
                <i class="fa-solid fa-file-excel"></i>
                <span>Xuất EX</span>
            </button>
        </div>
    </section>
    <section class="search" style="background: rgb(112, 186, 237); margin: 2px; padding: 0px 10px; width: 99.8%; border-radius: 5px; display: none">
        <div style="margin: 5px; display: none; ">
            <div class="" style="margin-right:10px">
                <label style="display: block;" for="from">Từ ngày:</label>
                <input style="width: 130px; outline: none; border: 1px solid; height: 26px;text-align: center;font-size: 15px;" type="text" id="from" name="from">
            </div>
            <div class="">
                <label style="display: block;" for="to">Đến ngày:</label>
                <input style="width: 130px;outline: none;border: 1px solid;height: 26px;text-align: center;font-size: 15px;" type="text" id="to" name="to">
            </div>
        </div>
        <div style="margin: 5px; display: flex; justify-content: space-between; width: 100%; ">
            <div class="lookup-container">
                <label style="margin-right: 5px; font-size: 15px; font-family: 'Roboto';">Mã PKL</label>
                <input style="text-align: center;" type="text" class="lookup-input" placeholder="Search...">
                <div class="ultitle" style="display:flex;justify-content:space-between">
                    <p class="ultile_p1">Mã Phiếu</p>
                    <p class="ultile_p1">Số xe</p>
                    <p class="ultile_p1">Số cont</p>
                    <p class="ultile_p1">Số rờ móc</p>
                    <p class="ultile_p1">Số Booking</p>
                </div>
                <ul class="lookup-results">
                </ul>
            </div>
        </div>
    </section>
    <section>
        <div class="title">BIÊN BẢN KIỂM TRA</div>
        <p> CONTAINER/TRAILER/TRUCK INSPECTION RECORD </p>
    </section>
    <section>
        <div class="row" style="display:flex;margin: 10px;width: 100%;">
            <div style="display: flex; width: 70%; margin-left: 56px; justify-content: center; align-items: center;">
                <div style="display:flex;">
                    <input class="vcCont" type="checkbox" name="name" value="" style="width: 33px; margin-left: 36px; outline: none; border: 1px solid;">
                    <p class="mb-0"> Container</p>
                </div>
                <div style="display:flex">
                    <input class="vcroMoc" type="checkbox" name="name" value="" style=" width: 35px; margin-left: 36px; outline: none; border: 1px solid;">
                    <p class="mb-0" style="white-space: nowrap;">Đầu kéo </p>
                </div>
                <div style="display:flex">
                    <input class="vcXetai" type="checkbox" name="name" value="" style=" width: 35px; margin-left: 36px; outline: none; border: 1px solid;">
                    <p class="mb-0" style="white-space: nowrap;">Xe tải </p>
                </div>
            </div>
        </div>
    </section>
    <section class="mapkl_cont">
        <div style="display: flex; padding: 0px 12px;">
            <div style="position: relative;">
                <label style="margin-right: 5px; font-size: 15px; font-family: 'Roboto'; white-space: nowrap;">Mã PKL</label>

            </div>
            <div class="lookup-input2">
                <div class="item_input2">

                </div>

            </div>
        </div>

        <div class=" list_item ma_PKL " style="display: flex; justify-content: left; align-items: center;margin-bottom:10px">

            <div class="lookup-container1">

                <div style="position: relative; display: flex; flex-direction: column;">

                    <input style="text-align: center;display:none" type="text" class="lookup-input1" placeholder="Search...">
                    <div class="hideLi" style="display:none">
                        <button class="">Ẩn</button>
                    </div>
                    <ul class="lookup-results1">
                    </ul>


                </div>
            </div>
        </div>
        @*</div>*@
    </section>
    <section class="bb-surface">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="bb-inline-field">
                    <p>Loại</p>
                    <input class="loaiFeest" type="number" value="" />
                    <p>Feets</p>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="bb-inline-field">
                    <p>Loại</p>
                    <input class="loaiTan" type="number" value="" />
                    <p>Tấn</p>
                </div>
            </div>
        </div>
    </section>
    <section class="inspection-form" style="margin: 10px 10px;width:98%">
        <div>
            <div class="item">
                <div class="row gap-2">
                    <div class="list_item col-6 col-md-6 col-xl-3" style="position: relative;">
                        <p>Số xe <em style="color: red; position: absolute; font-size: 25px; margin-top: -5px; margin-left: 5px;">*</em></p>
                        <i class="fa-regular fa-table icon_tableList listXe"></i>
                        <div class="item_input">
                            <input style="text-transform: uppercase;" class="banSo" type="text" value="" />
                        </div>
                    </div>

                    <div class="list_item inputcontainer col-6 col-md-6 col-xl-3">
                        <p>Số container <em style="color: red; position: absolute; font-size: 25px; margin-top: -5px; margin-left: 5px;">*</em></p>
                        <div class="item_input">
                            <input class="container" type="text" value="" />
                        </div>
