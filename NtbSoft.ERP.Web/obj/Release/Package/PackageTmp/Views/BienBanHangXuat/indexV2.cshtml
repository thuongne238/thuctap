                        down: 'fa-solid fa-arrow-down',
                        previous: 'fa-solid fa-chevron-left',
                        next: 'fa-solid fa-chevron-right',
                        today: 'fa-solid fa-calendar-check',
                        clear: 'fa-solid fa-trash',
                        close: 'fa-solid fa-xmark'
                    },
                    buttons: { today: true, clear: true, close: true }
                },
                localization: { format: 'dd/MM/yyyy HH:mm' },
                defaultDate: new Date()
            };

            // Khởi tạo tất cả picker
            const dpXeDen = new tempusDominus.TempusDominus(document.getElementById('dp_xeDen'), configDateTime);
            const dpCheckXe = new tempusDominus.TempusDominus(document.getElementById('dp_checkXe'), configDateOnly);
            const dpBvCheckBD = new tempusDominus.TempusDominus(document.getElementById('dp_bvCheckBD'), configDateTime);
            const dpBvCheckKT = new tempusDominus.TempusDominus(document.getElementById('dp_bvCheckKT'), configDateTime);
            const dpNvCheckBD = new tempusDominus.TempusDominus(document.getElementById('dp_nvCheckBD'), configDateTime);
            const dpNvCheckKT = new tempusDominus.TempusDominus(document.getElementById('dp_nvCheckKT'), configDateTime);
            const dpDongHang = new tempusDominus.TempusDominus(document.getElementById('dp_dongHang'), configDateTime);
            const dpFinishDong = new tempusDominus.TempusDominus(document.getElementById('dp_finishDongHang'), configDateTime);
            const dpXeDi = new tempusDominus.TempusDominus(document.getElementById('dp_xeDi'), configDateTime);

            // Trigger để set giá trị mặc định rồi ẩn picker
            $('#dp_xeDen input').trigger('click'); dpXeDen.hide();
            $('#dp_checkXe input').trigger('click'); dpCheckXe.hide();
            $('#dp_bvCheckBD input').trigger('click'); dpBvCheckBD.hide();
            $('#dp_bvCheckKT input').trigger('click'); dpBvCheckKT.hide();
            $('#dp_nvCheckBD input').trigger('click'); dpNvCheckBD.hide();
            $('#dp_nvCheckKT input').trigger('click'); dpNvCheckKT.hide();
            $('#dp_dongHang input').trigger('click'); dpDongHang.hide();
            $('#dp_finishDongHang input').trigger('click'); dpFinishDong.hide();
            $('#dp_xeDi input').trigger('click'); dpXeDi.hide();

            // Click icon để mở picker
            $('#dp_xeDen i').on('click', function () { $('#dp_xeDen input').trigger('focus'); });
            $('#dp_checkXe i').on('click', function () { $('#dp_checkXe input').trigger('focus'); });
            $('#dp_bvCheckBD i').on('click', function () { $('#dp_bvCheckBD input').trigger('focus'); });
            $('#dp_bvCheckKT i').on('click', function () { $('#dp_bvCheckKT input').trigger('focus'); });
            $('#dp_nvCheckBD i').on('click', function () { $('#dp_nvCheckBD input').trigger('focus'); });
            $('#dp_nvCheckKT i').on('click', function () { $('#dp_nvCheckKT input').trigger('focus'); });
            $('#dp_dongHang i').on('click', function () { $('#dp_dongHang input').trigger('focus'); });
            $('#dp_finishDongHang i').on('click', function () { $('#dp_finishDongHang input').trigger('focus'); });
            $('#dp_xeDi i').on('click', function () { $('#dp_xeDi input').trigger('focus'); });

            // Tắt nhập tay tất cả input trong các datetime picker
            $('#dp_xeDen input,' +
                '#dp_checkXe input,' +
                '#dp_bvCheckBD input,' +
                '#dp_bvCheckKT input,' +
                '#dp_nvCheckBD input,' +
                '#dp_nvCheckKT input,' +
                '#dp_dongHang input,' +
                '#dp_finishDongHang input,' +
                '#dp_xeDi input')
                .prop('readonly', true);
        });
    </script>
    <script src="~/Scripts/ThongKeDongThung/moment.min.js"></script>
    <script src="~/Scripts/TongHopNPL/popperjs.js"></script>
    <script src="~/Scripts/TongHopNPL/tempus-dominus.min.js"></script>

    <script src="~/Scripts/BienBanXuatHang/bienbanxuathangV3.js?ver=1.1"></script>


