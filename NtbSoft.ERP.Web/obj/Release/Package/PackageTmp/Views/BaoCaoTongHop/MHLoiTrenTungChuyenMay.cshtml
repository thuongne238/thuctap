<script>
    let brainChoose = sessionStorage.getItem("BranchName");
    //if (brainChoose == null)
    //    location.href = "../../../../danh-sach-bao-cao";
    $('#tittleBC').text(`${brainChoose} - Báo cáo tỉ lệ mã hàng lỗi trên chuyền`);
    $('#home').on('click', function () {
        location.href = "../../../danh-sach-bao-cao";
    });

    $('#date').on('click', function () {
        $('#byMonth').css({ 'display': 'none' });
        $('#byYear').css({ 'display': 'none' });

        $('#todate').css({ 'display': 'block' });
    });
    $('#month').on('click', function () {
        $('#byMonth').css({ 'display': 'block' });
        $('#byYear').css({ 'display': 'block' });

        $('#todate').css({ 'display': 'none' });
    });

    $(".btn-warning1").on("click", function () {
        $(".btn-warning1").removeClass("active");
        $(this).addClass("active");
    })
</script>


<script src="~/Scripts/BaoCaoTongHop/BaoCaoTiLoiTrenChuyen/BCMHLoiTrenTungChuyenMay.js"></script>