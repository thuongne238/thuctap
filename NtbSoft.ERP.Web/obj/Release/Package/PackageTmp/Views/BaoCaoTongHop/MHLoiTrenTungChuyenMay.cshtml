
@{
    ViewBag.Title = "MHLoiTrenTungChuyenMay";
    Layout = "~/Views/Shared/_LayoutBCTH.cshtml";
}

<style>
    #fromdate, #todate, #byMonth, #byYear {
        height: 35px;
        align-items: center;
        justify-content: space-between;
        padding: 5px 12px;
        border-radius: 8px;
        cursor: pointer;
        background-color: #fff;
        box-shadow: 0 5px 10px rgba(0, 0, 0, 0.1);
        margin-right: 10px;
        border: 2px solid #FFB822;
        outline: none;
    }

    .action input, #btnAll {
        font-weight: 700;
    }

    .btn-warning1.active {
        background: #ffb822;
    }

    .btn-warning1 {
        border-color: #ffb822;
        border: 2px solid #FFB822;
        border-radius: 8px;
        height: 35px;
    }

    .highcharts-credits {
        display: none;
    }

    .table-bordered thead {
        background: #C8DB7C;
        text-align: center;
        font-weight: 700;
        font-size: 18px;
    }

    .table-bordered tfoot {
        text-align: center;
        font-weight: 700;
        color: red;
        background: #F2F1FF;
    }

    .table-bordered thead tr th {
        vertical-align: middle;
        padding-top: 0.25rem;
        padding-bottom: 0.25rem;
    }

    .table-bordered tbody {
        text-align: center;
    }

        .table-bordered tbody tr:nth-child(even) {
            background: #F3F3F3;
            color: #009879;
        }

    .table-bordered thead {
        position: sticky;
        top: 0;
        left: 0;
        z-index: 3;
    }

        .table-bordered thead th:nth-child(1), .table-bordered tbody tr td:nth-child(1) {
            z-index: 2;
            position: sticky;
            left: 0;
        }

        .table-bordered thead th:nth-child(1) {
            background: #C8DB7C;
        }

    .kt-section .kt-section__content {
        max-height: 550px;
        overflow-y: scroll;
    }

    .table-bordered tbody tr:nth-child(even) td:nth-child(1) {
        background: #F3F3F3;
    }

    .table-bordered tbody tr:nth-child(odd) td:nth-child(1) {
        background: #fff;
    }
    /*css lo*/
    th {
        background-color: #5da566 !important;
        color: white !important;
        font-family: 'roboto' !important;
        border: 1px solid black !important;
        outline: 1px solid black !important;
    }

    thead td {
        background-color: #5da566 !important;
        color: white !important;
        font-family: 'roboto' !important;
        border: 1px solid black !important;
        outline: 1px solid black !important;
    }

    td {
        font-family: 'roboto';
        border: 1px solid black !important;
        outline: 1px solid black !important;
        font-weight: 400 !important;
        padding: 0.45rem !important;
    }
</style>

