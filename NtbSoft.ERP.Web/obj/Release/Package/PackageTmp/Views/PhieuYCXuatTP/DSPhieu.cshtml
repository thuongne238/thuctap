
@{
    ViewBag.Title = "Đề nghị xuất kho TP";
    Layout = null;

}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0" />
    <title>@ViewBag.Title</title>

    <link href="~/Content/plugins/select2/css/select2.css" rel="stylesheet" />
    <link href="~/css/TheoDoiHangXuat/fontawesome.pro.6.0.0.css" rel="stylesheet" />
    <link href="~/css/TheoDoiHangXuat/roboto.css" rel="stylesheet" />
    <link href="~/css/QRCode/toastr.minM.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/Content/dist/css/adminlte.min.css">
    <link href="~/css/BienBanMoKien/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/BienBanMoKien/flatpickr-min.css" rel="stylesheet" />
    <link href="~/css/DevExtreme/dx.light.css" rel="stylesheet" />
    <link href="~/css/DevExtreme/dx.common.css" rel="stylesheet" />
    <link href="~/css/BienBanMoKien/daterangepicker.css" rel="stylesheet" />
    <link href="~/Content/plugins/select2-bootstrap4-theme/select2-bootstrap4.min.css" rel="stylesheet" />
    <link href="~/css/XuatHangNPL/xuathangnpl.css" rel="stylesheet" />
    <link href="~/css/TongHopNPL/tempus-dominus.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.0/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="~/css/ViTriKhoNPL/ScanQrCodeMobile.css" rel="stylesheet" />


    <link href="~/css/PhieuYCXuatTP/phieuycxuattp.css?v=v1" rel="stylesheet" />
    <style>
        #chkXacNhanNhanh {
            width: 20px;
            height: 20px;
            cursor: pointer;
        }

        .mb-0 {
            margin-left: 15px !important;
            margin-bottom: -4px !important
        }

        .form-check {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .form-check-label {
            margin-bottom: 0;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            color: blue;
        }

        .custom-checkbox {
            display: flex;
            align-items: center;
            cursor: pointer;
            gap: 14px;
            font-size: 14px;
            font-weight: 600;
            user-select: none;
        }

            .custom-checkbox input {
                display: none;
            }

        .checkmark {
            width: 18px;
            height: 18px;
            border-radius: 6px;
            border: 2px solid #0d6efd;
            display: inline-block;
            position: relative;
            transition: all 0.2s ease;
        }

            .checkmark::after {
                content: "";
                position: absolute;
                width: 5px;
                height: 10px;
                border: solid white;
                border-width: 0 2px 2px 0;
                top: 1px;
                left: 5px;
                transform: rotate(45deg);
                opacity: 0;
                transition: 0.2s;
            }

        .custom-checkbox input:checked + .checkmark {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }

            .custom-checkbox input:checked + .checkmark::after {
                opacity: 1;
            }

        .label-text i {
            color: #28a745;
        }

        #dxDataGridDanhSachDangKy .dx-datagrid-headers col:first-child,
        #dxDataGridDanhSachDangKy .dx-datagrid-rowsview col:first-child {
            width: 0 !important;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .dx-header-row .col-header {
            background: #5da566;
            color: #fff;
            text-align: center !important;
            vertical-align: middle !important;
            white-space: nowrap;
            font-size: 13px;
        }

        .dx-data-row .col-header {
            text-align: center !important;
            font-size: 13px !important;
            vertical-align: middle !important
        }

        .dx-footer-row .col-header .dx-datagrid-text-content {
            text-align: center !important;
            color: red !important
        }

        .dx-row.dx-freespace-row.dx-column-lines {
            display: none !important
        }

        /* Set chiều cao cho tất cả các row */
        #dxDataGridDangKyVatTu, #dxDataGridDanhSachDangKy .dx-datagrid-rowsview .dx-row {
        }

        /* Set chiều cao cho header */
        #dxDataGridDangKyVatTu, #dxDataGridDanhSachDangKy .dx-datagrid-headers .dx-row {
        }

        /* Set chiều cao cho cell */
        #dxDataGridDangKyVatTu, #dxDataGridDanhSachDangKy .dx-datagrid-rowsview .dx-data-row > td {
            padding: 6px !important;
            vertical-align: middle !important;
        }

        /* Set Màu cho Footer*/
        .dx-datagrid-summary-item.dx-datagrid-text-content {
            color: red !important;
            text-align: center !important;
        }

        #txtSoPhieu:disabled {
            background-color: transparent
        }

        .form-group {
            margin: 0rem 0rem 0rem 0rem !important;
        }

        .labelHeader {
            font-size: 13px !important;
            margin-bottom: 0.1rem !important;
            font-weight: normal !important;
        }

        .input-box {
            font-weight: normal;
            width: 100%;
            padding: 7px 6px;
            border-radius: 5px;
            font-size: 12px;
            cursor: pointer;
            background: white;
            border: var(--bs-border-width) solid var(--bs-border-color);
        }

            .input-box:focus {
                outline: none;
                border-color: #007bff;
            }

        .dropdown-list {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: white;
            border: 2px solid #007bff;
            border-top: none;
            border-radius: 0 0 5px 5px;
            max-height: 300px;
            overflow-y: auto;
            z-index: 1000;
            margin-top: -2px;
        }

            .dropdown-list.show {
                display: block;
            }

        .dropdown-item {
            padding: 10px;
            border-bottom: 1px solid #eee;
            cursor: pointer;
            display: flex;
            align-items: center;
        }

            .dropdown-item:hover {
                background: #f8f9fa;
            }

            .dropdown-item:last-child {
                border-bottom: none;
            }

            .dropdown-item input[type="checkbox"] {
                margin-right: 10px;
                width: 18px;
                height: 18px;
                cursor: pointer;
            }

            .dropdown-item label {
                cursor: pointer;
                flex: 1;
                user-select: none;
                font-weight: unset !important
            }

                .dropdown-item label:not(.form-check-label):not(.custom-file-label) {
                    font-weight: 500 !important;
                }

        .check-all {
            background: #f0f0f0;
            font-weight: bold;
            border-bottom: 2px solid #ddd;
        }

        .search-box {
            padding: 10px;
            border-bottom: 2px solid #ddd;
        }

            .search-box input {
                width: 100%;
                padding: 8px;
                border: 1px solid #ccc;
                border-radius: 3px;
                font-size: 13px;
            }

                .search-box input:focus {
                    outline: none;
                    border-color: #007bff;
                }

        .form-control {
            font-weight: normal;
            font-size: 12px;
        }

        .select2-container .select2-selection--single {
            border: var(--bs-border-width) solid var(--bs-border-color);
            padding-top: 10px;
            height: 36px !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 31px;
            right: 8px;
            top: 4px;
        }

        /* width */
        ::-webkit-scrollbar {
            width: 4px;
        }

        /* Track */
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        /* Handle */
        ::-webkit-scrollbar-thumb {
            background: #888;
        }

            /* Handle on hover */
            ::-webkit-scrollbar-thumb:hover {
                background: #555;
            }

        #txtPhieu:disabled {
            background-color: transparent;
            cursor: default;
        }

        .modal-fullscreen .modal-content {
            /* height: 80%;*/
            border: 0;
            border-radius: 0;
        }

        #modalComfimrtDeleteVT {
            z-index: 1060 !important;
        }

            #modalComfimrtDeleteVT + .modal-backdrop {
                z-index: 1055 !important;
            }

        .modal-backdrop.show:nth-of-type(2) {
            z-index: 1055 !important;
        }

        /* Style cho mobile */
        @@media (max-width: 768px) {
            .btn-mobile {
                padding: 0.4rem 0.5rem;
                font-size: 0.75rem;
                white-space: nowrap;
            }

                .btn-mobile .btn-text {
                    font-size: 0.75rem;
                }

                .btn-mobile i {
                    font-size: 0.875rem;
                }
        }

        /* Style cho tablet */
        @@media (min-width: 768px) and (max-width: 991px) {
            .btn-mobile {
                padding: 0.5rem 0.75rem;
                font-size: 0.875rem;
            }
        }

        /* Style cho desktop */
        @@media (min-width: 992px) {
            .btn-mobile {
                padding: 0.5rem 1rem;
                font-size: 1rem;
            }
        }

        #modalEditDKVT #dxDataGridEditVatTu {
            width: 100% !important;
        }

        #modalEditDKVT .dx-datagrid {
            width: 100% !important;
        }

        .modal .btn,
        .title .btn,
        button.btn {
            font-size: 13px !important;
        }

        .highlight-row {
            background-color: #fff3cd !important;
        }

            .highlight-row td {
                background-color: #fff3cd !important;
                border-color: #ffc107 !important;
            }

        .fa-pen-to-square {
            position: static !important;
            color: green !important;
        }

        #modalTimNhanh .modal-dialog {
            margin: auto;
            max-width: 70%;
        }

        .dx-datagrid-rowsview .dx-checkbox {
            margin: auto;
        }
    </style>
</head>

<body>
    <div>
        <section>
            <div class="title">
                <div style="display: flex; align-items: center; width: 100%; ">
                    <div style="display: flex; justify-content: center; align-items: center; gap: 6px;">
                        <i id="home" class="fa-sharp fa-solid fa-house"></i>
                        <span style="margin-top: 2px;">@ViewBag.Title</span>
                    </div>
                </div>
            </div>
        </section>


        <section>
            <section>
                <div class="row m-0 p-0 align-items-end mb-2">
                    @*<div class="col-12 col-md-3 col-lg-2 p-1 mb-2 mb-md-0">
                            <div class="select2_item d-flex flex-column">
                                <label class="txtselected labelHeader">Mã Lệnh</label>
                                <select class="select_2" id="malenh">
                                </select>
                            </div>
                        </div>*@


                    <div class="col-12 col-md-4 col-lg-3 p-1 mb-2 mb-md-0">
                        <div class="select2_item d-flex flex-column">
                            <label class="txtselected labelHeader">Số Phiếu</label>
                            <select id="maphieu"></select>
                        </div>
                    </div>


                    <div class="col-6 col-md-2 col-lg-1 p-1 mb-2 mb-md-0">
                        <div class="select2_item d-flex flex-column">
                            <label class="txtselected labelHeader">Trạng thái duyệt</label>
                            <select id="trangThaiDuyet">
                                <option value="all" selected>-- Tất cả --</option>
                                <option value="1">Hoàn thành</option>
                                <option value="0">Chưa hoàn thành</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-6 col-md-2 col-lg-1 p-1 mb-2 mb-md-0">
                        <div class="d-flex flex-column">
                            <label class="txtselected labelHeader">Từ ngày</label>
                            <div class="input-group datetimepicker" id="dtpTuNgayFilter" style="position:relative">
                                <input style="height: 36px; font-size: 12px; border-radius: 5px; padding: 6px 28px 6px 8px;"
                                       type="text" class="form-control" id="filterTuNgay" placeholder="dd/mm/yyyy" />
                                <i style="position: absolute; right: 6px; top: 10px; font-size: 12px; cursor: pointer; z-index: 10"
                                   class="fa-solid fa-calendar-day"></i>
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-md-2 col-lg-1 p-1 mb-2 mb-md-0">
                        <div class="d-flex flex-column">
                            <label class="txtselected labelHeader">Đến ngày</label>
                            <div class="input-group datetimepicker" id="dtpDenNgayFilter" style="position:relative">
                                <input style="height: 36px; font-size: 12px; border-radius: 5px; padding: 6px 28px 6px 8px;"
                                       type="text" class="form-control" id="filterDenNgay" placeholder="dd/mm/yyyy" />
                                <i style="position: absolute; right: 6px; top: 10px; font-size: 12px; cursor: pointer; z-index: 10"
                                   class="fa-solid fa-calendar-day"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-2 col-lg-1 p-1 mb-2 mb-md-0">
                        <button class="btn btn-warning btn-mobile flex-fill flex-md-grow-0"
                                id="btnNapLaiDanhSach"
                                style="height: 32px; padding: 6px 12px;">
                            <i class="fa-solid fa-rotate-right mr-1 mr-md-2"></i>
                            <span class="d-sm-inline">Lọc</span>
                        </button>
                    </div>

                    <!-- Các nút -->
                    <div class="col-12 col-md col-lg p-1">
                        <div class="d-flex flex-nowrap gap-2 justify-content-md-end">
                            <button class="btn btn-success btn-mobile flex-fill flex-md-grow-0"
                                    id="btnXuatExcel"
                                    style="height: 32px; padding: 6px 12px;">
                                <i class="fa-solid fa-file-excel mr-1 mr-md-2"></i>
                                <span class="d-sm-inline">Xuất excel</span>
                            </button>
                            <button class="btn btn-danger btn-mobile flex-fill flex-md-grow-0"
                                    id="btnDeleteAllPhieu"
                                    style="height: 32px; padding: 6px 12px;">
                                <i class="fa-solid fa-trash mr-1 mr-md-2"></i>
                                <span class="d-sm-inline">Xóa Phiếu</span>
                            </button>
                            <button class="btn btn-info text-white btn-mobile flex-fill flex-md-grow-0"
                                    id="btnEditAllPhieu"
                                    style="height: 32px; padding: 6px 12px;">
                                <i class="fa-solid fa-file-pen mr-1 mr-md-2 text-white"></i>
                                <span class="d-sm-inline">Chỉnh Sửa Phiếu</span>
                            </button>

                            <button class="btn btn-success d-none" id="btnTimNhanh">
                                <i class="fa-solid fa-search mr-1 mr-md-2 text-white"></i>
                                <span class="btn-text-full d-sm-inline">Tìm Nhanh</span>
                            </button>
                            <button class="btn btn-secondary btn-mobile flex-fill flex-md-grow-0"
                                    id="btnShowModal"
                                    style="height: 32px; padding: 6px 12px;">
                                <i class="fa-solid fa-file-arrow-up mr-1 mr-md-2"></i>
                                <span class="d-sm-inline">Lập Phiếu</span>
                            </button>
                        </div>
                    </div>
                </div>
            </section>
            <div class="px-2">
                <div id="dxDataGridDanhSachDangKy" style=" min-height: calc(-200px + 100vh); max-height: calc(-60px + 100vh); width: 100%;" ;></div>
            </div>
        </section>
    </div>
    <!-- Modal Tìm Kiếm -->
    <div class="modal fade mt-2" id="modalTimNhanh" data-backdrop="static" data-keyboard="false" tabindex="-1">
        <div class="modal-dialog ">
            <div class="modal-content">
                <div class="modal-header py-2 bg-danger text-white">
                    <h6 class="modal-title" id="myModalLabelD">
                        <i class="fa-solid fa-search me-2"></i>Tìm Nhanh
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3">
                    <div class="mb-2" style="max-width: 225px">
                        <div class="input-group" style="min-width:350px">
                            <input id="inputTimKiem" class="form-control input-group-btn" placeholder="Tìm kiếm theo ItemCode và màu ... " style="font-size: 13px" />
                            <span id="btnTimKiem" class="input-group-text" style="cursor:pointer"><i class="fa-solid fa-search"></i></span>
                        </div>
                    </div>
                    <div id="dxDataPhieuDKVT" style="max-height: calc(100vh - 264px); min-height: 300px;"></div>
                </div>
                <div class="modal-footer d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fa-solid fa-xmark me-1"></i>Đóng
                    </button>
                </div>
            </div>
        </div>
    </div>

    <audio id="beepSound" controls="controls" style="display:none">
        <source src="~/css/QRCode/successSound.mp3" type="audio/mpeg" />
    </audio>
    <audio id="beepSoundError" controls="controls" style="display:none">
        <source src="~/css/QRCode/errorSound.mp3" type="audio/mpeg" />
    </audio>

    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999">
        <div id="successToast" class="toast" role="alert">
            <div class="toast-header bg-success text-white">
                <i class="fas fa-check-circle me-2"></i>
                <strong class="me-auto">Thành công</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="successMessage"></div>
        </div>
        <div id="errorToast" class="toast" role="alert">
            <div class="toast-header bg-danger text-white">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong class="me-auto">Lỗi</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="errorMessage"></div>
        </div>
        <div id="warningToast" class="toast" role="alert">
            <div class="toast-header bg-warning text-dark">
                <i class="fas fa-exclamation-circle me-2"></i>
                <strong class="me-auto">Cảnh báo</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="warningMessage"></div>
        </div>
    </div>

    <!-- Modal Thêm phiếu -->
    <div class="modal fade" id="modalAddPhieu" tabindex="-1" aria-labelledby="modalAddPhieu" aria-hidden="true" data-bs-backdrop="static"
         data-bs-keyboard="false">
        <div class="modal-dialog modal-fullscreen" style="padding: 24px">
            <div class="modal-content d-flex flex-column" style="height: 94vh; overflow: hidden;">


                <div class="modal-header">
                    <h5 class="modal-title" id="modalAddPhieuLabel">
                        <span class="material-symbols-outlined"></span>
                        Phiếu Xuất Kho Thành Phẩm
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <!-- Body -->
                <div class="modal-body">

                    <!-- Meta fields -->

                    <div class="meta-grid">
                        <!-- Hàng 1: Số phiếu | Ngày Đăng ký | Ngày YC Xuất kho | Chọn mã hàng -->
                        <div style="display: flex; gap: 12px; align-items: flex-end; width: 100%; margin-bottom: 10px;">
                            <!-- Số phiếu -->
                            <div style="flex: 1;">
                                <label for="m-so-phieu">Số phiếu</label>
                                <input id="m-so-phieu" type="text" value="PXKTP_1" style="width: 100%; height: 35px; border-radius: 5px; margin: 1px; border: 1px solid #d1d5db;" readonly />
                            </div>
                            <!-- Ngày Đăng ký -->
                            <div style="flex: 1;">
                                <label class="txtselected labelHeader">Ngày Đăng ký</label>
                                <div class="input-group datetimepicker" id="datetimepicker" style="position: relative;">
                                    <input style="height: 30px; font-size: 12px; border-radius: 5px; padding: 17px 12px; width: 100%;" type="text" class="form-control dateInput" id="tuNgay" />
                                    <i style="position: absolute; right: 12px; top: 9px; font-size: 12px; cursor: pointer; z-index: 10" class="fa-solid fa-calendar-day"></i>
                                </div>
                            </div>
                            <!-- Ngày YC Xuất kho -->
                            <div style="flex: 1;">
                                <label class="txtselected labelHeader">Ngày YC Xuất kho</label>
                                <div class="input-group datetimepicker" id="datetimepicker2" style="position: relative;">
                                    <input style="height: 30px; font-size: 12px; border-radius: 5px; padding: 17px 12px; width: 100%;" type="text" class="form-control dateInput" id="ngayCap" />
                                    <i style="position: absolute; right: 12px; top: 9px; font-size: 12px; cursor: pointer; z-index: 10" class="fa-solid fa-calendar-day"></i>
                                </div>
                            </div>
                            <!-- Chọn mã hàng -->
                            <div style="flex: 3;">
                                <label for="m-ma-hang">Chọn mã hàng</label>
                                <select id="m-ma-hang" style="width: 100%; display: block;"></select>
                            </div>
                        </div>

                        <!-- Hàng 2: Người nhận | Địa chỉ | Lý do -->
                        <div style="display: flex; gap: 12px; margin-bottom: 10px; align-items: center;">
                            <div class="meta-field" style="flex: 1;">
                                <label for="m-nguoi-nhan">Người nhận</label>
                                <input id="m-nguoi-nhan" type="text" placeholder="Nhập tên người nhận" />
                            </div>
                            <div class="meta-field" style="flex: 2;">
                                <label for="m-dia-chi">Địa chỉ</label>
                                <input id="m-dia-chi" type="text" placeholder="Nhập địa chỉ" />
                            </div>
                            <div class="meta-field" style="flex: 2;">
                                <label for="m-ly-do">Lý do</label>
                                <input id="m-ly-do" type="text" placeholder="Nhập lý do" />
                            </div>
                        </div>
                    </div>
                    <div class="table-toolbar">
                        <button class="btn-add-row" id="btnAddRow" type="button">
                            <span class="material-symbols-outlined"></span>Thêm dòng
                        </button>
                    </div>
                    <!-- Table -->
                    <div class="table-wrap" id="table-create" style="height:60vh">

                    </div>

                </div><!-- /modal-body -->
                <!-- Footer -->
                <div class="modal-footer">
                    <button type="button" class="btn-save" id="btnSavePhieu">
                        <span class="material-symbols-outlined"></span>Lưu dữ liệu
                    </button>
                    <button type="button" class="btn-cancel" data-bs-dismiss="modal">Hủy</button>
                </div>
            </div>
        </div>
    </div>
    @*Modal Thư viên*@
    <div class="modal fade" id="modalThuVien" tabindex="-1" aria-hidden="true"
         data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-fullscreen modal-dialog-scrollable" style="margin-top: 0;">
            <div class="modal-content" style="border-radius: 8px; margin: 12px;">
                <div class="modal-header" style="padding: 10px;">
                    <h6 class="modal-title">
