

<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width; initial-scale=1.0; maximum-scale=1.0; user-scalable=0;" />
    <title>Production Management System</title>

    <!-- Bootstrap 5.3 -->
    <link href="~/Scripts/ViTriKho/bootstrap5.3.min.css" rel="stylesheet" />
    <!-- Font Awesome 6 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet">

    <!-- Dùng lại JS của dự án -->
    <script src="~/Lib/JS/jquery3_7_1.js"></script>
    <script src="~/Lib/JS/ajax3.6.0.js"></script>
    <link href="/css/TheoDoiHangXuat/fontawesome.pro.6.0.0.css" rel="stylesheet" />

    <style>
        /* ═══════════════════════════════
           VARIABLES
        ═══════════════════════════════ */
        :root {
            --sidebar-w: 260px;
            --topbar-h: 60px;
            --font: 'Be Vietnam Pro', sans-serif;
            --primary: #1a56db;
            --primary-dk: #1342b0;
            --primary-lt: #e8effe;
            --sidebar-bg: #0d1526;
            --sidebar-text: rgba(255, 255, 255, .65);
            --sidebar-hover: rgba(255, 255, 255, .07);
            --sidebar-active: rgba(26, 86, 219, .25);
            --sidebar-active-border: #1a56db;
            --topbar-bg: #ffffff;
            --page-bg: #f3f5fb;
            --card-bg: #ffffff;
            --green: #0ea472;
            --green-lt: #e6f9f3;
            --blue: #1a56db;
            --blue-lt: #e8effe;
            --amber: #d97706;
            --amber-lt: #fff8e6;
            --violet: #7c3aed;
            --violet-lt: #f3effe;
            --rose: #e11d48;
            --rose-lt: #ffeef2;
            --slate: #475569;
            --slate-lt: #f1f4f8;
            --teal: #0891b2;
            --teal-lt: #e6f7fb;
            --shadow-sm: 0 1px 4px rgba(13, 21, 38, .06);
            --shadow-md: 0 4px 20px rgba(13, 21, 38, .10);
            --shadow-lg: 0 10px 40px rgba(13, 21, 38, .15);
        }

        /* ═══════════════════════════════
           BASE
        ═══════════════════════════════ */
        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html,
        body {
            height: 100%;
        }

        body {
            font-family: var(--font);
            background: var(--page-bg);
            color: #1e2a3b;
            font-size: 14px;
            overflow-x: hidden;
            /* XÓA: padding-top nếu có */
        }


        /* ═══════════════════════════════
           SIDEBAR
        ═══════════════════════════════ */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: var(--sidebar-w);
            background: var(--sidebar-bg);
            display: flex;
            flex-direction: column;
            z-index: 1040;
            transition: transform .28s cubic-bezier(.4, 0, .2, 1);
            overflow: hidden;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 0 20px;
            height: var(--topbar-h);
            border-bottom: 1px solid rgba(255, 255, 255, .06);
            flex-shrink: 0;
            text-decoration: none;
        }

        .brand-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #1a56db, #2563eb);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            color: #fff;
            box-shadow: 0 4px 12px rgba(26, 86, 219, .45);
            flex-shrink: 0;
        }

        .brand-name {
            font-size: 13px;
            font-weight: 700;
            color: #fff;
            line-height: 1.25;
            letter-spacing: .01em;
        }

        .brand-sub {
            font-size: 10px;
            color: rgba(255, 255, 255, .35);
            letter-spacing: .05em;
            font-weight: 400;
        }

        /* Scrollable nav area */
        .sidebar-nav {
            flex: 1;
            overflow-y: auto;
            padding: 14px 0 20px;
            scrollbar-width: thin;
            scrollbar-color: rgba(255, 255, 255, .1) transparent;
            overflow: auto;
            max-height: calc(100dvh - 135px);
        }

            .sidebar-nav::-webkit-scrollbar {
                width: 4px;
            }

            .sidebar-nav::-webkit-scrollbar-thumb {
                background: rgba(255, 255, 255, .1);
                border-radius: 2px;
            }

        /* Section label */
        .nav-section-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, .28);
            padding: 14px 20px 6px;
        }

        /* Nav link */
        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 20px;
            color: var(--sidebar-text);
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            border-left: 2px solid transparent;
            transition: all .15s;
            cursor: pointer;
        }

            .sidebar-link:hover {
                background: var(--sidebar-hover);
                color: #fff;
                text-decoration: none
            }

            .sidebar-link.active {
                background: var(--sidebar-active);
                border-left-color: var(--sidebar-active-border);
                color: #fff;
            }

            .sidebar-link .nav-icon {
                width: 30px;
                height: 30px;
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
                background: rgba(255, 255, 255, .06);
                flex-shrink: 0;
                transition: background .15s;
            }

            .sidebar-link:hover .nav-icon,
            .sidebar-link.active .nav-icon {
                background: rgba(26, 86, 219, .35);
                color: #60a5fa;
            }

            .sidebar-link.active .nav-icon {
                background: rgba(26, 86, 219, .4);
            }

        /* Sidebar footer */
        .sidebar-footer {
            padding: 14px 20px;
            border-top: 1px solid rgba(255, 255, 255, .06);
            flex-shrink: 0;
        }

        .sidebar-user {
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            padding: 8px 10px;
            border-radius: 10px;
            transition: background .15s;
        }

            .sidebar-user:hover {
                background: rgba(255, 255, 255, .07);
            }

        .user-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: linear-gradient(135deg, #3b82f6, #1d4ed8);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 700;
            color: #fff;
            flex-shrink: 0;
        }

        .user-info-name {
            font-size: 13px;
            font-weight: 600;
            color: #fff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-info-role {
            font-size: 11px;
            color: rgba(255, 255, 255, .35);
        }

        /* ═══════════════════════════════
           TOPBAR
        ═══════════════════════════════ */
        .topbar {
            position: fixed;
            top: 0;
            left: var(--sidebar-w);
            right: 0;
            height: var(--topbar-h);
            background: var(--topbar-bg);
            border-bottom: 1px solid #e8ecf4;
            display: flex;
            align-items: center;
            padding: 0 6px;
            gap: 0px;
            z-index: 1030;
            box-shadow: var(--shadow-sm);
        }

        .topbar-title {
            flex: 1;
            font-size: 16px;
            font-weight: 700;
            color: #1e2a3b;
        }

        .topbar-sub {
            font-size: 12px;
            font-weight: 400;
            color: #94a3b8;
            margin-left: 8px;
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .topbar-badge {
            display: flex;
            align-items: center;
            gap: 6px;
            background: #f3f5fb;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 6px 12px;
            font-size: 12px;
            color: #64748b;
            font-weight: 500;
        }

        .live-dot {
            width: 7px;
            height: 7px;
            background: #22c55e;
            border-radius: 50%;
            box-shadow: 0 0 0 2px rgba(34, 197, 94, .2);
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {

            0%,
            100% {
                box-shadow: 0 0 0 2px rgba(34, 197, 94, .2);
            }

            50% {
                box-shadow: 0 0 0 4px rgba(34, 197, 94, .06);
            }
        }

        .btn-icon {
            width: 36px;
            height: 36px;
            border-radius: 9px;
            border: 1px solid #e2e8f0;
            background: transparent;
            color: #64748b;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            cursor: pointer;
            transition: all .15s;
        }

            .btn-icon:hover {
                background: #f3f5fb;
                color: #1e2a3b;
                border-color: #c8d0e0;
            }

        /* Sidebar toggle for mobile */
        .sidebar-toggle {
            display: none;
        }

        /* ═══════════════════════════════
           MAIN CONTENT
        ═══════════════════════════════ */
        .main-content {
            margin-left: var(--sidebar-w);
        }

        .content-area {
            flex: 1;
            overflow-y: auto;
            padding: 0 28px 10px;
        }

        /* ═══════════════════════════════
           STAT CARDS (top row)
        ═══════════════════════════════ */
        .stat-card {
            background: var(--card-bg);
            border: 1px solid #e8ecf4;
            border-radius: 14px;
            padding: 20px 22px;
            box-shadow: var(--shadow-sm);
            transition: box-shadow .2s, transform .2s;
        }

            .stat-card:hover {
                box-shadow: var(--shadow-md);
                transform: translateY(-2px);
            }

        .stat-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }

        .stat-value {
            font-size: 22px;
            font-weight: 800;
            color: #1e2a3b;
            line-height: 1;
        }

        .stat-label {
            font-size: 12px;
            color: #94a3b8;
            font-weight: 500;
            margin-top: 4px;
        }

        .stat-delta {
            font-size: 12px;
            font-weight: 600;
        }

            .stat-delta.up {
                color: #0ea472;
            }

            .stat-delta.neutral {
                color: #94a3b8;
            }

        /* ═══════════════════════════════
           SECTION HEADING
        ═══════════════════════════════ */
        .section-heading {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 14px;
            margin-top: 28px;
        }

        .section-heading-icon {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
        }

        .section-heading h2 {
            font-size: 17px;
            font-weight: bold;
            letter-spacing: .07em;
            text-transform: uppercase;
            color: #0e3dff;
            margin: 0;
        }

        .section-heading-line {
            flex: 1;
            height: 1px;
            background: #e8ecf4;
        }

        /* ═══════════════════════════════
           MODULE CARDS
        ═══════════════════════════════ */
        .mod-card {
            background: var(--card-bg);
            border: 1.5px solid #e8ecf4;
            border-radius: 14px;
            padding: 18px 16px 14px;
            text-decoration: none;
            display: flex;
            flex-direction: column;
            gap: 10px;
            cursor: pointer;
            transition: all .2s cubic-bezier(.4, 0, .2, 1);
            box-shadow: var(--shadow-sm);
            position: relative;
            overflow: hidden;
            height: 100%;
        }

            .mod-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: var(--mod-color, #e8ecf4);
                opacity: 0;
                transition: opacity .2s;
            }

            .mod-card:hover {
                transform: translateY(-4px);
                box-shadow: var(--shadow-md);
                border-color: var(--mod-bd);
                background: var(--mod-bg);
            }

                .mod-card:hover::before {
                    opacity: 1;
                }

                .mod-card:hover .mod-icon {
                    transform: scale(1.1);
                }

                .mod-card:hover .mod-name {
                    color: var(--mod-color);
                }

        .mod-icon {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
            background: var(--mod-icon-bg);
            color: var(--mod-color);
            transition: transform .2s;
            flex-shrink: 0;
        }

        .mod-name {
            font-size: 13px;
            font-weight: 600;
            color: #1e2a3b;
            line-height: 1.35;
            transition: color .15s;
        }

        .mod-arrow {
            position: absolute;
            bottom: 12px;
            right: 12px;
            font-size: 10px;
            color: #cbd5e1;
            transition: all .2s;
        }

        .mod-card:hover .mod-arrow {
            color: var(--mod-color);
            transform: translate(2px, -2px);
        }

        /* Color tokens */
        .mod-green {
            --mod-color: var(--green);
            --mod-bg: var(--green-lt);
            --mod-bd: #86efcd;
            --mod-icon-bg: #d1fae5;
        }

        .mod-blue {
            --mod-color: var(--blue);
            --mod-bg: var(--blue-lt);
            --mod-bd: #93c5fd;
            --mod-icon-bg: #dbeafe;
        }

        .mod-amber {
            --mod-color: var(--amber);
            --mod-bg: var(--amber-lt);
            --mod-bd: #fcd34d;
            --mod-icon-bg: #fef3c7;
        }

        .mod-violet {
            --mod-color: var(--violet);
            --mod-bg: var(--violet-lt);
            --mod-bd: #c4b5fd;
            --mod-icon-bg: #ede9fe;
        }

        .mod-rose {
            --mod-color: var(--rose);
            --mod-bg: var(--rose-lt);
            --mod-bd: #fda4af;
            --mod-icon-bg: #ffe4e6;
        }

        .mod-slate {
            --mod-color: var(--slate);
            --mod-bg: var(--slate-lt);
            --mod-bd: #94a3b8;
            --mod-icon-bg: #e2e8f0;
        }

        .mod-teal {
            --mod-color: var(--teal);
            --mod-bg: var(--teal-lt);
            --mod-bd: #67e8f9;
            --mod-icon-bg: #cffafe;
        }

        /* ═══════════════════════════════
           ANIMATIONS
        ═══════════════════════════════ */
        .fade-in {
            animation: fadeInUp .35s ease both;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(16px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .delay-1 {
            animation-delay: .05s;
        }

        .delay-2 {
            animation-delay: .10s;
        }

        .delay-3 {
            animation-delay: .15s;
        }

        .delay-4 {
            animation-delay: .20s;
        }

        .delay-5 {
            animation-delay: .25s;
        }

        .delay-6 {
            animation-delay: .30s;
        }

        .delay-7 {
            animation-delay: .35s;
        }

        .delay-8 {
            animation-delay: .40s;
        }

        .delay-9 {
            animation-delay: .45s;
        }

        .delay-10 {
            animation-delay: .50s;
        }

        /* ═══════════════════════════════
           SIDEBAR OVERLAY (mobile)
        ═══════════════════════════════ */
        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, .45);
            z-index: 1039;
        }

        /* ═══════════════════════════════
           RESPONSIVE
        ═══════════════════════════════ */
        @@media (max-width: 991.98px) {
            .sidebar {
                transform: translateX(-100%);
            }

                .sidebar.show {
                    transform: translateX(0);
                }

            .sidebar-overlay.show {
                display: block;
            }

            .topbar {
                left: 0;
            }

            .main-content {
                margin-left: 0;
            }

            .sidebar-toggle {
                display: flex !important;
            }

            .content-area {
                padding: 20px 16px 48px;
            }
        }
        /* ── Sidebar collapsed ── */


        /* Main content co lại khi sidebar thu */
        .main-content.collapsed {
            margin-left: 64px;
        }

        .topbar.collapsed {
            left: 64px;
        }

        /* Transition mượt */
        .sidebar, .main-content, .topbar {
            transition: width .25s ease, left .25s ease, margin-left .25s ease, transform .28s cubic-bezier(.4,0,.2,1);
        }

            .sidebar.collapsed {
                width: 64px;
            }

                .sidebar.collapsed .brand-name,
                .sidebar.collapsed .brand-sub,
                .sidebar.collapsed .nav-section-label,
                .sidebar.collapsed .sidebar-link span:not(.nav-icon),
                .sidebar.collapsed .user-info-name,
                .sidebar.collapsed .user-info-role,
                .sidebar.collapsed .sidebar-footer .fa-ellipsis-v {
                    display: none !important;
                }

                .sidebar.collapsed .sidebar-brand {
                    justify-content: center;
                    padding: 0;
                }

                .sidebar.collapsed .sidebar-link {
                    justify-content: center;
                    padding: 9px 0;
                    border-left: 2px solid transparent;
                }

                .sidebar.collapsed .sidebar-user {
                    justify-content: center;
                    padding: 8px 0;
                }

                .sidebar.collapsed .nav-icon {
                    margin: 0;
                    width: 36px;
                    height: 36px;
                }

                /* Tooltip khi collapsed */
                .sidebar.collapsed .sidebar-link {
                    position: relative;
                }

            /* Main content co lại khi sidebar thu */
            .main-content.collapsed {
                margin-left: 64px;
            }

            .topbar.collapsed {
                left: 64px;
            }

        /* Transition mượt */
        .sidebar, .main-content, .topbar {
            transition: width .25s ease, left .25s ease, margin-left .25s ease, transform .28s cubic-bezier(.4,0,.2,1);
        }
        /* ── TAB BAR ── */
        .tab-bar {
            display: flex;
            align-items: center;
            gap: 2px;
            padding: 0 8px;
            background: #f3f5fb;
            border-bottom: 1px solid #e2e8f0;
            height: 38px;
            overflow-x: auto;
            overflow-y: hidden;
            scrollbar-width: none;
            flex-shrink: 0;
        }

            .tab-bar::-webkit-scrollbar {
                display: none;
            }

        .tab-item {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 5px 13px 5px 11px;
            border-radius: 7px 7px 0 0;
            background: transparent;
            border: 1px solid transparent;
            border-bottom: none;
            color: #64748b;
            font-size: 12.5px;
            font-weight: 500;
            cursor: pointer;
            white-space: nowrap;
            transition: all .15s;
            user-select: none;
            position: relative;
            top: 1px;
            max-width: 180px;
            border-bottom: 1px solid #ccc;
        }

            .tab-item:hover {
                background: #e8ecf4;
                color: #1e2a3b;
            }

            .tab-item.active {
                background: #fff;
                border-color: #e2e8f0;
                color: var(--primary);
                font-weight: 600;
            }

            .tab-item .tab-icon {
                font-size: 11px;
                opacity: .7;
                flex-shrink: 0;
            }

            .tab-item.active .tab-icon {
                opacity: 1;
            }

            .tab-item .tab-name {
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

        .tab-close {
            width: 16px;
            height: 16px;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            color: #94a3b8;
            flex-shrink: 0;
            transition: all .12s;
            margin-left: 2px;
        }

            .tab-close:hover {
                background: #fecdd3;
                color: #e11d48;
            }

        /* ── CONTENT PANELS ── */
        .tab-panels {
            display: none;
            height: calc(100vh - var(--topbar-h) - 38px); /* trừ topbar + tab bar */
            position: relative;
            overflow: hidden;
        }

        .tab-panel {
            position: absolute;
            inset: 0;
            display: none;
            height: 100%;
        }

            .tab-panel.active {
                display: block;
            }

            .tab-panel iframe {
                width: 100%;
                height: 100%;
                border: none;
            }

        /* ── Khi có tab: ẩn dashboard, hiện panels ── */
        .main-content {
            margin-left: var(--sidebar-w);
            height: calc(100dvh - 55px);
            display: flex;
            flex-direction: column;
            padding-top: 8px;
            overflow: hidden;
        }

        .content-area {
            flex: 1;
            overflow-y: auto;
        }

        .tab-panels {
            display: none;
        }

        .tab-bar-wrap {
            display: none;
        }

        .main-content.has-tabs .tab-bar-wrap {
            display: flex;
            flex-direction: column;
        }

        .main-content.has-tabs .tab-bar-wrap {
            display: block;
        }

        .main-content.has-tabs .tab-panels {
            display: block;
            flex: 1;
        }

        .main-content.has-tabs .content-area {
            display: none;
        }

        ::-webkit-scrollbar {
            height: 8px;
            width: 8px;
        }

        /* Track */
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        /* Handle */
        ::-webkit-scrollbar-thumb {
            background: #888;
        }

            /* Handle on hover */
            ::-webkit-scrollbar-thumb:hover {
                background: #555;
            }

        .nav-group-header {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 20px;
            color: rgba(255,255,255,.5);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: .05em;
            text-transform: uppercase;
            cursor: pointer;
            transition: all .15s;
            user-select: none;
        }

            .nav-group-header:hover {
                background: rgba(255,255,255,.05);
                color: rgba(255,255,255,.8);
            }

            .nav-group-header .nav-icon {
                width: 28px;
                height: 28px;
                border-radius: 7px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 12px;
                background: rgba(255,255,255,.06);
                flex-shrink: 0;
            }

        .nav-group-name {
            flex: 1;
        }

        .nav-chevron {
            font-size: 10px;
            color: rgba(255,255,255,.25);
            transition: transform .2s ease;
            flex-shrink: 0;
        }

        /* Khi đóng: xoay chevron */
        .nav-group.closed .nav-chevron {
            transform: rotate(-90deg);
        }

        /* Body ẩn/hiện */
        .nav-group-body {
            overflow: hidden;
            max-height: 600px; /* đủ lớn */
            transition: max-height .25s ease, opacity .2s ease;
            opacity: 1;
        }

        .nav-group.closed .nav-group-body {
            max-height: 0;
            opacity: 0;
        }

        /* Indent link con */
        .nav-group-body .sidebar-link {
            padding-left: 28px;
            font-size: 12.5px;
        }

            .nav-group-body .sidebar-link .nav-icon {
                width: 24px;
                height: 24px;
                font-size: 11px;
            }

        /* Khi sidebar collapsed: ẩn hết group text, chỉ hiện icon header */
        .sidebar.collapsed .nav-group-header {
            justify-content: center;
            padding: 9px 0;
        }

        .sidebar.collapsed .nav-group-name,
        .sidebar.collapsed .nav-chevron {
            display: none;
        }

        .sidebar.collapsed .nav-group-body {
            display: none;
        }
        /* ── Mobile: sidebar float trên, không đẩy body ── */
        @@media (max-width: 991.98px) {
            .sidebar {
                position: fixed !important;
                transform: translateX(-100%);
                width: var(--sidebar-w) !important;
                z-index: 1050;
            }

                .sidebar.show {
                    transform: translateX(0);
                }
                /* Không cho collapsed hoạt động trên mobile */
                .sidebar.collapsed {
                    width: var(--sidebar-w) !important;
                }

            .sidebar-overlay {
                z-index: 1045; /* thấp hơn sidebar, cao hơn content */
            }

            .sidebar.collapsed .brand-name,
            .sidebar.collapsed .brand-sub,
            .sidebar.collapsed .nav-section-label,
            .sidebar.collapsed .sidebar-link span:not(.nav-icon),
            .sidebar.collapsed .user-info-name,
            .sidebar.collapsed .user-info-role {
                display: block !important;
            }

            .sidebar.collapsed .sidebar-brand {
                justify-content: flex-start;
                padding: 0 20px;
            }

            .sidebar.collapsed .sidebar-link {
                justify-content: flex-start;
                padding: 9px 20px;
            }

            .sidebar.collapsed .sidebar-user {
                justify-content: flex-start;
                padding: 8px 10px;
            }

            .topbar {
                left: 0 !important;
            }

            .main-content {
                margin-left: 0 !important;
            }
        }

        .tab-bar-inline {
            display: flex;
            align-items: center;
            flex: 1;
            overflow-x: auto;
            overflow-y: hidden;
            gap: 4px;
            height: 100%;
            padding: 0 8px;
            overflow-x: auto;
            overflow-y: hidden;
            -webkit-overflow-scrolling: touch; /* ← fix iOS */
            scroll-snap-type: x mandatory; /* ← optional: snap mượt */
        }

            .tab-bar-inline::-webkit-scrollbar {
            }

        .tab-loading {
            position: absolute;
            inset: 0;
            background: #f3f5fb;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 12px;
            z-index: 10;
        }

        .tab-loading-spinner {
            width: 40px;
            height: 40px;
            border: 3px solid #e2e8f0;
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin .7s linear infinite;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .tab-loading-text {
            font-size: 13px;
            color: #94a3b8;
            font-weight: 500;
        }
    </style>
</head>

<body>

    <!-- ═══════════════════════════════════
      SIDEBAR
    ════════════════════════════════════ -->
    <aside class="sidebar" id="sidebar">

        <!-- Brand -->
        <a class="sidebar-brand" href="#">
            <div class="brand-icon">
                <i class="fas fa-industry"></i>
            </div>
            <div style="margin-top:5px">
                <div class="brand-name">PMS</div>
                <div class="brand-sub">Production Management</div>
            </div>
        </a>
        <nav class="sidebar-nav" id="sidebarNav">
            <!-- render bằng JS -->
        </nav>


        <!-- User footer -->
        <div class="sidebar-footer">
            <div id="DangXuat" class="mt-2 rounded-3 overflow-hidden"
                 style="display:none;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);">
                <a href="~/Login/Index" id="logout-link"
                   class="d-flex align-items-center gap-2 px-3 py-2 text-decoration-none"
                   style="color:rgba(255,255,255,.6);font-size:13px;transition:background .15s;"
                   onmouseover="this.style.background='rgba(225,29,72,.15)';this.style.color='#fb7185';"
                   onmouseout="this.style.background='';this.style.color='rgba(255,255,255,.6)';">
                    <i class="fas fa-sign-out-alt"></i> Đăng xuất
                </a>
            </div>
            <div class="sidebar-user" onclick="toggleLogout()">
                <div class="user-avatar" id="UserAvatarSidebar">U</div>
                <div class="flex-grow-1 overflow-hidden">
                    <div class="user-info-name user">Người dùng</div>
                    <div class="user-info-role">Quản lý hệ thống</div>
                </div>
                <i class="fas fa-ellipsis-v" style="color:rgba(255,255,255,.3);font-size:12px;"></i>
            </div>
            <!-- Logout popup -->

        </div>
    </aside>

    <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

    <header class="topbar justify-content-between">
        <!-- Mobile toggle -->
        <button class="btn-icon me-2" id="sidebarToggleBtn" onclick="toggleSidebar()">
            <i class="fas fa-bars"></i>
        </button>

        <!-- Tab bar nằm giữa, chiếm phần còn lại -->
        <div id="tabBar" class="tab-bar-inline"></div>

        <div class="topbar-actions" style="flex-shrink:0;">
            <div class="topbar-badge d-none d-sm-flex">
                <div class="live-dot"></div>
                <span>Online</span>
            </div>
            <div class="topbar-badge d-none d-md-flex" id="clock-display">--:--</div>
        </div>
    </header>

    <main class="main-content">


        <div class="tab-panels" id="tabPanels"></div>

        <div class="content-area" id="dashboardArea">
            <div id="dashboard-sections"></div>
        </div>


    </main>

    <!-- Bootstrap 5.3 JS -->
    <script src="~/Scripts/ViTriKho/bootstrap5.3.bundle.min.js"></script>
    <script src="~/Scripts/TheoDoiHangXuat/jquery.js"></script>
    <script src="~/Scripts/login.js"></script>
    <script src="~/Scripts/Dashboard/Dashboard.js"></script>

</body>

</html>

