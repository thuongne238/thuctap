    <div style="padding: 10px; height: 100%; overflow-y: auto; display: flex; flex-direction: column; gap: 10px;">   
        <div class="group-title" style="margin-bottom: 15px;">
            <div style="background: #f8f9fa; padding: 5px; border-left: 4px solid #007bff; border-radius: 4px;">
                <div id="headerInfo"></div>
            </div>
        </div>
        <div style="background: #f8f9fa; padding: 5px; border-left: 4px solid #007bff; border-radius: 4px;">
            <strong>TT PO-Lệnh Sản Xuất </strong>
            <div id="gridLenhSX" style="margin-bottom: 20px;"></div>
        </div>
    
        <div style="background: #f8f9fa; padding: 5px; border-left: 4px solid #007bff; border-radius: 4px;">
            <strong>TT Cấp phát </strong>
            <div id="gridCapPhat"></div>
        </div>


    </div>
