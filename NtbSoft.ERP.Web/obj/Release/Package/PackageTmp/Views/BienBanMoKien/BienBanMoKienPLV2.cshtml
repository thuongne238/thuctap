@{
    Layout = null;
}
@{
    ViewBag.Title = "Biên bản mở kiện ";
}

<!DOCTYPE html>
<html>
<head>
    <title>@ViewBag.Title</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width; initial-scale=1.0; maximum-scale=1.0; user-scalable=0;" />
    <link href="~/Content/plugins/select2/css/select2.css" rel="stylesheet" />
    <link href="~/css/TheoDoiHangXuat/fontawesome.pro.6.0.0.css" rel="stylesheet" />
    <link href="~/css/TheoDoiHangXuat/toastr.min.css" rel="stylesheet" />
    <link href="~/css/TheoDoiHangXuat/roboto.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/Content/dist/css/adminlte.min.css">
    <link href="~/css/QRCode/toastr.minM.css" rel="stylesheet" />
    <link href="~/css/BienBanMoKien/flatpickr-min.css" rel="stylesheet" />
    <link href="~/Scripts/ViTriKho/bootstrap5.3.min.css" rel="stylesheet" />
    <link href="~/Content/plugins/select2-bootstrap4-theme/select2-bootstrap4.min.css`" rel="stylesheet" />
    <link href="~/css/BienBanMoKien/BienBanMoKien.css" rel="stylesheet" />
    <style>
        tr:nth-child(even) {
            background-color: #ececec;
        }

        .dx-header-row .col-header {
            background: #5da566;
            color: #fff;
            text-align: center !important;
            vertical-align: middle !important
        }

        .dx-data-row .col-header {
            text-align: center !important;
            font-size: 13px !important;
            vertical-align: middle !important
        }

        .dx-data-row .checkboxTD {
            display: flex;
            justify-content: center
        }

        .dx-footer-row .col-header .dx-datagrid-text-content {
            text-align: center !important;
            color: red !important
        }

        .dx-datagrid-summary-item {
            text-align: center !important;
            color: red !important
        }

        #headerRect th, #headerCylinder th {
            background: #5DA566 !important;
            font-weight: unset;
            color: #fff;
            text-align: center;
        }

        .tdCBM.vtk {
            background: #91E1FF
        }

        .editcbm {
            position: absolute
        }

        .title {
            background: #357C97;
            color: #Fff
        }

        ::-webkit-scrollbar {
            height: 6px;
            width: 6px;
        }

        /* Track */
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        /* Handle */
        ::-webkit-scrollbar-thumb {
            background: #888;
        }

            /* Handle on hover */
            ::-webkit-scrollbar-thumb:hover {
                background: #555;
            }

        .select2_item label {
            white-space: nowrap;
            margin-bottom: 0;
            font-size: 14px;
            font-weight: 500 !important;
        }
    </style>
</head>

<body>
    <section>
        <div class="title">
            <div style="display: flex; align-items: center; width: 100%; flex-wrap: wrap; ">
                <div style="display: flex; justify-content: center; align-items: center; gap: 6px;">
                    <i id="home" class="fa-sharp fa-solid fa-house"></i>
                    <span style="margin-top: 2px;">Biên bản mở kiện phụ liệu</span>
                </div>
                <div class="d-flex flex-wrap" style="margin-left: auto;">
                    <button type="button"
                            class="save-buttonShare d-none btn-add btn btn-primary d-flex align-items-center gap-2 ">
                        <i class="fa-solid fa-plus"></i>
                        Thêm vật tư
                    </button>
                    <button type="button" style="background-color: #6a69e9; color: white;"
                            class="save-buttonShare btn-nhapcbm btn btn-primary d-flex align-items-center gap-2 ">
                        <i class="fa-solid fa-plus"></i>
                        Nhập CBM
                    </button>
                    <button type="button" style="background: #3466b3; color: #fff;"
                            class="save-buttonShare btn-huy btn btn-primary d-flex align-items-center gap-2 ">
                        <i class="fa-solid fa-xmark"></i>
                        Hủy nhận
                    </button>
                    <button type="button" style="background: #ffe216; color: #000;"
                            class="save-buttonShare btn-save btn btn-primary d-flex align-items-center gap-2 ">
                        <i class="fa-solid fa-floppy-disk-circle-arrow-right"></i>
                        Nhận vật tư
                    </button>
                    <button type="button" style="background: #438945; color: #fff;"
                            class="save-buttonShare btn btn-primary d-flex align-items-center gap-2 btn-excel">
                        <i class="fa-solid fa-file-excel"></i>
                        Excel
                    </button>
                    <button onclick="CheckHT()" type="button"
                            class="save-buttonShare  btn  d-flex align-items-center gap-2 ">
                        <i class="fa-solid fa-square-check"></i>
                        Hoàn thành
                    </button>
                </div>
            </div>
        </div>

    </section>
    <section>
        <div class="container-fluid p-0" style="box-shadow: rgba(100, 100, 111, 0.2) 0px 7px 29px 0px;">
            <div class="card-body" style="padding :2px;margin-bottom:5px">
                <div class="">
                    <div class="row p-0 m-0">
                        <div class="col-12 col-md-12 col-lg-12 col-xl-8">
                            <div class="row p-0 m-0">
                                <div class="col-4 col-md-4 col-lg-2 col-xl-2 ">
                                    <div class="select2_item ">
                                        <label class="txtselected">Khách hàng</label>
                                        <select onchange="GetMaHangNL()" class="select_2" id="khachhangid">
                                        </select>
                                    </div>
                                </div>
                                <div class="col-4 col-md-4 col-lg-2 col-xl-2 ">
                                    <div class="select2_item ">
                                        <label class="txtselected">Mã hàng</label>
                                        <select onchange="GetSoLo()" class="select_2" id="mahangid">
                                        </select>
                                    </div>
                                </div>
                                <div class="col-4 col-md-4 col-lg-2 col-xl-2 ">
                                    <div class="select2_item ">
                                        <label class="txtselected">PO Mua</label>
                                        <select onchange="GetVatTu()" class="select_2" id="soloid">
                                        </select>
                                    </div>
                                </div>
                                <div class="col-4 col-md-4 col-lg-4 col-xl-5 p-0">
                                    <div class="select2_item">
                                        <label class="txtselected">Vật tư </label>
                                        <select onchange="GetPhieuNK()" class="select_2" id="cayvai">
                                        </select>
                                    </div>
                                </div>

                                <div class="col-2 col-md-2 col-lg-2 col-xl-1">
                                    <div class="select2_item">
                                        <label class="txtselected">Kiểm xong</label>
                                        <input onchange="GetSoLo()" class="checkNhapThung" type="checkbox" style="width: 28px; height: 28px; margin-top: 1px;
">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-12 col-lg-12 col-xl-4 mt-2" style="">
                            <div style="display: flex; justify-content: end; align-items: center; height: 100%; gap: 10px; ">

                                <div class="icon_reload">
                                    <i class="fa-solid fa-filters"></i>
                                </div>
                                <button onclick="inbarcode()" class="btn  bg-warning " id="printBarCode" style="font-size: 15px; white-space: nowrap; width: 125px; height: 30px; display: flex; justify-content: center; align-items: center; background: #68ff1b;">
                                    <i class="fa-solid fa-qrcode mr-2"></i>
                                    In barcode
                                </button>
                                <button onclick="GetToViTrikho()" class="btn d-none btnDenKho" id="" style="font-size: 15px; width: 105px; height: 30px; white-space: nowrap; display: flex; justify-content: center; align-items: center; background: #492FF5; color: #fff;" fdprocessedid="w29i8">
                                    <i class="fa-solid fa-arrow-right mr-2"></i>
                                    Đến kho
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section>
        <div class="main-item">
            <div class="task-item" id="tbody"></div>

        </div>
    </section>
    <div class="modal fade" id="myModal" data-backdrop="static" data-keyboard="false" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h5 class="modal-title" id="myModalLabel">Thêm vật tư</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body py-2">
                    <div class="row mb-2  pb-2" style="border-bottom: 1px solid #E9ECEF;">
                        <div class="col-8 py-1">
                            <span style="font-size: 16px; color: black; font-weight: 500;"> Vật tư:</span>
                            <select onchange="GetSoLoModal()" class="modalVatTu select2_item">
                            </select>
                        </div>
                        <div class="col-4 py-1">
                            <span style="font-size: 16px; color: black; font-weight: 500;"> Số lô:</span>
                            <select class="modalSoLo select2_item">
                            </select>
                        </div>

                        <div class="col-4 py-1">
                            <span style="font-size: 16px; color: black; font-weight: 500;"> Khổ size:</span>
                            <span class="khosizeMDA" style="font-size: 16px; color: red; font-weight: 700;"></span>
                        </div>
                        <div class="col-4 py-1">
                            <span style="font-size: 16px; color: black; font-weight: 500;"> Đơn vị:</span>
                            <span class="donviMDA" style="font-size: 16px; color: red; font-weight: 700;"></span>
                        </div>
                        <div class="col-4 py-1">
                            <span style="font-size: 16px; color: black; font-weight: 500;"> Đơn giá:</span>
                            <span class="dongiaMDTextA" style="font-size: 16px; color: red; font-weight: 700;"></span>
                        </div>

                    </div>
                    <div class="row ">
                        <div class="col-6 py-1">
                            <div style="display: flex; gap: 2px;">
                                <span style="font-size: 16px; color: black; font-weight: 500; white-space: nowrap; width: 125px;">  Vật tư:</span>
                                <input class="sokienMD addKienInput" value="" />
                            </div>
                        </div>
                        <div class="col-6 py-1">
                            <div style="display: flex; gap: 2px;">
                                <span style="font-size: 16px; color: black; font-weight: 500; white-space: nowrap; width: 125px;"> Thực nhập:</span>
                                <input class="thucnhapMD addKienInput" type="number" value="" />
                            </div>
                        </div>
                        <div class="col-6 py-1">
                            <div style="display: flex; gap: 2px;">
                                <span style="font-size: 16px; color: black; font-weight: 500; white-space: nowrap; width: 125px;"> Tên LOT:</span>
                                <input class="tenlotMD addKienInput" type="text" value="" />
                            </div>
                        </div>
                        <div class="col-6 py-1 d-none">
                            <div style="display: flex; gap: 2px;">
                                <span style="font-size: 16px; color: black; font-weight: 500; white-space: nowrap; width: 125px;"> Đơn giá:</span>
                                <input class="dongiaMDA addKienInput" type="text" value="" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary saveKien">Lưu</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="myModalN" data-backdrop="static" data-keyboard="false" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h5 class="modal-title" id="myModalLabelN">Chọn ngày</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body py-2">
                    <div class="row ">
                        <div class="col-6 py-1">
                            <div style="display: flex; gap: 10px; justify-content: center; align-items: center;">
                                <span style="font-size: 16px; color: black; font-weight: 500;"> Ngày:</span>
                                <div class="item_ngaychon">
                                    <input style="outline: none; border: 1px solid #ccc; border-radius: 5px; height: 30px; font-size: 14px; text-align: center;" type="text" class="datepicker">
                                </div>
                            </div>

                        </div>
                        <div class="col-6 py-1">
                            <div style="display: flex; gap: 10px; justify-content: center; align-items: center;">
                                <span style="font-size: 16px; color: black; font-weight: 500;"> Palet:</span>
                                <input class="paletMD addKienInput" type="text" value="" style="height: 30px; color: #000; text-transform: uppercase;" />
                            </div>

                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary saveTable">Lưu</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="myModalIn" data-backdrop="static" data-keyboard="false" tabindex="-1">
        <div class="modal-dialog" style="width: 80%; max-width: 80%;">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h5 class="modal-title" id="myModalLabeIN">In barcode</h5>
                    <button type="button" class="close closebtn" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body py-2" style="height: calc(100vh - 180px); overflow: auto;">
                    <div id="labelContainerB">
                        <div class="row lablebarcodeB">
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" onclick="window.print()">In barcode</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="myModal4" data-backdrop="static" data-keyboard="false" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h5 class="modal-title" id="myModalLabel">Thực xuất</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body py-2">
                    <div class="row mb-2  pb-2" style="border-bottom: 1px solid #E9ECEF;">
                        <div class="col-4 py-1">
                            <span style="font-size: 16px; color: black; font-weight: 500;"> Số lô:</span>
                            <span class="soloMD" style="font-size: 16px; color: red; font-weight: 700;"></span>
                        </div>
                        <div class="col-8 py-1">
                            <span style="font-size: 16px; color: black; font-weight: 500;"> Vật tư:</span>
                            <span class="vattuMD" style="font-size: 16px; color: red; font-weight: 700;"></span>
                        </div>

                        <div class="col-4 py-1">
                            <span style="font-size: 16px; color: black; font-weight: 500;"> Số kiện:</span>
                            <span class="sokienS4" style="font-size: 16px; color: red; font-weight: 700;"></span>
                        </div>
                        <div class="col-4 py-1">
                            <span style="font-size: 16px; color: black; font-weight: 500;"> Số LOTt:</span>
                            <span class="solotS4" style="font-size: 16px; color: red; font-weight: 700;"></span>
                        </div>
                        <div class="col-4 py-1">
                            <span style="font-size: 16px; color: black; font-weight: 500;"> Theo CT:</span>
                            <span class="theoCTS4" style="font-size: 16px; color: red; font-weight: 700;"></span>
                        </div>

                        <div class="col-4 py-1">
                            <span style="font-size: 16px; color: black; font-weight: 500;"> Khổ size:</span>
                            <span class="khosizeMD" style="font-size: 16px; color: red; font-weight: 700;"></span>
                        </div>
                        <div class="col-4 py-1">
                            <span style="font-size: 16px; color: black; font-weight: 500;"> Đơn vị:</span>
                            <span class="donviMD" style="font-size: 16px; color: red; font-weight: 700;"></span>
                        </div>
                        <div class="col-4 py-1">
                            <span style="font-size: 16px; color: black; font-weight: 500;"> Đơn giá:</span>
                            <span class="dongiaMDText" style="font-size: 16px; color: red; font-weight: 700;"></span>
                        </div>

                    </div>
                    <div class="row">

                        <div class="col-12 py-1">
                            <div style="display: flex; gap: 2px;">
                                <span style="font-size: 16px; color: black; font-weight: 500; white-space: nowrap; width: ;"> Thực nhập:</span>
                                <input style="width:50%" class="SuaTNInput addKienInput" type="number" value="" />
                            </div>
                        </div>


                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary btnXacNhanSuaTN">Xác nhận</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="myModalD" data-backdrop="static" data-keyboard="false" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h5 class="modal-title" id="myModalLabelD">Reset thực nhập</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body py-2">
                    <p class="mb-0" style="font-size:16px;">Bạn muốn reset thực nhập từng vật tư ? </p>
                </div>
                <div class="modal-footer">
                    <button onclick="ResetThucNhap()" type="button" class="btn btn-primary" id="btnHuyThuCNhap">Xác nhận</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="myModalH" data-backdrop="static" data-keyboard="false" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h5 class="modal-title" id="myModalLabelD">Hủy nhận</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body py-2">
                    <p class="mb-0" style="font-size:16px;">Bạn muốn hủy nhận những vật tư này ? </p>
                </div>
                <div class="modal-footer">
                    <button onclick="HuyNhan()" type="button" class="btn btn-primary" id="btnHuyThuCNhap">Xác nhận</button>
                </div>
            </div>
        </div>
    </div>


    <div class="modal fade" id="cbmModal" tabindex="-1" aria-labelledby="cbmModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="cbmModalLabel">Nhập Thông Tin CBM</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" onclick="renderCheckFalse()" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">

                    <!-- Radio chọn dạng nhập -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-start align-items-center">
                            <div class="form-check form-check-inline d-flex justify-content-center align-items-center">
                                <input style="width:20px;height:20px" class="form-check-input" type="radio" name="typeCBM" id="typeRect" value="rect" checked>
                                <label class="form-check-label" for="typeRect">Dài - Rộng - Cao</label>
                            </div>
                            <div class="form-check form-check-inline d-flex justify-content-start align-items-center">
                                <input style="width:20px;height:20px" class="form-check-input" type="radio" name="typeCBM" id="typeCylinder" value="cylinder">
                                <label class="form-check-label" for="typeCylinder">Chiều dài & Đường kính</label>
                            </div>
                        </div>
                    </div>

                    <!-- Bảng nhập -->
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="">
                                <!-- Header Hình hộp -->
                                <tr id="headerRect">
                                    <th>Dài (m)</th>
                                    <th>Rộng (m)</th>
                                    <th>Cao (m)</th>
                                    <th>CBM</th>
                                </tr>
                                <!-- Header Hình trụ -->
                                <tr id="headerCylinder" class="d-none">
                                    <th>Chiều dài (m)</th>
                                    <th>Đường kính (m)</th>
                                    <th colspan="2">CBM</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <!-- Dạng hình hộp -->
                                    <td class="cell-rect"><input type="number" step="0.01" class="form-control cbm-input input-length"></td>
                                    <td class="cell-rect"><input type="number" step="0.01" class="form-control cbm-input input-width"></td>
                                    <td class="cell-rect"><input type="number" step="0.01" class="form-control cbm-input input-height"></td>

                                    <!-- Dạng hình trụ -->
                                    <td class="cell-cylinder d-none"><input type="number" step="0.01" class="form-control cbm-input input-cylinder-length"></td>
                                    <td class="cell-cylinder d-none"><input type="number" step="0.01" class="form-control cbm-input input-cylinder-diameter"></td>

                                    <!-- CBM -->
                                    <td style="min-width:60px;vertical-align:middle" class="cbm-value text-center" id="cbmResult">0.00</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                </div>
                <div class="modal-footer">
                    <button onclick="renderCheckFalse()" type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-primary" id="btnSaveCBM">Lưu CBM</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="myModalHT" data-backdrop="static" data-keyboard="false" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white">

                    <h6 class="modal-title" id="myModalLabelHT"><i class="fa-solid fa-circle-check"></i> Xác nhận hoàn thành</h6>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body py-2">
                    <p class="mb-0" style="font-size:16px;">Bạn muốn xác nhận hoàn thành đợt : <strong id="txtDotHT"></strong></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                        <i class="fa-solid fa-xmark" style="margin-right:5px"></i>Hủy
                    </button>
                    <button onclick="PostHT()" type="button" class="btn btn-success btn-sm" id="btnXacNhanHT">
                        <i class="fa-solid fa-square-check" style="margin-right:5px"></i>Xác nhận
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="barcodein" style="display:none;">
        <div id="labelContainer" style="opacity:0">
            <div class="lablebarcode">
            </div>
        </div>
    </div>
    @*modal Xuất Excel*@
    <div class="modal fade" id="modal-excel" tabindex="-1" aria-labelledby="modalExcelLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-md modal-dialog-centered">
            <div class="modal-content shadow-lg">

                <div class="modal-body px-4 py-3">
                    <!-- Ngày -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Từ ngày</label>
                            <input type="text" class="form-control excel-from-date" id="toDate" placeholder="Chọn từ ngày">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Đến ngày</label>
                            <input type="text" class="form-control excel-to-date" id="fromDate" placeholder="Chọn đến ngày">
                        </div>
                    </div>


                    <!-- Số lô -->
                    <div class="mb-3">
                        <label class="form-label">Chọn số lô</label>
                        <select multiple class="form-select excel-lot-select" id="SoLo_Export">
                        </select>
                    </div>

                    <!-- Loại xuất -->
                    <div class="mb-2">
                        <label class="form-label d-block mb-2">Xuất theo:</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input excel-radio" type="radio" name="excelExportType" id="xuatHQ" value="HaiQuan" checked>
                            <label class="form-check-label" for="xuatHQ">Hải Quan</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input excel-radio" type="radio" name="excelExportType" id="xuatTT" value="ThucTe">
                            <label class="form-check-label" for="xuatTT">Thực Tế</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer justify-content-between px-4 pb-3">
                    <button type="button" class="btn btn-outline-secondary btn-cancel-export" data-dismiss="modal">
                        <i class="fa-solid fa-ban" style="margin-right:5px"></i> Hủy
                    </button>
                    <button type="button" class="btn btn-success btn-confirm-excel">
                        <span class="spinner-border spinner-border-sm d-none me-2" role="status"></span>
                        <i class="fa-solid fa-file-export me-1" style="margin-right:5px"></i>Xuất Excel
                    </button>
                </div>
            </div>
        </div>
    </div>



