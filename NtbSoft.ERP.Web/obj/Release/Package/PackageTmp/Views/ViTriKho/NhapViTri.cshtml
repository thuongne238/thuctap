                $('#startScanBtn').show();
                $('#stopScanBtn').hide();
                lastScannedCode = '';
            }
        });

        function initScanner() {
            const videoElem = document.getElementById('video-preview');
            QrScanner.WORKER_PATH = '/Scripts/qr-scanner-worker.min.js';

            qrScanner = new QrScanner(
                videoElem,
                result => onScanSuccess(result),
                {
                    returnDetailedScanResult: true,
                    highlightScanRegion: false,
                    highlightCodeOutline: false,
                    maxScansPerSecond: 10,
                    preferredCamera: 'environment'
                }
            );
        }

        function onScanSuccess(result) {
            const currentTime = Date.now();
            const timeDiff = currentTime - lastScannedTime;
            const barcode = result.data;

            if (isProcessing || timeDiff < 1000 || barcode === lastScannedCode) {
                return;
            }

            isProcessing = true;
            lastScannedTime = currentTime;
            lastScannedCode = barcode;


            playSuccessSound();
            if (navigator.vibrate) {
                navigator.vibrate(200);
            }
            const isModal1Visible = $('#itemDetailModal').is(':visible');
            const isModal2Visible = $('#moveItemModal').is(':visible');
            if (window.scannerSource == 'detail') {
                GetVTBarCode(barcode).then(() => {
                    setTimeout(() => {
                        isProcessing = false;

                    }, 100)
                });

            } else {
                if (isModal1Visible) {
                    const currentMode = getScanMode();
                    if (currentMode == 'import') {
                        searchBarcode(barcode, 1).then(() => {

                            setTimeout(() => {
                                isProcessing = false;

                            }, 1000);
                        });
                    } else {
                        findAndCheckBarcode2(barcode).then(() => {

                            setTimeout(() => {
                                isProcessing = false;

                            }, 1000);
                        });
                    }


                }
                // Ngược lại nếu modal2 đang ẨN → điều kiện 2
                else if (isModal2Visible) {
                    searchBarcodeInMoveModal(barcode, "left").then(() => {
                        setTimeout(() => {
                            isProcessing = false;
                        }, 1000);
                    });
                }
            }


        }

        function showScanStatus(message, type) {
            const statusElement = $('#scanStatus');
            statusElement.text(message);
            statusElement.removeClass().addClass(`status text-${type === 'success' ? 'success' : type === 'error' ? 'danger' : 'info'}`);
        }



        // Bắt đầu quét
        $('#startScanBtn').on('click', async function () {
            try {
                $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Đang khởi động...');
                await qrScanner.start();
                $(this).hide();
                $('#stopScanBtn').show();
                $(this).prop('disabled', false).html('<i class="bi bi-play-circle"></i> Bắt đầu quét');
                //showScanStatus('🔍 Đang quét... Đưa mã barcode vào khung', 'info');
                lastScannedCode = '';
            } catch (err) {
                $(this).prop('disabled', false).html('<i class="bi bi-play-circle"></i> Bắt đầu quét');
                //showScanStatus('❌ Không thể truy cập camera. Vui lòng cho phép quyền!', 'error');
                console.error('Lỗi camera:', err);
            }
        });

        // Dừng quét
        $('#stopScanBtn').on('click', function () {
            qrScanner.stop();
            $(this).hide();
            $('#startScanBtn').show();
            //showScanStatus('⏸️ Đã dừng quét', 'error');
            lastScannedCode = '';
        });

        // Mở modal scanner
        $('#openScannerBtn,#openScannerBtnMove').on('click', function () {
            window.scannerSource = '';
            const scannerModal = new bootstrap.Modal($('#scannerModal')[0]);
            scannerModal.show();
        });

        // Xử lý tìm kiếm barcode từ button
        $('#searchBarcodeBtn').on('click', function () {
            const barcode = $('#barcodeInput').val().trim();
            if (barcode) {
                const currentMode = getScanMode();
                if (currentMode == 'import') {
                    searchBarcode(barcode);
                } else {
                    findAndCheckBarcode(barcode)
                }
                $('#barcodeInput').val("")

            } else {
                showToast('warning', 'Vui lòng nhập mã barcode!');
            }
        });

        // Xử lý Enter trong ô input
        $('#barcodeInput').on('keypress', function (e) {
            if (e.which === 13) {
                const barcode = $(this).val().trim();
                if (barcode) {
                    searchBarcode(barcode);
                    $('#barcodeInput').val("")
                }
            }
        });

        // Hàm tìm kiếm barcode và kiểm tra CBM
        async function searchBarcode(barcode, value) {
            try {

                const dataSave = await GetRollNK(barcode)
                if (dataSave.Table.length == 0) {
                    showToast('warning', ' Không tìm thấy barcode trong danh sách!');
                    PlayAudioError();
                    return false;
                }
                const foundItem = dataSave.Table[0].Barcode;
                const cbmSearch = dataSave.Table[0].CBM;
                const soCay = dataSave.Table[0].SoKienHienThi;


                // Kiểm tra CBM
                const itemCBM = parseFloat(cbmSearch) || 0;
                const sucChuaConLai = parseFloat(window.succhuaOCL || 0);
                if (itemCBM == 0) {
                    showToast('warning', '❌ Vui lòng nhập CBM cho vật tư này!!');
                    PlayAudioError();
                    return false;
                }

                if (itemCBM > sucChuaConLai) {
                    const message = `⚠️ CẢNH BÁO: vật tư "${soCay}" có CBM ${itemCBM.toFixed(2)}  > Sức chứa còn lại ${sucChuaConLai.toFixed(2)} . Không đủ chỗ chứa!`;

                    showToast('warning', message, 3000);
                    PlayAudioError();


                    return false;
                } else {
                    if (dataSave.Table[0].MaONPL != "") {
                        showToast('warning', `Vật tư này đã được nhập vào ô ${dataSave.Table[0].MaONPL} !!`);
                        PlayAudioError();
                    } else {
                        if (value == 1) {
                            arrHistoryBarCode.push(dataSave.Table[0])
                            getBarCodeScan(arrHistoryBarCode, barcode)
                        }

                        SaveCBMNPL(dataSave)
                    }
                    return true;
                }

            } catch (error) {
                console.error('Lỗi tìm kiếm:', error);
                showToast('warning', "Lỗi khi kiểm tra barcode");
                PlayAudioError();
                return false;
            }
        }

        function getBarCodeScan(result, itembarcode) {
            const itemScan = result.find(x => x.Barcode == itembarcode)
            setTextAndTitle("#txtPoMua", itemScan.POMua);
            setTextAndTitle("#txtLotBatch", `${itemScan.LOTBATCH}`);
            setTextAndTitle("#txtItemCode", itemScan.MaVT);
            setTextAndTitle("#txtRoll", itemScan.SoKienHienThi);
            setTextAndTitle("#txtCBM", itemScan.CBM);

            createViewDxGridDetailsContainer(result)
        }

        function setTextAndTitle(selector, value) {
            $(selector).text(value ?? "").attr("title", value ?? "");
        }
        function createViewDxGridDetailsContainer(data) {

            $("#dxLichSuQuet").dxDataGrid({
                dataSource: data,
                noDataText: "Chưa có dữ liệu",
                columnAutoWidth: false,
                allowColumnResizing: false,
                columnHidingEnabled: false,
                wordWrapEnabled: true,
                showRowLines: true,
                showBorders: true,
                noDataText: "",
                scrolling: { mode: 'standard' },
                filterRow: { visible: true },
                headerFilter: { visible: false },
                paging: {
                    enabled: false
                },
                renderAsync: false,
                grouping: { autoExpandAll: true },
                groupPanel: { visible: false },
                loadPanel: {
                    enabled: true,
                    text: "Đang tải dữ liệu...",
                    showIndicator: true,
                    showPane: true
                },
                columns: [
                    {
                        dataField: "POMua",
                        caption: "PO Mua",
                        width: 100,
                    },
                    {
                        caption: "LOT/Batch",
                        dataField: "LOTBATCH",
                        width: 120,
                    },
                    {
                        dataField: "MaVT",
                        caption: "Item Code",
                        width: 90,
                    },
                    {
                        dataField: "SoKienHienThi",
                        caption: "Vật tu",
                        minWidth: 80,
                        width: 140,
                    },
                    {
                        dataField: "CBM",
                        caption: "CBM",
                        width: 80,
                        calculateCellValue: function (row) {
                            return parseFloat(parseFloat(row.CBM || 0).toFixed(2));
                        }
                    },

                ],
                onCellPrepared: function (e) {
                    if (e.rowType === "header") {
                        $(e.cellElement).addClass("col-header");
                        $(e.cellElement).addClass("text-center");
                        $(e.cellElement).css("vertical-align", "middle");

                    }
                    if (e.rowType === "data") {
                        $(e.cellElement).addClass("text-center");
                        $(e.cellElement).css("vertical-align", "middle");
                    }
                },
            });

        }
        async function SaveCBMNPL(data) {
            var arr = []
            let SoLo = data.Table[0].SoLoID;
            let npl = data.Table[0].MaNPL;
            let mavtG = data.Table[0].MaVTGhep;
            const barcode = data.Table[0].Barcode;
            let object = {
                ID: 0,
                SoLoID: SoLo,
                MaNPL: npl,
                MaVTGhep: maONPLID,
                BarCode: barcode,
                Dai: 0,
                Rong: 0,
                Cao: 0,
                DK: 0,
                CBM: 0,
                IsNPL: data.Table[0].IsNPL,
                IsCBM: 0,
                MaONPL: solotIDBarCode,
            };
            arr.push(object)
            await SaveONPL(arr, true)
            PlayAudio()
            await loadVTKho()
        }
    </script>
