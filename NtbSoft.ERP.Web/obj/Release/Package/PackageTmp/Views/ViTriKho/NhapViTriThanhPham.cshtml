    <script>
        var userName = '@ViewBag.userName';
    </script>
    <script type="module">

        import QrScanner from '/Scripts/qrcodenew.js';
        let qrScanner;
        let isProcessing = false;
        let lastScannedTime = 0;
        let lastScannedCode = '';


        // Khởi tạo scanner khi mở modal
        $('#scannerModal').on('shown.bs.modal', function () {
            initScanner();
        });

        // Dừng scanner khi đóng modal
        $('#scannerModal').on('hidden.bs.modal', function () {
            if (qrScanner) {
                qrScanner.stop();
                $('#startScanBtn').show();
                $('#stopScanBtn').hide();
                $('#scanResultContainer').hide();
                lastScannedCode = '';
            }
        });

        function initScanner() {
            const videoElem = document.getElementById('video-preview');
            QrScanner.WORKER_PATH = '/Scripts/qr-scanner-worker.min.js';

            qrScanner = new QrScanner(
                videoElem,
                result => onScanSuccess(result),
                {
                    returnDetailedScanResult: true,
                    highlightScanRegion: false,
                    highlightCodeOutline: false,
                    maxScansPerSecond: 10,
                    preferredCamera: 'environment'
                }
            );
        }

        function onScanSuccess(result) {
            const currentTime = Date.now();
            const timeDiff = currentTime - lastScannedTime;
            const barcode = result.data;

            if (isProcessing || timeDiff < 1000 || barcode === lastScannedCode) {
                return;
            }

            isProcessing = true;
            lastScannedTime = currentTime;
            lastScannedCode = barcode;

            $('#scanResult').text(barcode);
            $('#scanResultContainer').show();

            playSuccessSound();
            if (navigator.vibrate) {
                navigator.vibrate(200);
            }
            const isModal1Visible = $('#itemDetailModal').is(':visible');
            const isModal2Visible = $('#moveItemModal').is(':visible');
            if (isModal1Visible) {
                searchBarcode(barcode).then(() => {
                    setTimeout(() => {
                        isProcessing = false;
                        //    showScanStatus('🔍 Đang quét... Đưa mã barcode vào khung', 'info');
                    }, 1000);
                });
            }
            // Ngược lại nếu modal2 đang ẨN → điều kiện 2
            else if (isModal2Visible) {
                searchBarcodeInMoveModal(barcode, "left").then(() => {
                    setTimeout(() => {
                        isProcessing = false;
                    }, 1000);
                });
            }

        }

        function showScanStatus(message, type) {
            const statusElement = $('#scanStatus');
            statusElement.text(message);
            statusElement.removeClass().addClass(`status text-${type === 'success' ? 'success' : type === 'error' ? 'danger' : 'info'}`);
        }



        // Bắt đầu quét
        $('#startScanBtn').on('click', async function () {
            try {
                $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Đang khởi động...');
                await qrScanner.start();
                $(this).hide();
                $('#stopScanBtn').show();
                $(this).prop('disabled', false).html('<i class="bi bi-play-circle"></i> Bắt đầu quét');
                lastScannedCode = '';
            } catch (err) {
                $(this).prop('disabled', false).html('<i class="bi bi-play-circle"></i> Bắt đầu quét');
                console.error('Lỗi camera:', err);
            }
        });

        // Dừng quét
        $('#stopScanBtn').on('click', function () {
            qrScanner.stop();
            $(this).hide();
            $('#startScanBtn').show();
            lastScannedCode = '';
        });

        // Mở modal scanner
        $('#openScannerBtn,#openScannerBtnMove').on('click', function () {
            const scannerModal = new bootstrap.Modal($('#scannerModal')[0]);
            scannerModal.show();
        });

        // Xử lý tìm kiếm barcode từ button
        $('#searchBarcodeBtn').on('click', function () {
            const barcode = $('#barcodeInput').val().trim();
            if (barcode) {

                searchBarcode(barcode);
                $('#barcodeInput').val("")

            } else {
                showToast('warning', 'Vui lòng nhập mã barcode!');
            }
        });

        // Xử lý Enter trong ô input
        $('#barcodeInput').on('keypress', function (e) {
            if (e.which === 13) {
                const barcode = $(this).val().trim();
                if (barcode) {
                    searchBarcode(barcode);
                    $('#barcodeInput').val("")
                }
            }
        });

        // Hàm tìm kiếm barcode và kiểm tra CBM
        async function searchBarcode(barcode) {

            const id = Number(barcode);
            if (!barcode) {
                const message = `⚠ CẢNH BÁO: barcode "${barcode}" không hợp lệ`;
                showToast('warning', message, 3000);
                PlayAudioError();
                return;
            }

            try {
                const dataSave = await GetRollNK(barcode)
                const foundItem = dataSave.Table1[0].qrscan;
                const cbmSearch = dataSave.Table1[0].CBM;
                const soThung = dataSave.Table1[0].SttThung;
                if (foundItem == null || foundItem == "") {
                    showToast('warning', ' Không tìm thấy barcode trong danh sách!');
                    PlayAudioError();
                    return false;
                }

                // Kiểm tra CBM
                const itemCBM = parseFloat(cbmSearch) || 0;
                const sucChuaConLai = parseFloat(window.succhuaOCL || 0);
                if (itemCBM == 0) {
                    showToast('warning', '❌ Vui lòng nhập CBM cho roll này!!');
                    PlayAudioError();
                    return false;
                }

                console.log("itemCBM: ", itemCBM)
                console.log("sucChuaConLai: ", sucChuaConLai)


                if (itemCBM > sucChuaConLai) {
                    const message = `⚠ CẢNH BÁO: Thùng "${soThung}" có CBM ${itemCBM.toFixed(2)}  > Sức chứa còn lại ${sucChuaConLai.toFixed(2)} . Không đủ chỗ chứa!`;
                    showToast('warning', message, 3000);
                    PlayAudioError();
                    return false;
                } else {
                    if (dataSave.Table.length > 0) {
                        showToast('warning', `⚠ Thùng này đã được nhập vào ô ${dataSave.Table[0].MaONPL} !!`);
                        PlayAudioError();
                    } else {
                        SaveCBMNPL(dataSave.Table1[0])
                    }

                    $("#txtStt").text(dataSave.Table1[0].SttThung);
                    $("#txtDH").text(dataSave.Table1[0].MaDH);
                    $("#txtPO").text(dataSave.Table1[0].POID);
                    $("#txtMaPKL").text(dataSave.Table1[0].MaPKL);
                    $("#txtSLSP").text(dataSave.Table1[0].SLSP);
                    lstDataLichSuQuet.push(dataSave.Table1[0]);

                    // ===== UPDATE GRID NGAY =====
                    dxGridLichSuQuet.beginUpdate();
                    dxGridLichSuQuet.option("dataSource", lstDataLichSuQuet);
                    dxGridLichSuQuet.endUpdate();
                    return true;
                }

            } catch (error) {
                showToast('warning', "Lỗi khi kiểm tra barcode");
                PlayAudioError();
                return false;
            }
        }
        async function GetRollNK(barcode) {
            const url = `/api/KeHoachXuatHangThanhPham/GetThanhPham?action=GetRollNK&para1=${barcode}`;
            try {
                const response = await fetch(url);
                if (!response.ok) throw new Error(`Response status: ${response.status} `);

                const data = await response.json();
                return data

            } catch (error) {
                console.error(error.message);
            }
        }

        async function SaveCBMNPL(data) {
            var arr = []
            let object = {
                MaDH: data.MaDH,
                MaGop: data.MaGop,
                MaPKL: data.MaPKL,
                PO: data.PO,
                POID: data.POID,
                ColorID: data.ColorID,
                TenMau: data.TenMau,
                DauSize: data.DauSize,
                DauSizeID: data.DauSizeID,
                SLSP: data.SLSP,
                SttThung: data.SttThung,
                CBM: data.CBM,
                MaONPL: solotIDBarCode,
                qrscan:1
            };
            arr.push(object)
            await SaveONPLThanhPham(arr, solotIDBarCode)
            PlayAudio()
            await GetOSugget()
            await loadVTKho()
        }
        $(document).on('click', '#itemDetailModal .btn-close', function (e) {

            $("#txtStt").empty()
            $("#txtDH").empty()
            $("#txtPO").empty()
            $("#txtMaPKL").empty()
            $("#txtSLSP").empty()

            lstDataLichSuQuet = []
            dxGridLichSuQuet.beginUpdate();
            dxGridLichSuQuet.option("dataSource", lstDataLichSuQuet);
            dxGridLichSuQuet.endUpdate();
        });


    </script>

</body>
</html>




