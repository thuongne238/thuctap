@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title></title>

    <link rel="stylesheet" href="~/Content/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="~/Content/plugins/select2/css/select2.min.css">
    <link rel="stylesheet" href="~/Content/plugins/select2-bootstrap4-theme/select2-bootstrap4.min.css">
    <link href="~/css/NguyenPhuLieu/mon.css" rel="stylesheet" />
    <link href="~/css/Toast/Toast.css" rel="stylesheet" />
    <link href="~/css/NguyenPhuLieu/other.css" rel="stylesheet" />
    <link href="~/Content/plugins/daterangepicker/daterangepicker.css" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/plugins/fontawesome-free/css/all.min.css">
    <link href="~/css/Sign/Sign.css" rel="stylesheet" />
    <style>
        .highlight {
            background-color: #17a2b8 !important;
            color: white;
        }

        html {
            overflow: auto;
        }

        .table thead th {
            border-bottom: none !important;
            padding: 8px 10px !important;
            font-size: 13px !important;
            /* background: #dee2e6 !important;*/
            background: #3d9970 !important;
            color: white !important;
            border: 1px solid #c1c1c1 !important;
        }

        .table td {
            padding: 2px 10px !important;
            font-size: 14px !important;
        }

        .view {
            margin: auto;
            width: 100%;
            max-height: calc(100vh - 400px);
            overflow: auto;
        }

        .wrapper {
            position: relative;
            overflow: auto;
            white-space: nowrap;
        }

        .sticky-col {
            position: -webkit-sticky;
            position: sticky;
            background-color: white;
            color: black
        }

        .first-col {
            width: 350px;
            min-width: 350px;
            max-width: 350px;
            left: 0px;
        }

        .second-col {
            width: 80px;
            min-width: 80px;
            max-width: 80px;
            left: 350px;
        }

        .second-col1 {
            width: 150px;
            min-width: 150px;
            max-width: 150px;
            left: 350px;
        }

        .third-col {
            width: 80px;
            min-width: 80px;
            max-width: 80px;
            left: 430px;
        }

        .third-col1 {
            width: 80px;
            min-width: 80px;
            max-width: 80px;
            left: 500px;
        }

        .four-col {
            width: 100px;
            min-width: 100px;
            max-width: 100px;
            left: 320px;
        }

        .col-form-label {
            color: #17a2b8 !important;
            font-size: 15px !important;
        }

        .form-control {
            text-align: center !important;
            font-size: 15px !important;
        }

        .is-active {
            background: blue;
            color: white;
        }

        .display {
            margin: -5px 0 0 0 !important;
        }

            .display .item_label {
                margin-right: 5px;
                white-space: nowrap;
            }

        .list_dothongso {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            margin: 0 8px;
            width: 50%;
        }

            .list_dothongso .item_dothongso {
                display: flex;
                justify-content: center;
                align-items: center;
                flex-direction: column;
                border: 1px solid #dee2e6;
                padding: 5px 0;
                background: #fff;
            }

                .list_dothongso .item_dothongso p {
                    margin-bottom: 5px !important;
                    font-weight: 600;
                    color: #016b69;
                }

                .list_dothongso .item_dothongso img {
                    width: 50%;
                    height: 100px;
                    display: flex;
                    justify-content: center;
                    align-items: center;
                }

        #signatureCanvas {
            border: 1px solid #ccc;
        }

            #signatureCanvas:hover {
                cursor: url('https://cur.cursors-4u.net/user/use-1/use151.cur'), auto;
            }

        .popup {
            width: 100%;
            height: 100vh;
            position: fixed;
            top: 0;
            background: rgba(0, 0, 0, 0.34);
            z-index: 99;
            display: none
        }

            .popup .list-popup {
                position: fixed;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                background-color: white;
                border: 1px solid black;
                padding: 20px;
            }

            .popup .tieude {
                font-size: 16px;
                color: #5a675a;
                font-weight: bold;
                border-bottom: 1px solid #000;
                margin-bottom: 6px;
                display: flex;
            }

            .popup .hide_popup {
                position: absolute;
                right: 4%;
                top: 0px;
                font-size: 35px;
                cursor: pointer;
                color: red;
            }

        .item-img {
            display: flex;
            position: relative;
        }

            .item-img .list-item {
                text-align: center;
                display: flex;
                flex-direction: column;
                margin-left: 17px;
                width: 180px;
            }

                .item-img .list-item .color {
                    margin-top: 85px;
                }

                .item-img .list-item #colorPicker {
                    width: 80px;
                    height: 32px;
                }

                .item-img .list-item .save_cancel {
                    position: absolute;
                    bottom: 2%;
                    display: flex;
                }

                    .item-img .list-item .save_cancel .clear {
                        border: 1px solid;
                        border-radius: 5px;
                        margin-right: 5px;
                        font-size: 20px;
                        background: #bbff84
                    }

                        .item-img .list-item .save_cancel .clear #clearButton {
                            border: none;
                            background: #bbff84;
                        }

                    .item-img .list-item .save_cancel .save {
                        border: 1px solid;
                        border-radius: 5px;
                        margin-right: 5px;
                        font-size: 20px;
                        background: #bbff84
                    }

                        .item-img .list-item .save_cancel .save #saveButton {
                            border: none;
                            background: #bbff84;
                        }

        .select2-results {
            text-align: center
        }

        .form-group .selection {
            text-align: center
        }

        /*.select2 {
            width: 80% !important;
        }
*/
        .item-table .table thead {
            position: sticky;
            top: 0;
            z-index: 3
        }

            .item-table .table thead tr {
                border: 1px solid;
                position: sticky;
                top: 0;
            }

                .item-table .table thead tr td {
                    border: 1px solid #c5c1c1 !important;
                    text-align: center;
                    font-weight: bold;
                    font-family: serif;
                    color: #fff;
                    vertical-align: middle;
                    background: #5da566;
                }

                    .item-table .table thead tr td .active {
                    }

        .item-table .table tbody {
        }

            .item-table .table tbody tr {
                border: 1px solid;
                height: 35px;
            }

                .item-table .table tbody tr td {
                    border: 1px solid #c5c1c1 !important;
                    text-align: center;
                    font-size: 15px;
                    font-family: roboto;
                    vertical-align: middle;
                }

                .item-table .table tbody tr .td-image {
                    max-width: 170px;
                    text-align: left;
                    min-width: 170px;
                }

                    .item-table .table tbody tr .td-image .image {
                        margin-right: 5px;
                        margin-bottom: 5px;
                        width: 42px;
                        height: 25px;
                    }

        ::-webkit-scrollbar {
            width: 0px;
            height: 0px;
        }
        /* Chiều cao cho hộp select hiển thị */
        .select2-container .select2-selection--single {
            height: 38px; /* hoặc giá trị bạn muốn */
            line-height: 38px; /* để canh giữa văn bản */
            font-size: 13px;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            font-size: 13px;
            text-align: left !important;
        }
        /* Toàn bộ dropdown */
        .select2-container .select2-dropdown {
            font-size: 13px;
        }

        /* Từng option trong dropdown */
        .select2-container .select2-results__option {
            font-size: 13px;
            text-align: left;
        }
        /* Điều chỉnh vị trí của mũi tên dropdown nếu cần */
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 38px;
        }
    </style>
    <link rel="stylesheet" href="~/css/NguyenPhuLieu/main.css">
</head>
<body>
    <div class="content-wrapper">
        <section class="content">
            <div class="container-fluid">
                <div id="toast"></div>
                <div class="row">
                    <div class="col-12 border-bottom">
                        <div class="card card-default">
                            <div class="card-header bg-info">
                                <h3 class="card-title"> <a href="~/Home/DashBoard" style="color:white"><i class="fas fa-home" style="font-size:x-large;margin-right:5px"></i></a>Báo cáo phụ liệu</h3>
                                <div class="card-tools">
                                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                        <i class="fas fa-minus"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="card-body" style="padding:0px 0px 0px 5px">
                                <div class="row" style="border-radius:5px;margin:0px">
                                    <div class="col-3 col-md-3 col-lg-1">
                                        <div class="form-group display">
                                            <label class="col-form-label item_label" style="color:#17a2b8">Lọc</label>
                                            <select class="form-control inputEnLine" id="Loc" onchange="LocChange()" style="margin-bottom: 5px; padding: 1px; font-weight: bold; font-size: 13px !important;">
                                                <option value="Tuan">Tuần</option>
                                                <option value="MH">Mã Hàng</option>
                                                <option value="Ngay">Ngày</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-6 col-lg-3">
                                        <div class="form-group display">
                                            <label class="col-form-label item_label" style="color: white;display:block">Mã hàng</label>
                                            <select class="sLenhSX form-control inputEnLine" id="MaHang" onchange="MaHangChange()" style="margin-bottom:0px;padding:1px 1px 1px 1px;text-align:center;font-size:13px !important"></select>
                                        </div>
                                    </div>
                                    <div class="col-2 col-md-3 col-lg-1 list_tuan">
                                        <div class="form-group display">
                                            <label class="col-form-label item_label " style="color: white;display:block">Năm</label>
                                            <select class="form-control inputEnLine" id="Year" onchange="YearChange()" style="margin-bottom:5px;padding:1px 1px 1px 1px;text-align:center;font-size:13px !important"></select>

                                        </div>
                                    </div>
                                    <div class="col-2 col-md-3 col-lg-2 list_tuan">
                                        <div class="form-group display">
                                            <label class="col-form-label item_label" style="color: white;display:block">Tuần</label>
                                            <select class="form-control inputEnLine" id="Week" onchange="WeekChange()" style="margin-bottom:5px;padding:1px 1px 1px 1px;text-align:center;font-size:13px !important"></select>

                                        </div>
                                    </div>
                                    <div class="col-3 col-md-3 col-lg-2 ngay" style="display:none">
                                        <div class="form-group display">
                                            <label class="col-form-label item_label" style="color:#17a2b8">Ngày</label>
                                            <div>
                                                <div class="input-group ">
                                                    <div class="input-group-prepend">
                                                        <span class="input-group-text">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </div>
                                                    <input type="text" readonly style="background:white" onchange="NgayChange()" class="form-control float-right" id="Ngay">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-3 col-md-3 col-lg-2">
                                        <div class="form-group display">
                                            <label class="col-form-label item_label" style="color: white;display:block">Khách hàng</label>
                                            <input type="text" class="form-control inputEnLine" readonly style="background:white !important" id="KhachHang">
                                        </div>
                                    </div>
                                    <div class="col-2 col-lg-2 col-xl-2" style="display:flex;justify-content: end;margin-top: 30px;">
                                        <div class="form-group display excel" style="display: flex; align-items: center; justify-content: right;">
                                            <span style="text-align:center;margin:2px 0px 0px 0px;float:right"><button class="btn btn-block bg-warning" id="btnExport" style="width:100px;height:32px"><i class="fas fa-file-excel"></i> Excel</button></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="card card-primary">
                            <div class="card-header bg-info">
                                <h3 class="card-title"><i class="fas fa-table"></i>   Thống kê kiểm phụ liệu</h3>
                                <div class="card-tools">
                                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                        <i class="fas fa-minus"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="card-body" style="padding:10px 0px 0px">
                                <div class="view">
                                    <div class="item-table">
                                        <table class="table table-bordered" style="position: relative">
                                            <thead class="">
                                                <tr>
                                                    <th rowspan="2">STT</th>
                                                    <th rowspan="2">Tên phụ liệu </th>
                                                    <th rowspan="2">Qui cách</th>
                                                    <th rowspan="2">Unit</th>
                                                    <th colspan="3">Kiểm số lượng</th>
                                                    <th colspan="3">Kiểm C.Lượng</th>
                                                    <th rowspan="2">Loại lỗi</th>
                                                    <th rowspan="2">Kết quả</th>
                                                </tr>
                                                <tr>
                                                    <th>SL theo C.từ</th>
                                                    <th>SL thực tế</th>
                                                    <th>Balance</th>
                                                    <th>SL kiểm (10%)</th>
                                                    <th>SL lỗi</th>
                                                    <th>% lỗi</th>
                                                </tr>
                                            </thead>
                                            <tbody id="BodyListChecked">
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <label> Ghi chú:</label>
                        <span id="GhiChu"> </span>
                    </div>
                </div>

            </div>

        </section>
        <div class="col-12  border-top" id="FormSign" style="margin:20px 0px">
            <div class="row">
                <div style="width:50%" class="border-right">
                    <span style="display: block; text-align: center">Phụ trách đơn vị</span>
                    <div style="display:flex;justify-content:center"><img onclick="CallModal('SignManager')" id="SignManager" style="height:100px;width:100px"></div>
                </div>
                <div style="width:50%" class="border-right">
                    <span style="display: block; text-align: center">NV kiểm</span>
                    <div style="display:flex;justify-content:center"><img onclick="CallModal('SignNVKiem')" id="SignNVKiem" style="height:100px;width:100px"></div>
                </div>
            </div>
        </div>
        <div class="modal fade" id="ModalSign" style="" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered" role="document" style="max-width: 900px !important;">
                <div class="modal-content">
                    <div class="modal-body" style="display:flex">
                        <section class="tools-board">
                            <div class="row">

                            </div>
                            <div class="row">
                                <label class="title">Kí tên</label>
                                <ul class="options" style="margin:20px 0px 0px 0px">
                                    <li class="option active tool" id="brush">
                                        <img src="icons/brush.svg" alt="">
                                        <span>Nét chữ</span>
                                    </li>
                                    <li class="option" style="margin:20px 0px 0px 0px">
                                        <input type="range" id="size-slider" min="1" max="30" value="5">
                                    </li>
                                </ul>
                            </div>
                            <div class="row colors">
                                <label class="title">Colors</label>
                                <ul class="options">
                                    <li class="option"></li>
                                    <li class="option selected"></li>
                                    <li class="option"></li>
                                    <li class="option"></li>
                                    <li class="option">
                                        <input type="color" id="color-picker" value="#4A98F7">
                                    </li>
                                </ul>
                            </div>
                            <div class="row buttons" style="margin-top:70px">
                                <button class="clear-canvas">Xóa</button>
                                <button class="save-img">Lưu</button>
                            </div>
                        </section>
                        <section class="drawing-board" style="border:1px black solid">
                            <canvas></canvas>
                        </section>
                    </div>


                </div>
            </div>
        </div>
        <div class="popup">
            <div class="list-popup">
                <div class="tieude">

                </div>
                <div class="hide_popup">
                    <i class="fa-sharp fa-solid fa-xmark"></i>
                </div>
                <div style="display: flex; justify-content: center; align-items: center;">
                    <div class="item-img">
                        <canvas id="signatureCanvas" width="400" height="300" style="touch-action: none;"></canvas>
                        <div class="list-item">
                            <div class="color">
                                <ul class="option" style=" list-style: none; margin: 0; padding: 0;">
                                    <li>
                                        <input type="range" id="size-slider" min="1" max="30" value="5">
                                    </li>
                                </ul>
                                <input type="color" id="colorPicker" value="#000000">
                            </div>
                            <div class="save_cancel">
                                <div class="clear">
                                    <i style="padding-left: 3px;" class="fa-duotone fa-eraser"></i>
                                    <button id="clearButton">Clear</button>
                                </div>
                                <div class="save">
                                    <i style="padding-left: 3px;" class="fa-duotone fa-floppy-disk"></i>
                                    <button id="saveButton">Save</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/Scripts/jquery.min-3.6.1.js"></script>
    <script src="~/Content/plugins/moment/moment.min.js"></script>
    <script src="/Content/js/core/utils.js"></script>
    <script src="/Content/js/core/common.js"></script>
    <script src="/Content/js/core/knockout-2.2.1.debug.js"></script>
    <script src="/Content/js/core/knockout.mapping-2.4.1.debug.js"></script>
    <script src="/Content/js/core/knockout.bindings.js"></script>
    <script src="~/Scripts/Toast/Toast.js"></script>
    <script src="~/Content/plugins/select2/js/select2.full.min.js"></script>
    <script src="~/Content/plugins/daterangepicker/daterangepicker.js"></script>
    <script src="~/Content/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Content/plugins/bootstrap/js/bootstrap.min.js"></script>
    <script src="~/Content/dist/js/adminlte.min.js"></script>
    <script type="text/javascript">
        var NgayLV = localStorage.getItem('NgayLV');
        $("#Ngay").attr('value', NgayLV);
        window['Ngay'] = $('#Ngay').daterangepicker({
            singleDatePicker: true,
            showDropdowns: true,
            locale: {
                format: 'DD-MM-YYYY'
            }
        });
        var Module = 1;
    </script>
    <script>
        $('.sLenhSX').select2();
    </script>
    <script src="~/Scripts/Sign/Sign.js"></script>
    <script src="~/Scripts/NguyenPhuLieu/BCPhuLieu.js"></script>
</body>
</html>
