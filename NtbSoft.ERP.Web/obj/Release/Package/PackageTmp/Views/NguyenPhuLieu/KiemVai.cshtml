    <style>
        .table-responsive {
            display: table;
        }

        .selectedLi {
            background: #00C6F0 !important;
            border-radius: 7px;
        }

        .forecolorSelected {
            color: white !important;
        }

        li a:focus {
            background: #00C6F0;
        }

        .table-filter-container {
            text-align: right;
        }

        table, th, td {
            border: 1px ridge;
            border-collapse: collapse;
            text-align: center;
        }

        .custom-table > tbody {
            display: block;
            overflow: auto;
        }

            .custom-table > thead, .custom-table > tbody tr {
                display: table;
                width: 100%;
            }

        .custom-table > thead {
            width: 100%
        }

        .custom-table {
            width: 100%;
        }

        .button-fix {
            margin: 0px 10px !important;
            width: 118px !important;
            height: 40px !important;
        }

        .button-table {
            margin: 0px 20px !important;
            background-color: transparent !important;
            height: 40px !important;
            padding: 2px 5px !important;
        }

        .nhomloi::-webkit-scrollbar {
            display: none;
        }

        .child-nhomloi::-webkit-scrollbar {
            display: none;
        }

        .form-group {
            margin: 0rem 0rem 0.2rem 0rem !important;
        }

        .inputEnLine {
            text-align: center;
            font-size: 0.8rem !important;
            background-color: white !important;
            height: 1.7rem !important;
            font-weight: bold !important;
            padding: 0.125rem !important
        }

        .labelHeader {
            color: white;
            font-size: 0.8rem;
            margin-bottom: 0.1rem;
        }

        .textHeader {
            color: black;
            font-size: 0.8rem;
        }

        .card {
            margin-bottom: 0.4rem !important;
        }

        .js-width::-webkit-scrollbar {
            display: none;
        }

        .canhbaoloi::-webkit-scrollbar {
            display: none;
        }

        .set-height {
            height: calc(100vh - 400px);
        }

        /**/
        .sidebar-mini.sidebar-collapse .wrapper .content-wrapper {
            margin-left: 0 !important;
        }

        .main-sidebar, .sidebar-collapse .wrapper .main-sidebar::before {
            margin-left: -250px !important;
        }

        .sidebar-open .main-sidebar, .sidebar-collapse .wrapper .main-sidebar::before {
            margin-left: 0 !important;
        }

        body:not(.sidebar-mini-md):not(.sidebar-mini-xs):not(.layout-top-nav) .content-wrapper {
            margin-left: 0 !important;
        }

        body:not(.sidebar-mini-md):not(.sidebar-mini-xs):not(.layout-top-nav) .main-header {
            margin-left: 0 !important;
        }

        .sidebar-open #sidebar-overlay {
            display: block;
        }

        .sidebar-mini.sidebar-collapse .wrapper .main-footer {
            margin-left: 0 !important;
        }

        .check-IsQC.is-none {
            display: none;
        }

        /* Chrome, Safari, Edge, Opera */
        input::-webkit-outer-spin-button,
        input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        /* Firefox */
        input[type=number] {
            -moz-appearance: textfield;
        }

        /*-------------*/
        .box-error {
            position: absolute;
            right: 0;
            /* width: 100px; */
            /* display: none; */
            background: white;
            top: 40px;
            transition: 1s;
            margin-right: 5px;
        }

            .box-error.is-hide {
                transform: translateX(100%);
                margin-right: 0px;
            }

        .nav-item.nav-item--1 {
            position: absolute;
            right: 7px;
            top: 0;
            /*background: red;*/
        }

        .col-cus {
            padding-right: 2px !important;
        }

        .btn-CongDoan {
            width: 48% !important;
            display: inline !important;
            margin: 2px;
            box-sizing: border-box;
            color: black;
            background: linear-gradient(to bottom,#ffffff 0,#eeeeee 100%)
        }

        .btn-group-lg > .btn, .btn-lg {
            font-size: 1rem !important;
            padding: 0.2rem 0.1rem !important;
        }

        .item-MaLoi {
            min-height: 55px !important;
            font-weight: bold !important;
            width: 55px !important;
            /*background-color: #15979bf0 !important;
            color: white !important;*/
            margin: 0px 5px 5px 0px !important;
            display: flex !important;
            justify-content: center !important;
            align-items: center !important;
            cursor: pointer !important
        }

        .p-motaloi {
            margin-bottom: 0px !important;
            font-size: 1rem !important;
            word-wrap: break-word;
            white-space: pre-wrap;
        }

        h6 {
            font-size: 0.75rem !important;
            margin-bottom: 0.1rem !important;
        }

        .btn-outline-primary:hover {
            background: #007bff;
            color: white !important;
        }
        /*.btn-CongDoan:focus{
            background:red;
        }*/
        .btn-outline-primary {
            color: black !important;
            /*border-color: #007bff;*/
        }

        #DSNhomLoi button.is-active {
            background: #007bff;
            color: #fff !important;
        }

        .ErrorImage {
            height: 35px;
            width: 35px;
            margin-right: 2px;
        }

        .labelHT {
            margin-right: 5px;
        }

        .lblValueHT {
            color: red;
        }

        .daterangepicker .calendar-table table {
            display: grid !important;
        }

        .select2-selection__rendered {
            line-height: 25px !important;
            font-size: 12px !important;
            font-weight: bold !important;
        }

        .select2-container .select2-selection--single {
            height: 100% !important;
            padding: 0rem 0.75rem !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            margin-top: 0px !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 80% !important;
        }

        #select2-MaHang-results li {
            font-size: 12px;
        }

        /* .select2-search__field {
            display: none;
        }*/

        .select2-search.select2-search--dropdown [ aria-controls = "select2-MaHang-results"] {
            display: block;
        }

        .select2-container--default .select2-results > .select2-results__options {
            max-height: 60vh !important;
            overflow-y: auto;
        }

        .class-PhuLieu, .DiemLoi {
            height: 20px;
            width: 20px
        }

        .classFocusVT {
            background: #007bff;
            color: white;
        }

        .table td {
            vertical-align: middle !important;
        }

        .select2-results__option {
            font-size: 12px !important;
        }

        .select2-container {
            height: 27px !important;
        }

        .input-CheckList {
            width: 100%;
            height: 100% !important;
            text-align: center;
            border: none;
        }
        /*-------------*/
    </style>
    <link rel="stylesheet" href="~/css/NguyenPhuLieu/main.css">
