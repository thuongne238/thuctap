            top: 40px;
            transition: 1s;
            margin-right: 5px;
        }

            .box-error.is-hide {
                transform: translateX(100%);
                margin-right: 0px;
            }

        .nav-item.nav-item--1 {
            position: absolute;
            right: 7px;
            top: 0;
            /*background: red;*/
        }

        .col-cus {
            padding-right: 2px !important;
        }

        .btn-CongDoan {
