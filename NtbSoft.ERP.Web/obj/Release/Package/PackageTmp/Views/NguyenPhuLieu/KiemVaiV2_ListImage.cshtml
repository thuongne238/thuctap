                <div class="modal-header text-white" style="background: #5DA566;font-size:18px">
                    <h5 class="modal-title" id="modalNhapSoLuongLabel" style="font-size: 18px"></h5>
                    <button style="outline: none; border: 1px solid #ccc; border-radius: 5px; padding: 0px 10px; color: red;" type="button" class="btn-close btn-close-white" data-dismiss="modal" aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div class="modal-body">
                    <label for="soLuongInput" class="form-label fw-semibold itemLable">Số lượng</label>
                    <input type="number" class="form-control" id="soLuongInput" placeholder="" min="0">
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-success" id="btnLuuSoLuong" onclick="UpdateSLTT()">💾 Lưu</button>
                </div>

            </div>
        </div>
