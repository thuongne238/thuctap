            display: inline !important;
            margin: 2px;
            box-sizing: border-box;
            color: black;
            background: linear-gradient(to bottom,#ffffff 0,#eeeeee 100%)
        }

        .btn-group-lg > .btn, .btn-lg {
            font-size: 1rem !important;
            padding: 0.2rem 0.1rem !important;
        }

        .item-MaLoi {
