            font-weight: bold !important;
            width: 55px !important;
            /*background-color: #15979bf0 !important;
            color: white !important;*/
            margin: 0px 5px 5px 0px !important;
            display: flex !important;
            justify-content: center !important;
            align-items: center !important;
            cursor: pointer !important
        }

        .p-motaloi {
            margin-bottom: 0px !important;
            font-size: 1rem !important;
            word-wrap: break-word;
            white-space: pre-wrap;
        }

        h6 {
            font-size: 0.75rem !important;
            margin-bottom: 0.1rem !important;
        }

        .btn-outline-primary:hover {
            background: #007bff;
            color: white !important;
        }
        /*.btn-CongDoan:focus{
            background:red;
        }*/
        .btn-outline-primary {
            color: black !important;
            /*border-color: #007bff;*/
        }

        #DSNhomLoi button.is-active {
            background: #007bff;
            color: #fff !important;
        }

        .ErrorImage {
            height: 35px;
            width: 35px;
            margin-right: 2px;
        }

        .labelHT {
            margin-right: 5px;
        }

        .lblValueHT {
            color: red;
        }

        .daterangepicker .calendar-table table {
            display: grid !important;
        }

        .select2-selection__rendered {
            line-height: 25px !important;
            font-size: 12px !important;
            font-weight: bold !important;
        }

        .select2-container .select2-selection--single {
            height: 100% !important;
            padding: 0rem 0.15rem !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            margin-top: 0px !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 80% !important;
        }

        #select2-MaHang-results li {
            font-size: 12px;
        }

        /* .select2-search__field {
            display: none;
        }*/

        .select2-search.select2-search--dropdown [ aria-controls = "select2-MaHang-results"] {
            display: block;
        }

        .select2-container--default .select2-results > .select2-results__options {
            max-height: 60vh !important;
            overflow-y: auto;
        }

        .class-PhuLieu, .DiemLoi {
            height: 20px;
            width: 20px
        }

        .classFocusVT {
            background: #007bff;
            color: white;
        }

        .table td {
            vertical-align: middle !important;
        }

        .select2-results__option {
            font-size: 12px !important;
        }

        .select2-container {
            height: 27px !important;
        }

        .input-CheckList {
            width: 100%;
            height: 100% !important;
            text-align: center;
            border: none;
        }

        .item_text input[type="radio"] {
            width: 15px !important;
            height: 15px !important;
            cursor: pointer;
        }

        .div-radio label {
            font-size: 12px !important
        }

        input[name="weight"],
        input[name="shrinkage"],
        input[name="waterproof"],
        input[name="weight"] + label,
        input[name="shrinkage"] + label,
        input[name="waterproof"] + label {
            pointer-events: none !important;
            cursor: not-allowed;
        }

        .camera-image-container {
            width: 22px;
            height: 18px;
            border-radius: 0px
        }

        .image-list {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 6px;
            margin-top: 6px;
        }

        .image-item {
            position: relative;
            border: 1px solid #ddd;
            border-radius: 6px;
            overflow: hidden;
            background: #fff;
            margin-bottom: 2px
        }

            .image-item img {
                width: 100%;
                height: 70px;
                object-fit: cover;
                display: block;
                cursor: pointer;
            }

        .image-item-actions {
            display: flex;
            gap: 4px;
            padding: 4px;
        }

            .image-item-actions button {
                flex: 1;
                font-size: 11px;
                padding: 3px 4px;
            }

        .camera-image-container i {
            color: #999;
            font-size: 11px;
            position: absolute;
            top: 1px;
        }

        .image-note {
            width: 100%;
            min-height: 45px;
            border: none;
            border-top: 1px solid #ddd;
            padding: 1px;
            font-size: 9px;
            resize: vertical;
            outline: none;
            text-align: left;
        }

            .image-note:focus {
                border-top-color: #4CAF50;
                background: #f8fff8;
            }

        .preview-nav {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-top: 8px;
        }

        .preview-counter {
            min-width: 60px;
            text-align: center;
            font-weight: 600;
        }

        .image-preview {
            max-width: 100%;
            max-height: 330px;
            border-radius: 8px;
            object-fit: contain;
        }

        .preview-note-wrap {
            margin-top: 10px;
            width: 100%;
        }

        .preview-note-label {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .preview-image-note {
            font-size: 13px;
            resize: vertical;
            text-align: left;
        }

        button {
            padding: 6px !important
        }

        #cameraModal .modal-content {
            max-height: unset !important
        }

        ::-webkit-scrollbar {
            width: 8px !important;
        }

        #previewModal .modal-dialog {
            width: fit-content;
            max-width: 80vw !important;
            margin: 30px auto;
        }

        #previewModal .modal-content {
            width: fit-content;
            max-width: 80vw;
        }

        #previewModal .modal-body {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        #previewModal .image-preview {
            width: auto;
            height: auto;
            max-width: 100%;
            max-height: 80vh;
            object-fit: contain;
        }
        /*-------------*/
    </style>
