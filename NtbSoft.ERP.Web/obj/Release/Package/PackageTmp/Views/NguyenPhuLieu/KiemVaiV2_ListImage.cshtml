                                            <div class="form-group">
                                                <label class="labelHeader" for="exampleInputPassword1" style="text-align:center; color:White">Lọc</label>
                                                <select class="sLenhSX form-control inputEnLine select_2" id="changeViTri">
                                                    <option value="0">PO</option>
                                                    <option value="1">Vật Tư</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-5 col-md-3 col-lg-3 col-xl-2 col-cus">
                                            <div class="form-group">
                                                <label class="labelHeader" for="exampleInputPassword1" style="text-align:center; color:White">PO</label>
                                                <select class="sLenhSX form-control inputEnLine select_2" onchange="GetKhachHang()" id="SoLo"></select>
                                            </div>
                                        </div>
                                        <div class="col-5 col-md-3 col-lg-3 col-xl-2 col-cus">
