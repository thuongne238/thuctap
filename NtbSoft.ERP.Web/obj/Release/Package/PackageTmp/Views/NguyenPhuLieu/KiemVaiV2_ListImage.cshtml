    <div class="modal fade" id="modalDelete" tabindex="-1" aria-labelledby="modalNhapSoLuongLabel" aria-hidden="true" style="z-index:999999">
        <div class="modal-dialog modal-dialog" style=" display: flex; justify-content: center;">
            <div class="modal-content border-0 shadow-lg rounded-4">


                <div class="modal-header text-white" style="background: #5DA566;font-size:18px">
                    <h5 class="modal-title" id="modalDeleteLabel" style="font-size: 18px">Thông báo</h5>
                    <button style="outline: none; border: 1px solid #ccc; border-radius: 5px; padding: 0px 10px; color: red;" type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">

                    <p class="font-weight-bold text-danger mb-0">
                        <i class="fas fa-exclamation-triangle text-warning mb-3" style="font-size: 20px;"></i>
                        Bạn có chắc chắn muốn xóa hình này không?
                    </p>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-success" id="" onclick="ConfirmDelete()"> Xóa</button>
                </div>

            </div>
        </div>
    </div>
    <div class="modal fade" id="ModalSign" style="" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document" style="max-width: 900px !important;">
            <div class="modal-content">

                <div class="modal-body">
                    <div class="d-flex signItem">
                        <section class="tools-board">
                            <div class="row">

                            </div>
                            <div class="row">
                                <label class="title">Kí tên</label>
                                <ul class="options" style="margin:20px 0px 0px 0px">
                                    <li class="option active tool" id="brush">
                                        <img src="icons/brush.svg" alt="">
                                        <span>Nét chữ</span>
                                    </li>
                                    <li class="option" style="margin:20px 0px 0px 0px">
                                        <input type="range" id="size-slider" min="1" max="30" value="5">
                                    </li>
                                </ul>
                            </div>
                            <div class="row colors">
                                <label class="title">Colors</label>
                                <ul class="options">
                                    <li class="option"></li>
                                    <li class="option selected"></li>
                                    <li class="option"></li>
                                    <li class="option"></li>
                                    <li class="option">
                                        <input type="color" id="color-picker" value="#4A98F7">
                                    </li>
                                </ul>
                            </div>
                            <div class="row buttons" style="margin-top:70px">
                                <button class="clear-canvas">Xóa</button>
                                <button class="save-img">Lưu</button>

                            </div>

                        </section>
                        <section class="drawing-board" style="border:1px black solid">
                            <canvas></canvas>
                        </section>
                    </div>
                </div>


            </div>
        </div>
    </div>
    <!-- Toast Container -->

    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div id="successToast" class="toast" role="alert">
            <div class="toast-header bg-success text-white">
                <i class="fas fa-check-circle me-2"></i>
                <strong class="me-auto">Thành công</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="successMessage"></div>
        </div>
        <div id="errorToast" class="toast" role="alert">
            <div class="toast-header bg-danger text-white">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong class="me-auto">Lỗi</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="errorMessage"></div>
        </div>
        <div id="warningToast" class="toast" role="alert">
            <div class="toast-header bg-warning text-dark">
                <i class="fas fa-exclamation-circle me-2"></i>
                <strong class="me-auto">Cảnh báo</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="warningMessage"></div>
        </div>
    </div>
    <div class="modal fade" id="inputModal" tabindex="-1" role="dialog" aria-labelledby="inputModalLabel">
        <div class="modal-dialog" role="document" style="display: flex; justify-content: center;">
            <div class="modal-content">
                <div class="modal-header" style="background-color: #4CAF50; color: white;">
                    <h5 class="modal-title" id="inputModalLabel">Nhập dữ liệu</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true" style="color: white;">&times;</span>
                    </button>

                </div>
                <div class="modal-body">
                    <label id="modalFieldLabel" style=" margin-bottom: 10px; display: block; font-weight: normal;"></label>
                    <textarea id="modalTextarea" class="form-control text-left" rows="5" style="font-size: 16px; padding: 10px;"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success" id="btnConfirm">
                        <i class="fa fa-check"></i> Xác nhận
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="counterModal" tabindex="-1" role="dialog" aria-labelledby="counterModalLabel">
        <div class="modal-dialog" role="document" style="display: flex; justify-content: center;">
            <div class="modal-content">
                <div class="modal-header" style="background-color: #4CAF50; color: white;">
                    <h5 class="modal-title" id="counterModalLabel">Nhập số lượng lỗi</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true" style="color: white;">&times;</span>
                    </button>

                </div>
                <div class="modal-body">
                    <div style="margin-bottom: 15px;">
                        <strong id="counterDefectName" style="font-size: 16px; color: #333;"></strong>
                        <br>
                        <span id="counterDefectNameEn" style="font-size: 14px; color: #666; font-style: italic;"></span>
                        <br>
                        <span id="counterPointLabel" style="font-size: 14px; color: #4CAF50; font-weight: 600;"></span>
                    </div>
                    <label for="counterInput" style="font-weight: 600; margin-bottom: 10px;">Số lượng:</label>
                    <input type="number" id="counterInput" class="form-control" min="0"
                           style="font-size: 15px; padding: 15px; text-align: center">
                </div>
                <div class="modal-footer">

                    <button type="button" class="btn btn-success" id="btnCounterConfirm">
                        <i class="fa fa-check"></i> Xác nhận
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- Camera Modal -->
    <div id="cameraModal" class="modal">
        <div class="modal-content" style="max-width: 700px;">
            <div class="modal-header">
                <h3><i class="fas fa-camera"></i> Chụp Ảnh</h3>
                <button class="close-modal" onclick="closeCamera()">&times;</button>
            </div>
            <div class="modal-body modalCamera">
                <div class="camera-container">
                    <video id="video" autoplay playsinline></video>
                    <canvas id="canvas"></canvas>
                    <div class="button-group">
                        <button class="btn btn-primary" onclick="capturePhoto()">
                            <i class="fas fa-camera"></i> Chụp Ảnh
                        </button>
                        <button class="btn btn-primary" style="background: #17a2b8;" onclick="switchCamera()">
                            <i class="fas fa-sync-alt"></i> Xoay Camera
                        </button>
                        @*<button class="btn btn-secondary" onclick="closeCamera()">
                                <i class="fas fa-times"></i> Hủy
                            </button>*@
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Option Modal -->
    <div id="optionModal" class="modal">
        <div class="modal-content" style="max-width: 400px;">
            <div class="modal-header">
                <h3><i class="fas fa-images"></i> Chọn Nguồn Ảnh</h3>
                <button class="close-modal" onclick="closeOptionModal()">&times;</button>
            </div>
            <div class="modal-body">
                <div class="option-buttons optionSource" style="flex-direction: column;">
                    <button class="btn btn-primary" style="width: 100%;" onclick="openCamera()">
                        <i class="fas fa-camera"></i> Chụp Ảnh Từ Camera
                    </button>
                    <button class="btn btn-primary" style="width: 100%; background: #17a2b8;" onclick="selectFromGallery()">
                        <i class="fas fa-folder-open"></i> Chọn Từ Thư Viện
                    </button>
                    @*<button class="btn btn-secondary" style="width: 100%;" onclick="closeOptionModal()">
                            <i class="fas fa-times"></i> Hủy
                        </button>*@
                </div>
            </div>
        </div>
    </div>
    <!-- Hidden File Input -->
    <input type="file" id="fileInput" accept="image/*" style="display: none;">
    <div id="previewModal" class="modal">
        <div class="modal-dialog" role="document" style="max-width: 700px;">
            <div class="modal-content" style="padding:1px;border:none; border-radius:15px;">
                <div class="modal-header" style="background:#1e1e2e; color:#fff; border:none;">
                    <h6 class="modal-title"><i class="fas fa-image"></i> Xem Ảnh</h6>
                    <button class="close-modal" onclick="closePreview()" style="background:none; border:none; color:#fff; font-size:24px;">&times;</button>
                </div>
                <div class="modal-body" style="background: #1e1e2e; display: flex; flex-direction: column; align-items: center; gap: 8px; border-radius: 0px 0px 14px 14px;">

                    <!-- Toolbar -->
                    <div style="display:flex; gap:6px; flex-wrap:wrap; justify-content:center;">
                        <button class="btn btn-outline-secondary btn-sm" onclick="imgZoomIn()" title="Phóng to">
                            <i class="fas fa-search-plus"></i>
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" onclick="imgZoomOut()" title="Thu nhỏ">
                            <i class="fas fa-search-minus"></i>
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" onclick="imgResetTransform()" title="Mặc định">
                            <i class="fas fa-compress-arrows-alt"></i>
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" onclick="imgRotate(-90)" title="Xoay trái">
                            <i class="fas fa-undo"></i>
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" onclick="imgRotate(90)" title="Xoay phải">
                            <i class="fas fa-redo"></i>
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" onclick="imgFlip()" title="Lật dọc">
                            <i class="fas fa-arrows-alt-v"></i>
                        </button>
                    </div>

                    <!-- Viewport -->
                    <div id="imgViewport" style=" width: 100%; min-height: 300px; max-height: 65vh; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #111; border-radius: 8px; cursor: grab; min-width: 350px; min-height: 250px;">
                        <img id="previewImage" class="image-preview" src="" alt="Preview" style="
                        max-width:100%; max-height:60vh;
                        object-fit:contain; user-select:none;
                        transform-origin:center center;">
                    </div>

                    <!-- Nav -->
                    <div class="preview-nav" style="display:flex; align-items:center; justify-content:center; gap:12px;">
                        <button type="button" class="btn btn-secondary btn-sm" id="btnPreviewPrev" onclick="previewPrevImage()">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <span id="previewImageCounter" class="preview-counter" style="color:#ccc; font-weight:600; min-width:60px; text-align:center;">0/0</span>
                        <button type="button" class="btn btn-secondary btn-sm" id="btnPreviewNext" onclick="previewNextImage()">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>

                    <!-- Ghi chú -->
                    <div class="preview-note-wrap" style="display:flex; align-items:center; gap:5px; width:100%;">
                        <label class="preview-note-label" style="color:#aaa; white-space:nowrap; font-size:13px;">Ghi chú</label>
                        <textarea style="flex:1; min-height:30px; border-radius:5px; border:1px solid #444;
                        background:#2a2a3e; color:#fff; outline:none; padding:4px 8px; font-size:13px;"
                                  id="previewImageNote" class="preview-image-note" rows="1"
                                  oninput="updatePreviewImageNote(this.value)"></textarea>
                    </div>

                    <!-- Buttons -->
                    <div class="option-buttons" style="display:flex; gap:8px;">
                        <button class="btn btn-primary btn-sm d-none" onclick="retakePhoto()">
                            <i class="fas fa-camera"></i> Chụp Lại
                        </button>
                        <button class="btn btn-danger btn-sm" onclick="deletePhoto()">
                            <i class="fas fa-trash"></i> Xóa Ảnh
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="modalXacNhanXongLo" tabindex="-1" aria-labelledby="modalXacNhanXongLoLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">

                <!-- Header -->
                <div class="modal-header text-white" style="background-color: #BA7517;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <div>
                            <h5 class="modal-title mb-0" id="modalXacNhanXongLoLabel">Xác nhận hoàn thành</h5>
                            <small class="opacity-75">Hành động này không thể hoàn tác</small>
