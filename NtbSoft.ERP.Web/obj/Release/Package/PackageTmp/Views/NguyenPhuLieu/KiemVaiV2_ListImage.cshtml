                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <!-- Body -->
                <div class="modal-body">
                    <!-- Cảnh báo -->
                    <div class="alert alert-warning d-flex gap-2 align-items-start" role="alert">
                        <i class="bi bi-info-circle-fill mt-1 flex-shrink-0"></i>
                        <div class="small">
                            Sau khi xác nhận hoàn thành, ItemCode này sẽ <strong>không thể kiểm tra lại</strong>.
                            Vui lòng đảm bảo tất cả các roll/kiện đã được kiểm hoàn thành trước khi tiếp tục.
                        </div>
                    </div>
                </div>

                <!-- Footer -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Hủy bỏ
                    </button>
                    <button type="button" id="xacNhanHoanThanh" class="btn text-white" style="background-color: #BA7517;" onclick="">
                        <i class="bi bi-check-lg me-1"></i> Xác nhận hoàn thành
                    </button>
                </div>

            </div>
        </div>
    </div>
