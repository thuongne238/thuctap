                                                <label class="labelHeader" for="exampleInputPassword1" style="text-align:center; color:White">Mã vật tư</label>
                                                <select onchange="GetDot()" class="sLenhSX form-control inputEnLine" id="MauVai"></select>
                                            </div>
                                        </div>
                                        <div class="col-4 col-md-4 col-lg-4 col-xl-2 col-cus">
