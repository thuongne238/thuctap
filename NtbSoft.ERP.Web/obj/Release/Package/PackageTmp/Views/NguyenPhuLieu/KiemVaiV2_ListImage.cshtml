                                                <div style="margin-top: -4px;" class="btn-group-demo">
                                                    <button onclick="OpenImg()" style="background-color: #00e7ff; color: #000;" type="button" class="btn btn-success btn-sm">
                                                        <i class="fa-solid fa-abacus"></i> Xem công thức
                                                    </button>

                                                    <button onclick="SaveKiemVai()" id="btnLuu" style="background-color: #d2ff20; color: #000;" type="button" class="btn btn-success btn-sm">
                                                        <i class="fas fa-save"></i> Lưu
                                                    </button>

                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-5 col-md-4 col-lg-7 col-xl-3 col-cus ">
