                                                <input type="text" class="form-control float-right inputEnLine" readonly id="nhacungcap">
                                            </div>
                                        </div>

                                        <div class="col-4 col-md-4 col-lg-2 col-xl-1 col-cus">
                                            <div class="form-group">
                                                <label class="labelHeader" for="exampleInputPassword1" style="text-align:center; color:White">K.Hàng</label>
                                                <select class="sLenhSX form-control inputEnLine" onchange="GetMaHang()" id="KhachHang"></select>
                                            </div>
                                        </div>

                                        <div class="col-4 col-md-4 col-lg-2 col-xl-2 col-cus">
