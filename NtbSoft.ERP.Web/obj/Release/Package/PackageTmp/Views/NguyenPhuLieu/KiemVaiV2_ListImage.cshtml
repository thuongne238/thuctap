                                                <div style="margin-top: -4px;" class="btn-group-demo d-flex justify-content-end">
                                                    <button onclick="ConfirmLo()" id="btnConfirmLo" style="background-color: #d2ff20; color: #000;" type="button" class="btn btn-success btn-sm d-flex justify-content-center align-items-center gap-1">
                                                        <i class="fa-solid fa-check-double"></i>XN H.thành
                                                    </button>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
