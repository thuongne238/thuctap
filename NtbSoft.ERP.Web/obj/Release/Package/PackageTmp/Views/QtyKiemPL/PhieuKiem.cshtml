@{
    Layout = null;
    ViewBag.Title = "BB Kiểm Phụ Liệu";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BB Kiểm Phụ Liệu</title>

    <link rel="stylesheet" href="~/Content/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="~/Content/plugins/select2/css/select2.min.css">
    <link href="~/Content/plugins/daterangepicker/daterangepicker.css" rel="stylesheet">
    <link href="~/css/TheoDoiHangXuat/fontawesome.pro.6.0.0.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/Content/plugins/fontawesome-free/css/all.min.css">
    @*<link href="~/css/NguyenPhuLieu/Sign.css" rel="stylesheet" />*@
    <link href="~/Scripts/ViTriKho/bootstrap5.3.min.css" rel="stylesheet" />
    <link href="~/Content/plugins/DevExtreme/dx.light.css" rel="stylesheet" />
    <link href="~/Content/plugins/DevExtreme/dx.common.css" rel="stylesheet" />
    @*<script src="~/Scripts/NguyenPhuLieu/Sign.js"></script>*@
    <link href="~/css/QtyKiemPL/PhieuKiem.css" rel="stylesheet" />
</head>
<body>

    <div class="container-fluid">
        <div class="header-section sticky-top">
            <div class="container-fluid">
                <div class="header-content d-flex flex-wrap align-items-center justify-content-between gap-3 py-2">
                    <div class="d-flex align-items-center gap-3">
                        <a href="~/Home/DashBoard" class="text-white" id="home">
                            <i class="fas fa-home fa-lg"></i>
                        </a>
                        <h5 class="header-title mb-0 text-white">
                            ACCESSORY INSPECTION REPORT
                            <br />
                            <span class="d-block text-sm opacity-90">Báo Cáo Kiểm Tra Phụ Liệu</span>
                        </h5>
                    </div>

                    <div class="action-buttons d-flex flex-wrap gap-2 group-btn">
                        <button class="btn btn-custom btn-danger" id="btn-cancel">
                            <i class="fa-brands fa-cloudflare"></i> Cho phép kiểm lại
                        </button>
                        <button class="btn btn-custom btn-history" id="btn-history">
                            <i class="fas fa-history"></i> Lịch Sử
                        </button>
                        <button class="btn btn-custom btn-save" id="btn-save" onclick="SavePhieuWithValidation()">
                            <i class="fas fa-save"></i> Lưu
                        </button>
                        <button class="btn btn-custom btn-success btn-complete d-none" id="btn-complete">
                            <i class="fa-solid fa-box-check"></i> Hoàn thành
                        </button>
                        <button class="btn btn-custom btn-refresh" id="btn-refresh">
                            <i class="fas fa-sync-alt"></i> Nạp Lại
                        </button>
                    </div>
                </div>
            </div>
        </div>


    </div>
    <div class="main-card animate-in">
        <div style="padding:3px 15px;">
            <div class="row g-3">

                <div class="col-6 col-sm-4 col-md-3 col-lg-2 col-xl-1">
                    <label class="form-label-custom">
                        <i class="fas fa-filter me-1"></i>Lọc
                    </label>
                    <select class="form-control form-control-custom" id="filterTypeSelect">
                        <option value="PO">PO</option>
                        <option value="Items">Vật tư</option>
                        <option value="Supplier">Nhà cung cấp</option>
                    </select>
                </div>
                @*Kiểm theo vật tư -> Số lô *@
                <div class="col-8 col-sm-4 col-md-9 col-lg-6 kiem-vat-tu">
                    <div class="row">
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                            <label class="form-label-custom">
                                <i class="fas fa-tags me-1"></i>
                                Mã Vật Tư
                            </label>
                            <div class="input-group">
                                <input type="text" class="form-control form-control-custom" id="btn-chon-vat-tu" readonly placeholder="Chọn mã vật tư">
                                <button class="btn btn-outline-secondary d-none" type="button" data-bs-toggle="modal" data-bs-target="#plModalbyVatTu" id="select-kiem-by-vat-tu">
                                    Chọn
                                </button>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-8 col-lg-9 ">
                            <label class="form-label-custom">
                                <i class="fas fa-box me-1"></i>
                                Số PO
                            </label>
                            <select class="form-control form-control-custom" id="selectSoLobyVatTu">
                            </select>
                        </div>
                    </div>
                </div>
                <!-- PI NCC -->
                <div class="col-12 col-sm-12 col-md-8 col-lg-8 kiem-po container-so-po-kiem">
                    <label class="form-label-custom">
                        <i class="fas fa-box me-1"></i>
                        Số PO
                    </label>
                    <select class="form-control form-control-custom" id="selectSoLO">
                    </select>
                </div>


                <div class="col-12 col-sm-4 col-md-9 col-lg-6 kiem-vat-tu-nha-cc">
                    <div class="row">
                        <div class="col-12 col-sm-6 col-md-6 col-lg-6">
                            <label class="form-label-custom">
                                <i class="fas fa-building me-1"></i>
                                Nhà Cung Cấp
                            </label>
                            <select class="form-control form-control-custom" id="selectNhaCungCap">
                            </select>
                        </div>
                        <div class="col-12 col-sm-6 col-md-6 col-lg-6 ">
                            <label class="form-label-custom">
                                <i class="fas fa-box me-1"></i>
                                Số PO
                            </label>
                            <select class="form-control form-control-custom" id="selectSoLobyVatTuNhaCC">
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Nhà Cung Cấp -->
                <div class="col-12 col-sm-6 col-md-4 col-lg-3 txtNhaCC-Container">
                    <label class="form-label-custom">
                        <i class="fas fa-building me-1"></i>
                        Nhà Cung Cấp
                    </label>
                    <input type="text" class="form-control form-control-custom" id="txt-nha-cc" placeholder="Nhà cung cấp" disabled>
                </div>
                <!-- Khách Hàng -->
                <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                    <label class="form-label-custom">
                        <i class="fas fa-user-tie me-1"></i>
                        Khách Hàng
                    </label>
                    <input type="text" class="form-control form-control-custom" id="txt-khach-hang" placeholder="Khách hàng" disabled>
                </div>

                <!-- PL Kiểm -->


                <div class="col-12 col-sm-6 col-md-4 col-lg-3 kiem-po">
                    <label class="form-label-custom">
                        <i class="fas fa-tags me-1"></i>
                        Mã Vật Tư
                    </label>
                    <div class="input-group">
                        <input type="text" class="form-control form-control-custom" id="selectPL" readonly placeholder="Chọn mã vật tư">
                        <button class="btn btn-outline-secondary d-none" type="button" data-bs-toggle="modal" data-bs-target="#plModal" id="btn-chon-pl-kiem">
                            Chọn
                        </button>
                    </div>
                </div>


                <!-- Mô tả -->
                <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                    <label class="form-label-custom">
                        <i class="fa-sharp fa-solid fa-reel"></i> Mô Tả
                    </label>
                    <input type="text" class="form-control form-control-custom" id="txt-mo-ta-npl" placeholder="Mô tả" disabled>
                </div>
                <!-- Ngày Về Kho -->
                <div class="col-12 col-sm-4 col-md-3 col-lg-2">
                    <label class="form-label-custom">
                        <i class="fas fa-warehouse me-1"></i>
                        Ngày Về Kho
                    </label>
                    <input type="text" disabled class="form-control form-control-custom" id="ngay-nhap-kho" placeholder="Ngày nhập kho" readonly>
                </div>
                <div class="col-12 col-sm-2 col-md-2 col-lg-1 item-kiem-100-persents">
                    <label class="custom-checkbox xac-nhan-qc">
                        <input type="checkbox" id="check-kiem-100-persent">
                        <span class="checkmark"></span>
                        <span class="checkbox-label">Kiểm 100%</span>
                    </label>
                </div>
                <!-- Số Roll (Hidden) -->
                <div class="col-12 col-sm-2 col-md-2 col-lg-1 d-none">
                    <label class="form-label-custom">
                        <i class="fas fa-box me-1"></i>
                        Số Roll
                    </label>
                    <select class="form-control form-control-custom" id="selectSoRoll">
                        @*<option>Chọn số roll</option>*@
                    </select>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Grid Container -->
            <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12">
                <div class="grid-contianer">

                    <div id="grvPhuLieuKiem">

                    </div>

                </div>
            </div>
        </div>

    </div>



    <div class="container-danh-gia">
        <table class="danhgia-table">
            <thead>
                <tr>
                    <th>
                        <div style="display: flex; justify-content: flex-start; align-items: center; gap: 20px;">
                            <strong>Kết luận của QC/Conclusion</strong>
                            <div class="d-flex gap-3 align-items-center flex-shrink-0">

                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="result-kiem" id="KQPass" value="pass" disabled>
                                    <label class="form-check-label text-success font-weight-bold" for="KQPass">Pass</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="result-kiem" id="KQFail" value="fail" disabled>
                                    <label class="form-check-label text-danger font-weight-bold" for="KQFail">Fail</label>
                                </div>
                            </div>

                            <div class="d-flex gap-3 align-items-center flex-shrink-0 margin-auto-left">
                                <i class="fa-sharp fa-solid fa-message-pen fa-2xl" style="color: rgb(37, 116, 53);" id="check-edit-conclusion"></i>
                                <div class="signature-controls" id="btnChange_KetLuanQC">
                                    <button class="btn btn-outline-hover-success"> <i class="fa-sharp-duotone fa-regular fa-pen-clip" style="--fa-primary-color: rgb(37, 68, 116); --fa-secondary-color: rgb(37, 68, 116);"></i></button>


                                </div>
                            </div>
                        </div>
                    </th>
                    <th>
                        <div style="display: flex; justify-content: flex-start; align-items: center; gap: 20px;" class="xac-nhan-tbp">
                            <strong>TPCL xác nhận/QC manager confirm</strong>
                            <div class="d-flex gap-3 align-items-center flex-shrink-0 d-none">

                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="result-kiem-tbp" id="KQPass_TBP" value="pass" disabled>
                                    <label class="form-check-label text-success font-weight-bold" for="KQPass_TBP">Pass</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="result-kiem-tbp" id="KQFail_TBP" value="fail" disabled>
                                    <label class="form-check-label text-danger font-weight-bold" for="KQFail_TBP">Fail</label>
                                </div>
                            </div>
                            <div class="d-flex gap-3 align-items-center flex-shrink-0 margin-auto-left">

                                <div class="signature-controls">
                                    <button class="btn btn-clear bg-success" onclick="confirmTBP_QC()">Hoàn Thành</button>

                                </div>
                            </div>
                        </div>
                    </th>
                    <th>
                        <div style="display: flex; justify-content: flex-start; align-items: center; gap: 20px;" class="xac-nhan-mer">
                            <strong>Mer xác nhận/Mer confirm</strong>
                            <div class="d-flex gap-3 align-items-center flex-shrink-0">

                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="result-kiem-mer" id="KQPass_Mer" value="pass">
                                    <label class="form-check-label text-success font-weight-bold" for="KQPass_Mer">Pass</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="result-kiem-mer" id="KQFail_Mer" value="fail">
                                    <label class="form-check-label text-danger font-weight-bold" for="KQFail_Mer">Fail</label>
                                </div>
                            </div>
                            <div class="d-flex gap-3 align-items-center flex-shrink-0 margin-auto-left">

                                <div class="signature-controls">
                                    <button class="btn btn-clear bg-lightblue" onclick="ComfirmMer()">Xác Nhận</button>

                                </div>
                            </div>
                        </div>
                    </th>
                </tr>
            </thead>
            <tbody id="tbodyXNKiem">
                <tr>
                    <td>
                        <div class="cell-content xac-nhan-qc">
                            <div>

                                <div>
                                    <span class="signature-label">Ghi chú</span>
                                    <textarea class="danhgia-textarea" id="txtDG_QC"></textarea>
                                </div>

                            </div>
                            <div class="signature-wrapper">
                                <div class="content-sign">
                                    <span class="signature-label">Ký Tên</span>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="ckSignTemplate_QC">
                                        <span class="form-check-label signature-label" for="ckSignTemplate_QC">
                                            <i class="ti ti-lock" style="font-size:13px;vertical-align:-2px;margin-right:4px"></i>
                                            Chữ ký mẫu
                                        </span>
                                    </div>
                                    <div class="signature-controls">
                                        <button class="btn btn-clear" onclick="clearSignature('signQC')">Xóa</button>

                                    </div>
                                </div>

                                <div class="signature-pad-container">
                                    <canvas class="signature-pad" id="signQC"></canvas>
                                    <span id="txtQCName"> </span>
                                </div>
                            </div>
                        </div>
                    </td>
                    <td>
                        <div class="cell-content xac-nhan-tbp">
                            <span class="signature-label">Ghi chú</span>
                            <textarea class="danhgia-textarea" id="txtDG_KQ"></textarea>

                        </div>

                        <div class="signature-wrapper xac-nhan-tbp">

                            <div class="content-sign">
                                <span class="signature-label">Ký Tên</span>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="ckSignTemplate_QCManger">
                                    <span class="form-check-label signature-label" for="ckSignTemplate_QCManger">
                                        <i class="ti ti-lock" style="font-size:13px;vertical-align:-2px;margin-right:4px"></i>
                                        Chữ ký mẫu
                                    </span>
                                </div>
                                <div class="signature-controls">
                                    <button class="btn btn-clear" onclick="clearSignature('signXN_KQ')">Xóa</button>

                                </div>
                            </div>

                            <div class="signature-pad-container">
                                <canvas class="signature-pad" id="signXN_KQ"></canvas>
                                <span id="txtQCManagerName"> </span>
                            </div>
                        </div>
                    </td>
                    <td>
                        <div class="cell-content xac-nhan-mer">
                            <span class="signature-label">Ghi chú</span>
                            <textarea class="danhgia-textarea" id="txtDG_Mer"></textarea>
                            <div class="signature-wrapper">
                                <div class="content-sign">
                                    <span class="signature-label">Ký Tên</span>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="ckSignTemplate_Mer">
                                        <span class="form-check-label signature-label" for="ckSignTemplate_Mer">
                                            <i class="ti ti-lock" style="font-size:13px;vertical-align:-2px;margin-right:4px"></i>
                                            Chữ ký mẫu
                                        </span>
                                    </div>
                                    <div class="signature-controls">
                                        <button class="btn btn-clear" onclick="clearSignature('signMer')">Xóa</button>

                                    </div>
                                </div>
                                <div class="signature-pad-container">
                                    <canvas class="signature-pad" id="signMer"></canvas>
                                    <span id="txtMerName"> </span>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>

            </tbody>
        </table>
    </div>


    <!-- ── Option Modal ── -->
    <div class="modal fade" id="optionModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" style="max-width:380px;">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-images me-2"></i>Chọn Nguồn Ảnh
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex flex-column gap-2">

                        <button class="btn btn-primary w-100 text-start px-3" onclick="openCamera()">
                            <i class="fas fa-camera me-2"></i>Chụp Ảnh Từ Camera
                            <small class="d-block text-white-50" style="font-size:11px;margin-top:2px;">
                                Chụp liên tục nhiều ảnh, bấm Xong khi hoàn thành
                            </small>
                        </button>

                        <button class="btn btn-info text-white w-100 text-start px-3" onclick="selectFromGallery()">
                            <i class="fas fa-folder-open me-2"></i>Chọn Từ Thư Viện
                            <small class="d-block" style="font-size:11px;margin-top:2px;opacity:.85;">
                                Chọn nhiều file ảnh cùng lúc
                            </small>
                        </button>

                        <button class="btn btn-success w-100 text-start px-3" onclick="ViewImage()">
                            <i class="fas fa-photo-video me-2"></i>Xem Ảnh Đã Chụp
                            <small class="d-block text-white-50" style="font-size:11px;margin-top:2px;">
                                Xem toàn bộ, xóa từng ảnh
                            </small>
                        </button>

                        <button class="btn btn-secondary w-100" data-bs-dismiss="modal">
                            <i class="fas fa-times me-2"></i>Hủy
                        </button>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Camera Modal: chụp LIÊN TỤC ── -->
    <div class="modal fade" id="cameraModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" style="max-width:700px;">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-camera me-2"></i>Chụp Ảnh
                        <small id="cameraModalKey" class="text-muted ms-2" style="font-size:13px;font-weight:400;"></small>
                    </h5>
                    <button type="button" class="btn-close" onclick="closeCamera()" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="camera-container text-center">


                        <div style="position:relative;display:inline-block;width:100%;">
                            <video id="video"
                                   class="w-100 rounded"
                                   autoplay
                                   playsinline
                                   style="max-height:400px;background:#000;display:block;">
                            </video>

                            <div id="captureFlash"
                                 style="position:absolute;inset:0;background:#fff;
                                    opacity:0;transition:opacity .08s;
                                    pointer-events:none;border-radius:4px;">
                            </div>
                        </div>


                        <canvas id="canvas" style="display:none;"></canvas>


                        <div id="captureCount"
                             class="mt-2 text-muted fw-500"
                             style="font-size:13px;">
                            Đã chụp: 0 ảnh
                        </div>


                        <div class="button-group mt-3 d-flex gap-2 justify-content-center flex-wrap">

                            <button class="btn btn-primary btn-lg px-4" onclick="capturePhoto()">
                                <i class="fas fa-camera me-1"></i>Chụp Ảnh
                            </button>

                            <button class="btn btn-secondary" onclick="switchCamera()">
                                <i class="fas fa-sync-alt me-1"></i>Xoay Camera
                            </button>

                            <button class="btn btn-success px-4" onclick="closeCamera()">
                                <i class="fas fa-check me-1"></i>Xong
                            </button>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="modal fade" id="galleryModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-images me-2"></i>
                        <span id="galleryModalTitle">Ảnh Kiểm</span>
                        <span id="galleryCount"
                              class="badge bg-secondary ms-2"
                              style="font-size:12px;font-weight:400;">
                        </span>
                    </h5>
                    <button type="button" class="btn-close" onclick="closeGalleryModal()" aria-label="Close"></button>
                </div>
                <div class="modal-body">

                    <!-- Grid ảnh -->
                    <div id="galleryContainer"
                         style="display:flex;flex-wrap:wrap;align-content:flex-start;
                            min-height:100px;max-height:400px;
                            overflow-y:auto;padding:6px;
                            border:1px solid #dee2e6;border-radius:6px;
                            background:#f8f9fa;">
                    </div>

                    <p class="text-muted mt-2 mb-0" style="font-size:12px;">
                        <i class="fas fa-info-circle me-1"></i>
                        Click vào ảnh để xem full. Click <i class="fas fa-times text-danger"></i> để xóa từng ảnh.
                    </p>

                </div>
                <div class="modal-footer d-flex gap-2 justify-content-center flex-wrap">

                    <button class="btn btn-primary" onclick="closeGalleryModal(); openCamera();">
                        <i class="fas fa-camera me-1"></i>Chụp Thêm
                    </button>

                    <button class="btn btn-info text-white" onclick="closeGalleryModal(); selectFromGallery();">
                        <i class="fas fa-folder-open me-1"></i>Thêm Từ Thư Viện
                    </button>

                    <button class="btn btn-danger d-none" onclick="showDeleteAllConfirm()">
                        <i class="fas fa-trash me-1"></i>Xóa Tất Cả
                    </button>

                    <button class="btn btn-secondary" onclick="closeGalleryModal()">
                        <i class="fas fa-times me-1"></i>Đóng
                    </button>

                </div>
            </div>
        </div>
    </div>

    <!-- ── Modal xác nhận xóa tất cả ── -->
    <div class="modal fade" id="modalDelete" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" style="max-width:360px;">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle me-2"></i>Xác Nhận Xóa
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="fas fa-trash-alt fa-3x text-danger mb-3 d-block"></i>
                    <p class="mb-1 fw-500">Xóa tất cả ảnh của phụ lục này?</p>
                    <p class="text-muted mb-0" style="font-size:13px;">Hành động này không thể hoàn tác.</p>
                </div>
                <div class="modal-footer justify-content-center gap-2">
                    <button class="btn btn-danger px-4" onclick="ConfirmDelete()">
                        <i class="fas fa-check me-1"></i>Xác Nhận Xóa
                    </button>
                    <button class="btn btn-secondary px-4" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i>Hủy
                    </button>
                </div>
