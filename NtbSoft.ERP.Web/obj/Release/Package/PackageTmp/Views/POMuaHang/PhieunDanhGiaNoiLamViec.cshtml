
@{
    ViewBag.Title = "PhieunDanhGiaNoiLamViec";
    Layout = null;

}

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Phiếu đánh giá nhà cung cấp</title>
    <link rel="stylesheet" href="~/Content/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="~/Content/plugins/select2/css/select2.min.css">
    <link href="~/Content/plugins/daterangepicker/daterangepicker.css" rel="stylesheet">
    <link href="~/css/TheoDoiHangXuat/fontawesome.pro.6.0.0.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/Content/plugins/fontawesome-free/css/all.min.css">
    <link href="~/Scripts/ViTriKho/bootstrap5.3.min.css" rel="stylesheet" />
    <link href="~/Content/plugins/DevExtreme/dx.light.css" rel="stylesheet" />
    <link href="~/Content/plugins/DevExtreme/dx.common.css" rel="stylesheet" />
    <link href="~/css/POMuaHang/DanhGiaNhaCCNoiLV.css" rel="stylesheet" />
</head>
<body>
    <div class="container-fluid">
        <div class="header-section bg-info sticky-top">
            <div class="container-fluid px-3 px-md-4">
                <div class="header-content d-flex align-items-center justify-content-between py-2">

                    <!-- BÊN TRÁI -->
                    <div class="d-flex align-items-center gap-3">
                        <a href="@Url.Action("DashBoard","Home")" class="text-white">
                            <i class="fas fa-home fa-lg"></i>
                        </a>
                        <h5 class="header-title mb-0 text-white">
                            ĐÁNH GIÁ NHÀ CUNG CẤP/NHÀ THẦU PHỤ TẠI NƠI LÀM VIỆC
                        </h5>
                    </div>
                    
                    <!-- BÊN PHẢI -->
                    <div class="doc-info-box text-white small">
                        <div><strong>Ký hiệu:</strong>BM13/QT15/KH02</div>
                        <div><strong>Lần sửa đổi:</strong> 01</div>
                        <div><strong>Ngày ban hành:</strong> 16/07/2025</div>
                    </div>


                </div>
            </div>
        </div>

        <div class="main-card animate-in">

            <div class="row g-3">
                <!-- Card 1 -->
                <div class="col-md-12">
                    <div class="card ui-card h-100">
                        <div class="card-header ui-header">
                            <button class="btn btn-outline-light btn-sm btn-toggle ms-2" id="toggle-card">
                                <i class="fas fa-minus"></i>
                            </button>
                            <h6 class="mb-0">TT Phiếu đánh giá</h6>

                            <div class="d-flex flex-wrap gap-2 ms-auto">
                                <button class="btn btn-light btn-sm" id="btn-ls-danh-gia">

                                    <i class="fa-brands fa-slack"></i> Lịch sử
                                </button>
                                <button class="btn btn-success btn-sm" id="btn-save">

                                    <i class="fas fa-save"></i> Lưu
                                </button>
                                <button class="btn btn-danger btn-sm" id="btn-Excel">

                                    <i class="fa-solid fa-file-excel"></i> Excel
                                </button>
                                <button class="btn btn-light btn-sm" id="btn-refresh">

                                    <i class="fas fa-sync-alt"></i> Nạp lại
                                </button>

                            </div>

                        </div>
                        <div class="card-body collapse-content">
                            <div class="row g-3 align-items-end">
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-3">
                                        <label class="form-label">
                                            <i class="fas fa-user-tie me-1"></i>
                                            Nhà cung cấp
                                        </label>
                                        <select class="form-control form-control-dropdown" id="selectNhaCC"></select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">
                                            <i class="fa-solid fa-clipboard-list me-1"></i>
                                            Phiếu đánh giá
                                        </label>
                                        <input type="text" class="form-control" id="txt-phieu-dg" placeholder="Phiếu đánh giá" disabled>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">
                                            <i class="fa-solid fa-user-tie me-1"></i>
                                            Người đánh giá
                                        </label>
                                        <input type="text" class="form-control" id="txt-nguoi-danh-gia" placeholder="Người đánh giá" disabled>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">
                                            <i class="fa-solid fa-calendar-days me-1"></i>
                                            Ngày đánh giá
                                        </label>
                                        <input type="text" class="form-control" id="ngay-danh-gia" placeholder="Ngày đánh giá">
                                    </div>
                                    <div class="col-md-2 col-ket-luan">
                                        <div class="group-box">
                                            <h6 class="group-title">Kết luận</h6>
                                            <div class="d-flex" style="gap: 20px; justify-content:center;align-items:center">
                                                <div class="form-check item">
                                                    <input type="radio" id="radio-pass" name="ketluan" class="form-check-input">
                                                    <label class="form-check-label" for="radio-pass">Đạt</label>
                                                </div>
                                                <div class="form-check item">
                                                    <input type="radio" id="radio-fail" name="ketluan" class="form-check-input">
                                                    <label class="form-check-label" for="radio-fail">Fail</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>



                                </div>


                            </div>
                        </div>
                    </div>






            </div>
            <div class="card ui-card">
                <div class="card-body p-0">
                    <div id="gridPhieuDanhGia"></div>
                </div>
            </div>
        </div>
            </div>
    

    <script src="~/Scripts/jquery.min-3.6.1.js"></script>
    <script src="~/Content/plugins/moment/moment.min.js"></script>
    <script src="/Content/js/core/utils.js"></script>
    <script src="/Content/js/core/common.js"></script>
    <script src="~/Scripts/Toast/Toast.js"></script>
    <script src="~/Content/plugins/select2/js/select2.full.min.js"></script>
    <script src="~/Content/plugins/daterangepicker/daterangepicker.js"></script>
    <script src="~/Scripts/ViTriKho/bootstrap5.3.bundle.min.js"></script>
    <script src="~/Content/dist/js/adminlte.min.js"></script>
    <script src="~/Content/plugins/DevExtreme/dx.all.js"></script>
    <script src="~/Content/plugins/DevExtreme/knockout-latest.min.js"></script>
    <script src="~/Content/plugins/PadSign/signature_pad.min.js"></script>
    <script>

      let actionType = '@(ViewBag.ActionType ?? "add")';

        var MaPhieu = '@(ViewBag.MaPhieu ?? "NONE")';
        var MaNhaCC = '@(ViewBag.MaNhaCC ?? "NONE")';
        var TenPhieu = '@(ViewBag.TenPhieu ?? "")';
        var NguoiTao = '@(ViewBag.NguoiTao ?? "")';
        console.log(actionType, MaPhieu)
    </script>

    <script>

         var _userName = '@ViewBag.userName';
        if (window.CefSharp) {
            $("#home").hide();
            localStorage.setItem('username', _userName)
        }

        // Add hover effects
        document.querySelectorAll('.btn-custom').forEach(btn => {
            btn.addEventListener('mouseenter', function () {
                this.style.transform = 'translateY(-3px)';
            });

            btn.addEventListener('mouseleave', function () {
                this.style.transform = 'translateY(0)';
            });
        });

        // Add click effects
        document.querySelectorAll('.btn-custom').forEach(btn => {
            btn.addEventListener('click', function () {
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.transform = 'translateY(-3px)';
                }, 100);
            });
        });
       
        
    </script>

    <script src="~/Scripts/POMuaHang/DanhGiaNhaCCNoiLV.js"></script>
</body>

</html>

