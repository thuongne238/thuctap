@{
    Layout = null;
}
@{
    ViewBag.Title = "Thống kê đơn hàng ";
}

<!DOCTYPE html>
<html>
<head>
    <title>@ViewBag.Title</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="~/css/TheoDoiHangXuat/bootstrap.css" rel="stylesheet" />
    <link href="~/css/TheoDoiHangXuat/fontawesome.pro.6.0.0.css" rel="stylesheet" />
    <link href="~/css/TheoDoiHangXuat/toastr.min.css" rel="stylesheet" />

    <link href="~/css/TheoDoiHangXuat/roboto.css" rel="stylesheet" />
    <link href="~/Content/plugins/select2/css/select2.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <link href="~/css/NhanHangGiaCong/nhanhanggiacong.css" rel="stylesheet" />
    <link href="~/css/NhanHangGiaCong/ThongKeDonHang.css" rel="stylesheet" />
</head>

<body>
    <section class="content" style=" ">
        <div class="" style="width: 100%; display: flex; padding: 0 5px; justify-content: space-between; flex-wrap: wrap;">
            <div style="display: flex; flex-wrap: wrap;width:100%">
                <i id="home" style="font-size: 21px; cursor: pointer; display: flex; justify-content: center; align-items: center; margin-right: 5px;" class="fa-sharp fa-solid fa-house"></i>
                <div class="lst_DonHang" style="width: auto; min-width: 100px;">
                    <label class="col-form-label item_lable" style="color: white">Đơn hàng</label>
                    <select class="item_select selectDs donhang"></select>
                </div>
                <div class="lst_DonHang" style="width: auto; min-width: 100px;">
                    <label class="col-form-label item_lable" style="color: white">PO</label>
                    <select class="item_select selectDs po"></select>
                </div>
                <div class="lst_DonHang" style="width: auto; min-width: 200px;">
                    <label class="col-form-label item_lable" style="color: white">Mã PKL</label>
                    <select class="item_select selectDs mapkl"></select>
                </div>
                <div style="margin-left: auto; margin-right: 10px; display: flex; justify-content: center; align-items: center;display:none">
                    <button style="min-width: 72px; outline: none;" class="btn btn-primary" id="Excel"><i class="fas fa-save"></i> Xuất ex</button>
                </div>
            </div>
        </div>

    </section>
    <section>
        <div class="list_phieu">
            <button id="detail">Chi tiết</button>
            <button id="total">Tổng</button>
        </div>
    </section>
    @*view  nhập*@
    <section class="lstChiTiet">
            <div class="main-item">
                <div class="task-item" style="max-height: calc(100vh - 105px); margin: 3px 8px 0;">
                    <div class="item-table">
                        <table class="table" style="position: relative">
                            <thead id="thead" class="thead-list">
                               

                            </thead>
                            <tbody id="tbody">
                            </tbody>
                            <tfoot id="tfoot">

                            </tfoot>
                        </table>
                    </div>

                </div>
            </div>
        </section>
    <section class="lstTotal"  style="display:none">
        <div class="main-item">
            <div class="task-item" style="max-height: calc(100vh - 105px); margin: 3px 8px 0;">
                <div class="item-table">
                    <table class="table" style="position: relative">
                        <thead id="theadTotal" class="thead-list">


                        </thead>
                        <tbody id="tbodyTotal">
                        </tbody>
                        <tfoot id="tfootTotal">

                        </tfoot>
                    </table>
                </div>

            </div>
        </div>
    </section>
    <script src="~/Scripts/TheoDoiHangXuat/jquery.js"></script>
    <script src="~/Scripts/TheoDoiHangXuat/toastr.min.js"></script>
    <script src="~/Scripts/bootstrap.js"></script>
    <script src="~/Content/plugins/select2/js/select2.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>
    <script src="~/Scripts/ThongKeDongThung/thongkedongthung.js"></script>


</body>
</html>



