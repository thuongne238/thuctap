@{
    Layout = null;
}


<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width; initial-scale=1.0; maximum-scale=1.0; user-scalable=0;" />
    <title>Khai báo kho NPL</title>

    <link href="~/css/TheoDoiHangXuat/fontawesome.pro.6.0.0.css" rel="stylesheet" />
    <link href="~/css/TheoDoiHangXuat/roboto.css" rel="stylesheet" />
    <link href="~/css/QRCode/toastr.minM.css" rel="stylesheet" />
    <link href="~/Content/plugins/select2/css/select2.css" rel="stylesheet" />
    <link href="~/Scripts/ViTriKho/bootstrap5.3.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.0/font/bootstrap-icons.min.css"
          rel="stylesheet">

    <style>
        :root {
            --clr-primary: #185FA5;
            --clr-danger: #A32D2D;
            --clr-border: #dee2e6;
            --clr-header-bg: #f8f9fa;
        }

        body {
            background: #f4f6f9;
            font-family: 'Segoe UI', sans-serif;
            font-size: 13px;
        }

        .select2-container--default .select2-dropdown {
            border: 1px solid #ced4da;
            min-width: 100px;
            overflow-wrap: break-word;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 26px;
            position: absolute;
            top: 2px;
            right: 1px;
            width: 20px;
        }

        .select2-results__option[aria-selected] {
            cursor: pointer;
            font-size: 13px;
        }

        .txtselected {
            margin-bottom: 2px;
            font-size: 14px;
            font-weight: 600;
        }

        .select2-container .select2-selection--single .select2-selection__rendered {
            font-size: 13px;
            padding-top: 0px;
        }

        .select2-container .select2-selection--single {
            box-sizing: border-box;
            cursor: pointer;
            display: block;
            height: 33px;
            border: 1px solid #ccc !important;
            user-select: none;
            -webkit-user-select: none;
        }
        /* ── Page wrapper ── */
        .page-card {
            background: #fff;
            border-radius: 2px;
            border: 1px solid var(--clr-border);
            padding: 4px 4px;
            margin: 5px 4px;
        }

        /* ── Page title ── */
        .page-title {
            font-size: 15px;
            font-weight: 600;
            color: #1a1a2e;
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 14px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--clr-border);
        }

            .page-title i {
                color: var(--clr-primary);
                font-size: 18px;
            }

        /* ── Filter bar ── */
        .filter-card {
            background: #fff;
            border-radius: 8px;
            padding: 0px 0px;
            margin-bottom: 10px;
        }

        .filter-label {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: #6c757d;
            margin-bottom: 4px;
        }

        /* ── Buttons ── */
        .btn-tra {
            background: #185FA5;
            color: #fff;
            border: none;
            border-radius: 6px;
            padding: 0 18px;
            height: 36px;
            font-size: 13px;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            transition: background .15s;
        }

            .btn-tra:hover {
                background: #0C447C;
            }

        .btn-bo {
            border: 1px solid #A32D2D;
            border-radius: 6px;
            padding: 0 18px;
            height: 36px;
            font-size: 13px;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            transition: background .15s, color .15s;
            background: #A32D2D;
            color: #fff;
        }

            .btn-bo:hover {
                background: #A32D2D;
                color: #fff;
            }

        /* ── Grid header bar ── */
        .grid-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 12px;
            background: var(--clr-header-bg);
            border: 1px solid var(--clr-border);
            border-bottom: none;
            border-radius: 8px 8px 0 0;
            font-size: 13px;
            font-weight: 500;
            color: #495057;
        }

            .grid-topbar .sel-count {
                background: #e8f0fe;
                color: #185FA5;
                border-radius: 99px;
                font-size: 11px;
                font-weight: 600;
                padding: 2px 10px;
            }

        /* ── DevExtreme overrides ── */
        #gridTraHang {
            border-radius: 0 0 8px 8px;
            border: 1px solid var(--clr-border);
            border-top: none;
            max-height: calc(100vh - 205px);
        }

        .dx-datagrid-headers {
            background: #f1f3f5 !important;
        }

            .dx-datagrid-headers .dx-header-row td {
                font-weight: 600 !important;
                font-size: 13px !important;
            }

        .dx-datagrid-rowsview .dx-row {
            font-size: 13px;
        }

        .dx-datagrid-rowsview .dx-row-alt > td {
            background: #fafbfc;
        }

        /* SL màu khác nhau */
        .sl-diff {
            color: #c0392b;
            font-weight: 600;
        }

        .sl-match {
            color: #27ae60;
            font-weight: 500;
        }

        /* ── Footer summary ── */
        .grid-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 12px;
            border: 1px solid var(--clr-border);
            border-top: none;
            border-radius: 0 0 8px 8px;
            background: #f8f9fa;
            font-size: 12px;
            color: #6c757d;
        }

            .grid-footer strong {
                color: #185FA5;
            }

        /* Select2 height fix */
        .select2-container--bootstrap-5 .select2-selection {
            height: 36px !important;
            font-size: 13px !important;
        }

        .select2-container--bootstrap-5 .select2-selection--single .select2-selection__rendered {
            line-height: 34px !important;
        }

        /* Toast */
        .toast-custom {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            padding: 10px 22px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            color: #fff;
            opacity: 0;
            pointer-events: none;
            transition: opacity .3s;
            z-index: 9999;
            white-space: nowrap;
        }

            .toast-custom.show {
                opacity: 1;
            }

        .dx-header-row .col-header {
            background: #5da566;
            color: #fff !important;
            text-align: center !important;
            vertical-align: middle !important
        }

        .dx-data-row .col-header {
            text-align: center !important;
            font-size: 13px !important;
            vertical-align: middle !important
        }

        .dx-data-row .checkboxTD {
            display: flex;
            justify-content: center
        }

        .dx-footer-row .col-header .dx-datagrid-text-content {
            text-align: center !important;
            color: red !important
        }

        .dx-datagrid-summary-item {
            text-align: center !important;
            color: red !important
        }

        .dx-datagrid-filter-row {
            background: #fff !important;
        }
        /* 2. Scrollbar custom */
        ::-webkit-scrollbar {
            height: 8px;
            width: 8px;
        }

        /* Track */
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        /* Handle */
        ::-webkit-scrollbar-thumb {
            background: #888;
        }

            /* Handle on hover */
            ::-webkit-scrollbar-thumb:hover {
                background: #555;
            }

        .title {
            background: #357C97;
            color: #Fff
        }

        .btn-text {
            font-size: 13px;
        }

        @@media (max-width: 768px) {
            .btn-text {
                font-size: 10px;
            }
        }

        @@media (max-width: 576px) {
            .btn-text {
                font-size: 9px;
            }
        }
    </style>
</head>

<body>
    <section>
        <div class="title">
            <div style="display: flex; align-items: center; width: 100%; ">
                <div style="display: flex; justify-content: center; align-items: center; gap: 6px;">
                    <i id="home" style="font-size: 21px; cursor: pointer; margin-right: 7px; color: #fff; margin-top: 2px;" class="fa-sharp fa-solid fa-house"></i>
                    <span style="margin-top: 2px; color: white; font-size: 18px; padding: 4px 8px; font-weight: 700;">Chi tiết vật tư lỗi</span>
                </div>

            </div>
        </div>
    </section>
    <div class="page-card">



        <!-- ── BỘ LỌC ── -->
        <div class="filter-card">
            <div class="row g-2 align-items-end">
                <div class="col-4 col-md-4 col-lg-3 col-xl-2 px-1">
                    <div class="select2_item ">
                        <label class="txtselected">Lọc</label>
                        <select onchange="renderDataSoLo()" class="select_2" id="lockho">
                            <option value="1">Nguyên liệu</option>
                            <option value="0">Phụ liệu</option>

                        </select>
                    </div>
                </div>
                <div class="col-4 col-md-4 col-lg-3 col-xl-2 px-1">
                    <div class="select2_item ">
                        <label class="txtselected">Lọc</label>
                        <select onchange="renderDataSoLo()" class="select_2" id="trangthaihang">
                            <option value="1">Hàng trong kho</option>
                            <option value="2">Hàng ngoài kho</option>
                        </select>
                    </div>
                </div>
                <div class="col-4 col-md-4 col-lg-3 col-xl-2 px-1">
                    <div class="select2_item ">
                        <label class="txtselected">PO Mua</label>
                        <select onchange="bindDropdownMaNPL()" class="select_2" id="soLoID">
                        </select>
                    </div>
                </div>
                <div class="col-7 col-md-6 col-lg-4 col-xl-4 px-1">
                    <div class="select2_item ">
                        <label class="txtselected">ItemCode</label>
                        <select onchange="renderDataTable()" class="select_2" id="maNPL">
                        </select>
                    </div>
                </div>

                <!-- Nút -->
                <div class="col-5 col-md-4 col-ld-4 col-xl-2 d-flex gap-2">
                    <button class="btn-tra" onclick="handleTraHang()">
                        <i class="fa-solid fa-rotate-left"></i>
                        <span class="btn-text">Trả hàng</span>
                    </button>
                    <button class="btn-bo" onclick="handleBoTraHang()">
                        <i class="fa-solid fa-xmark"></i>
                        <span class="btn-text">Hủy hàng trả</span>
                    </button>
                </div>
            </div>
        </div>
        <!-- ── END BỘ LỌC ── -->
        <!-- Grid top bar -->
        <div class="grid-topbar">
            <span>Danh sách Barcode trả hàng</span>
            <span id="selCountBadge" class="sel-count">0 barcode được chọn</span>
        </div>

        <!-- DevExtreme DataGrid -->
        <div id="gridTraHang"></div>

        <!-- Grid footer summary -->
        <div class="grid-footer">
            <strong id="totalSLCT">0</strong>
            <span>Tổng SL nhập: <strong id="totalSLNhap">0</strong></span>
        </div>

    </div>
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:99999999">
        <div id="successToast" class="toast" role="alert">
            <div class="toast-header bg-success text-white">
                <i class="fas fa-check-circle me-2"></i>
                <strong class="me-auto">Thành công</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="successMessage"></div>
        </div>
        <div id="errorToast" class="toast" role="alert">
            <div class="toast-header bg-danger text-white">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong class="me-auto">Lỗi</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="errorMessage"></div>
        </div>
        <div id="warningToast" class="toast" role="alert">
            <div class="toast-header bg-warning text-dark">
                <i class="fas fa-exclamation-circle me-2"></i>
                <strong class="me-auto">Cảnh báo</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="warningMessage"></div>
        </div>
    </div>
    <!-- Modal Trả Hàng -->
    <div class="modal fade" id="modalTraHang" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h6 class="modal-title">
                        <i class="fa-solid fa-rotate-left me-2"></i>Xác nhận trả hàng
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info d-flex align-items-center gap-2 mb-3">
                        <i class="fa-solid fa-circle-info fs-5"></i>
                        <div id="modalTraHangMessage">Bạn có chắc muốn trả hàng?</div>
                    </div>
                    <table class="table table-sm table-bordered mb-0">
                        <tbody>
                            <tr>
                                <td class="fw-semibold text-muted" style="width:50%">Số barcode chọn</td>
                                <td><strong id="modalTraHangCount" class="text-primary">0</strong></td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-muted">Tổng SL mở kiện</td>
                                <td><strong id="modalTraHangSL" class="text-success">0</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                        <i class="fa-solid fa-xmark me-1"></i>Hủy
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" id="btnConfirmTraHang">
                        <i class="fa-solid fa-rotate-left me-1"></i>Xác nhận trả
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Hủy Hàng Trả -->
    <div class="modal fade" id="modalHuyTraHang" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h6 class="modal-title">
                        <i class="fa-solid fa-xmark me-2"></i>Xác nhận hủy hàng trả
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3">
                        <i class="fa-solid fa-triangle-exclamation fs-5"></i>
                        <div id="modalHuyTraHangMessage">Bạn có chắc muốn hủy hàng trả?</div>
                    </div>
                    <table class="table table-sm table-bordered mb-0">
                        <tbody>
                            <tr>
                                <td class="fw-semibold text-muted" style="width:50%">Số barcode chọn</td>
                                <td><strong id="modalHuyTraHangCount" class="text-danger">0</strong></td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-muted">Tổng SL mở kiện</td>
                                <td><strong id="modalHuyTraHangSL" class="text-danger">0</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                        <i class="fa-solid fa-xmark me-1"></i>Đóng
                    </button>
                    <button type="button" class="btn btn-danger btn-sm" id="btnConfirmHuyTraHang">
                        <i class="fa-solid fa-ban me-1"></i>Xác nhận hủy
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="modalGhiChuAll" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background:#185FA5; color:#fff;">
                    <h6 class="modal-title">
                        <i class="fas fa-edit me-2"></i>Nhập ghi chú cho tất cả barcode
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info d-flex align-items-center gap-2 mb-3">
                        <i class="fas fa-circle-info fs-5"></i>
                        <div>Ghi chú sẽ được áp dụng cho <strong id="modalGhiChuCount">0</strong> vật tư.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="font-size:13px;">
                            <i class="fas fa-pen me-1 text-primary"></i>Nội dung ghi chú
                        </label>
                        <textarea id="inputGhiChuAll"
                                  class="form-control"
                                  rows="4"
                                  maxlength="500"
                                  placeholder="Nhập nội dung ghi chú..."
                                  style="font-size:13px; resize:none;"></textarea>
                        <div class="d-flex justify-content-between mt-1">
                            <small class="text-muted">Tối đa 500 ký tự</small>
                            <small id="ghiChuCharCount" class="text-muted">0/500</small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                        <i class="fas fa-xmark me-1"></i>Hủy
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" id="btnConfirmGhiChuAll">
                        <i class="fas fa-save me-1"></i>Lưu tất cả
                    </button>
                </div>
            </div>
        </div>
    </div>
    <script src="~/Scripts/TheoDoiHangXuat/jquery.js"></script>
    <script src="~/Scripts/ViTriKho/bootstrap5.3.bundle.min.js"></script>
    <script src="~/Scripts/TheoDoiHangXuat/select2.js"></script>
    <link href="~/css/DevExtreme/dx.common.css" rel="stylesheet" />
    <link href="~/css/DevExtreme/dx.light.css" rel="stylesheet" />
    <script src="~/css/DevExtreme/dx.all.js"></script>
    <script src="~/Content/plugins/select2/js/select2.js"></script>

    <script src="~/css/DevExtreme/knockout-latest.min.js"></script>
    <script>
        var userName = '@ViewBag.userName';
        console.log(userName)
        function showToast(type, message, delay = 2000) {
            let toastId, messageId;

            switch (type) {
                case 'success':
                    toastId = 'successToast';
                    messageId = 'successMessage';
                    break;
                case 'error':
                    toastId = 'errorToast';
                    messageId = 'errorMessage';
                    break;
                case 'warning':
                    toastId = 'warningToast';
                    messageId = 'warningMessage';
                    break;
                default:
                    console.error('Unknown toast type:', type);
                    return;
            }

            $('#' + messageId).text(message);

            const toastElement = $('#' + toastId)[0];
            const toast = new bootstrap.Toast(toastElement, {
                autohide: true,
                delay: delay
            });

            toast.show();
        }
    </script>

    <script src="~/Scripts/ViTriKho/chitiethangloi.js?Ver=1.0"></script>
</body>
</html>
