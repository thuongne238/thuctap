    <script>
        var Action = '@(ViewBag.ActionDG ?? "add")';
        let MaPhieu = '@(ViewBag.MaPhieu ?? "NONE")';
        let MaCLVTID = '@(ViewBag.MaCLVTID ?? "NONE")';
    </script>

    <script>

         var _userName = '@ViewBag.userName';
        if (window.CefSharp) {
            $("#home").hide();
            localStorage.setItem('username', _userName)
        }
        var signaturePads = {};
        var signatureData = {}; // Lưu trữ dữ liệu chữ ký
        var canvasIds = ['signQC', 'signMer', 'signXN_KQ'];
        // Add hover effects
        document.querySelectorAll('.btn-custom').forEach(btn => {
            btn.addEventListener('mouseenter', function () {
                this.style.transform = 'translateY(-3px)';
            });

            btn.addEventListener('mouseleave', function () {
                this.style.transform = 'translateY(0)';
            });
        });

        // Add click effects
        document.querySelectorAll('.btn-custom').forEach(btn => {
            btn.addEventListener('click', function () {
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.transform = 'translateY(-3px)';
                }, 100);
            });
        });
       

        canvasIds.forEach(id => {
            const canvas = document.getElementById(id);
            const signaturePad = new SignaturePad(canvas, {
                backgroundColor: 'rgb(255,255,255)',
                penColor: '#667eea',
                minWidth: 1.5,
                maxWidth: 3,
            });

            // Lưu chữ ký mỗi khi vẽ xong
            signaturePad.onEnd = function () {
                if (!signaturePad.isEmpty()) {
                    signatureData[id] = signaturePad.toDataURL();
                }
            };

            function resizeCanvas() {
                // Lưu chữ ký trước khi resize
                const data = signaturePad.isEmpty() ? null : signaturePad.toDataURL();

                const ratio = Math.max(window.devicePixelRatio || 1, 1);
                canvas.width = canvas.offsetWidth * ratio;
                canvas.height = canvas.offsetHeight * ratio;
                canvas.getContext('2d').scale(ratio, ratio);

                // Khôi phục chữ ký sau khi resize
                if (data) {
                    signaturePad.fromDataURL(data);
                    signatureData[id] = data;
                } else if (signatureData[id]) {
                    signaturePad.fromDataURL(signatureData[id]);
                }
            }

            window.addEventListener('resize', resizeCanvas);
            resizeCanvas();
            signaturePads[id] = signaturePad;
        });

        // Hàm xóa chữ ký
        function clearSignature(id) {
            if (signaturePads[id]) {
                signaturePads[id].clear();
                delete signatureData[id]; // Xóa dữ liệu đã lưu
            }
        }

        // Hàm khôi phục tất cả chữ ký
        function restoreAllSignatures() {
            Object.keys(signatureData).forEach(id => {
                if (signaturePads[id] && signatureData[id]) {
                    signaturePads[id].fromDataURL(signatureData[id]);
                }
            });
        }

        // Hàm lấy tất cả dữ liệu chữ ký (để submit form)
        function getAllSignatures() {
            const result = {};
            Object.keys(signaturePads).forEach(id => {
                if (!signaturePads[id].isEmpty()) {
                    result[id] = signaturePads[id].toDataURL();
                } else if (signatureData[id]) {
                    result[id] = signatureData[id];
                }
            });
            return result;
        }

        // Hàm load chữ ký từ database
        function loadSavedSignatures(savedData) {
            if (!savedData) return;

            Object.keys(savedData).forEach(id => {
                if (signaturePads[id] && savedData[id]) {
                    signatureData[id] = savedData[id];
                    signaturePads[id].fromDataURL(savedData[id]);
                }
            });
        }

        // Hàm check xem có chữ ký nào chưa
        function hasAnySignature() {
            return Object.keys(signaturePads).some(id => !signaturePads[id].isEmpty());
        }
        function getSignatureBase64(canvasId) {
            if (!signaturePads[canvasId]) {
                console.warn(`SignaturePad "${canvasId}" chưa được khởi tạo!`);
                return null;
            }

            if (signaturePads[canvasId].isEmpty()) {
                return null;
            }

            // Trả về base64 image
            return signaturePads[canvasId].toDataURL('image/png');
        }
       

    </script>
    <script>

        $("#selectChungLoaiVatTu").dxDropDownBox({
            value: null,
            valueExpr: "MaCLVT",
            displayExpr: "ChungLoaiVatTu",
            placeholder: "Chọn loại hàng hóa",
            dataSource:[],
            contentTemplate: function (e) {
                return $("<div class='pl-contents'>").dxDataGrid({
                    dataSource: e.component.option("dataSource"),
                    height: 600, // hoặc giá trị phù hợp
                    columns: [
                        { dataField: "MaCLVT", caption: "MaCLVT", visible: false },
                        { dataField: "ChungLoaiVatTu", caption: "Loại hàng hóa", cssClass: "col-chi-tiet" },
                        { dataField: "TenKhac", caption: "Tên gọi khác" },
                        {
                            dataField: "LoaiVT", caption: "Loại vật tư",
                            groupIndex: 0,
                            groupCellTemplate: function (cellElement, cellInfo) {
                                cellElement.html(`<span style="color: teal; font-weight: bold;">${cellInfo.value}</span>`);
                            }
                        },
                    ],
                    searchPanel: { visible: true },
                    scrolling: {
                        mode: 'standard',
                        showScrollbar: 'always'
                    },
                    width: '100%',
                    noDataText: "Chưa có dữ liệu",
                    selection: { mode: "single" },
                    hoverStateEnabled: true,
                    paging: { enabled: false },
                    filterRow: { visible: true },
                    showBorders: true,
                    showRowLines: true,
                    showColumnLines: true,
                    onRowClick: function (eRow) {
                        const keys = [eRow.data];
                        e.component.option("value", keys.length ? keys[0].MaCLVT : null);
                        if (keys[0]?.MaCLVT) {
                            rowSelected_CLVT = keys[0];
                            GetNhaCungCap(keys[0]?.MaCLVT);
                            if (Action != 'edit') {
                                Action = "add"
                                GeneratePhieuDanhGia();
                                GetCountPhieuDanhGia(rowSelected_CLVT.MaCLVT, rowSelected_CLVT.ChungLoaiVatTu)
                                GetPhieuDanhGia(rowSelected_CLVT.MaCLVT);
                            }
                        }
                        eRow.component.selectRowsByIndexes([eRow.rowIndex]);
                        $("#selectChungLoaiVatTu").dxDropDownBox("instance").close();
                    },
                    onContentReady: function () {
                        $(".dx-datagrid-headers td").css({
                            "background-color": "RoyalBlue",
                            "color": "#fff",
                            "text-align": "center",
                            "vertical-align": "middle",
                            "font-weight": "700"
                        });
                    }
                });

            },

        });

    </script>
