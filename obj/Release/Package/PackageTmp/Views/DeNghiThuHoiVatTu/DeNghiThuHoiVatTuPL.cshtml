    <script>
        var userName = '@ViewBag.userName';
        var isNPL = 0
        if (window.CefSharp) {
            $('#home').hide();
        }
        function showToast(type, message, delay = 2000) {
            let toastId, messageId;

            switch (type) {
                case 'success':
                    toastId = 'successToast';
                    messageId = 'successMessage';
                    break;
                case 'error':
                    toastId = 'errorToast';
                    messageId = 'errorMessage';
                    break;
                case 'warning':
                    toastId = 'warningToast';
                    messageId = 'warningMessage';
                    break;
                default:
                    console.error('Unknown toast type:', type);
                    return;
            }

            $('#' + messageId).text(message);

            const toastElement = $('#' + toastId)[0];
            const toast = new bootstrap.Toast(toastElement, {
                autohide: true,
                delay: delay
            });

            toast.show();
        }

        if (typeof sendNotify === "undefined") {
            window.sendNotify = function (userID, moduleCode, title, detail, role, filter, type) {
                console.log("sendNotify:", { userID, moduleCode, title, detail, role, filter, type });
            };
        }

    </script>
