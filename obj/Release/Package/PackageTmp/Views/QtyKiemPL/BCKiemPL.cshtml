    <!-- Input ẩn cho chọn ảnh từ gallery -->
    <input type="file" id="fileInput" accept="image/*" style="display: none;">


    <script src="~/Scripts/jquery.min-3.6.1.js"></script>
    <script src="~/Content/plugins/moment/moment.min.js"></script>
    <script src="/Content/js/core/utils.js"></script>
    <script src="/Content/js/core/common.js"></script>
    <script src="~/Scripts/Toast/Toast.js"></script>
    <script src="~/Content/plugins/select2/js/select2.full.min.js"></script>
    <script src="~/Content/plugins/daterangepicker/daterangepicker.js"></script>
    <script src="~/Scripts/ViTriKho/bootstrap5.3.bundle.min.js"></script>
    <script src="~/Content/dist/js/adminlte.min.js"></script>
    <script src="~/Content/plugins/DevExtreme/dx.all.js"></script>
    <script src="~/Content/plugins/DevExtreme/knockout-latest.min.js"></script>
    @*<script src="https://cdnjs.cloudflare.com/ajax/libs/signature_pad/1.5.3/signature_pad.min.js"></script>*@
    <script src="~/Content/plugins/PadSign/signature_pad.min.js"></script>
    <script>


        var _userName = "";
        if (!window.CefSharp) {
            _userName = localStorage.getItem("username1");

            if (!_userName) {
                alert("Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại!");
                window.location.href = '/Login';
            }
        } else {
            _userName = '@ViewBag.userName';
            $("#home").hide();
        }

        localStorage.setItem('username1', _userName)

        document.querySelectorAll('.btn-custom').forEach(btn => {
            btn.addEventListener('mouseenter', function () {
                this.style.transform = 'translateY(-3px)';
            });

            btn.addEventListener('mouseleave', function () {
                this.style.transform = 'translateY(0)';
            });
        });


        document.querySelectorAll('.btn-custom').forEach(btn => {
            btn.addEventListener('click', function () {
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.transform = 'translateY(-3px)';
                }, 100);
            });
        });
        const signaturePads = {};
        const signatureData = {};
        const canvasIds = ['signQC', 'signMer', 'signXN_KQ'];

        canvasIds.forEach(id => {
            const canvas = document.getElementById(id);
            const signaturePad = new SignaturePad(canvas, {
                backgroundColor: 'rgb(255,255,255)',
                penColor: '#667eea',
                minWidth: 1.5,
                maxWidth: 3,
            });


            signaturePad.onEnd = function () {
                if (!signaturePad.isEmpty()) {
                    signatureData[id] = signaturePad.toDataURL();
                }
            };

            function resizeCanvas() {

                const data = signaturePad.isEmpty() ? null : signaturePad.toDataURL();

                const ratio = Math.max(window.devicePixelRatio || 1, 1);
                canvas.width = canvas.offsetWidth * ratio;
                canvas.height = canvas.offsetHeight * ratio;
                canvas.getContext('2d').scale(ratio, ratio);

                // Khôi phục chữ ký sau khi resize
                if (data) {
                    signaturePad.fromDataURL(data);
                    signatureData[id] = data;
                } else if (signatureData[id]) {
                    signaturePad.fromDataURL(signatureData[id]);
                }
            }

            window.addEventListener('resize', resizeCanvas);
            resizeCanvas();
            signaturePads[id] = signaturePad;
        });


        function clearSignature(id) {
            if (id == "signQC")
            {
                $("#ckSignTemplate_QC").prop("checked", false);
            } else if (id == "signXN_KQ")
            {
                $("#ckSignTemplate_QCManger").prop("checked", false);
            }
            else if (id == "signMer") {
                $("#ckSignTemplate_Mer").prop("checked", false);
            }

            if (signaturePads[id]) {
                signaturePads[id].clear();
                delete signatureData[id];
            }
        }


        function restoreAllSignatures() {
            Object.keys(signatureData).forEach(id => {
                if (signaturePads[id] && signatureData[id]) {
                    signaturePads[id].fromDataURL(signatureData[id]);
                }
            });
        }


        $(document).ready(function () {
            let isScrolling = false;

            $('.danhgia-textarea').on('focus', function () {
                if (isScrolling) return;
                isScrolling = true;

                const $textarea = $(this);

                // Lưu tất cả chữ ký trước khi scroll
                Object.keys(signaturePads).forEach(id => {
                    if (!signaturePads[id].isEmpty()) {
                        signatureData[id] = signaturePads[id].toDataURL();
                    }
                });


                setTimeout(function () {
                    const offset = $textarea.offset().top - 10;

                    $('html, body').animate({
                        scrollTop: offset
                    }, 300, function () {
                        isScrolling = false;
                        restoreAllSignatures();
                    });
                }, 100);
            });


            $('.danhgia-textarea').on('blur', function () {
                setTimeout(function () {
                    restoreAllSignatures();
                }, 200);
            });

            // Xử lý khi orientation change trên mobile
            $(window).on('orientationchange', function () {

                Object.keys(signaturePads).forEach(id => {
                    if (!signaturePads[id].isEmpty()) {
                        signatureData[id] = signaturePads[id].toDataURL();
                    }
                });

                setTimeout(function () {
                    restoreAllSignatures();
                }, 500);
            });

            // Xử lý khi virtual keyboard xuất hiện/ẩn trên mobile
            let lastHeight = window.innerHeight;
            $(window).on('resize', function () {
                const currentHeight = window.innerHeight;

                if (currentHeight < lastHeight) {

                    Object.keys(signaturePads).forEach(id => {
                        if (!signaturePads[id].isEmpty()) {
                            signatureData[id] = signaturePads[id].toDataURL();
                        }
                    });
                }
                else if (currentHeight > lastHeight) {
                    setTimeout(function () {
                        restoreAllSignatures();
                    }, 300);
                }

                lastHeight = currentHeight;
            });

            $('.signature-pad').each(function () {
                $(this).on('touchstart touchmove', function (e) {
                    e.stopPropagation();
                });
            });
        });

        function getAllSignatures() {
            const result = {};
            Object.keys(signaturePads).forEach(id => {
                if (!signaturePads[id].isEmpty()) {
                    result[id] = signaturePads[id].toDataURL();
                } else if (signatureData[id]) {
                    result[id] = signatureData[id];
                }
            });
            return result;
        }

        function loadSavedSignatures(savedData) {
            if (!savedData) return;

            Object.keys(savedData).forEach(id => {
                if (signaturePads[id] && savedData[id]) {
                    signatureData[id] = savedData[id];
                    signaturePads[id].fromDataURL(savedData[id]);
                }
            });
        }


        function hasAnySignature() {
            return Object.keys(signaturePads).some(id => !signaturePads[id].isEmpty());
        }

    </script>

