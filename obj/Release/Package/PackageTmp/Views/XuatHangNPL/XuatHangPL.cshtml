            }

            .picker-grid::-webkit-scrollbar-thumb {
                background: #c5cfe0;
                border-radius: 10px;
            }

        .picker-item {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 10px 14px;
            border-radius: 10px;
            border: 1.5px solid #e8edf5;
            cursor: pointer;
            background: #fafbfd;
            transition: all 0.15s;
            text-align: center;
            font-size: 0.875rem;
            color: #1e2d40;
            user-select: none;
        }

            .picker-item:hover {
                border-color: #93b4f5;
                background: #f0f5ff;
                color: #1a56db;
            }

            .picker-item.selected {
                border-color: #e6eeff;
                background: #e6eeff;
                color: #000;
            }
            /* Đổi từ .picker-item.selected → .picker-item.active */
            .picker-item.active {
                border-color: #1a56db;
                background: #e6eeff;
                color: #1a56db;
                font-weight: 600;
            }

