            if (stockDetailEl) {
                const stockItems = Array.isArray(stock && stock.subItems) ? stock.subItems : [];
                stockDetailEl.innerHTML = stockItems.length
                    ? `<div class="live-chip-row">${stockItems.map(text => `<span class="live-chip">${text}</span>`).join("")}</div>`
                    : "";
            }
        }

function renderTotalWarehouseOverview() {
            const npl = demoState.overallWarehouse.nguyenLieu;
            const pl = demoState.overallWarehouse.phuLieu;
            const summary = latestDashboardSummary || getDashboardSummary();
            const total = {
                used: npl.used + pl.used,
                capacity: npl.capacity + pl.capacity,
                inbound: npl.inbound + pl.inbound,
                outbound: npl.outbound + pl.outbound,
                pending: npl.pending + pl.pending,
                alerts: npl.alerts + pl.alerts
            };
            const totalFree = Math.max(0, total.capacity - total.used);
            const pieSegments = overallCapacityRealState.loaded
                ? {
                    nplPercent: Math.max(0, Number(npl.percent) || 0),
                    plPercent: Math.max(0, Number(pl.percent) || 0),
                    freePercent: Math.max(0, 100 - ((Number(npl.percent) || 0) + (Number(pl.percent) || 0)))
                }
                : (total.capacity > 0
                    ? {
                        nplPercent: (npl.used / total.capacity) * 100,
                        plPercent: (pl.used / total.capacity) * 100,
                        freePercent: (totalFree / total.capacity) * 100
                    }
                    : { nplPercent: 0, plPercent: 0, freePercent: 100 });

            const nplPctText = pieSegments.nplPercent.toLocaleString("vi-VN", { minimumFractionDigits: 1, maximumFractionDigits: 2 });
            const plPctText = pieSegments.plPercent.toLocaleString("vi-VN", { minimumFractionDigits: 1, maximumFractionDigits: 2 });
            const freePctText = pieSegments.freePercent.toLocaleString("vi-VN", { minimumFractionDigits: 1, maximumFractionDigits: 2 });

            const blueLegendText = `Nguyên liệu: ${nplPctText}%`;
