        function compareOrderCode(a, b) {
            const numA = Number(a);
            const numB = Number(b);
            if (!Number.isNaN(numA) && !Number.isNaN(numB)) {
                return numA - numB;
            }
            return (a || "").localeCompare(b || "", "vi-VN", { numeric: true });
        }

        function normalizeItemCodeKey(itemCode) {
