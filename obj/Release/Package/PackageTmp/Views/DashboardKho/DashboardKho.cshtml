        function renderReceivingData(summary) {
            const liveRows = receivingRealState.loaded ? receivingRealState.items : [];
            const sourceRows = liveRows;

            const panelState = flowPanelsState.receiving;
            const sortedRows = [...sourceRows].sort(function (a, b) {
                const timeA = a && a.dateValue instanceof Date && !Number.isNaN(a.dateValue.getTime())
                    ? a.dateValue.getTime()
                    : Number.MAX_SAFE_INTEGER;
                const timeB = b && b.dateValue instanceof Date && !Number.isNaN(b.dateValue.getTime())
                    ? b.dateValue.getTime()
                    : Number.MAX_SAFE_INTEGER;
                return (timeA - timeB) || compareOrderCode(a.po, b.po);
            });

            const pages = [];
            for (let i = 0; i < sortedRows.length; i += panelState.pageSize) {
                pages.push({
                    pos: sortedRows.slice(i, i + panelState.pageSize)
                });
            }

            const totalPages = Math.max(1, pages.length);
            panelState.totalPages = totalPages;
            panelState.page = Math.min(Math.max(0, panelState.page || 0), totalPages - 1);
            
            const currentPageData = pages[panelState.page] || { pos: [] };

            const poListHtml = currentPageData.pos.map(function (po) {
                return `
                    <div class="receiving-po-card">
                        <div class="receiving-po-head">
                            <div class="receiving-po-title" title="${po.po}"><i class="fa-regular fa-file-lines" style="margin-right:4px;color:#94a3b8;"></i>${shortenPoLabel(po.po)}</div>
                            <div class="receiving-po-date">${po.dateLabel || ""}</div>
                        </div>
                        ${(po.maDH || "").trim() ? `<div class="receiving-po-meta">${po.maDH}</div>` : ""}
                        ${(po.maHang || "").trim() ? `<div class="receiving-po-submeta">${po.maHang}</div>` : ""}
                    </div>
                `;
            }).join("");

            const receivingEmptyState = receivingRealState.error
                ? `<div style="color:#dc2626;font-size:16px;line-height:1.5;grid-column:1/-1;">Không tải được dữ liệu chuẩn bị về.<br>${receivingRealState.error}</div>`
                : '<div style="color:#94a3b8;font-size:20px;grid-column:1/-1;">Chưa có dữ liệu</div>';

            document.getElementById("receivingWrap").innerHTML = `
                <div style="display:grid;grid-template-rows:auto 1fr auto;height:100%;min-height:0;gap:12px;">
                    <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;">
                        <div style="font-weight:800;color:#0f172a;font-size:29px;display:inline-flex;align-items:center;gap:10px;">
                            <i class="fa-solid fa-ship" style="color:#0284c7;font-size:24px;padding-right:18px"></i>
                            <span>Chuẩn bị về</span>
                        </div>
                    </div>
                    
                    <div class="receiving-po-grid">
                        ${poListHtml || receivingEmptyState}
                    </div>
                    ${buildFlowPagerHtml("receiving", panelState)}
                </div>
            `;

            bindFlowPagerEvents();
        }
        
        function renderCapacity() {
            const summary = latestDashboardSummary || getDashboardSummary();
            renderShippingData(summary);
            renderReadyShippingData(summary);
            renderReceivingData(summary);
            bindFlowPagerEvents();
        }

        function getLoadColor(total) {
            if (total >= 13) return "linear-gradient(90deg, #f97316, #dc2626)";
            if (total >= 8) return "linear-gradient(90deg, #f59e0b, #d97706)";
            return "linear-gradient(90deg, #22c55e, #16a34a)";
        }

        function inboundBadge(total) {
            if (total >= 13) return '<span class="badge-status" style="background:#dc2626;">Quá tải</span>';
            if (total >= 8) return '<span class="badge-status" style="background:#d97706;">Cao</span>';
            return '<span class="badge-status" style="background:#16a34a;">Bình thường</span>';
        }

        function renderOutboundDetail(summary) {
            const dateGroups = Array.isArray(summary.outboundByDate) ? summary.outboundByDate : [];
            let runningCumulative = 0;

            const rowsHtml = dateGroups.map(function (dateGroup) {
                const orderMap = new Map();
                (dateGroup.rows || []).forEach(function (row) {
                    const key = (row.lenh || "").toString();
                    if (!orderMap.has(key)) orderMap.set(key, []);
                    orderMap.get(key).push(row);
                });

                const orderCodes = [...orderMap.keys()].sort(compareOrderCode);
                const orderHtml = orderCodes.map(function (orderCode) {
                    const details = (orderMap.get(orderCode) || []).sort(function (a, b) {
                        return (a.itemCode || "").localeCompare(b.itemCode || "", "vi-VN", { numeric: true });
                    });

                    const detailRows = details.map(function (item) {
                        const spec = getOutboundItemSpec(item.itemCode);
                        const actual = Number(item.thucXuat) || 0;
                        runningCumulative += actual;

                        return `
                            <tr>
                                <td class="outbound-material">${item.itemCode || ""}</td>
                                <td>${item.materialType || ""}</td>
                                <td>${spec.mau}</td>
                                <td>${spec.widthSize}</td>
                                <td>${item.unit || ""}</td>
                                <td class="outbound-cell-right">${(Number(item.tonKho) || 0).toLocaleString("vi-VN", { maximumFractionDigits: 2 })}</td>
                                <td class="outbound-cell-right">${(Number(item.yeuCau) || 0).toLocaleString("vi-VN", { maximumFractionDigits: 2 })}</td>
                                <td class="outbound-cell-right">${actual.toLocaleString("vi-VN", { maximumFractionDigits: 2 })}</td>
                                <td class="outbound-cell-cum">${runningCumulative.toLocaleString("vi-VN", { maximumFractionDigits: 2 })}</td>
                            </tr>
                        `;
                    }).join("");

                    return `
                        <tr class="outbound-group-order">
                            <td colspan="9">Mã lệnh: ${orderCode}</td>
                        </tr>
                        ${detailRows}
                    `;
                }).join("");

                return `
                    <tr class="outbound-group-date">
                        <td colspan="9">Ngày xuất: ${dateGroup.dateLabel}</td>
                    </tr>
                    ${orderHtml}
                `;
            }).join("");

            document.getElementById("outboundDetailWrap").innerHTML = `
                <div class="outbound-detail-wrap">
                    <div class="outbound-detail-scroll">
                        <table class="outbound-detail-table">
                            <thead>
                                <tr>
                                    <th>Vật tư</th>
                                    <th>Loại vật tư</th>
                                    <th>Màu</th>
                                    <th>Width/size</th>
                                    <th>Đơn vị</th>
                                    <th>Tồn kho</th>
                                    <th>Yêu cầu</th>
                                    <th>Thực xuất</th>
                                    <th>Lũy kế</th>
                                </tr>
                            </thead>
                            <tbody>${rowsHtml || '<tr><td colspan="9">Chưa có dữ liệu xuất hàng</td></tr>'}</tbody>
                        </table>
                    </div>
                </div>
            `;
        }

        function renderLowStock() {
            const html = demoState.lowStock.map(item => `
                <tr>
                    <td>${item.ma}</td>
                    <td>${item.ten}</td>
                    <td style="text-align:right;">${item.ton.toLocaleString("vi-VN")}</td>
                    <td style="text-align:right;">${item.min.toLocaleString("vi-VN")}</td>
                    <td>${statusBadge(item.status)}</td>
                </tr>
            `).join("");
            document.getElementById("lowStockBody").innerHTML = html;
        }

        function renderMaterialRequests() {
            const html = demoState.materialRequests.map(item => `
                <tr>
                    <td>${item.chuyen}</td>
                    <td>${item.lenh}</td>
                    <td style="text-align:right;font-weight:700;">${item.soMaVt}</td>
                    <td>${levelBadge(item.level)}</td>
                </tr>
            `).join("");
            document.getElementById("materialReqBody").innerHTML = html;
        }

        function renderTimeline() {
            const html = demoState.timeline.map(item => {
                let dotColor = "#9ca3af";
                if (item.level === "bad") dotColor = "#dc2626";
                if (item.level === "warn") dotColor = "#d97706";
                if (item.level === "good") dotColor = "#16a34a";
                if (item.level === "info") dotColor = "#2563eb";
                return `
                    <li class="timeline-item">
                        <span class="timeline-dot" style="background:${dotColor};"></span>
                        <div class="timeline-time">${item.time}</div>
                        <div class="timeline-text">${item.text}</div>
                    </li>
                `;
            }).join("");
            document.getElementById("timelineList").innerHTML = html;
        }

        function setClock() {
            const now = new Date();
            const clock = now.toLocaleTimeString("vi-VN", { hour12: false });
            const date = now.toLocaleDateString("vi-VN");
            const clockEl = document.getElementById("clock");
            const dateEl = document.getElementById("dateText");
            if (clockEl) clockEl.textContent = clock;
            if (dateEl) dateEl.textContent = date;
        }

        function setUpdatedNow() {
            return;
        }

        function randomInt(min, max) {
            return Math.floor(Math.random() * (max - min + 1)) + min;
        }

        function initUserActivityTracking() {
            const events = ["mousemove", "mousedown", "wheel", "keydown", "touchstart"];
            events.forEach(function (eventName) {
                document.addEventListener(eventName, markUserInteraction);
            });
        }

        function refreshOverallWarehouseData() {
            if (overallCapacityRealState.loaded) {
               
                demoState.overallWarehouse.nguyenLieu.inbound = demoState.kpis[2].value;
                demoState.overallWarehouse.nguyenLieu.outbound = demoState.kpis[3].value;
                demoState.overallWarehouse.nguyenLieu.pending = demoState.kpis[4].value;
                demoState.overallWarehouse.nguyenLieu.alerts = demoState.kpis[5].value;

                const plLive = demoState.overallWarehouse.phuLieu;
                plLive.inbound = Math.max(0, plLive.inbound + randomInt(15, 70));
                plLive.outbound = Math.max(0, plLive.outbound + randomInt(10, 60));
                plLive.pending = Math.max(4, plLive.pending + randomInt(-1, 1));
                plLive.alerts = Math.max(0, plLive.alerts + randomInt(-1, 1));
                return;
            }

            const nplRacks = getAllRacks();
            const nplUsed = nplRacks.reduce((sum, item) => sum + item.stored, 0);
            const nplCapacity = nplRacks.reduce((sum, item) => sum + item.capacity, 0);

            demoState.overallWarehouse.nguyenLieu.used = nplUsed;
            demoState.overallWarehouse.nguyenLieu.capacity = nplCapacity;
            demoState.overallWarehouse.nguyenLieu.inbound = demoState.kpis[2].value;
            demoState.overallWarehouse.nguyenLieu.outbound = demoState.kpis[3].value;
            demoState.overallWarehouse.nguyenLieu.pending = demoState.kpis[4].value;
            demoState.overallWarehouse.nguyenLieu.alerts = demoState.kpis[5].value;

            const pl = demoState.overallWarehouse.phuLieu;
            pl.capacity = 1100;
            pl.used = clamp(pl.used + randomInt(-6, 8), Math.floor(pl.capacity * 0.58), pl.capacity);
            pl.inbound = Math.max(0, pl.inbound + randomInt(15, 70));
            pl.outbound = Math.max(0, pl.outbound + randomInt(10, 60));
            pl.pending = Math.max(4, pl.pending + randomInt(-1, 1));
            pl.alerts = Math.max(0, pl.alerts + randomInt(-1, 1));
        }

        function simulateRefresh() {
            syncSkuKpi();
            demoState.kpis[2].value += randomInt(30, 120);
            demoState.kpis[3].value += randomInt(25, 90);
            demoState.kpis[4].value = Math.max(10, demoState.kpis[4].value + randomInt(-2, 2));
            demoState.kpis[5].value = Math.max(4, demoState.kpis[5].value + randomInt(-1, 1));
            demoState.kpis[6].value = Math.max(1, demoState.kpis[6].value + randomInt(-1, 1));
            demoState.kpis[7].value = Math.max(0, demoState.kpis[7].value + randomInt(-1, 1));

            demoState.capacityPages.forEach(page => {
                page.racks.forEach(item => {
                    const nextStored = item.stored + randomInt(-3, 4);
                    item.stored = Math.max(Math.floor(item.capacity * 0.55), Math.min(item.capacity, nextStored));
                    item.throughput = clamp((item.throughput || 88) + randomInt(-2, 2), 75, 99);
                    item.fifo = clamp((item.fifo || 86) + randomInt(-2, 2), 72, 99);

                    const shiftedCustomers = (item.customers || []).map(customer => ({
                        name: customer.name,
                        qty: Math.max(0, (customer.qty || 0) + randomInt(-2, 2))
                    }));

                    item.customers = normalizeCustomerQuantities(shiftedCustomers, item.stored);
                });
            });

            demoState.operations.forEach(item => {
                item.choNhan = Math.max(0, item.choNhan + randomInt(-1, 2));
                item.dangDo = Math.max(0, item.dangDo + randomInt(-1, 1));
                item.choQc = Math.max(0, item.choQc + randomInt(-1, 1));
            });

            const inboundRiskCount = demoState.operations.filter(item => (item.choNhan + item.dangDo + item.choQc) >= 13).length;
            demoState.kpis[5].value = inboundRiskCount;
            demoState.kpis[5].note = inboundRiskCount > 0
                ? inboundRiskCount + " khu tiếp nhận quá tải"
                : "Tiếp nhận ổn định";

            demoState.materialRequests.forEach(item => {
                item.soMaVt = Math.max(1, item.soMaVt + randomInt(-1, 1));
            });
            demoState.kpis[4].value = demoState.materialRequests.length;
            demoState.kpis[6].note = demoState.kpis[6].value > 3 ? "Có phiếu kiểm kê tồn đọng" : "Tiến độ kiểm kê ổn định";
            demoState.kpis[7].note = demoState.kpis[7].value > 0 ? "Còn lệnh thu hồi chưa hoàn tất" : "Không có lệnh thu hồi tồn";

            demoState.purchaseOrders.forEach(item => {
                const planned = Math.max(0, Number(item.slMua) || 0);
                const nextNhap = (Number(item.slNhap) || 0) + randomInt(-120, 220);
                item.slNhap = clamp(nextNhap, 0, planned);
                if (randomInt(1, 12) === 1) {
                    item.etaOffset = clamp((Number(item.etaOffset) || 0) + randomInt(-1, 1), 0, 7);
                }
                if (item.slNhap >= planned && planned > 0) item.qcStatus = "Đã kiểm";
                else if (item.slNhap > 0) item.qcStatus = "Đang QC";
                else item.qcStatus = "Chưa kiểm";
            });

            demoState.outboundShipments.forEach(order => {
                order.items = (order.items || []).map(row => {
                    const req = Math.max(0, (Number(row.yeuCau) || 0) + randomInt(-2, 3));
                    const actual = clamp((Number(row.thucXuat) || 0) + randomInt(-2, 3), 0, req);
                    const stock = Math.max(0, (Number(row.tonKho) || 0) + randomInt(-30, 40));
                    return {
                        ...row,
                        yeuCau: req,
                        thucXuat: actual,
                        tonKho: stock
                    };
                });
            });

            const sampleEvents = [
                "Nhập kho 180m vải TC65 - Khu A.3",
                "Xuất kho 90m bo thun - Lệnh SX #LSX9038",
                "Cảnh báo: Khu C dồn phiếu nhập, chờ QC tăng",
                "Điều chuyển 8 kiện phụ trợ sang khu buffer",
                "Yêu cầu cấp NL ưu tiên cao từ Chuyền 01",
                "Kiểm kê định kỳ Khu B đang chờ xác nhận",
                "Phát sinh lệnh thu hồi lô NL-8941 theo biên bản QC"
            ];

            const now = new Date().toLocaleTimeString("vi-VN", { hour12: false });
            demoState.timeline.unshift({
                time: now,
                text: sampleEvents[randomInt(0, sampleEvents.length - 1)],
                level: ["good", "warn", "bad", "info"][randomInt(0, 3)]
            });
            demoState.timeline = demoState.timeline.slice(0, 7);
            refreshOverallWarehouseData();
            const summary = getDashboardSummary();
            latestDashboardSummary = summary;

            renderCustomerSpotlight(summary);
            renderSituationPanel(summary);
            renderHeaderMetrics();
            renderTotalWarehouseOverview();
            renderCapacity();
            setUpdatedNow();
        }

        function buildFlowPagerHtml(type, state) {
            if (!state || state.totalPages <= 1) return "";
            const dotsHtml = Array.from({ length: state.totalPages }, function (_, index) {
                return `<button type="button" class="page-dot ${index === state.page ? "active" : ""}" data-flow-type="${type}" data-flow-page="${index}"></button>`;
            }).join("");
            return `
                <div style="display:flex;justify-content:center;align-items:center;gap:8px;padding:8px 0;">
                    <button type="button" class="tv-btn" data-flow-nav="${type}" data-flow-step="-1" aria-label="Trang trước"><i class="fa-solid fa-chevron-left"></i></button>
                    ${dotsHtml}
                    <button type="button" class="tv-btn" data-flow-nav="${type}" data-flow-step="1" aria-label="Trang sau"><i class="fa-solid fa-chevron-right"></i></button>
                </div>
            `;
        }

        function bindFlowPagerEvents() {
            const dots = document.querySelectorAll("[data-flow-type]");
            for (let i = 0; i < dots.length; i++) {
                dots[i].onclick = function () {
                    const type = this.getAttribute("data-flow-type");
                    const page = Number(this.getAttribute("data-flow-page")) || 0;
                    runPagerActionOnce(`flow-dot-${type}`, () => {
                        this.disabled = true;
                        markUserInteraction();
                        if (type === "receiving") {
                            flowPanelsState.receiving.page = page;
                            renderReceivingData(latestDashboardSummary);
                        } else if (type === "shipping") {
                            flowPanelsState.shipping.page = page;
                            renderShippingData(latestDashboardSummary);
                        } else if (type === "ready") {
                            flowPanelsState.ready.page = page;
                            renderReadyShippingData(latestDashboardSummary);
                        }
                    });
                };
            }

            const navButtons = document.querySelectorAll("[data-flow-nav]");
            for (let i = 0; i < navButtons.length; i++) {
                navButtons[i].onclick = function () {
                    const type = this.getAttribute("data-flow-nav");
                    const step = Number(this.getAttribute("data-flow-step")) || 0;
                    if (!type || !step || !flowPanelsState[type]) return;
                    runPagerActionOnce(`flow-nav-${type}`, () => {
                        this.disabled = true;
                        markUserInteraction();
                        const state = flowPanelsState[type];
                        const totalPages = Math.max(1, state.totalPages || 1);
                        state.page = (state.page + step + totalPages) % totalPages;
                        if (type === "receiving") renderReceivingData(latestDashboardSummary);
                        if (type === "shipping") renderShippingData(latestDashboardSummary);
                        if (type === "ready") renderReadyShippingData(latestDashboardSummary);
                    });
                };
            }
        }

        function restartCustomerWhereAuto() {
            if (customerWhereState.timer) {
                clearInterval(customerWhereState.timer);
                customerWhereState.timer = null;
            }
            customerWhereState.timer = setInterval(function () {
                if (!latestDashboardSummary || !isAutoRotateAllowed()) return;
                const totalPages = customerWhereState.totalPages || 1;
                if (totalPages <= 1) return;
                customerWhereState.page = (customerWhereState.page + 1) % totalPages;
                renderTotalWarehouseOverview();
            }, customerWhereState.autoMs);
        }

        function restartFlowPanelsAuto() {
            ['receiving', 'shipping', 'ready'].forEach(function(type) {
                const state = flowPanelsState[type];
                if (state.timer) {
                    clearInterval(state.timer);
                    state.timer = null;
                }
                state.timer = setInterval(function () {
                    if (!latestDashboardSummary || !isAutoRotateAllowed()) return;
                    if (state.totalPages <= 1) return;
                    state.page = (state.page + 1) % state.totalPages;
                    if (type === "receiving") renderReceivingData(latestDashboardSummary);
                    if (type === "shipping") renderShippingData(latestDashboardSummary);
                    if (type === "ready") renderReadyShippingData(latestDashboardSummary);
                }, state.autoMs);
            });
        }

        function init() {
            initUserActivityTracking();
            applyCustomersFromKhachHangSource();
            syncSkuKpi();
            loadRealOverallCapacity();
            loadRealRacks();
            loadRealWarehouseCustomers();
            loadRealReceivingData();
            loadRealShippingData();
            loadRealReadyShippingData();

            const summary = getDashboardSummary();
            latestDashboardSummary = summary;
            
            renderCustomerSpotlight(summary);
            renderSituationPanel(summary);
            renderHeaderMetrics();
            renderTotalWarehouseOverview();
            renderCapacity();
            
            setClock();
            setUpdatedNow();
            restartCustomerSpotlightAuto();
            restartCustomerWhereAuto();
            restartFlowPanelsAuto();
            goTvPage(0, false);
            restartTvPageAuto();
            
            setInterval(setClock, 1000);
            setInterval(loadRealOverallCapacity, 60000);
            setInterval(loadRealRacks, 60000);
            setInterval(loadRealWarehouseCustomers, 60000);
            setInterval(loadRealReceivingData, 60000);
            setInterval(loadRealShippingData, 60000);
            setInterval(loadRealReadyShippingData, 60000);
            setInterval(function () {
                window.location.reload();
            }, 300000);
        }

        init();
    
    </script>
</body>
</html>
