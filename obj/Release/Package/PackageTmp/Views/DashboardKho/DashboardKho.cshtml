@{
    Layout = null;
    Response.ContentType = "text/html; charset=utf-8";
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.HeaderEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";
    Response.Cache.SetCacheability(System.Web.HttpCacheability.NoCache);
    Response.Cache.SetNoStore();
    Response.Cache.SetRevalidation(System.Web.HttpCacheRevalidation.AllCaches);
    Response.Cache.SetExpires(DateTime.UtcNow.AddMinutes(-1));
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>Dashboard Kho</title>
    <link href="~/Scripts/ViTriKho/bootstrap5.3.min.css" rel="stylesheet" />
    <link href="~/css/fontawesome-6.2.1/css/all.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js"></script>
    <style>
        :root {
            --bg: #e9f6ff;
            --card: #ffffff;
            --line: #c6e7f8;
            --text: #0f172a;
            --muted: #475569;
            --good: #16a34a;
            --warn: #0284c7;
            --bad: #dc2626;
            --primary: #0ea5e9;
            --primary-dark: #0369a1;
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
            font-family: "Segoe UI", Arial, sans-serif;
            overflow: hidden;
        }

        .page {
            max-width: none;
            width: 100%;
            margin: 0 auto;
            padding: 12px;
            height: 100vh;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .tv-page-wrap {
            flex: 1;
            min-height: 0;
            position: relative;
            overflow: hidden;
        }

        .tv-page {
            display: none;
            height: 100%;
            overflow: hidden;
            padding-right: 0;
        }

        .tv-page.active {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .tv-pager {
            position: fixed;
            right: 14px;
            top: auto;     
            bottom: 14px;   
            z-index: 30;
            background: rgba(255, 255, 255, 0.15); 
            border: 1px solid rgba(191, 219, 254, 0.3);
            border-radius: 999px;
            padding: 6px 8px;
            display: flex;
            align-items: center;
            gap: 6px;
            box-shadow: 0 1px 6px rgba(15, 23, 42, 0.05);
            backdrop-filter: blur(4px); 
            opacity: 0.25;
            transition: all 0.3s ease;
        }

        .tv-pager:hover {
            opacity: 1; 
            background: rgba(255, 255, 255, 0.9);
        }
        .tv-btn {
            border: 1px solid #cbd5e1;
            background: #fff;
            color: #334155;
            border-radius: 999px;
            width: 22px;
            height: 22px;
            line-height: 20px;
            padding: 0;
            font-size: 13px;
            cursor: pointer;
        }

        .tv-btn:disabled,
        .spotlight-btn:disabled,
        .page-dot:disabled {
            opacity: 0.45;
            cursor: not-allowed;
        }

        .tv-btn i,
        .spotlight-btn i {
            font-size: 11px;
            line-height: 1;
        }


        .tv-page-label {
            font-size: 11px;
            color: var(--muted);
            margin-right: 4px;
            display: none;
        }

        .card-box {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 12px;
            box-shadow: 0 2px 10px rgba(2, 132, 199, .08);
        }

        .header-main {
            padding: 8px 14px;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 12px;
            border-color: #9fd9f6;
            background: linear-gradient(180deg, #f8fdff 0%, #eaf7ff 100%);
        }

        .title-wrap h1 {
            margin: 0;
            font-size: 24px;
            font-weight: 700;
        }

        .title-wrap p {
            margin: 4px 0 0;
            color: var(--muted);
            font-size: 14px;
        }

        .live-box {
            display: flex;
            align-items: baseline;
            justify-content: flex-end;
            gap: 14px;
            width: 100%;
            text-align: right;
        }

        .summary-title-row {
            display: grid;
            grid-template-columns: minmax(240px, 0.85fr) minmax(0, 2.65fr);
            align-items: flex-start;
            gap: 14px;
            margin-bottom: 4px;
        }

        .summary-title-main {
            min-width: 0;
        }

        .summary-title-row .live-box {
            width: 100%;
            display: grid;
            grid-template-columns: minmax(200px, 1.45fr) repeat(5, minmax(0, 1fr));
            gap: 8px;
            align-items: stretch;
            flex-wrap: nowrap;
            margin-left: 0;
        }

        .live-field.sku {
            min-width: 0;
        }

        .live-field {
            display: grid;
            gap: 2px;
            justify-items: center;
            min-width: 0;
            width: 100%;
            padding: 5px 8px 6px;
            border: 1px solid #dbeafe;
            border-radius: 10px;
            background: linear-gradient(180deg, #ffffff, #f8fbff);
            text-align: center;
        }

        .live-label {
            font-size: 15px; 
            font-weight: 700;
            color: #0f766e;
            line-height: 1;
        }

        .live-value {
            font-size: 28px; 
            font-weight: 800;
            color: var(--primary);
            line-height: 1.02;
        }

        .live-detail {
            margin-top: 2px;
            display: grid;
            gap: 4px;
            justify-items: center;
            width: 100%;
        }

        .live-detail-line {
            font-size: 14px; 
            line-height: 1.25;
            color: #334155;
            text-align: center;
        }

        .live-field.sku .live-detail-line {
            white-space: nowrap;
        }

        .live-chip-row {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 4px;
        }

        .live-chip {
            border: 1px solid #bfdbfe;
            background: #eff6ff;
            color: #1e3a8a;
            border-radius: 999px;
            padding: 2px 8px;
            font-size: 10px;
            line-height: 1.2;
            white-space: nowrap;
        }

        .live-field.inbound .live-value {
            color: #0ea5e9;
        }

        .live-field.outbound .live-value {
            color: #7c3aed;
        }

        .live-field.date .live-value,
        .live-field.time .live-value {
            color: #0f172a;
        }

        .summary-focus-card {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .summary-focus-card #totalWarehouseWrap {
            flex: 1;
            min-height: 0;
        }

        .chart-focus-card {
            display: flex;
            flex-direction: column;
            gap: 8px;
            min-height: 0;
            overflow: hidden;
        }

        .insight-grid {
            margin-top: 8px;
            display: grid;
            grid-template-columns: 1.75fr .75fr .75fr;
            gap: 10px;
        }

        .insight-card {
            padding: 10px;
            border-radius: 16px;
            border: 1px solid var(--line);
            background: radial-gradient(circle at top right, rgba(59,130,246,.08), transparent 28%), linear-gradient(180deg,#fff,#f8fbff);
        }

        .insight-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 8px;
            margin-bottom: 10px;
        }

        .insight-title {
            font-size: 17px;
            font-weight: 800;
            line-height: 1.25;
            color: #0f172a;
        }

        .insight-sub {
            font-size: 12px;
            color: var(--muted);
            margin-top: 3px;
        }

        .signal-badge {
            border-radius: 999px;
            padding: 4px 10px;
            font-size: 11px;
            font-weight: 700;
            color: #fff;
            white-space: nowrap;
        }

        .signal-badge.good { background: var(--good); }
        .signal-badge.warn { background: var(--warn); }
        .signal-badge.bad { background: var(--bad); }

        .signal-list {
            display: grid;
            gap: 8px;
        }

        .signal-item {
            border: 1px solid #dbeafe;
            background: #fff;
            border-radius: 12px;
            padding: 9px 10px;
        }

        .signal-item-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
        }

        .signal-label {
            font-size: 13px;
            font-weight: 700;
            color: #0f172a;
        }

        .signal-value {
            font-size: 20px;
            font-weight: 800;
            line-height: 1;
        }

        .signal-note {
            margin-top: 4px;
            font-size: 12px;
            color: var(--muted);
        }

        .action-page {
            display: grid;
            gap: 8px;
        }

        .action-table-wrap {
            border: 1px solid #dbeafe;
            border-radius: 10px;
            overflow: hidden;
            background: #fff;
        }

        .action-table-scroll {
            max-height: 210px;
            overflow: auto;
        }

        .action-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
        }

        .action-table th,
        .action-table td {
            border: 1px solid #e2e8f0;
            padding: 4px 6px;
            white-space: nowrap;
            vertical-align: middle;
        }

        .action-table th {
            position: sticky;
            top: 0;
            background: linear-gradient(180deg, #0ea5e9, #0284c7);
            color: #ffffff;
            border-color: #7dd3fc;
            z-index: 1;
        }

        .action-table td.wrap {
            white-space: normal;
        }

        .action-group-date td {
            background: #dff4ff;
            color: #075985;
            font-weight: 800;
        }

        .action-group-order td {
            background: #f0f9ff;
            color: #0f172a;
            font-weight: 700;
        }

        .action-detail-muted {
            color: #64748b;
            font-style: italic;
        }

        .action-group-date-cell {
            background: #dff4ff;
            color: #075985;
            font-weight: 800;
            vertical-align: top;
        }

        .action-group-order-cell {
            background: #f0f9ff;
            color: #0f172a;
            font-weight: 700;
            vertical-align: top;
        }

        .action-page-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .action-page-text {
            font-size: 11px;
            color: var(--muted);
        }

        .action-pager {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .spotlight-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px;
        }

        .spotlight-card {
            border: 1px solid #dbeafe;
            border-radius: 12px;
            background: #fff;
            padding: 12px;
        }

        .spotlight-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 6px;
        }

        .spotlight-name {
            font-size: 17px;
            font-weight: 800;
            color: #0f172a;
            display: flex;
            align-items: center;
            gap: 6px;
            min-width: 0;
        }

        .spotlight-total {
            font-size: 17px;
            font-weight: 800;
            color: #1d4ed8;
            white-space: nowrap;
        }

        .spotlight-meta {
            margin-top: 6px;
            font-size: 30px;
            color: var(--muted);
        }

        .spotlight-racks {
            margin-top: 8px;
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
        }

        .customer-materials {
            margin-top: 7px;
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
        }

        .customer-material-chip {
            font-size: 11px;
            font-weight: 600;
            color: #0f172a;
            border-radius: 999px;
            padding: 2px 8px;
            background: #f8fafc;
            border: 1px solid #cbd5e1;
        }

        .spotlight-chip {
            font-size: 11px;
            font-weight: 700;
            color: #0f172a;
            border-radius: 999px;
            padding: 3px 8px;
            background: #edf4ff;
            border: 1px solid #bfdbfe;
        }

        .spotlight-footer {
            margin-top: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .spotlight-page-text {
            font-size: 11px;
            color: var(--muted);
        }

        .spotlight-pager {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .spotlight-btn {
            border: 1px solid #cbd5e1;
            background: #fff;
            color: #334155;
            border-radius: 8px;
            width: 24px;
            height: 24px;
            line-height: 22px;
            padding: 0;
            font-size: 14px;
            cursor: pointer;
        }

        .page-dot {
            width: 8px;
            height: 8px;
            border: none;
            border-radius: 999px;
            background: #cbd5e1;
            cursor: pointer;
            padding: 0;
        }

        .page-dot.active {
            width: 18px;
            background: #2563eb;
        }

        .situation-grid {
            display: grid;
            gap: 8px;
        }

        .situation-main {
            border-radius: 14px;
            padding: 12px;
            color: #fff;
            background: linear-gradient(135deg, #0f172a, #1d4ed8);
        }

        .situation-main .big {
            font-size: 34px;
            font-weight: 800;
            line-height: 1;
        }

        .situation-main .small {
            margin-top: 6px;
            font-size: 13px;
            color: rgba(255, 255, 255, .84);
        }

        .situation-tiles {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .situation-tile {
            border: 1px solid #dbeafe;
            border-radius: 12px;
            padding: 10px;
            background: #fff;
        }

        .situation-tile .label {
            font-size: 11px;
            color: var(--muted);
        }

        .situation-tile .value {
            margin-top: 3px;
            font-size: 24px;
            font-weight: 800;
            color: #0f172a;
        }

        .section-card {
            padding: 10px;
        }

        .tv-page[data-tv-page="1"].active {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .tv-page[data-tv-page="1"] .section-card {
            height: 100%;
            min-height: 0;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .tv-page[data-tv-page="1"] #kpiGrid,
        .tv-page[data-tv-page="1"] .layout-3 {
            flex: 1;
            min-height: 0;
        }

        .section-title {
            margin: 0 0 4px;
            font-size: 18px;
            font-weight: 800;
            color: var(--primary-dark);
        }

        .section-caption {
            margin-top: -2px;
            margin-bottom: 6px;
            font-size: 12px;
            color: var(--muted);
        }

        .kpi-grid {
            margin-top: 8px;
            display: grid;
            grid-template-columns: repeat(4, minmax(180px, 1fr));
            gap: 10px;
        }

        .kpi-card {
            padding: 10px 12px;
        }

        .kpi-label {
            font-size: 14px;
            color: #64748b;
        }

        .kpi-value {
            font-size: 34px;
            font-weight: 800;
            line-height: 1;
            margin-top: 2px;
        }

        .kpi-note {
            font-size: 12px;
            color: var(--muted);
            margin-top: 4px;
            min-height: 18px;
        }

        .kpi-sub-list {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 6px;
        }

        .tv-page[data-tv-page="1"] .kpi-card {
            text-align: center;
        }

        .tv-page[data-tv-page="1"] .kpi-sub-list {
            justify-content: center;
        }

        .tv-page[data-tv-page="1"] .kpi-label {
            font-size: 12px;
        }

        .tv-page[data-tv-page="1"] .kpi-value {
            font-size: 28px;
        }

        .tv-page[data-tv-page="1"] .kpi-note {
            font-size: 10px;
        }

        .tv-page[data-tv-page="1"] .kpi-sub-item {
            font-size: 10px;
            padding: 2px 7px;
        }

        .kpi-sub-item {
            font-size: 11px;
            padding: 3px 8px;
            border: 1px solid #bfdbfe;
            background: #eff6ff;
            color: #1e3a8a;
            border-radius: 999px;
        }

        .total-overview-grid {
            display: grid;
            grid-template-columns: 1.05fr 1.35fr;
            gap: 10px;
            align-items: stretch;
        }

        .warehouse-side {
            display: grid;
            grid-template-rows: auto auto;
            gap: 8px;
            height: 100%;
        }

        .warehouse-cards {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .warehouse-card {
            border: 1px solid #dbeafe;
            border-radius: 10px;
            padding: 10px;
        }

        .warehouse-head {
            display: flex;
            justify-content: space-between;
            font-weight: 700;
            gap: 8px;
        }

        .warehouse-percent {
            font-size: 12px;
            color: #1e3a8a;
        }

        .capacity-track {
            height: 14px;
            border-radius: 999px;
            background: #e2e8f0;
            overflow: hidden;
            margin-top: 6px;
        }

        .capacity-fill {
            height: 100%;
            border-radius: inherit;
        }

        .rack-meta {
            margin-top: 6px;
            font-size: 12px;
            color: var(--muted);
        }

        .warehouse-kpis {
            margin-top: 8px;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 6px;
        }

        .warehouse-kpi {
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 7px;
            font-size: 11px;
        }

        .overall-col-chart {
            border: 1px solid #dbeafe;
            border-radius: 10px;
            padding: 10px;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        .capacity-formula {
            text-align: right;
            font-size: 12px;
            color: var(--muted);
            margin-bottom: 8px;
        }

        .overall-chart-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            align-items: stretch;
            flex: 1;
        }

        .overall-pie-panel {
            display: grid;
            gap: 8px;
            justify-items: center;
        }

        .overall-pie {
            width: 180px;
            aspect-ratio: 1 / 1;
            border-radius: 50%;
            display: grid;
            place-items: center;
            position: relative;
        }

        .overall-pie::after {
            content: "";
            position: absolute;
            inset: 22px;
            border-radius: 50%;
            background: #fff;
        }

        .overall-pie-center {
            position: relative;
            z-index: 1;
            text-align: center;
        }

        .overall-pie-center .big {
            font-size: 38px;
            font-weight: 800;
            line-height: 1;
        }

        .overall-pie-center .small {
            margin-top: 4px;
            font-size: 13px;
            color: var(--muted);
        }

        .overall-pie-legend {
            width: 100%;
            display: grid;
            gap: 6px;
        }

        .overall-pie-item {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            gap: 8px;
        }

        .overall-pie-label {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-weight: 700;
        }

        .legend-box {
            display: inline-block;
            width: 12px;
            height: 12px;
            border-radius: 4px;
            flex: 0 0 auto;
        }

        .overall-col-wrap {
            position: relative;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 8px;
            align-items: end;
            min-height: 210px;
            border-left: 2px solid #cbd5e1;
            border-bottom: 2px solid #cbd5e1;
            padding: 12px 8px 0;
            background:
                linear-gradient(to top, rgba(148, 163, 184, .2) 1px, transparent 1px) 0 0 / 100% 25%,
                linear-gradient(180deg, #ffffff, #f8fbff);
        }

        .overall-col-area {
            display: grid;
            grid-template-columns: 30px minmax(0, 1fr);
            align-items: stretch;
            gap: 6px;
            min-height: 220px;
        }

        .chart-y-scale {
            display: grid;
            grid-template-rows: repeat(5, 1fr);
            align-items: end;
            justify-items: end;
            font-size: 10px;
            color: #64748b;
            padding-top: 8px;
            padding-bottom: 8px;
        }

        .overall-col-item {
            display: grid;
            justify-items: center;
            gap: 5px;
            align-content: end;
        }

        .overall-col-value {
            font-size: 24px;
            font-weight: 800;
        }

        .overall-col-track {
            width: 84px;
            height: 145px;
            border-radius: 10px 10px 0 0;
            overflow: hidden;
            background: #e2e8f0;
            display: flex;
            flex-direction: column-reverse;
            position: relative;
            box-shadow: inset -7px 0 0 rgba(15, 23, 42, .08), 0 6px 14px rgba(15, 23, 42, .14);
        }

        .overall-col-foot {
            margin-top: 4px;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 8px;
        }

        .overall-col-foot-item {
            text-align: center;
        }

        .overall-col-track::after {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            width: 9px;
            height: 100%;
            background: linear-gradient(180deg, rgba(255,255,255,.28), rgba(15,23,42,.08));
            pointer-events: none;
        }

        .overall-col-used.npl { background: linear-gradient(180deg, #2563eb, #1d4ed8); }
        .overall-col-used.pl { background: linear-gradient(180deg, #22c55e, #16a34a); }
