        function buildShippingOrders(summary, sourceType) {
            const type = (sourceType || "shipping").toString().toLowerCase();
            const dateGroups = type === "ready"
                ? (Array.isArray(summary && summary.outboundReadyByDate) ? summary.outboundReadyByDate : [])
                : (Array.isArray(summary && summary.outboundShippingByDate)
                    ? summary.outboundShippingByDate
                    : (Array.isArray(summary && summary.outboundByDate) ? summary.outboundByDate : []));
            const orders = [];

            dateGroups.forEach(function (dateGroup) {
                const orderMap = new Map();
                (dateGroup.rows || []).forEach(function (row) {
                    const key = (row.lenh || "").toString();
                    if (!key) return;
                    if (!orderMap.has(key)) {
                        orderMap.set(key, {
                            lenh: key,
                            dateLabel: dateGroup.dateLabel,
                            customer: row.customer || "-",
                            items: []
                        });
                    }
                    orderMap.get(key).items.push(row);
                });

                const sortedOrders = [...orderMap.values()].sort(function (a, b) {
                    return compareOrderCode(a.lenh, b.lenh);
                });

                sortedOrders.forEach(function (order) {
                    order.items = order.items.sort(function (left, right) {
                        return (left.itemCode || "").localeCompare(right.itemCode || "", "vi-VN", { numeric: true });
                    });
                    orders.push(order);
                });
            });

            return orders;
        }

        function buildReceivingOrders(summary) {
            const poRows = Array.isArray(summary && summary.poRows) ? summary.poRows : [];
            const orderMap = new Map();

            poRows.forEach(function (row) {
                const key = (row.po || "").toString();
                if (!key) return;
                if (!orderMap.has(key)) {
                    orderMap.set(key, {
                        po: key,
                        dateLabel: row.dateLabel || "-",
                        offset: Number(row.offset) || 0,
                        itemCount: 0,
                        orderedQty: 0,
                        receivedQty: 0,
                        pendingQty: 0
                    });
                }

                const item = orderMap.get(key);
                const ordered = Number(row.slMua) || 0;
                const received = Number(row.slNhap) || 0;
                item.itemCount += 1;
                item.orderedQty += ordered;
                item.receivedQty += received;
                item.pendingQty += Math.max(0, ordered - received);
                if ((Number(row.offset) || 0) < item.offset) {
                    item.offset = Number(row.offset) || 0;
                    item.dateLabel = row.dateLabel || item.dateLabel;
                }
            });

            return [...orderMap.values()].sort(function (a, b) {
                return (a.offset - b.offset) || compareOrderCode(a.po, b.po);
            });
        }

        function toIsoDateOnly(dateValue) {
            const date = dateValue instanceof Date ? dateValue : new Date(dateValue);
            if (Number.isNaN(date.getTime())) return "";
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, "0");
            const day = String(date.getDate()).padStart(2, "0");
            return `${year}-${month}-${day}`;
        }

        function parseDateValue(value) {
            if (!value) return null;
            const text = value.toString();
            const parsed = new Date(text);
            if (!Number.isNaN(parsed.getTime())) return parsed;

            const match = text.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/);
            if (match) {
                const day = Number(match[1]);
                const month = Number(match[2]) - 1;
                const year = Number(match[3]);
                const fallback = new Date(year, month, day);
                if (!Number.isNaN(fallback.getTime())) return fallback;
            }

            return null;
        }

        function readFieldValue(row, fieldNames) {
            for (let i = 0; i < fieldNames.length; i++) {
                const fieldName = fieldNames[i];
                if (row && Object.prototype.hasOwnProperty.call(row, fieldName) && row[fieldName] !== null && row[fieldName] !== undefined && row[fieldName] !== "") {
                    return row[fieldName];
                }
            }
            return "";
        }

        function extractRowsFromPayload(payload) {
            if (Array.isArray(payload)) return payload;
            if (!payload || typeof payload !== "object") return [];

            if (Array.isArray(payload.d)) return payload.d;
            if (payload.d && typeof payload.d === "string") {
                try {
                    const inner = JSON.parse(payload.d);
                    if (Array.isArray(inner)) return inner;
                    if (inner && typeof inner === "object") {
                        if (Array.isArray(inner.Table)) return inner.Table;
                        if (Array.isArray(inner.rows)) return inner.rows;
                        if (Array.isArray(inner.Rows)) return inner.Rows;
                    }
                } catch (e) {
                    // Ignore malformed nested json payload.
                }
            }

            if (Array.isArray(payload.Table)) return payload.Table;
            if (Array.isArray(payload.Table1)) return payload.Table1;
            if (Array.isArray(payload.data)) return payload.data;
            if (Array.isArray(payload.Data)) return payload.Data;
            if (Array.isArray(payload.rows)) return payload.rows;
            if (Array.isArray(payload.Rows)) return payload.Rows;

            const keys = Object.keys(payload);
            for (let i = 0; i < keys.length; i++) {
                const value = payload[keys[i]];
                if (Array.isArray(value)) return value;
            }

            return [];
        }

        function normalizeReceivingRealRows(rows) {
            const mappedRows = (Array.isArray(rows) ? rows : []).map(function (row) {
                const po = (readFieldValue(row, ["PO", "POMua", "Po", "po"]) || "").toString().trim();
                if (!po) return null;

                const plannedDateText = readFieldValue(row, ["NgayDuKien", "NgayNKDuKien", "NgayNhapKho_Update", "NgayNhapKho", "NgayChungTu", "NgayBienBan"]);
                const plannedDate = parseDateValue(plannedDateText);
                const quantity = Number(readFieldValue(row, ["TongSoLuong", "SoLuongSP", "SLTong", "SLNhap", "SoLuong", "SoLuongThung"])) || 0;
                const boxQty = Number(readFieldValue(row, ["SoLuongThung"])) || 0;
                const materialCount = Number(readFieldValue(row, ["SoLuongMa", "ItemCount", "SoMa"])) || 0;
                const maDH = (readFieldValue(row, ["MaDH", "madh"]) || "").toString().trim();
                const maHang = (readFieldValue(row, ["TenHang", "MaHang", "mahang"]) || "").toString().trim();

                return {
                    po: po,
                    dateLabel: plannedDate ? toDayMonthLabel(plannedDate) : "-",
                    dateValue: plannedDate,
                    itemCount: materialCount,
                    totalQuantity: quantity,
                    totalBoxes: boxQty,
                    primaryLabel: "",
                    primaryText: quantity.toLocaleString("vi-VN", { maximumFractionDigits: 2 }),
                    maDH: maDH,
                    maHang: maHang
                };
            }).filter(Boolean);

            return mappedRows.sort(function (a, b) {
                const timeA = a.dateValue ? a.dateValue.getTime() : Number.MAX_SAFE_INTEGER;
                const timeB = b.dateValue ? b.dateValue.getTime() : Number.MAX_SAFE_INTEGER;
                return (timeA - timeB) || compareOrderCode(a.po, b.po);
            });
        }

        async function loadRealReceivingData() {
            if (receivingRealState.loading) return;
            receivingRealState.loading = true;
            receivingRealState.error = "";

            try {
                const today = new Date();
                const from = new Date(today.getFullYear(), today.getMonth(), today.getDate());
                const until = addDays(from, 14);
                const url = `/api/DashboardKho/Get?tuNgay=${encodeURIComponent(toIsoDateOnly(from))}&denNgay=${encodeURIComponent(toIsoDateOnly(until))}`;
                const response = await fetch(url, { credentials: "same-origin" });
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                const payload = await response.json();
                const rows = extractRowsFromPayload(payload);

                receivingRealState.items = normalizeReceivingRealRows(rows);
                receivingRealState.loaded = true;
            } catch (error) {
                receivingRealState.error = error && error.message ? error.message : "Load receiving data failed";
                receivingRealState.loaded = false;
                receivingRealState.items = [];
            } finally {
                receivingRealState.loading = false;
                if (latestDashboardSummary) {
                    renderReceivingData(latestDashboardSummary);
                }
            }
        }

        function normalizeRackEfficiencyRows(rows) {
            return (Array.isArray(rows) ? rows : []).map(function (row) {
                const rackName = (row.TenKe || row.rack || row.Rack || "").toString().trim();
                const module = Number(row.Module || 0) || 0;
                const stored = Number(row.TongCBMSuDungTrongKe || 0) || 0;
                const capacity = Number(row.TongCBMTrongKe || 0) || 0;
                const percent = capacity > 0 ? Math.round((stored / capacity) * 100) : 0;
                return {
                    rack: rackName,
                    module: module,
                    stored: stored,
                    capacity: capacity,
                    usedPercent: clamp(percent, 0, 100)
                };
            }).filter(function (item) {
                return item.rack && item.capacity > 0;
            }).sort(function (a, b) {
                return (a.module - b.module) || a.rack.localeCompare(b.rack, "vi-VN", { numeric: true });
            });
        }

        function normalizeWarehouseCustomers(rows) {
            return (Array.isArray(rows) ? rows : []).map(function (row) {
                const maKh = (row.MaKH || "").toString().trim();
                const tenKh = (row.TenKH || row.CustomerName || "").toString().trim();
                const name = tenKh || maKh || "KH trống";
                const cbm = Number(row.CBMSDTrongKho || row.TotalCBM || 0) || 0;
                return {
                    maKh: maKh,
                    tenKh: tenKh,
                    name: name,
                    cbm: cbm,
                    qty: Number(row.SLVatTu || 0) || 0
                };
            }).sort(function (a, b) {
                return b.cbm - a.cbm;
            });
        }

        function distributeCustomersToRack(storedValue, customers) {
            const total = Math.max(0, Math.round(Number(storedValue) || 0));
            if (total <= 0) {
                return [{ name: "Chưa có khách hàng", qty: 0 }];
            }
            if (!Array.isArray(customers) || !customers.length) {
                return [{ name: "Chưa có khách hàng", qty: total }];
            }

            const weighted = customers.slice(0, 4).map(function (item) {
                return { name: item.name, qty: item.cbm > 0 ? item.cbm : 1 };
            });
            const normalized = normalizeCustomerQuantities(weighted, total);
            return normalized.length ? normalized : [{ name: "Chưa có khách hàng", qty: total }];
        }

        function applyRealRackAndCustomerData() {
            if (!rackEfficiencyRealState.loaded || !rackEfficiencyRealState.items.length) return;

            const normalizedRacks = normalizeRackEfficiencyRows(rackEfficiencyRealState.items);
            if (!normalizedRacks.length) return;

            const customerRows = customerWarehouseRealState.loaded
                ? normalizeWarehouseCustomers(customerWarehouseRealState.items)
                : [];

            dbCustomerNames.length = 0;
            customerRows.forEach(function (item) {
                dbCustomerNames.push(item.name);
            });

            const byModule = normalizedRacks.filter(function (item) {
                return Number(item.module) === 1;
            });
            const sourceRacks = byModule.length ? byModule : normalizedRacks;

            const racksForUi = sourceRacks.map(function (item) {
                return {
                    aisle: "",
                    rack: item.rack,
                    stored: Math.max(0, Number(item.stored) || 0),
                    capacity: Math.max(1, Number(item.capacity) || 1),
                    throughput: item.usedPercent,
                    fifo: item.usedPercent,
                    customers: distributeCustomersToRack(item.stored, customerRows)
                };
            });

            const pages = [];
            for (let i = 0; i < racksForUi.length; i += 6) {
                pages.push({
                    name: "Nhóm kệ " + (pages.length + 1),
                    racks: racksForUi.slice(i, i + 6)
                });
            }
            if (pages.length) {
                demoState.capacityPages = pages;
            }

            if (latestDashboardSummary) {
                latestDashboardSummary = getDashboardSummary();
                renderCustomerSpotlight(latestDashboardSummary);
                renderTotalWarehouseOverview();
                renderSituationPanel(latestDashboardSummary);
            }
        }

