        function normalizeCustomerQuantities(customers, total) {
            const safeList = (customers || [])
                .map(item => ({ name: item.name, qty: Math.max(0, Number(item.qty) || 0) }))
                .filter(item => item.name);

            if (!safeList.length) return [];
            if (total <= 0) return safeList.map(item => ({ name: item.name, qty: 0 }));

            const sumQty = safeList.reduce((sum, item) => sum + item.qty, 0);
            if (sumQty <= 0) {
                return safeList.map((item, index) => ({
                    name: item.name,
                    qty: index === 0 ? total : 0
                }));
            }

            const enriched = safeList.map(item => {
                const exact = total * (item.qty / sumQty);
                const base = Math.floor(exact);
                return { name: item.name, exact, qty: base, frac: exact - base };
            });

            let allocated = enriched.reduce((sum, item) => sum + item.qty, 0);
            let remainder = total - allocated;
            const byFrac = [...enriched].sort((a, b) => b.frac - a.frac);
            let cursor = 0;
            while (remainder > 0 && byFrac.length > 0) {
                byFrac[cursor % byFrac.length].qty += 1;
                remainder--;
                cursor++;
            }

            return enriched.map(item => ({ name: item.name, qty: item.qty }));
        }

        function getCustomerSplit(item) {
            const normalized = normalizeCustomerQuantities(item.customers, item.stored);
            item.customers = normalized;
            return normalized
                .filter(customer => customer.qty > 0)
                .sort((a, b) => b.qty - a.qty)
                .map(customer => ({
                    name: customer.name,
                    qty: customer.qty,
                    percent: item.stored > 0 ? Math.round((customer.qty / item.stored) * 100) : 0,
                    color: getCustomerColor(customer.name)
                }));
        }

        function calculateRackEfficiency(item, usedPercent) {
            const throughput = clamp(item.throughput || 0, 0, 100);
            const fifo = clamp(item.fifo || 0, 0, 100);
            return clamp(Math.round((usedPercent * 0.7) + (throughput * 0.2) + (fifo * 0.1)), 0, 99);
        }

        function buildCustomerLegendFromRacks(racks) {
            const totals = new Map();
            racks.forEach(rack => {
                const split = getCustomerSplit(rack);
                split.forEach(customer => {
                    const current = totals.get(customer.name) || 0;
                    totals.set(customer.name, current + customer.qty);
                });
            });
            return [...totals.entries()]
                .sort((a, b) => b[1] - a[1])
                .map(([name]) => ({ name, color: getCustomerColor(name) }));
        }

