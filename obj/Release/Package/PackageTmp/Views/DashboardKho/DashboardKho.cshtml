        function renderTvPager() {
            const pages = document.querySelectorAll(".tv-page");
            const totalPages = Math.max(1, pages.length || tvPageState.totalPages || 1);
            tvPageState.totalPages = totalPages;
            if (totalPages <= 1) {
                const pager = document.getElementById("tvPager");
                if (pager) pager.innerHTML = "";
                return;
            }
            const currentPage = ((tvPageState.page % totalPages) + totalPages) % totalPages;
            const dotsHtml = Array.from({ length: totalPages }, function (_, index) {
                return `<button type="button" class="page-dot ${index === currentPage ? "active" : ""}" data-tv-target="${index}" aria-label="Trang dashboard ${index + 1}"></button>`;
            }).join("");

            const pager = document.getElementById("tvPager");
            if (!pager) return;

            pager.innerHTML = `
                <span class="tv-page-label">Màn hình ${currentPage + 1}/${totalPages}</span>
                <button type="button" class="tv-btn" id="tvPrevBtn" aria-label="Trang trước"><i class="fa-solid fa-chevron-left"></i></button>
                ${dotsHtml}
                <button type="button" class="tv-btn" id="tvNextBtn" aria-label="Trang sau"><i class="fa-solid fa-chevron-right"></i></button>
            `;

            const prevBtn = document.getElementById("tvPrevBtn");
            const nextBtn = document.getElementById("tvNextBtn");
            if (prevBtn) {
                prevBtn.onclick = function () {
                    runPagerActionOnce("tv-page-nav", function () {
                        prevBtn.disabled = true;
                        markUserInteraction();
                        goTvPage(tvPageState.page - 1, true);
                    });
                };
            }
            if (nextBtn) {
                nextBtn.onclick = function () {
                    runPagerActionOnce("tv-page-nav", function () {
                        nextBtn.disabled = true;
                        markUserInteraction();
                        goTvPage(tvPageState.page + 1, true);
                    });
                };
            }
            const dots = document.querySelectorAll("[data-tv-target]");
            for (let i = 0; i < dots.length; i++) {
                dots[i].onclick = function () {
                    const target = Number(this.getAttribute("data-tv-target")) || 0;
                    runPagerActionOnce("tv-page-dot", () => {
                        this.disabled = true;
                        markUserInteraction();
                        goTvPage(target, true);
                    });
                };
            }
        }

        function goTvPage(targetPage, restartAuto) {
            const pages = document.querySelectorAll(".tv-page");
            if (!pages.length) return;

            const totalPages = pages.length;
            tvPageState.totalPages = totalPages;
            const normalized = ((targetPage % totalPages) + totalPages) % totalPages;
            tvPageState.page = normalized;

            for (let i = 0; i < pages.length; i++) {
                if (i === normalized) pages[i].classList.add("active");
                else pages[i].classList.remove("active");
            }

            renderTvPager();
            if (normalized === 0) {
                scheduleOverallCapacityChartRefresh();
            }
            if (restartAuto) {
                markUserInteraction();
                restartTvPageAuto();
            }
        }

        function getTvPageDuration() {
            if (tvPageState.page === 0) return tvPageState.page1To2Ms;
            if (tvPageState.page === 1) return tvPageState.page2To1Ms;
            return tvPageState.page1To2Ms;
        }

        function restartTvPageAuto() {
            if (tvPageState.timer) {
                clearTimeout(tvPageState.timer);
                tvPageState.timer = null;
            }

            tvPageState.timer = setTimeout(function () {
                if (isAutoRotateAllowed()) {
                    goTvPage(tvPageState.page + 1, false);
                }
                restartTvPageAuto();
            }, getTvPageDuration());
        }

