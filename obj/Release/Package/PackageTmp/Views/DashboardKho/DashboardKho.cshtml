        function buildShippingDataFromDb(rows) {
            const orderMap = new Map();
            const today = new Date();
            const todayMidnight = new Date(today.getFullYear(), today.getMonth(), today.getDate());

            const parseAnyDate = function (value) {
                if (!value) return null;
                const d = new Date(value);
                if (!Number.isNaN(d.getTime())) return d;
                const text = value.toString();
                const match = text.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/);
                if (!match) return null;
                const fallback = new Date(Number(match[3]), Number(match[2]) - 1, Number(match[1]));
                return Number.isNaN(fallback.getTime()) ? null : fallback;
            };

            const toLabel = function (dateValue) {
                if (!dateValue) return "";
                return dateValue.toLocaleDateString("vi-VN", {
                    day: "2-digit",
                    month: "2-digit",
                    year: "numeric"
                });
            };

            (rows || []).forEach(function (row) {
                const orderCode = (readFieldValue(row, ["MaLenh", "maLenh", "MaLenhSX", "maLenhSX", "PhieuYC", "phieuYC", "PhieuDK", "phieuDK"]) || "").toString().trim();
                if (!orderCode) return;

                const planDateText = readFieldValue(row, ["KHCat", "khCat", "NgayCapDate", "ngayCapDate", "NgayXuatHang", "ngayXuatHang", "NgayCapPhieu", "ngayCapPhieu", "NgayCap", "ngayCap"]);
                const expectedDateText = readFieldValue(row, ["DuKienCat", "duKienCat", "NgayXuatHang", "ngayXuatHang", "NgayCapDate", "ngayCapDate", "NgayCapPhieu", "ngayCapPhieu", "NgayCap", "ngayCap"]);

                const planDate = parseAnyDate(planDateText);
                const expectedDate = parseAnyDate(expectedDateText);
                const customerName = (readFieldValue(row, ["KhachHang", "TenKH", "TenKh", "tenKH", "CustomerName", "customer"]) || "").toString().trim();
                const fallbackCustomer = (readFieldValue(row, ["MaDH", "MaGop"]) || "").toString().trim();
                const itemCode = (readFieldValue(row, ["TenHang", "MaNPL", "MaHang", "itemCode"]) || "").toString().trim();
                const rawDate = planDate || expectedDate;
                const parsedDate = rawDate || null;
                const hasValidDate = parsedDate && !Number.isNaN(parsedDate.getTime());
                const normalizedDate = hasValidDate
                    ? new Date(parsedDate.getFullYear(), parsedDate.getMonth(), parsedDate.getDate())
                    : todayMidnight;
                const offset = Math.round((normalizedDate - todayMidnight) / (24 * 60 * 60 * 1000));

                const key = orderCode + "|" + offset;
                if (!orderMap.has(key)) {
                    orderMap.set(key, {
                        lenh: orderCode,
                        customer: customerName || fallbackCustomer || "Kh trống",
                        planDateLabel: toLabel(planDate),
                        expectedDateLabel: toLabel(expectedDate),
                        dateOffset: offset,
                        items: []
                    });
                }
                const order = orderMap.get(key);
                order.items.push({
                    itemCode: itemCode,
                    materialType: Number(readFieldValue(row, ["IsNPL", "isNPL", "NPL", "npl"])) ? 'NPL' : 'PL',
                    tonKho: 0,
                    yeuCau: Number(readFieldValue(row, ["YeuCau", "yeuCau", "SoMet", "soMet"])) || 0,
                    thucXuat: Number(readFieldValue(row, ["ThucXuat", "thucXuat", "SLXuat", "slXuat"])) || 0,
                    unit: ''
                });
            });

            return [...orderMap.values()].sort(function (a, b) {
                return (Number(a.dateOffset) || 0) - (Number(b.dateOffset) || 0) || compareOrderCode(a.lenh, b.lenh);
            });
        }

        function buildOutboundByDate(orders, now) {
            const outboundDateMap = new Map();
            const sortedOrders = (orders || [])
                .map(function (order) {
                    return {
                        ...order,
                        offset: Number(order.dateOffset) || 0
                    };
                })
                .sort(function (a, b) {
                    return (a.offset - b.offset) || compareOrderCode(a.lenh, b.lenh);
                });

            sortedOrders.forEach(function (order) {
                const offset = Number(order.offset) || 0;
                const shipDate = addDays(now, offset);
                const key = offset.toString();
                if (!outboundDateMap.has(key)) {
                    outboundDateMap.set(key, { offset: offset, dateLabel: toDayMonthLabel(shipDate), rows: [], dayTotalActual: 0, orderCodes: [] });
                }
                const dateNode = outboundDateMap.get(key);
                dateNode.orderCodes.push(order.lenh);
                (order.items || []).forEach(function (item) {
                    const actual = Number(item.thucXuat) || 0;
                    const required = Number(item.yeuCau) || 0;
                    dateNode.rows.push({
                        dateLabel: dateNode.dateLabel,
                        lenh: order.lenh,
                        customer: order.customer,
                        itemCode: item.itemCode,
                        materialType: item.materialType,
                        tonKho: Number(item.tonKho) || 0,
                        yeuCau: required,
                        thucXuat: actual,
                        unit: item.unit || ""
                    });
                    dateNode.dayTotalActual += actual;
                });
            });

            let cumulativeByDate = 0;
            return [...outboundDateMap.values()]
                .sort(function (a, b) { return a.offset - b.offset; })
                .map(function (item) {
                    item.rows.sort(function (left, right) {
                        return compareOrderCode(left.lenh, right.lenh) || (left.itemCode || "").localeCompare(right.itemCode || "", "vi-VN", { numeric: true });
                    });
                    cumulativeByDate += item.dayTotalActual;
                    return {
                        offset: item.offset,
                        dateLabel: item.dateLabel,
                        rows: item.rows,
                        dayTotalActual: item.dayTotalActual,
                        cumulativeActual: cumulativeByDate,
                        orderCodes: [...new Set(item.orderCodes)]
                    };
                });
        }

        function getDashboardSummary() {
            const racks = getAllRacks()
                .filter(item => !shouldHideCustomerRack(item.rack));
            const customerMap = buildCustomerRackMap(racks);
            const rackLoads = racks.map(item => ({
                rack: item.rack,
                usedPercent: item.capacity > 0 ? Math.round((item.stored / item.capacity) * 100) : 0,
                stored: item.stored,
                capacity: item.capacity
            })).sort((a, b) => b.usedPercent - a.usedPercent);

            const rackStored = racks.reduce((sum, item) => sum + item.stored, 0);
            const rackCapacity = racks.reduce((sum, item) => sum + item.capacity, 0);
            const nplUsed = demoState.overallWarehouse.nguyenLieu.used || 0;
            const nplCapacity = demoState.overallWarehouse.nguyenLieu.capacity || 0;
            const phuLieuStored = demoState.overallWarehouse.phuLieu.used || 0;
            const phuLieuCapacity = demoState.overallWarehouse.phuLieu.capacity || 0;

            const totalStored = overallCapacityRealState.loaded ? nplUsed : rackStored;
            const totalCapacity = overallCapacityRealState.loaded ? nplCapacity : rackCapacity;
            const freeCapacity = Math.max(0, totalCapacity - totalStored);
            const totalWarehouseStored = overallCapacityRealState.loaded
                ? (nplUsed + phuLieuStored)
                : (rackStored + phuLieuStored);
            const totalWarehouseCapacity = overallCapacityRealState.loaded
                ? (nplCapacity + phuLieuCapacity)
                : (rackCapacity + phuLieuCapacity);
            const overloadedZones = demoState.operations.filter(item => (item.choNhan + item.dangDo + item.choQc) >= 13);
            const criticalRacks = rackLoads.filter(item => item.usedPercent >= 95);
            const warningRacks = rackLoads.filter(item => item.usedPercent >= 90);
            const highPriorityRequests = demoState.materialRequests.filter(item => item.level === "Cao");
            const lowStockAlerts = demoState.lowStock.filter(item => item.status === "Cảnh báo");
            const customerShareFromRack = customerMap.map(item => ({
                name: item.name,
                total: item.total,
                percent: totalWarehouseStored > 0 ? Math.round((item.total / totalWarehouseStored) * 1000) / 10 : 0
            })).sort((a, b) => b.percent - a.percent);

            const customerDbStats = customerWarehouseRealState.loaded
                ? normalizeWarehouseCustomers(customerWarehouseRealState.items)
                : [];

            const totalDbCustomerCbm = customerDbStats.reduce(function (sum, item) {
                return sum + (Number(item.cbm) || 0);
            }, 0);

            const customerShareFromDb = customerDbStats.map(function (item) {
                const percent = totalDbCustomerCbm > 0
                    ? Math.round((item.cbm / totalDbCustomerCbm) * 1000) / 10
                    : 0;
                return {
                    name: item.name,
                    maKh: item.maKh || "",
                    tenKh: item.tenKh || "",
                    slVatTu: Number(item.qty || 0) || 0,
                    total: item.cbm,
                    percent: percent
                };
            });

            const customerShare = customerShareFromDb;

            const now = new Date();
            const poRows = (demoState.purchaseOrders || []).map(item => {
                const offset = Number(item.etaOffset) || 0;
                const etaDate = addDays(now, offset);
                return {
                    ...item,
                    offset,
                    dateLabel: toDayMonthLabel(etaDate)
                };
            }).sort((a, b) =>
                (a.offset - b.offset) ||
                (a.po || "").localeCompare(b.po || "", "vi-VN", { numeric: true }) ||
                (a.itemCode || "").localeCompare(b.itemCode || "", "vi-VN", { numeric: true })
            );

            const poByDateMap = new Map();
            poRows.forEach(item => {
                const key = item.offset.toString();
                if (!poByDateMap.has(key)) {
                    poByDateMap.set(key, { offset: item.offset, dateLabel: item.dateLabel, count: 0, rows: [] });
                }
                const row = poByDateMap.get(key);
                row.count += 1;
                row.rows.push(item);
            });
            const poByDate = [...poByDateMap.values()].sort((a, b) => a.offset - b.offset);
            const poTotalCount = new Set(poRows.map(item => item.po)).size;
            const poDueTodayCount = new Set(poRows.filter(item => item.offset === 0).map(item => item.po)).size;

            const hasReadyLive = readyShippingRealState.loaded && readyShippingRealState.items.length > 0;
            const hasShippingLive = shippingRealState.loaded && shippingRealState.items.length > 0;

            const readySource = hasReadyLive ? buildShippingDataFromDb(readyShippingRealState.items) : [];
            const shippingSource = hasShippingLive ? buildShippingDataFromDb(shippingRealState.items) : [];

            const outboundReadyByDate = buildOutboundByDate(readySource, now);
            const outboundShippingByDate = buildOutboundByDate(shippingSource, now);
            const outboundByDate = outboundShippingByDate;
            const outboundTotalQty = outboundByDate.reduce(function (sum, item) { return sum + item.dayTotalActual; }, 0);
            const outboundOrderCodes = [...new Set(shippingSource.map(function (item) { return item.lenh; }).filter(Boolean))];

            return {
                racks,
                customerMap,
                customerDbStats,
                customerShare,
                rackLoads,
                totalStored,
                totalCapacity,
                freeCapacity,
                phuLieuStored,
                totalWarehouseStored,
                totalUsedPercent: overallCapacityRealState.loaded
                    ? (Number(demoState.overallWarehouse.totalUsedPercent || 0) || 0)
                    : (totalWarehouseCapacity > 0
                        ? Math.round(((totalWarehouseStored / totalWarehouseCapacity) * 100) * 100) / 100
                        : 0),
                overloadedZones,
                criticalRacks,
                warningRacks,
                highPriorityRequests,
                lowStockAlerts,
                poRows,
                poByDate,
                poTotalCount,
                poDueTodayCount,
                outboundReadyByDate,
                outboundShippingByDate,
                outboundByDate,
                outboundTotalQty,
                outboundOrderCodes
            };
        }

        function restartActionPanelAuto() {
            if (actionPanelState.timer) {
                clearInterval(actionPanelState.timer);
                actionPanelState.timer = null;
            }

            actionPanelState.timer = setInterval(function () {
                if (!latestDashboardSummary) return;
                if (!isAutoRotateAllowed()) return;
                actionPanelState.page = (actionPanelState.page + 1) % 2;
                renderActionPanel(latestDashboardSummary);
            }, actionPanelState.autoMs);
