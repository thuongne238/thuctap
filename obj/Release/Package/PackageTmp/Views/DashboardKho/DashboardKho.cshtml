        function getOutboundItemSpec(itemCode) {
            const key = normalizeItemCodeKey(itemCode);
            if (!key) return { mau: "NA", widthSize: "NA" };

            const matched = (demoState.purchaseOrders || []).find(function (row) {
                return normalizeItemCodeKey(row.itemCode) === key;
            });

            if (!matched) return { mau: "NA", widthSize: "NA" };
            return {
