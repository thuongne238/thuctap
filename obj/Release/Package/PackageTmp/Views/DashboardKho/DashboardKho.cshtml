        function renderHeaderMetrics() {
            const sku = demoState.kpis.find(item => item.key === "sku");
            const stock = demoState.kpis.find(item => item.key === "stock");
            const inbound = demoState.kpis.find(item => item.key === "inbound");
            const outbound = demoState.kpis.find(item => item.key === "outbound");
            const formatValue = item => typeof item.value === "number"
                ? Number(item.value).toLocaleString("vi-VN")
                : item.value;
            const skuEl = document.getElementById("skuText");
            const stockEl = document.getElementById("stockText");
            const skuDetailEl = document.getElementById("skuDetail");
            const stockDetailEl = document.getElementById("stockDetail");
            const inboundEl = document.getElementById("inboundText");
            const outboundEl = document.getElementById("outboundText");
            if (skuEl && sku) skuEl.textContent = formatValue(sku);
            if (stockEl && stock) stockEl.textContent = formatValue(stock);
            if (inboundEl && inbound) inboundEl.textContent = formatValue(inbound);
            if (outboundEl && outbound) outboundEl.textContent = formatValue(outbound);

            if (skuDetailEl) {
                const npl = demoState.materialCatalog.nguyenLieu;
                const pl = demoState.materialCatalog.phuLieu;
                const skuText = `Kho NL: ${npl.skuCount} mã · Kho PL: ${pl.skuCount} mã`;
                skuDetailEl.innerHTML = `
                    <div class="live-detail-line">${skuText}</div>
                `;
