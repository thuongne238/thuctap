        function applyCustomersFromKhachHangSource() {
            const sourceNames = getCustomerNamesFromSource();
            if (!sourceNames.length) {
                demoState.capacityPages.forEach(page => {
                    page.racks.forEach(item => {
                        item.customers = [{ name: "Chưa có khách hàng", qty: item.stored }];
                    });
                });
                return;
            }

            let customerStartIndex = 0;
            demoState.capacityPages.forEach(page => {
                page.racks.forEach(item => {
                    const customerCount = Math.max(1, Math.min(4, sourceNames.length));
                    const seeded = [];
                    for (let i = 0; i < customerCount; i++) {
                        const name = sourceNames[(customerStartIndex + i) % sourceNames.length];
                        seeded.push({ name, qty: Math.max(1, (customerCount - i) * 10) });
                    }
                    customerStartIndex = (customerStartIndex + 1) % sourceNames.length;
                    item.customers = normalizeCustomerQuantities(seeded, item.stored);
                });
            });
        }

