        function buildCustomerRackMap(racks) {
            const map = new Map();
            racks.forEach(rack => {
                if (shouldHideCustomerRack(rack.rack)) return;
                const split = getCustomerSplit(rack);
                split.forEach(customer => {
                    if (!map.has(customer.name)) {
                        map.set(customer.name, { name: customer.name, total: 0, racks: [] });
                    }
                    const item = map.get(customer.name);
                    item.total += customer.qty;
                    item.racks.push({ rack: rack.rack, qty: customer.qty });
                });
            });

            return [...map.values()]
                .map(item => {
                    item.racks = item.racks.sort((a, b) => b.qty - a.qty);
                    return item;
                })
                .sort((a, b) => b.total - a.total);
        }

