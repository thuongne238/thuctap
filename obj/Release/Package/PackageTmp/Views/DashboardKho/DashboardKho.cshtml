            const plMidAngle = -90 + (pieSegments.nplPercent * 3.6) + (pieSegments.plPercent * 3.6 * 0.15);// Đặt điểm mốc ở 15% đoạn phụ liệu để tránh bị che khuất khi phần phụ liệu nhỏ
