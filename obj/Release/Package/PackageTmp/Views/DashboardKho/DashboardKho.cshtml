        function getCustomerMaterialCount(customerName, sharePercent) {
            const pool = demoState.customerMaterialCatalog || [];
            if (!pool.length) return 0;

            const customerKey = normalizeSearchText(customerName);
            const exactCount = pool.filter(row => normalizeSearchText(row.supplier) === customerKey).length;
            const estimatedCount = Math.max(0, Math.round((Number(sharePercent) || 0) * 4));

            return Math.max(exactCount, estimatedCount);
        }

        function getCustomerOwnedMaterials(customerName, takeCount) {
            const pool = demoState.customerMaterialCatalog || [];
            if (!pool.length) return [];

            const count = Math.max(1, Math.min(takeCount || 3, pool.length));
            const start = hashName(customerName || "") % pool.length;
            const step = 3;
            const usedIndex = {};
            const result = [];
            let cursor = 0;

            while (result.length < count && cursor < (pool.length * 2)) {
                const index = (start + (cursor * step)) % pool.length;
                if (!usedIndex[index]) {
                    usedIndex[index] = true;
                    const row = pool[index];
                    result.push({
                        itemCode: row.itemCode || "",
                        materialName: row.materialName || "",
                        materialType: row.materialType || "",
                        supplier: row.supplier || "Chưa rõ"
                    });
                }
                cursor++;
            }

            return result;
        }

