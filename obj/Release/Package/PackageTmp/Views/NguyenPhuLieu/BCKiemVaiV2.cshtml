    <script src="~/Scripts/NguyenPhuLieu/BCKiemVaiV2.js?Ver=1.1"></script>
    <script>
        var userName = '@ViewBag.userName';
        var _soLoID = '@ViewBag.soLoID';
        var _soLo   = '@ViewBag.soLo';
        var _maNPL  = '@ViewBag.maNPL';
        var _Dot  = '@ViewBag.Dot';
        if (window.CefSharp && _soLoID && _soLoID !== '') {
            var _original_GetSoLoID = GetSoLoID;
            GetSoLoID = async function () {
                await _original_GetSoLoID();
                $('#SoLo').val(_soLoID).trigger('change');
            };
            var _original_GetMauVai = GetMauVai;
            GetMauVai = async function () {
                await _original_GetMauVai();
                if (_maNPL && _maNPL !== '') {
                    $('#MauVai').val(_maNPL).trigger('change');
                }
            };
            var _original_GetDot = GetDot;
            GetDot = async function () {
                await _original_GetDot();
                $('#Dot').val(_Dot).trigger('change');
            };
        }
    </script>
