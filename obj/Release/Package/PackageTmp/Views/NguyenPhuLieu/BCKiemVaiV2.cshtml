    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title></title>

    <link rel="stylesheet" href="~/Content/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="~/Content/plugins/select2/css/select2.min.css">
    <link href="~/css/NguyenPhuLieu/kiemvaiv2.css" rel="stylesheet" />
    <link href="~/Scripts/ViTriKho/bootstrap5.3.min.css" rel="stylesheet" />
    <link href="~/css/TheoDoiHangXuat/fontawesome.pro.6.0.0.css" rel="stylesheet" />
    <link href="~/css/NguyenPhuLieu/other.css" rel="stylesheet" />
    <link href="~/css/NguyenPhuLieu/kiemvaiv2.css" rel="stylesheet" />

    <style>
        .table-responsive {
            display: table;
        }

        .selectedLi {
            background: #00C6F0 !important;
            border-radius: 7px;
        }

        .forecolorSelected {
            color: white !important;
        }

        li a:focus {
            background: #00C6F0;
        }

        .table-filter-container {
            text-align: right;
        }

        table, th, td {
            border: 1px ridge;
            border-collapse: collapse;
            text-align: center;
        }

        .custom-table > tbody {
            display: block;
            overflow: auto;
        }

            .custom-table > thead, .custom-table > tbody tr {
                display: table;
                width: 100%;
            }

        .custom-table > thead {
            width: 100%
        }

        .custom-table {
            width: 100%;
        }

        .button-fix {
            margin: 0px 10px !important;
            width: 118px !important;
            height: 40px !important;
        }

        .button-table {
            margin: 0px 20px !important;
            background-color: transparent !important;
            height: 40px !important;
            padding: 2px 5px !important;
        }

        .nhomloi::-webkit-scrollbar {
            display: none;
        }

        .child-nhomloi::-webkit-scrollbar {
            display: none;
        }

        .form-group {
            margin: 0rem 0rem 0.2rem 0rem !important;
            flex-direction: column;
            display: flex;
            justify-content: end;
            align-items: start;
        }

        .inputEnLine {
            text-align: center;
            font-size: 0.8rem !important;
            background-color: white !important;
            height: 1.7rem !important;
            font-weight: bold !important;
            padding: 0.125rem !important
        }

        .labelHeader {
            color: white;
            font-size: 0.8rem;
            margin-bottom: 0.1rem;
        }

        .textHeader {
            color: black;
            font-size: 0.8rem;
        }

        .card {
            margin-bottom: 0.4rem !important;
        }

        .js-width::-webkit-scrollbar {
            display: none;
        }

        .canhbaoloi::-webkit-scrollbar {
            display: none;
        }

        .set-height {
            height: calc(100vh - 400px);
        }

        /**/
        .sidebar-mini.sidebar-collapse .wrapper .content-wrapper {
            margin-left: 0 !important;
        }

        .main-sidebar, .sidebar-collapse .wrapper .main-sidebar::before {
            margin-left: -250px !important;
        }

        .sidebar-open .main-sidebar, .sidebar-collapse .wrapper .main-sidebar::before {
            margin-left: 0 !important;
        }

        body:not(.sidebar-mini-md):not(.sidebar-mini-xs):not(.layout-top-nav) .content-wrapper {
            margin-left: 0 !important;
        }

        body:not(.sidebar-mini-md):not(.sidebar-mini-xs):not(.layout-top-nav) .main-header {
            margin-left: 0 !important;
        }

        .sidebar-open #sidebar-overlay {
            display: block;
        }

        .sidebar-mini.sidebar-collapse .wrapper .main-footer {
            margin-left: 0 !important;
        }

        .check-IsQC.is-none {
            display: none;
        }

        /* Chrome, Safari, Edge, Opera */
        input::-webkit-outer-spin-button,
        input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        /* Firefox */
        input[type=number] {
            -moz-appearance: textfield;
        }

        /*-------------*/
        .box-error {
            position: absolute;
            right: 0;
            /* width: 100px; */
            /* display: none; */
            background: white;
            top: 40px;
            transition: 1s;
            margin-right: 5px;
        }

            .box-error.is-hide {
                transform: translateX(100%);
                margin-right: 0px;
            }

        .nav-item.nav-item--1 {
            position: absolute;
            right: 7px;
            top: 0;
            /*background: red;*/
        }

        .col-cus {
            padding-right: 2px !important;
        }

        .btn-CongDoan {
            width: 48% !important;
            display: inline !important;
            margin: 2px;
            box-sizing: border-box;
            color: black;
            background: linear-gradient(to bottom,#ffffff 0,#eeeeee 100%)
        }

        .btn-group-lg > .btn, .btn-lg {
            font-size: 1rem !important;
            padding: 0.2rem 0.1rem !important;
        }

        .item-MaLoi {
            min-height: 55px !important;
            font-weight: bold !important;
            width: 55px !important;
            /*background-color: #15979bf0 !important;
            color: white !important;*/
            margin: 0px 5px 5px 0px !important;
            display: flex !important;
            justify-content: center !important;
            align-items: center !important;
            cursor: pointer !important
        }

        .p-motaloi {
            margin-bottom: 0px !important;
            font-size: 1rem !important;
            word-wrap: break-word;
            white-space: pre-wrap;
        }

        h6 {
            font-size: 0.75rem !important;
            margin-bottom: 0.1rem !important;
        }

        .btn-outline-primary:hover {
            background: #007bff;
            color: white !important;
        }
        /*.btn-CongDoan:focus{
            background:red;
        }*/
        .btn-outline-primary {
            color: black !important;
            /*border-color: #007bff;*/
        }

        #DSNhomLoi button.is-active {
            background: #007bff;
            color: #fff !important;
        }

        .ErrorImage {
            height: 35px;
            width: 35px;
            margin-right: 2px;
        }

        .labelHT {
            margin-right: 5px;
        }

        .lblValueHT {
            color: red;
        }

        .daterangepicker .calendar-table table {
            display: grid !important;
        }

        .select2-selection__rendered {
            line-height: 25px !important;
            font-size: 12px !important;
            font-weight: bold !important;
        }

        .select2-container .select2-selection--single {
            height: 100% !important;
            padding: 0rem 0.75rem !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            margin-top: 0px !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 80% !important;
        }

        #select2-MaHang-results li {
            font-size: 12px;
        }

        /* .select2-search__field {
            display: none;
        }*/

        .select2-search.select2-search--dropdown [ aria-controls = "select2-MaHang-results"] {
            display: block;
        }

        .select2-container--default .select2-results > .select2-results__options {
            max-height: 60vh !important;
            overflow-y: auto;
        }

        .class-PhuLieu, .DiemLoi {
            height: 20px;
            width: 20px
        }

        .classFocusVT {
            background: #007bff;
            color: white;
        }

        .table td {
            vertical-align: middle !important;
        }

        .select2-results__option {
            font-size: 12px !important;
        }

        .select2-container {
            height: 27px !important;
        }

        .input-CheckList {
            width: 100%;
            height: 100% !important;
            text-align: center;
            border: none;
        }

        .input-box {
            width: 100%;
            padding: 2px 6px;
            border: 2px solid #ccc;
            border-radius: 5px;
            font-size: 14px;
            cursor: pointer;
            background: white;
        }

            .input-box:focus {
                outline: none;
                border-color: #007bff;
            }

        .dropdown-list {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: white;
            border: 2px solid #007bff;
            border-top: none;
            border-radius: 0 0 5px 5px;
            max-height: 300px;
            overflow-y: auto;
            z-index: 1000;
            margin-top: -2px;
        }

            .dropdown-list.show {
                display: block;
            }

        .dropdown-item {
            padding: 10px;
            border-bottom: 1px solid #eee;
            cursor: pointer;
            display: flex;
            align-items: center;
        }

            .dropdown-item:hover {
                background: #f8f9fa;
            }

            .dropdown-item:last-child {
                border-bottom: none;
            }

            .dropdown-item input[type="checkbox"] {
                margin-right: 10px;
                width: 18px;
                height: 18px;
                cursor: pointer;
            }

            .dropdown-item label {
                cursor: pointer;
                flex: 1;
                user-select: none;
                font-weight: unset !important
            }

        .check-all {
            background: #f0f0f0;
            font-weight: bold;
            border-bottom: 2px solid #ddd;
        }

        .search-box {
            padding: 10px;
            border-bottom: 2px solid #ddd;
        }

            .search-box input {
                width: 100%;
                padding: 8px;
                border: 1px solid #ccc;
                border-radius: 3px;
                font-size: 13px;
            }

                .search-box input:focus {
                    outline: none;
                    border-color: #007bff;
                }

        label {
            margin-bottom: 0px
        }

        .label-col {
            width: auto !important;
            font-weight: 500;
            color: #333;
        }

        .signature-container {
            padding: 0 5px;
            background-color: #f8f9fa;
            margin-bottom: 5px
        }

        .signature-box {
            border: 2px solid #dee2e6;
            border-radius: 8px;
            padding: 15px;
            background-color: white;
            height: 100%;
            min-height: 200px;
        }

            .signature-box h6 {
                color: #495057;
                font-weight: 600;
                margin-bottom: 10px;
                font-size: 14px;
            }

            .signature-box p {
                color: #6c757d;
                font-size: 13px;
                margin-bottom: 15px;
            }

        .signature-image {
            width: 100%;
            height: 120px;
            object-fit: contain;
            border: 1px dashed #dee2e6;
            border-radius: 4px;
            padding: 10px;
            background-color: #f8f9fa;
        }

        .date-section {
            margin-top: 10px;
            font-size: 12px;
            color: #6c757d;
        }

        .unit-box {
            min-width: 45px !important;
            padding: 0 3px !important;
            color: #FF3A00;
            border: 1px solid #ced4da;
            border-radius: 8px;
            font-size: 12px;
            white-space: nowrap;
        }

        .row-flex-nowrap {
            display: flex;
            flex-wrap: nowrap;
            align-items: stretch;
            gap: 2px;
        }

        .input-main {
            flex-grow: 1;
            min-width: 0;
        }

        .image1, .image2, .image3 {
            object-fit: contain;
        }

            .image1[src=""], .image2[src=""], .image3[src=""] {
                display: none;
            }
        .btn-delete-fabric {
            position: absolute;
            top: 4px;
            right: 4px;
            border: none;
            background: transparent;
            color: #e7ff0d;
            cursor: pointer;
            font-size: 13px;
            padding: 2px 4px;
        }

            .btn-delete-fabric:hover {
                color: #a71d2a;
            }
    </style>
    <link rel="stylesheet" href="~/css/NguyenPhuLieu/main.css">
</head>
<body>
    <div class="content-wrapper">
        <section class="content" style="">
            <div class="container-fluid">
                <div class="row js-get-height">
                    <div class="col-12">
                        <div class="bg-info" style="margin-bottom: 10px; margin-top: 10px; border-radius: 5px; background-color: #17a2b8 !important; display: flex; width: 100%; align-items: center; justify-content: space-between; padding: 5px;">
                            <h3 class="card-title" style="height: 30px; display: flex; justify-content: center; align-items: center;">
                                <a id="home" href="~/Home/DashBoard" style="color:white"><i class="fas fa-home" style="font-size:x-large;margin-right:5px"></i></a>
                                <span style="margin-top: 3px;">BC Kiểm vải</span>
                            </h3>
                            <button onclick="Export()" type="button" class="btn btn-primary btn-export d-flex align-items-center px-2 py-1 " style="height: 33px; ">
                                <i class="fas fa-file-export me-2"></i>
                                Excel
                            </button>
                        </div>
                    </div>
                    <div class="col-md-12 QCT">
                        <div class="card-body" style="background-color: #1b81c9; border-radius: 5px; display: block; padding: 0px 10px 5px 10px; margin: 0px 0px 5px 0px">
                            <div class="row top_nav">
                                <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 pr-4">
                                    <div class="row">
                                        <div class="col-6 col-md-4 col-lg-3 col-xl-2 col-cus">
                                            <div class="form-group">
                                                <label class="labelHeader" for="exampleInputPassword1" style="text-align:center; color:White">PO Mua</label>
                                                <select class="sLenhSX form-control inputEnLine" onchange="GetMauVai()" id="SoLo"></select>
                                            </div>
                                        </div>
                                        <div class="col-6 col-md-4 col-lg-3 col-xl-2 col-cus">
                                            <div class="form-group">
                                                <label class="labelHeader" for="exampleInputEmail1" style="text-align:center; color:White">Nhà Cung Cấp</label>

                                                <input type="text" class="form-control float-right inputEnLine" readonly id="nhacungcap">
                                            </div>
                                        </div>

                                        <div class="col-6 col-md-4 col-lg-2 col-xl-1 col-cus">
                                            <div class="form-group">
                                                <label class="labelHeader" for="exampleInputPassword1" style="text-align:center; color:White">K.Hàng</label>
                                                <input type="text" class="form-control float-right inputEnLine" readonly id="KhachHang">

                                            </div>
                                        </div>
                                        <div class="col-6 col-md-4 col-lg-3 col-xl-2 col-cus">
                                            <div class="form-group">
                                                <label class="labelHeader" for="exampleInputPassword1" style="text-align:center; color:White">Màu Vải</label>
                                                <select class="sLenhSX form-control inputEnLine" onchange="GetDot()" id="MauVai"></select>
                                            </div>

                                        </div>
                                        <div class="col-6 col-md-4 col-lg-2 col-xl-1 col-cus">
                                            <div class="form-group">
                                                <label class="labelHeader" for="exampleInputPassword1" style="text-align:center; color:White">Đợt</label>
                                                <select class="sLenhSX form-control inputEnLine" onchange="GetBatchLot()" id="Dot"></select>
                                            </div>
                                        </div>
                                        <div class="col-6 col-md-4 col-lg-5 col-xl-4 col-cus">
                                            <div class="form-group select-container">
                                                <label class="labelHeader" for="exampleInputPassword1" style="text-align:center; color:White">Số Batch/LOT</label>
                                                <input type="text"
                                                       class="input-box"
                                                       id="batchInput"
                                                       placeholder=""
                                                       readonly>
                                                <div class="dropdown-list" id="dropdownList">
                                                    <div class="search-box">
                                                        <input type="text" id="searchInput" placeholder="Tìm kiếm...">
                                                    </div>

                                                    <div class="dropdown-item check-all">
                                                        <input type="checkbox" id="checkAll">
                                                        <label style="font-weight: 400 !important" for="checkAll">Chọn tất cả</label>
                                                    </div>

                                                    <div id="itemList"></div>
                                                </div>
                                            </div>
                                        </div>


                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="minFabricAlert" class="alert alert-warning d-flex align-items-center" role="alert" style="padding: 5px !important; margin-bottom: 5px; display: none !important;">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <div>
                                <strong>Thông báo:</strong> Vui lòng phải có ít nhất hai cây vải.
                            </div>
                            @*<i class="fa-solid fa-x" style="margin-left: auto; cursor: pointer" id="btn-hide"></i>*@
                        </div>

                        <div id="percentInput" class="alert alert-warning d-flex align-items-center" role="alert" style="padding: 5px !important; margin-bottom: 5px; display: none !important;">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <div>
                                <strong>Thông báo:</strong> Vui lòng phải có ít nhất hai cây vải.
                            </div>
                            @*<i class="fa-solid fa-x" style="margin-left: auto; cursor: pointer" id="btn-hide-1"></i>*@
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12 ">
                    <div class="form-card" style="padding: 0 10px;">
                        <div class="" style="max-height: calc(100vh - 125px); overflow: auto;">
                            <table class="inspection-table" style="overflow:auto"></table>
                            <div class="divResult d-none" style="padding: 0 ;">


                                <div class="alert alert-info mt-2 " role="alert">
                                    <strong><i class="fa-solid fa-recycle"></i> Kết luận của QC/Conclusion:</strong>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="form-check form-check-inline div-radio">
                                            <input class="form-check-input no-click" type="radio" name="resultQC" id="resultQC-pass" value="pass">
                                            <label class="form-check-label text-success">
                                                Pass
                                            </label>
                                        </div>
                                        <div class="form-check form-check-inline div-radio">
                                            <input class="form-check-input no-click" type="radio" name="resultQC" id="resultQC-fail" value="fail">
                                            <label class="form-check-label text-danger">
                                                Fail
                                            </label>
                                        </div>
                                        <span class="text-nowrap"> Kết quả giải quyết:</span>  <textarea style="" class="form-control flex-grow-1 text-black text-result" placeholder="" rows="1"></textarea>
                                        <div>
                                            <button onclick="SaveResult()" style="background-color: #d2ff20; color: #000;" type="button" class="btn btn-success btn-sm text-nowrap">
                                                <i class="fas fa-save"></i> Lưu kết quả
                                            </button>
                                        </div>
                                    </div>

                                </div>
                                <div class="alert alert-info mt-2 " role="alert">
                                    <strong><i class="fa-solid fa-recycle"></i>  Kết luận Mer/Mer Results:</strong>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="form-check form-check-inline div-radio">
                                            <input class="form-check-input no-click" type="radio" name="resultMer" id="resultMer-pass" value="pass">
                                            <label class="form-check-label text-success">
                                                Pass
                                            </label>
                                        </div>
                                        <div class="form-check form-check-inline div-radio">
                                            <input class="form-check-input no-click" type="radio" name="resultMer" id="resultMer-fail" value="fail">
                                            <label class="form-check-label text-danger">
                                                Fail
                                            </label>
                                        </div>
                                        <span class="text-nowrap"> Note (ghi chú Mer):</span>  <textarea style="pointer-events:none" class="form-control flex-grow-1 text-black no-click noteMer-result" placeholder="" rows="1"></textarea>

                                    </div>

                                </div>

                                <div class="signature-container py-2">
                                    <div class="row g-3">
                                        <div class="col-md-4 m-0 p-0 ">
                                            <div onclick="CallModal('image1')" class="signature-box">
                                                <h6>Ngày kiểm tra</h6>
                                                <p class="mb-2">Ký tên:</p>
                                                <img src="" alt="" class="signature-image image1">
                                            </div>
                                        </div>
                                        <div class="col-md-4 m-0 p-0 px-2">
                                            <div onclick="CallModal('image2')" class="signature-box">
                                                <h6>TPCL xác nhận/QC manager confirm</h6>
                                                <p class="mb-2">Ký tên:</p>
                                                <img src="" alt="" class="signature-image image2">
                                            </div>
                                        </div>
                                        <div class="col-md-4 m-0 p-0 ">
                                            <div onclick="CallModal('image3')" class="signature-box">
                                                <h6>Nhận thông tin/Received info</h6>
                                                <p class="mb-2">Ký tên:</p>
                                                <img src="" alt="" class="signature-image image3">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </section>

    </div>

    <div class="modal fade" id="inputModal" tabindex="-1" role="dialog" aria-labelledby="inputModalLabel">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header" style="background-color: #4CAF50; color: white;">
                    <h5 class="modal-title" id="inputModalLabel">Nhập dữ liệu</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true" style="color: white;">&times;</span>
                    </button>

                </div>
                <div class="modal-body">
                    <label id="modalFieldLabel" style=" margin-bottom: 10px; display: block; font-weight: normal;"></label>
                    <textarea id="modalTextarea" class="form-control text-left" rows="5" style="font-size: 16px; padding: 10px;"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success" id="btnConfirm">
                        <i class="fa fa-check"></i> Xác nhận
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="signatureModal" tabindex="-1" aria-labelledby="signatureModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="signatureModalLabel">
                        <i class="fas fa-pen-fancy me-2"></i>Ký Tên Điện Tử
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Công cụ -->
                    <div class="row mb-3 g-2">
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold">Màu bút:</label>
                            <div class="d-flex gap-2 flex-wrap">
                                <input type="color" class="color-picker" id="penColor" value="#000000">
                                <button class="btn btn-tool btn-outline-dark" onclick="setPenColor('#000000')">
                                    <i class="fas fa-circle" style="color: #000000;"></i>
                                </button>
                                <button class="btn btn-tool btn-outline-primary" onclick="setPenColor('#0d6efd')">
                                    <i class="fas fa-circle" style="color: #0d6efd;"></i>
                                </button>
                                <button class="btn btn-tool btn-outline-danger" onclick="setPenColor('#dc3545')">
                                    <i class="fas fa-circle" style="color: #dc3545;"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold">Độ dày bút:</label>
                            <div class="pen-size-selector">
                                <div class="pen-size-btn active" onclick="setPenSize(2)" data-size="2">
                                    <div style="width: 6px; height: 6px; background: #000; border-radius: 50%;"></div>
                                </div>
                                <div class="pen-size-btn" onclick="setPenSize(4)" data-size="4">
                                    <div style="width: 10px; height: 10px; background: #000; border-radius: 50%;"></div>
                                </div>
                                <div class="pen-size-btn" onclick="setPenSize(6)" data-size="6">
                                    <div style="width: 14px; height: 14px; background: #000; border-radius: 50%;"></div>
                                </div>
                                <div class="pen-size-btn" onclick="setPenSize(8)" data-size="8">
                                    <div style="width: 18px; height: 18px; background: #000; border-radius: 50%;"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Canvas vẽ chữ ký -->
                    <div class="position-relative">
                        <canvas id="signatureCanvas" class="signature-canvas"></canvas>
                        <small class="text-muted d-block mt-2 text-center">
                            <i class="fas fa-info-circle"></i> Vẽ chữ ký của bạn vào khung trên
                        </small>
                    </div>

                    <!-- Nút hành động -->
                    <div class="d-flex gap-2 mt-3 flex-wrap justify-content-center">
                        <button class="btn btn-outline-secondary" onclick="clearSignature()">
                            <i class="fas fa-eraser me-1"></i> Xóa
                        </button>
                        <button class="btn btn-outline-primary" onclick="undoSignature()">
                            <i class="fas fa-undo me-1"></i> Hoàn tác
                        </button>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i> Hủy
                    </button>
                    <button type="button" class="btn btn-primary" onclick="saveSignature()">
                        <i class="fas fa-check me-1"></i> Lưu Chữ Ký
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- Toast Container -->

    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div id="successToast" class="toast" role="alert">
            <div class="toast-header bg-success text-white">
                <i class="fas fa-check-circle me-2"></i>
                <strong class="me-auto">Thành công</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="successMessage"></div>
        </div>
        <div id="errorToast" class="toast" role="alert">
            <div class="toast-header bg-danger text-white">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong class="me-auto">Lỗi</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="errorMessage"></div>
        </div>
        <div id="warningToast" class="toast" role="alert">
            <div class="toast-header bg-warning text-dark">
                <i class="fas fa-exclamation-circle me-2"></i>
                <strong class="me-auto">Cảnh báo</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="warningMessage"></div>
        </div>
    </div>
    <div class="modal fade" id="previewModal" tabindex="-1" role="dialog" aria-labelledby="inputModalLabel">
        <div class="modal-dialog" role="document">
            <div class="modal-content" style="max-width: 700px;">
                <div class="modal-header">
                    <h3><i class="fas fa-image"></i> Xem Ảnh</h3>
                    <button class="close-modal" onclick="closePreview()">&times;</button>
                </div>
                <div class="modal-body" style="display: flex; flex-direction: column;">
                    <img id="previewImage" class="image-preview" src="" alt="Preview">
                    <div class="option-buttons">


                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="modalDeleteFabric" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Xác nhận xóa</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    Bạn có chắc chắn muốn xóa cây này khỏi báo cáo không?
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button id="btnConfirmDeleteFabric" class="btn btn-danger" onclick="DeleteCayVai()">Xóa</button>
                </div>
            </div>
        </div>
    </div>
