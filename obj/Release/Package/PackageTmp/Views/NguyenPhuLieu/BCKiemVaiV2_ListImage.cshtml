        input::-webkit-outer-spin-button,
        input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        /* Firefox */
        input[type=number] {
            -moz-appearance: textfield;
        }

        /*-------------*/
        .box-error {
            position: absolute;
            right: 0;
            /* width: 100px; */
            /* display: none; */
            background: white;
            top: 40px;
            transition: 1s;
            margin-right: 5px;
        }

            .box-error.is-hide {
                transform: translateX(100%);
                margin-right: 0px;
            }

        .nav-item.nav-item--1 {
            position: absolute;
            right: 7px;
            top: 0;
            /*background: red;*/
        }

        .col-cus {
            padding-right: 2px !important;
        }

        .btn-CongDoan {
            width: 48% !important;
            display: inline !important;
            margin: 2px;
            box-sizing: border-box;
            color: black;
            background: linear-gradient(to bottom,#ffffff 0,#eeeeee 100%)
        }

        .btn-group-lg > .btn, .btn-lg {
            font-size: 1rem !important;
            padding: 0.2rem 0.1rem !important;
        }

        .item-MaLoi {
            min-height: 55px !important;
            font-weight: bold !important;
            width: 55px !important;
            /*background-color: #15979bf0 !important;
            color: white !important;*/
            margin: 0px 5px 5px 0px !important;
            display: flex !important;
            justify-content: center !important;
            align-items: center !important;
            cursor: pointer !important
        }

        .p-motaloi {
            margin-bottom: 0px !important;
            font-size: 1rem !important;
            word-wrap: break-word;
            white-space: pre-wrap;
        }

        h6 {
            font-size: 0.75rem !important;
            margin-bottom: 0.1rem !important;
        }

        .btn-outline-primary:hover {
            background: #007bff;
            color: white !important;
        }
        /*.btn-CongDoan:focus{
            background:red;
        }*/
        .btn-outline-primary {
            color: black !important;
            /*border-color: #007bff;*/
        }

        #DSNhomLoi button.is-active {
            background: #007bff;
            color: #fff !important;
        }

        .ErrorImage {
            height: 35px;
            width: 35px;
            margin-right: 2px;
        }

        .labelHT {
            margin-right: 5px;
        }

        .lblValueHT {
            color: red;
        }

        .daterangepicker .calendar-table table {
            display: grid !important;
        }

        .select2-selection__rendered {
            line-height: 25px !important;
            font-size: 12px !important;
            font-weight: bold !important;
        }

        .select2-container .select2-selection--single {
            height: 100% !important;
            padding: 0rem 0.15rem !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            margin-top: 0px !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 80% !important;
        }

        #select2-MaHang-results li {
            font-size: 12px;
        }

        /* .select2-search__field {
            display: none;
        }*/

        .select2-search.select2-search--dropdown [ aria-controls = "select2-MaHang-results"] {
            display: block;
        }

        .select2-container--default .select2-results > .select2-results__options {
            max-height: 60vh !important;
            overflow-y: auto;
        }

        .class-PhuLieu, .DiemLoi {
            height: 20px;
            width: 20px
        }

        .classFocusVT {
            background: #007bff;
            color: white;
        }

        .table td {
            vertical-align: middle !important;
        }

        .select2-results__option {
            font-size: 12px !important;
        }

        .select2-container {
            height: 27px !important;
        }

        .input-CheckList {
            width: 100%;
            height: 100% !important;
            text-align: center;
            border: none;
        }

        .input-box {
            width: 100%;
            padding: 2px 6px;
            border: 2px solid #ccc;
            border-radius: 5px;
            font-size: 14px;
            cursor: pointer;
            background: white;
        }

            .input-box:focus {
                outline: none;
                border-color: #007bff;
            }

        .dropdown-list {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: white;
            border: 2px solid #007bff;
            border-top: none;
            border-radius: 0 0 5px 5px;
            max-height: 300px;
            overflow-y: auto;
            z-index: 1000;
            margin-top: -2px;
        }

            .dropdown-list.show {
                display: block;
            }

        .dropdown-item {
            padding: 10px;
            border-bottom: 1px solid #eee;
            cursor: pointer;
            display: flex;
            align-items: center;
        }

            .dropdown-item:hover {
                background: #f8f9fa;
            }

            .dropdown-item:last-child {
                border-bottom: none;
            }

            .dropdown-item input[type="checkbox"] {
                margin-right: 10px;
                width: 18px;
                height: 18px;
                cursor: pointer;
            }

            .dropdown-item label {
                cursor: pointer;
                flex: 1;
                user-select: none;
                font-weight: unset !important
            }

        .check-all {
            background: #f0f0f0;
            font-weight: bold;
            border-bottom: 2px solid #ddd;
        }

        .search-box {
            padding: 10px;
            border-bottom: 2px solid #ddd;
        }

            .search-box input {
                width: 100%;
                padding: 8px;
                border: 1px solid #ccc;
                border-radius: 3px;
                font-size: 13px;
            }

                .search-box input:focus {
                    outline: none;
                    border-color: #007bff;
                }

        label {
            margin-bottom: 0px
        }

        .label-col {
            width: auto !important;
            font-weight: 500;
            color: #333;
        }

        .signature-container {
            padding: 0 5px;
            background-color: #f8f9fa;
            margin-bottom: 5px
        }

        .signature-box {
            border: 2px solid #dee2e6;
            border-radius: 8px;
            padding: 15px;
            background-color: white;
            height: 100%;
            min-height: 250px;
        }

            .signature-box h6 {
                color: #495057;
                font-weight: 600;
                margin-bottom: 10px;
                font-size: 14px;
            }

            .signature-box p {
                color: #6c757d;
                font-size: 13px;
                margin-bottom: 15px;
            }

        .signature-image {
            width: 100%;
            height: 120px;
            object-fit: contain;
            border: 1px dashed #dee2e6;
            border-radius: 4px;
            padding: 10px;
            background-color: white;
        }

        .date-section {
            margin-top: 10px;
            font-size: 12px;
            color: #6c757d;
        }

        .unit-box {
            min-width: 45px !important;
            padding: 0 3px !important;
            color: #FF3A00;
            border: 1px solid #ced4da;
            border-radius: 8px;
            font-size: 12px;
            white-space: nowrap;
        }

        .row-flex-nowrap {
            display: flex;
            flex-wrap: nowrap;
            align-items: stretch;
            gap: 2px;
        }

        .input-main {
            flex-grow: 1;
            min-width: 0;
        }

        .image1, .image2, .image3 {
            object-fit: contain;
        }

            .image1[src=""], .image2[src=""], .image3[src=""] {
                display: none;
            }

        .bc-image-list {
            display: grid;
            grid-template-columns: repeat(2, 52px);
            gap: 4px;
        }

        .bc-image-item {
            cursor: pointer;
        }

            .bc-image-item img {
                width: 52px;
                height: 42px;
                object-fit: cover;
                border: 1px solid #ddd;
                border-radius: 4px;
            }

        .bc-image-note {
            font-size: 10px;
            max-width: 52px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .preview-nav {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            margin-top: 8px;
        }

        .preview-image-note-view {
            margin-top: 8px;
            font-size: 13px;
            color: #333;
            text-align: left;
        }

        .preview-image-note-view {
            margin-top: 8px;
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 6px;
            color: #333;
            text-align: left;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .bc-image-note {
            font-size: 10px;
            width: 52px;
            min-height: 34px;
            resize: none;
            border: 1px solid #ddd;
            border-radius: 0 0 4px 4px;
            text-align: left;
            background: #fff;
            color: #333;
            outline: none;
        }

        @@media(max-width:400px) {
            .btnKyTuDong {
                padding: 6px;
                font-size: 9px;
            }

            #btnDuyetQC {
                padding: 6px;
                font-size: 9px;
            }
        }

        @@media(min-width:400px) {
            .btnKyTuDong {
                padding: 6px;
                height: 33px;
            }
        }

        .txtSign {
            display: flex;
            justify-content: center;
            margin-top: 4px;
        }

        .btnKyTuDong {
            min-width: 100px
        }

        .form-card {
            overflow: auto;
            height: 100vh;
        }

        .confirmModal {
            --confirm-color-start: #E24B4A;
            --confirm-color-end: #ff6271;
            --confirm-color-icon-bg: #FCEBEB;
            --confirm-color-icon: #E24B4A;
            --confirm-color-hover: #A32D2D;
        }

            .confirmModal .form-control-sm {
                min-height: calc(1.5em + .5rem + calc(var(--bs-border-width) * 2));
                padding: .25rem .5rem;
                font-size: 12px !important;
                border-radius: var(--bs-border-radius-sm);
            }

            .confirmModal .modal-dialog {
                max-width: 360px;
                margin: auto;
            }

            .confirmModal .modal-header {
                background: linear-gradient(135deg, var(--confirm-color-start), var(--confirm-color-end));
                border-radius: 0px;
                font-size: 16px;
            }

            .confirmModal .danger {
                background: linear-gradient(135deg, #E24B4A, #ff6271);
            }

            .confirmModal .reset {
                background: linear-gradient(135deg, #24b359, #4ade80)
            }

            .confirmModal .modal-content {
                border-radius: 12px;
                border: none;
                overflow: hidden;
            }

        #confirmModal .modal-icon-wrap {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: var(--confirm-color-icon-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
        }

        .confirmModal .modal-icon-wrap i {
            font-size: 28px;
            color: var(--confirm-color-icon);
        }


        .confirmModal .modal-body {
            padding: 8px 14px 14px;
            text-align: center;
            border-bottom: 1px solid #f0f0f0;
        }

        .confirmModal .modal-title-text {
            margin: 0 0 8px;
            font-size: 15px;
            font-weight: 500;
            color: #1a1a1a;
        }

        .confirmModal .modal-sub-text {
            margin: 0;
            font-size: 13px;
            color: #6c757d;
            line-height: 1.6;
        }

        .confirmModal .modal-footer {
            display: flex;
            gap: 10px;
            padding: 16px 20px;
            border: none;
        }

        .confirmModal .btn-cancel {
            flex: 1;
            padding: 10px 0;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            background: #f8f9fa;
            color: #495057;
            border: 1px solid #dee2e6;
            cursor: pointer;
        }

            .confirmModal .btn-cancel:hover {
                background: #e9ecef;
            }

        .confirmModal .btn-delete {
            background: linear-gradient(135deg, var(--confirm-color-start), var(--confirm-color-end));
            flex: 1;
            padding: 10px 0;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            color: #fff;
            border: none;
            cursor: pointer;
        }

            .confirmModal .btn-delete:hover {
                background: var(--confirm-color-hover);
            }

        .modal-consequence {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            background: #fff8f0;
            border: 1px solid #fed7aa;
            border-radius: 8px;
            padding: 10px 14px;
            margin: 12px 0 0;
            font-size: 13px;
            color: #92400e;
            text-align: left;
        }

            .modal-consequence i {
                font-size: 15px;
                color: #f97316;
                margin-top: 1px;
                flex-shrink: 0;
            }
    </style>
