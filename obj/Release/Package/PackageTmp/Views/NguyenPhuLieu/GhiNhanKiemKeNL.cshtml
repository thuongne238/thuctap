                        <!-- SUMMARY -->
                        <!--<tfoot style=" border-color: #ddd;">
                                    <tr class="fw-bold bg-light text-red">
                                        <td colspan="4"></td>
                                        <td id="sumSLNK" style="color:red" class="text-center">0</td>
                                        <td id="sumSLKiemKe" style="color:red" class="text-center">0</td>
                                        <td colspan="2"></td>
