                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal Xác Nhận Tất Cả -->
        <div class="modal fade" id="modalConfirmAll" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header" style="background: linear-gradient(135deg, #ff9e30 0%, #ff6616 100%); color: white;">
                        <h5 class="modal-title">
                            <i class="fas fa-exclamation-triangle"></i> Xác nhận tất cả
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" style="filter: brightness(0) invert(1);"></button>
                    </div>
                    <div class="modal-body text-center">
                        <i style="font-size: 28px; color: orange;" class="bi bi-exclamation-triangle icon-warning"></i>
                        <h5 class="mt-3 mb-3">Xác nhận danh sách yêu cầu kiểm kê?</h5>
                        <p class="text-muted">
                            Bạn có chắc chắn muốn xác nhận danh sách yêu cầu kiểm kê này không?
                        </p>
                        <div class="bg-light border border-warning rounded p-3 mt-3">
                            <i class="bi bi-unlock-fill text-warning me-2"></i>
                            <span class="text-dark">
                                <strong>Lưu ý:</strong> Sau khi xác nhận, các vật tư trên sẽ <strong>được phép xuất hàng</strong> trở lại.
                            </span>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fas fa-times"></i> Hủy
                        </button>
                        <button type="button" class="btn btn-primary" id="btnConfirmAllSave">
                            <i class="fas fa-check"></i> Xác nhận
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Xác Nhận  -->
    <div class="modal fade" id="modalConfirmKK" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #ff9e30 0%, #ff6616 100%); color: white;">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle"></i> Xác nhận <span class="txtSLVTKK"></span> vật tư
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" style="filter: brightness(0) invert(1);"></button>
                </div>
                <div class="modal-body text-center">
                    <i style="font-size: 28px; color: orange;" class="bi bi-exclamation-triangle icon-warning"></i>
                    <h5 class="mt-3 mb-3">Xác nhận kiểm kê?</h5>
                    <p class="text-muted">
                        Bạn có chắc chắn muốn xác nhận <span class="txtSLVTKK"></span> vật tư yêu cầu kiểm kê này không?
                    </p>
                    <div class="bg-light border border-warning rounded p-3 mt-3">
                        <i class="bi bi-unlock-fill text-warning me-2"></i>
                        <span class="text-dark">
                            <strong>Lưu ý:</strong> Sau khi xác nhận, các vật tư trên sẽ <strong>được phép xuất hàng</strong> trở lại.
                        </span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i> Hủy
                    </button>
                    <button type="button" class="btn btn-primary" id="btnConfirmSave">
                        <i class="fas fa-check"></i> Xác nhận
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Tìm Kiếm -->
    <div class="modal fade mt-2" id="modalTimNhanh" data-backdrop="static" data-keyboard="false" tabindex="-1">
        <div class="modal-dialog ">
            <div class="modal-content">
                <div class="modal-header py-2 bg-danger text-white">
                    <h6 class="modal-title" id="myModalLabelD">
                        <i class="fa-solid fa-search me-2"></i>Tìm Nhanh
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3">
                    <div class="mb-2" style="max-width: 225px">
                        <div class="input-group" style="min-width:350px">
                            <input id="inputTimKiem" class="form-control input-group-btn" placeholder="Tìm kiếm theo ItemCode ... " style="font-size: 13px" />
                            <span id="btnTimKiem" class="input-group-text" style="cursor:pointer"><i class="fa-solid fa-search"></i></span>
                        </div>
                    </div>
                    <div id="dxDanhSachItemCode" style="max-height: calc(100vh - 264px); min-height: 300px;"></div>
                </div>
                <div class="modal-footer d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fa-solid fa-xmark me-1"></i>Đóng
                    </button>
                </div>
            </div>
        </div>
    </div>
    <select id="select-LstVideo" style="display:none">
    </select>
    <audio id="beepSoundSuccess" controls="controls" style="display: none">
        <source src="/css/QRCode/successSound.mp3" type="audio/mpeg" />
    </audio>
    <audio id="beepSoundError" controls="controls" style="display:none">
        <source src="/css/QRCode/errorSound.mp3" type="audio/mpeg" />
    </audio>

    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div id="successToast" class="toast" role="alert">
            <div class="toast-header bg-success text-white">
                <i class="fas fa-check-circle me-2"></i>
                <strong class="me-auto">Thành công</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="successMessage"></div>
        </div>
        <div id="errorToast" class="toast" role="alert">
            <div class="toast-header bg-danger text-white">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong class="me-auto">Lỗi</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="errorMessage"></div>
        </div>
        <div id="warningToast" class="toast" role="alert">
            <div class="toast-header bg-warning text-dark">
                <i class="fas fa-exclamation-circle me-2"></i>
                <strong class="me-auto">Cảnh báo</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="warningMessage"></div>
        </div>
    </div>

    <!--Modal Xác Nhận Hủy Kiểm Kê-->
    <div class="modal fade" id="modalCancelInventory" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header text-white" style="background:linear-gradient(135deg, #ea8066 0%, #b8553c 100%);">
                    <h5 class="modal-title">
                        Xác nhận hủy kiểm kê
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center">
                        <i class="bi bi-exclamation-triangle" style="font-size: 28px; color: #ea8066;"></i>
                        <h5 class="mt-3 mb-3">Bạn có chắc chắn muốn hủy kiểm kê?</h5>
                    </div>

                    <div class="bg-light border border-warning rounded p-3 mt-3 mb-3" role="alert">
                        <i class="bi bi-lock-fill me-2"></i>
                        <strong>Lưu ý:</strong> Sau khi hủy, các vật tư sẽ bị <strong>khóa lại</strong> không được phép <strong>nhập kho và xuất hàng</strong>.
                    </div>

                    <div class="mb-3">
                        <label for="cancelReason" class="form-label">
                            Lý do hủy <span class="text-danger">*</span>
                        </label>
                        <textarea style="font-size:14px" class="form-control"
                                  id="cancelReason"
                                  rows="3"
                                  placeholder="Nhập lý do hủy kiểm kê..."
                                  required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </button>
                    <button type="button" class="btn" style="color: white; background-color: #ea8066;" id="btnCancelInventory">
                        <i class="bi bi-trash"></i> Hủy kiểm kê
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalXuatPhieu" tabindex="-1" aria-labelledby="modalXuatPhieuLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width:510px">
            <div class="modal-content modal-confirm">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalXuatPhieuLabel">
                        <i class="bi bi-send-check me-2"></i>
                        <span id="modalTieuDe">Xuất Phiếu</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" style="padding: 12px !important">
                    <div class="con-phieu d-flex justify-content-between align-items-center py-2"
                         style="border-bottom: 1px solid #dee2e6">

                        <div class="d-flex align-items-center gap-2">
                            <span style="font-size: 13px; color: #333;" id="txtPhieuVTKKXP"></span>
                        </div>

                        <button onclick="ExportPhieu()" id="btnExportEX3"
                                class="btn btn-success btn-sm d-flex align-items-center gap-2"
                                style="height:28px">
                            <i class="fa-solid fa-file-excel" style="font-size: 12px;"></i>
                            <span style="font-size: 12px;">Xuất Phiếu</span>
                        </button>
                    </div>
                    <div class="row" style="padding: 0px 8px;">
                        <div class="col-6 col-md-4 col-lg-3 col-xl-3 p-1">
                            <div class="select2_item d-flex flex-column">
                                <label class="txtselected labelHeader" style="font-size: 14px !important">Từ Ngày</label>
                                <div class="input-group datetimepicker " id="datetimepicker5" style="position:relative ">
                                    <input style="height: 30px; font-size: 12px; border-radius: 5px; padding: 17px 12px;" type="text" class="form-control dateInput" id="tuNgayXP" />
                                    <i style="position: absolute; right: 12px; top: 9px; font-size: 12px; cursor: pointer; z-index: 10" class="fa-solid fa-calendar-day"></i>
                                </div>

                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-lg-3 col-xl-3 p-1">
                            <div class="select2_item d-flex flex-column">
                                <label class="txtselected labelHeader" style="font-size: 14px !important">Đến Ngày</label>
                                <div class="input-group datetimepicker" id="datetimepicker6" style="position:relative ">
                                    <input style="height: 30px; font-size: 12px; border-radius: 5px; padding: 17px 12px;" type="text" class="form-control dateInput" id="denNgayXP" />
                                    <i style="position: absolute; right: 12px; top: 9px; font-size: 12px; cursor: pointer; z-index: 10" class="fa-solid fa-calendar-day"></i>
                                </div>

                            </div>
                        </div>
