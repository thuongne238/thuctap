                                </div>
                            </div>
                            <div class="col-12 col-md-4 col-lg-2 d-flex gap-1">
                                <button id="btnTimNhanh" class="btn btn-primary d-flex align-items-center justify-content-center gap-2 w-100" style="font-size: 12px; text-align: center; height: 37px ">
                                    <i class="fa-solid fa-search"></i>
                                    <span class="btn-text">Tìm Nhanh </span>
                                </button>
                                <button onclick="OpenPhieu()" class="btn btn-success d-flex align-items-center justify-content-center gap-2 w-100" style="font-size: 12px; text-align: center; height: 37px">
