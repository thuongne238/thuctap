                    </div>
                </div>
            </div>
            <div class="px-1">
                <div id="dxDataGhiNhanKiemKe" style="min-height: 300px; max-height: calc(100vh - 185px);"></div>
            </div>
        </section>
        <!-- Modal Xác Nhận Thay Đổi -->
        <div class="modal fade" id="modalConfirmSLKK" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="fas fa-exclamation-circle"></i> Xác nhận
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-3">Bạn muốn xác nhận thay đổi số lượng kiểm kê cho:</p>

                        <div class="info-group" style="font-size: 14px;display: flex;justify-content: space-between;flex-wrap: wrap;">
                            <div class="info-row">
                                <span class="label">Item Code:</span>
                                <span class="value" id="confirmItemCode">-</span>
                            </div>
                            <div class="info-row">
                                <span class="label">Màu:</span>
                                <span class="value" id="confirmMau">-</span>
                            </div>
                            <div class="info-row">
                                <span class="label">Khổ vải:</span>
                                <span class="value" id="confirmKhoVai">-</span>
                            </div>
                            <div class="info-row highlight">
                                <span class="label" style="margin:0">Số lượng mới:</span>
                                <span class="value" id="confirmSLKK">-</span>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="button" class="btn btn-primary" id="btnConfirmSaveSLKK">Xác nhận</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal Xem thông tin chi tiết vật tư -->
        <div class="modal fade" id="modalInputSLKK" tabindex="-1" aria-labelledby="modalInputSLKKLabel" aria-hidden="true" data-bs-backdrop="static"
             data-bs-keyboard="false">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalInputSLKKLabel">Thông tin kiểm kê </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body">
                        @*<div class="row mb-3 gap-2">
                                <div class="col-md-5">
                                    <input type="text" class="form-control form-control-sm" id="searchVatTu" placeholder="Tìm kiếm số roll/số kiện...">
                                </div>
                                <div class="col-md-5 d-none">
                                    <div class="select2_item d-flex flex-column">
                                        <div class="input-group datetimepicker " id="datetimepicker3" style="position:relative">
                                            <input style="height: 30px; font-size: 12px; border-radius: 5px;" type="text" class="form-control dateInput" placeholder="Ngày Kiểm kê" id="ngayKK" />
                                            <i style="position: absolute; right: 5px; top: 4px; font-size: 14px; cursor: pointer; z-index: 10" class="fa-solid fa-calendar-days"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-1 d-none" id="colClearFilter">
                                    <button type="button" class="btn btn-sm btn-outline-secondary w-100" id="btnClearFilter" style="height: 30px; font-size: 12px;">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </div>*@
                        <!-- Bảng nhập -->
