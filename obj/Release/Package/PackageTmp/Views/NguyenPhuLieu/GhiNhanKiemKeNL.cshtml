                                    <div class="input-group datetimepicker " id="datetimepicker4" style="position:relative">
                                        <input style="font-size: 14px ; height: 36px; border-radius: 5px;" type="text" class="form-control dateInput" id="denNgay" />
                                        <i style="position: absolute; right: 14px; top: 8px; font-size: 14px; cursor: pointer; z-index: 10 " class="fa-solid fa-calendar-day"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-4 col-lg-2 ">
