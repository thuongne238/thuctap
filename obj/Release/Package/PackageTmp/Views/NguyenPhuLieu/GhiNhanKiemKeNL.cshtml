                            <div class="col-12 col-lg-auto mt-2 mt-lg-0 btnHuyKiemKe ms-lg-auto">
                                <div class="row g-2 justify-content-lg-end">
                                    <div class="col-4 col-lg-auto">
                                        <button class="btn btn-primary btn-action w-100" id="btnSaveAllSLKK" style="font-size: 13px;; height: 37px">
                                            <i class="fas fa-check-double"></i> Xác nhận tất cả
                                        </button>
                                    </div>
                                    <div class="col-4 col-lg-auto">
                                        <button class="btn btn-info btn-action w-100" id="btnSaveKK" style="font-size: 13px; height: 37px">
                                            <i class="fa-sharp-duotone fa-regular fa-check-to-slot mr-2"></i>Xác nhận
                                        </button>
                                    </div>
                                    <div class="col-4 col-lg-auto">
                                        <button class="btn btn-action w-100" id="btnShowModalDelete" style="color: white; background: #ea8066; font-size: 13px; height: 37px">
                                            <i class="fa-duotone fa-light fa-trash-can mr-2"></i>Hủy Kiểm Kê
                                        </button>
                                    </div>
