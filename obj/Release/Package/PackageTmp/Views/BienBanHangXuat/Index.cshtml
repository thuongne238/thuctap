<body>

    <section class="nav_title">

        <div class="list_phieu">
            <i id="home" style="font-size: 21px; cursor: pointer; " class="fa-sharp fa-solid fa-house"></i>
            <button id="creatPhieu">Tạo phiếu</button>
            <button id="viewPhieu">Sửa phiếu</button>
        </div>
        <div class="maPhieu" style="display: flex; justify-content: center; align-items: center;">
            <label style="white-space: nowrap; margin: 0px; ">Biên bản phiếu số</label>
            <p style=" font-style: unset; font-size: 16px; margin-left: 5px; font-weight: bold;" id="soPhieu">1</p>
            
        </div>
        <div style="margin-right: 10px;display:flex">
            <button style="min-width:72px" class="btn_search" id="Update"><i class="fa-sharp fa-solid fa-floppy-disk"></i>Lưu</button>
            <button style="background: #dde924; white-space: nowrap; display:none " class="btn_search" id="delete"><i class="fa-solid fa-trash-can-xmark"></i> Xóa phiếu</button>
            <button style="background: #dde924; white-space: nowrap; display:none " class="btn_search" id="xuatEX">Xuất EX</button>
        </div>
    </section>
    <section class="search" style="background: rgb(112, 186, 237); margin: 2px; padding: 0px 10px; width: 99.8%; border-radius: 5px; display: none">
        <div style="margin: 5px; display: none; ">
            <div class="" style="margin-right:10px">
                <label style="display: block;" for="from">Từ ngày:</label>
                <input style="width: 130px; outline: none; border: 1px solid; height: 26px;text-align: center;font-size: 15px;" type="text" id="from" name="from">
            </div>
            <div class="">
                <label style="display: block;" for="to">Đến ngày:</label>
                <input style="width: 130px;outline: none;border: 1px solid;height: 26px;text-align: center;font-size: 15px;" type="text" id="to" name="to">
            </div>
        </div>
        <div style="margin: 5px; display: flex; justify-content: space-between; width: 100%; ">
            <div class="lookup-container">
                <label style="margin-right: 5px; font-size: 15px; font-family: 'Roboto';">Mã PKL</label>
                <input style="text-align: center;" type="text" class="lookup-input" placeholder="Search...">
                <div class="ultitle" style="display:flex;justify-content:space-between">
                    <p class="ultile_p1">Mã Phiếu</p>
                    <p class="ultile_p1">Số xe</p>
                    <p class="ultile_p1">Số cont</p>
                    <p class="ultile_p1">Số rờ móc</p>
                    <p class="ultile_p1">Số Booking</p>
                </div>
                <ul class="lookup-results">
                </ul>
            </div>

        </div>

    </section>
    <section>
        <div class="title">BIÊN BẢN KIỂM TRA</div>
        <p> CONTAINER/TRAILER/TRUCK INSPECTION RECORD </p>
    </section>
    <section>
        <div class="row" style="display:flex;margin: 10px;width: 100%;">
            <div style="display: flex; width: 70%; margin-left: 56px; justify-content: center; align-items: center;">
                <div style="display:flex;">
                    <input class="vcCont" type="checkbox" name="name" value="" style="width: 33px; margin-left: 36px; outline: none; border: 1px solid;">
                    <p> Container</p>
                </div>
                <div style="display:flex">
                    <input class="vcroMoc" type="checkbox" name="name" value="" style=" width: 35px; margin-left: 36px; outline: none; border: 1px solid;">
                    <p style="white-space: nowrap;">Rờ móc </p>
                </div>
                <div style="display:flex">
                    <input class="vcXetai" type="checkbox" name="name" value="" style=" width: 35px; margin-left: 36px; outline: none; border: 1px solid;">
                    <p style="white-space: nowrap;">Xe tải </p>
                </div>
            </div>
        </div>
    </section>
    <section>
        <div class=" list_item ma_PKL " style="display: flex; justify-content: left; align-items: center;margin-bottom:10px">
