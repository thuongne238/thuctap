<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đóng thùng</title>
    <link href="/css/TheoDoiHangXuat/fontawesome.pro.6.0.0.css" rel="stylesheet" />
    <link href="~/css/fontawesome-6.5.1.css" rel="stylesheet" />
    <link href="~/css/TheoDoiHangXuat/roboto.css" rel="stylesheet" />
    <link href="~/css/DevExtreme/dx.light.css" rel="stylesheet" />
    <link href="~/css/DevExtreme/dx.common.css" rel="stylesheet" />
    <link href="~/css/dongthungV2.css?version=1.0" rel="stylesheet" />
    <link href="~/css/XuatHangNPL/xuathangnpl.css" rel="stylesheet" />
    <link href="~/Scripts/ViTriKho/bootstrap5.3.min.css" rel="stylesheet" />
    <link href="~/css/tippy-animation.css" rel="stylesheet" />

    <link href="~/css/ViTriKhoNPL/ScanQrCodeMobile.css" rel="stylesheet" />

    <style>
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            color: #444;
            line-height: 23px !important;
            /*margin-top: -1px;*/
        }

        .sec-action .item {
            margin-right: 10px;
            border: none;
        }

        .sec-action {
            border: 1px solid #5DA566;
            display: flex;
            justify-content: start;
            align-items: end;
            gap: 4px;
            flex-wrap: wrap;
            border-radius: 6px;
            padding: 4px 7px;
            margin: 0 8px;
        }

        body {
            font-size: 12px
        }

        .select-pkl {
            flex-direction: column;
            display: flex;
        }

        .labelTitle {
            font-weight: bold;
            color: green;
            font-size: 15px !important;
        }

        #reader {
            width: 500px;
            position: fixed !important;
            padding: 0px;
            border: none;
            left: 50%;
            top: 170px;
            transform: translate(-50%, -0%);
        }

        #reader2 {
            width: 600px;
            position: fixed !important;
            padding: 0px;
            border: none;
            left: 50%;
            top: 144px;
            transform: translate(-50%, -0%);
            background: #fff;
            height: 422px;
            z-index: 99;
        }

        #reader.active {
            z-index: 999;
        }

        .lableValue {
            font-weight: bold;
            font-size: 15px;
        }

        .dx-header-row .col-header {
            background: #5da566;
            color: #fff;
            text-align: center !important;
            vertical-align: middle !important;
            white-space: nowrap
        }

        .dx-data-row .col-header {
            text-align: center !important;
            font-size: 13px !important;
            vertical-align: middle !important
        }

        .dx-footer-row .col-header .dx-datagrid-text-content {
            text-align: center !important;
            color: red !important
        }

        #dxTable1 .activeT {
            background: #cff2f3 !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            margin-top: -2px !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__clear {
            font-size: 18px;
            cursor: pointer;
            float: right;
            font-weight: bold;
        }

        .custom-select {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 30px;
            padding: 0 !important
        }

            .custom-select.open .select-options {
                top: 32px;
            }

        .list-item {
            margin-bottom: 5px;
        }

        .collapsible-group {
            margin: 0 5px;
        }

        svg {
            margin-right: 3px;
            margin-top: -1px;
            width: 25px;
        }
        /* Modal Customization */
        .modal-content {
            border-radius: 8px;
            overflow: hidden;
        }

        .modal-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
        }

            .modal-header .btn-close {
                filter: brightness(0) invert(1);
            }

        /* Single Image Section */
        .single-image {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            text-align: center;
        }

            .single-image img {
                max-width: 100%;
                height: auto;
                border-radius: 8px;
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
                max-height: 250px;
            }

        /* Carousel Container - Slide Effect */
        .carousel-container-slide {
            background: #fff;
            border-radius: 12px;
            overflow: hidden;
            position: relative;
            min-height: 450px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .carousel-track {
            display: flex;
            transition: transform 0.7s cubic-bezier(0.25, 0.1, 0.25, 1);
            will-change: transform;
            height: 100%;
        }

        .carousel-slide-item {
            min-width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

            .carousel-slide-item img {
                max-height: 300px;
                max-width: 100%;
                object-fit: contain;
                border-radius: 8px;
            }

        /* Navigation Controls */
        .carousel-control-prev,
        .carousel-control-next {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
            border: 2px solid rgba(255, 255, 255, 0.3);
            width: 50px;
            height: 50px;
            border-radius: 50%;
            z-index: 10;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
        }

            .carousel-control-prev:hover,
            .carousel-control-next:hover {
                background: rgba(255, 255, 255, 0.4);
                transform: translateY(-50%) scale(1.1);
                border-color: rgba(255, 255, 255, 0.5);
            }

            .carousel-control-prev:active,
            .carousel-control-next:active {
                transform: translateY(-50%) scale(0.95);
            }

        .carousel-control-prev {
            left: 15px;
        }

        .carousel-control-next {
            right: 15px;
        }

        .carousel-control-prev-icon,
        .carousel-control-next-icon {
            display: none;
        }

        /* Custom Indicators */
        .carousel-indicators-custom {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 10px;
            z-index: 10;
            padding: 10px 15px;
            background: rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(10px);
            border-radius: 25px;
        }

            .carousel-indicators-custom button {
                width: 10px;
                height: 10px;
                border-radius: 50%;
                border: 2px solid #fff;
                background: rgba(255, 255, 255, 0.4);
                cursor: pointer;
                transition: all 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);
                padding: 0;
                position: relative;
            }

                .carousel-indicators-custom button:hover {
                    background: rgba(255, 255, 255, 0.7);
                    transform: scale(1.2);
                }

                .carousel-indicators-custom button.active {
                    background: #fff;
                    width: 30px;
                    border-radius: 5px;
                    transform: scale(1);
                }

        /* Slide Counter */
        .slide-counter {
            position: absolute;
            top: 20px;
            right: 20px;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(10px);
            color: #fff;
            padding: 8px 16px;
            border-radius: 25px;
            font-size: 14px;
            font-weight: 600;
            z-index: 10;
            letter-spacing: 1px;
        }

        /* Loading Animation */
        .carousel-slide-item img {
            animation: fadeInImage 0.5s ease-in-out;
        }

        @@keyframes fadeInImage {
            from {
                opacity: 0;
                transform: scale(0.95);
            }

            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        /* No Image Section */
        #noImageSection {
            padding: 80px 20px;
        }

            #noImageSection i {
                font-size: 64px;
                color: #dee2e6;
                margin-bottom: 20px;
            }

        /* Section Headers */
        .modal-body h6 {
            color: #667eea;
            font-weight: 600;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 2px solid #e9ecef;
            font-size: 16px
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .carousel-container-slide {
                min-height: 300px;
            }

            .carousel-slide-item img {
                max-height: 300px;
            }

            .carousel-control-prev,
            .carousel-control-next {
                width: 40px;
                height: 40px;
                font-size: 16px;
            }

            .carousel-control-prev {
                left: 10px;
            }

            .carousel-control-next {
                right: 10px;
            }
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            margin-top: 3px !important;
        }

        .modal-content, .modal-content .btn {
            font-size: 15px
        }

        #handleFast, #btn-hide {
            background: #5acde7;
            font-size: 15px;
            padding: 0px 16px;
            height: 30px;
        }

        .select2-container--default .select2-results > .select2-results__options {
            max-height: 200px;
            white-space: normal;
            word-wrap: break-word;
        }

        #filterRow input.filter-input {
            width: 100%;
            box-sizing: border-box;
            padding: 6px;
            border: none;
            font-size: 12px;
        }

        #filterRow table tr th {
            font-weight: 500;
            color: white;
            background: white;
        }

        #filterRow th {
            padding: 0px !important;
            background: white !important;
            outline:1px solid #ccc
        }

        .search-table {
            display: flex;
            justify-content: start;
            align-items: center;
            gap: 3px;
            border: 1.5px solid transparent;
            border-radius: 3px;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
            background: #fff;
        }

            .search-table i {
                padding-left: 4px;
                color: #999;
                font-size: 11px;
                pointer-events: none;
            }

        #filterRow input.filter-input {
            width: 100%;
            box-sizing: border-box;
            padding: 6px;
            border: none !important;
            outline: none !important;
            box-shadow: none !important;
            font-size: 12px;
            background: transparent;
        }

        .search-table:focus-within {
            border-color: #0d6efd;
            box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.15);
        }

        .dongthung thead {
            position: sticky;
            top: 0;
        }
    </style>
</head>
