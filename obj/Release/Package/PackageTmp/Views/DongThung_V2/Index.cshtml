    <div class="modal fade" id="scannerModal" tabindex="-1" data-bs-backdrop="static"
         data-bs-keyboard="false" style="z-index: 1054;background:rgb(0,0,0,0.45)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" style="font-size:18px">📷 Quét Barcode</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="scanner-container" style="max-width: 100%;">
                        <div class="video-container" style="position: relative; width: 100%; height: 400px; background: #000; border-radius: 10px; overflow: hidden;">
                            <video id="video-preview" playsinline muted style="width: 100%; height: 100%; object-fit: cover;"></video>
                            <!-- Overlay khung quét -->
                            <div class="scan-region-highlight" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 250px; height: 250px; box-shadow: 0 0 0 9999px rgba(0,0,0,0.5);">
                                <div class="scan-line" style="position: absolute; width: 100%; height: 2px; background: linear-gradient(90deg, transparent, #00ff00, transparent); animation: scan 2s linear infinite;"></div>
                                <div class="scan-corner corner-tl" style="position: absolute; top: -2px; left: -2px; width: 20px; height: 20px; border-top: 2px solid #00ff00; border-left: 2px solid #00ff00;"></div>
                                <div class="scan-corner corner-tr" style="position: absolute; top: -2px; right: -2px; width: 20px; height: 20px; border-top: 2px solid #00ff00; border-right: 2px solid #00ff00;"></div>
                                <div class="scan-corner corner-bl" style="position: absolute; bottom: -2px; left: -2px; width: 20px; height: 20px; border-bottom: 2px solid #00ff00; border-left: 2px solid #00ff00;"></div>
                                <div class="scan-corner corner-br" style="position: absolute; bottom: -2px; right: -2px; width: 20px; height: 20px; border-bottom: 2px solid #00ff00; border-right: 2px solid #00ff00;"></div>
                            </div>
                        </div>
                        <div class="controls text-center mt-3">
                            <button class="btn btn-success" id="startScanBtn" style="background-color: #157347;color:white ">
