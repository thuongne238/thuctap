            min-width: 34px;
            width: 34px;
            height: 34px;
            padding: 0 !important;
            background: #2563eb;
            border: 1px solid #1d4ed8;
            color: #fff;
            box-shadow: 0 2px 6px rgba(37, 99, 235, 0.28);
        }

            #btnRecalcLine .dx-button:hover {
                background: #1d4ed8;
