        body {
            font-family: Times New Roman, sans-serif;
            background: var(--page-bg);
            color: var(--text-main);
            padding-top: var(--padding-top);
        }

        /* ===== Top bar (tabs + actions in one row) ===== */
        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 2px 6px;
            margin: 4px 0;
            background: var(--bg-white);
            border-radius: 12px;
            border: 1px solid var(--border-color);
            box-shadow: 0 2px 10px rgba(15, 23, 42, 0.06);
        }


        .topbar-left {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }

        #lineTabs {
            flex: 1;
            min-width: 0;
        }

            #lineTabs .dx-tabs {
                border: 1px solid #e5e7eb;
                background: #fff;
                border-radius: 10px;
                padding: 4px;
            }

            #lineTabs .dx-tab {
                background: transparent !important;
                border: none !important;
                color: #64748b;
                font-weight: 600;
                font-size: 11px;
                padding: 6px 12px;
                border-radius: 6px;
                transition: all .15s ease;
            }


                #lineTabs .dx-tab:hover {
                    background-color: #f1f5f9 !important;
                    color: var(--text-main);
                }

                /* Tab đang được chọn (Active) */
                #lineTabs .dx-tab.dx-tab-selected {
                    background: #e0f2fe !important;
                    color: var(--accent-dark) !important;
                    font-weight: 700;
                    position: relative;
                }

                    #lineTabs .dx-tab.dx-tab-selected::after {
                        content: "";
                        position: absolute;
                        left: 10px;
                        right: 10px;
                        bottom: 2px;
                        height: 2px;
                        background: var(--accent-dark);
                        border-radius: 2px;
                    }

        /* Ẩn đường kẻ focus mặc định xấu xí của DevExtreme */
        .dx-tab.dx-state-focused::before {
            border: none !important;
        }

        /* ===== CẢI THIỆN BUTTONS (dxButton) ===== */

        /* 1. Button Load/Refresh (Style nhẹ nhàng) */
        #btnLoad .dx-button {
            background-color: #fff;
            border: 1px solid #d1d5db;
            color: #374151;
            box-shadow: 0 1px 2px rgba(0,0,0,0.04);
        }

            #btnLoad .dx-button:hover {
                background-color: #f9fafb;
                border-color: #9ca3af;
            }

        #btnLoad .dx-icon {
            color: #6b7280; /* Icon màu xám */
        }

