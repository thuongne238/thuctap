@{
    ViewBag.Title = "WIP - Đơn hàng / Chuyền";
    Layout = "~/Views/Shared/_LayoutBCTH.cshtml";
    var isWinHost = ViewBag.IsWinHost != null && (bool)ViewBag.IsWinHost;
    ViewBag.Version = "1.3"; // Dùng để cache-bust cho các file tĩnh, nếu cần
}
<link href="~/css/TheoDoiHangXuat/fontawesome.pro.6.0.0.css" rel="stylesheet" />
@*<link href="~/Content/bootstrap.css" rel="stylesheet" />*@
<link href="~/css/DevExtreme/dx.light.css" rel="stylesheet" />
<link href="~/css/DevExtreme/dx.common.css" rel="stylesheet" />
<link href="~/css/WipDonHang/popUp.css" rel="stylesheet" />
<!-- ===== TOP BAR ===== -->
<div class="wip-page-shell" style="margin-top: 0 !important; padding: 0px 15px">
    <div class="topbar">
        <!-- Left: Tabs -->
        <div class="topbar-left">
            <div id="lineTabs"></div>
        </div>

        <!-- Right: Actions -->
        <div class="topbar-right">
            <div id="btnToggleIsKetThuc"></div>
            <div id="btnToggleUnassigned"></div>
            @*<div id="btnAddRow"></div>*@
            <div id="btnLoad"></div>
            <div id="btnRecalcLine"></div>
            <div id="btnExportWipExcel"></div>
            <div id="btnSortMode"></div>
            <div id="btnDateFilter"></div>
            <div id="popDateFilter">
                <div class="date-range-row">
                    <div id="fromDate"></div>
                    <div class="date-sep">|</div>
                    <div id="toDate"></div>
                </div>
            </div>
            <div id="btnLibraryWip"></div>
            <div id="btnKHXH"></div>
            <div id="btnHeaderColorConfig"></div>
        </div>
    </div>

    <div id="gridContainer" style="width: 100%;"></div>

    <div id="unassignedWrap" class="unassigned-wrap is-collapsed">
        <div class="subgrid-bar">
            <div class="subgrid-title">Danh sách chưa chia kế hoạch</div>
            <div class="subgrid-actions">
                @*<div id="btnToggleUnassigned"></div>*@
                <div id="btnReloadUnassigned"></div>
                <div id="btnCrossMode"></div>
            </div>
        </div>

        <div id="unassignedPanel" class="unassigned-panel">
            <div id="gridContainerUnassigned" style="width: 100%;"></div>
        </div>
    </div>

    <!-- ✅ Loading overlay -->
    <div id="wipLoadPanel"></div>
    <!-- Popup nhập liệu -->
    <div id="popupEditor"></div>
    <div id="popupEditCell"></div>
    <div id="popupHeaderColor"></div>
    <div id="popupSuaLenhSX" style="display:none">
        <div class="sua-lenh-sx">
            <div class="sua-lenh-sx__header">
                <div class="sua-lenh-sx__field sua-lenh-sx__field--sx">
                    <label>Lệnh SX</label>
                    <div id="sxEdit_LenhSX"></div>
                </div>
                <div class="sua-lenh-sx__field sua-lenh-sx__field--dh">
                    <label>Đơn hàng</label>
                    <div id="sxEdit_MaDH"></div>
                </div>
                <div class="sua-lenh-sx__field sua-lenh-sx__field--mahang">
                    <label>Mã hàng</label>
                    <div id="sxEdit_MaHang"></div>
                </div>
                <div class="sua-lenh-sx__field sua-lenh-sx__field--dot">
                    <label>Đợt SX</label>
                    <div id="sxEdit_DotSX"></div>
                </div>
                <div class="sua-lenh-sx__field sua-lenh-sx__field--dvsx">
                    <label>Đơn vị sản xuất</label>
                    <div id="sxEdit_DVSX"></div>
                </div>
                <div class="sua-lenh-sx__field sua-lenh-sx__field--ghichu">
                    <label>Ghi chú</label>
                    <div id="sxEdit_GhiChu"></div>
                </div>
            </div>
            <div class="sua-lenh-sx__body">
                <div id="gridSuaLenhSXSize" class="sua-lenh-sx__grid"></div>
                <div id="gridSuaLenhSXProcess" class="sua-lenh-sx__process"></div>
            </div>
            <div class="sua-lenh-sx__availability">
                <div class="sua-lenh-sx__sub-title">Số lượng còn lại</div>
                <div id="gridSuaLenhSXAvailability" class="sua-lenh-sx__availability-grid"></div>
            </div>
            <div id="lpSuaLenhSX"></div>
        </div>
    </div>
    <!-- Floating button -->
    <div class="wip-fab-wrap">
        <button type="button" class="wip-fab" onclick="openProductionPopup('DH_323','Daisy')">
            <i class="fa fa-plus-square"></i> Chia Sản Xuất
        </button>
    </div>

    <div id="modalProduction" class="wip-modal" aria-hidden="true">
        <div class="wip-backdrop" onclick="closeProductionPopup()"></div>

        <div class="wip-dialog" role="dialog" aria-modal="true">
            <div class="wip-modal-header">
                <div class="wip-modal-title">CHIA ĐƠN HÀNG SẢN XUẤT</div>
                <button type="button" class="wip-close" onclick="closeProductionPopup()">&times;</button>
            </div>

            <div class="wip-modal-body">

                <!-- ===== FILTER ===== -->
                <div class="wip-filter">
                    <div class="wip-row">
                        <div class="wip-field wip-col-3">
                            <label class="wip-label wip-label-red">Đơn hàng</label>
                            <div id="txt_MaDH" class="wip-input"></div>
                        </div>
                        <div class="wip-field wip-col-2">
                            <label class="wip-label wip-label-red">Mã hàng</label>
                            <div id="txt_MaHang" class="wip-input"></div>
                        </div>
                        <div class="wip-field wip-col-3">
                            <label class="wip-label wip-label-red">PO</label>
                            <div id="sl_PO" class="wip-input"></div>
                        </div>

                        <div class="wip-field wip-col-2">
                            <label class="wip-label wip-label-blue">Nhóm size</label>
                            <div id="sl_InSeam" class="wip-input"></div>
                        </div>

                        <div class="wip-field wip-col-2 wip-check" style="display:none">
                            <input type="checkbox" id="chk_AllData">
                            <label for="chk_AllData">Chọn tất cả</label>
                        </div>

                        <div class="wip-field wip-col-6">
                            <label class="wip-label wip-label-blue">Màu</label>
                            <div id="sl_Mau" class="wip-input"></div>
                        </div>

                        <div class="wip-field wip-col-4">
                            <label class="wip-label wip-label-blue">Size</label>
                            <div id="sl_Size" class="wip-input"></div>
                        </div>
                        <div class="wip-field wip-col-2">
                            <button id="btnXacNhan" type="button" class="wip-btn-confirm">
                                <i class="fa fa-check"></i> Xác nhận
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ===== BLOCK TOP ===== -->
                <div class="wip-block">
                    <div class="wip-block-head">
                        <i class="fa fa-list-alt"></i> Số lượng từ đơn hàng
                    </div>

                    <div id="gridDonHangContainer" style="max-height: calc(-130px + 40vh); min-height: calc(-120px + 35vh);" class="wip-grid-top"></div>

                    <div class="wip-block-foot">
                        @*<span>SLKH: <b id="lbl_SLKH">0</b></span>*@
                        <span>Tổng: <b id="lbl_TotalTop">0</b></span>
                    </div>
                </div>

                <!-- ===== BLOCK MAIN ===== -->
                <div class="wip-block wip-block-main">
                    <div class="wip-block-head wip-head-blue">
                        <i class="fa fa-list-ul"></i> CHI TIẾT LỆNH SX
                    </div>

                    <div class="wip-toolbar">
                        @*<div class="wip-toolbar-left">
                                <button type="button" id="btnLayDuLieu" class="wip-btn wip-btn-primary">
                                    <i class="fa fa-download"></i> Lấy dữ liệu
                                </button>
                                <button type="button" class="wip-btn wip-btn-danger">
                                    <i class="fa fa-trash"></i> Xóa dòng
                                </button>
                            </div>*@

                        @*<div class="wip-toolbar-sep"></div>*@

                        <div class="wip-toolbar-field">
                            <label>Mã SX(*)</label>
                            <input id="txt_MaSX" class="wip-input wip-input-sm" value="419">
                        </div>

                        <div class="wip-toolbar-field">
                            <label>Đợt SX(*)</label>
                            <input id="txt_DotSX" type="text" class="wip-input wip-input-sm" value="SX_437-DOT-3">
                        </div>

                        <div class="wip-toolbar-field wip-toolbar-field-wide">
                            <label>Chuyền(*)</label>
                            <div id="txt_LineX" class="wip-dx wip-input-sm"></div>
                        </div>

                        <div class="wip-toolbar-field">
                            <label>ĐV SX(*)</label>
                            <div id="sl_DonViSX" class="wip-dx wip-input-sm"></div>
                        </div>

                        <div class="wip-toolbar-field wip-toolbar-note">
                            <label>Ghi chú</label>
                            <input type="text" class="wip-input wip-input-sm">
                        </div>
                        <div class="wip-toolbar-field wip-toolbar-mer">
                            <label>MD(*)</label>
                            <div id="sl_Mer" class="wip-dx wip-input-sm"></div>
                        </div>
                    </div>

                    <div class="wip-split">
                        <div class="wip-split-left">
                            <div id="gridSanXuatContainer" style="max-height: calc(-55px + 35vh); " class="wip-grid-bottom"></div>
                            <div class="wip-block-foot">
                                <span>SLTH: <b id="lbl_SLTH">0</b></span>
                                <span>Còn lại: <b id="lbl_Remain">0</b></span>
                            </div>
                        </div>

                        <div class="wip-split-right">
                            <div id="gridProcessContainer" class="wip-grid-right"></div>
                        </div>
                    </div>
                </div>
                <div class="wip-modal-topbar">
                    <button id="btnLuuTop" type="button" class="wip-topbtn wip-topbtn-save">
                        <i class="fa fa-save"></i> Lưu
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>
<div id="popupChangeLine"></div>
@*<div id="popupSplitLine"></div>*@
<div id="popupSplitLine" style="display:none">
    <div class="split-wrap">
        <div class="split-header">
            <div class="split-form-grid" id="splitFormRoot">
                <div class="f-item" style="display:none">
                    <div class="f-label">Mã ĐH</div>
                    <div id="sl_MaDH"></div>
                </div>
                <div class="f-item">
                    <div class="f-label">Mã ĐH</div>
                    <div id="sl_gopDH"></div>
                </div>

                <div class="f-item">
                    <div class="f-label">Lệnh SX</div>
                    <div id="sl_LenhSX"></div>
                </div>

                <div class="f-item">
                    <div class="f-label">Chuyền gốc</div>
                    <div id="sl_LineGocText"></div>
                </div>

                <div class="f-item">
                    <div class="f-label">Chuyền cần chia <span class="req">*</span></div>
                    <div id="sl_LineMoi"></div>
                </div>

                @*<div class="f-item f-actions">
                        <button type="button" id="btnSplitLoad" class="btn-load-native">
                            <i class="dx-icon dx-icon-refresh"></i>
                            <span>Tải dữ liệu</span>
                        </button>
                    </div>*@
            </div>
        </div>

        <div class="split-grids">
            <div class="split-grid-top">
                <div class="split-title">Chuyền hiện tại (gốc)</div>
                <div id="gridSplitTop"></div>
            </div>

            <div class="split-grid-bottom">
                <div class="split-title">Chuyền cần chia</div>
                <div id="gridSplitBottom"></div>
            </div>
        </div>
    </div>
</div>
<img style="display:none" src="~/Content/Image/LOGOVIKING.png" />
<div id="wipAuditPopup" class="wip-audit-popup" style="display:none">
    <div class="wip-audit-popup__content">
        <div id="wipAuditHeader" class="wip-audit-header"></div>
        <div id="wipAuditGrid" class="wip-audit-grid"></div>
    </div>
</div>
